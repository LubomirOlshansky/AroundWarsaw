# Godot's import cache and editor state
.godot/
.DS_Store

# Python bytecode from the tools
__pycache__/
*.pyc

# Builds: tools/export_ios.sh makes build/ios
build/

# Raw downloads (about 5 GB, some single files near 300 MB); README.md, "Map data",
# says where each comes from and how to bake it into game/map/
data/raw/

# Screenshots from test runs
shots/

# Temporary copies of the game made while measuring
game_*/

# Logs
*.log

# Session handoff notes (device IDs, local paths): local only
.handoff/

# Claude Code agents' isolated git worktrees (each on its own branch; merged, never added)
.claude/worktrees/

# Never commit keys: MCP server keys (PixelLab and others) stay in the user's Claude Code
# config, never in a project .mcp.json
.mcp.json
.env
*.env
.claude/settings.local.json

# Loop 3d-1 (the user's decision, 2026-10-29): the sector split and the prebuilt city are derived
# from the committed map (centrum.json and the .bin maps) and never committed: re-bakes grew the
# pack 194 → 340 MB in a day. A fresh clone makes them once with tools/setup_map.sh (~20 s).
game/map/sectors/
game/map/index.json
game/map/index.res
game/map/proxies.scn
game/map/shared/
