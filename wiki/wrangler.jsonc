// The design wiki: a Worker that serves build/wiki (tools/wiki_build.py) behind a password
// (worker.js runs before every file). Its own Worker and subdomain, so the landing's Worker
// (site/wrangler.jsonc) and its deploys are untouched. wiki/README.md: build, password, deploy.
{
  "name": "aroundwarsaw-wiki",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "../build/wiki",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "wiki.aroundwarsaw.app", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false
}
