// play.aroundwarsaw.app: the game's web build, a Cloudflare Worker that only serves the static
// files tools/export_web.sh makes in build/web (not committed). Its own Worker, so the landing's
// deploys (site/, also from GitHub) never touch it: `tools/export_web.sh --deploy`, or
// `npx wrangler@4 deploy` from this folder after an export. aroundwarsaw.app/play/ redirects here.
{
  "name": "aroundwarsaw-play",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "../../build/web",
    "not_found_handling": "none",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "play.aroundwarsaw.app", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false
}
