// The aroundwarsaw.app landing page: a Cloudflare Worker that serves the static files in
// public/ and, through worker.js, counts the store-button links /go/ios and /go/android.
// `npx wrangler deploy` from this folder uploads them and attaches the custom domains below
// (the aroundwarsaw.app zone must be in the same Cloudflare account).
{
  "name": "aroundwarsaw",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  // Beta links: the TestFlight public join link and the Play listing (Android testers are added by hand).
  // Empty means /go/ios and /go/android send the visitor to the beta form instead.
  "vars": { "IOS_URL": "https://testflight.apple.com/join/dKEKRncj", "ANDROID_URL": "https://play.google.com/store/apps/details?id=com.olshanskysoft.nocnawarszawa" },
  "analytics_engine_datasets": [{ "binding": "CLICKS", "dataset": "aroundwarsaw_clicks" }],
  "observability": { "enabled": true },
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": ["/go/*"],
    "directory": "./public",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "aroundwarsaw.app", "custom_domain": true },
    { "pattern": "www.aroundwarsaw.app", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false
}
