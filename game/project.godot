; Engine configuration file.

config_version=5

[application]

config/name="Around Warsaw"
run/main_scene="res://main.tscn"
run/flush_stdout_on_print=true
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.659, 0.804, 0.902, 1)
boot_splash/show_image=false

[editor_plugins]

enabled=PackedStringArray("res://addons/nw_android_export/plugin.cfg")

[autoload]

PhantomCameraManager="*res://addons/phantom_camera/scripts/managers/phantom_camera_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/handheld/orientation=4
window/ios/allow_high_refresh_rate=false

[audio]

general/ios/session_category=0

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

common/physics_interpolation=true

[rendering]

renderer/rendering_method="mobile"
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=0
textures/vram_compression/import_etc2_astc=true

[shader_globals]

lights_on={
"type": "float",
"value": 0.0
}
daylight={
"type": "float",
"value": 1.0
}
sky_colour={
"type": "vec3",
"value": Vector3(0.66, 0.8, 0.91)
}
wetness={
"type": "float",
"value": 0.0
}
rain={
"type": "float",
"value": 0.0
}
