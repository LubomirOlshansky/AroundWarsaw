## The court walls' colour: the model's own wall stone.
func _court_wall_colour(key: String) -> Color:
	match key:
		"muzeum":
			return MUZEUM_STONE
	return tower_colour(key, Color("#d9d2c4"))


## Whether an OpenStreetMap building of the bake should still be drawn.
func keeps_building(bld: Dictionary) -> bool:
	var poly := _pts(bld["p"])
	if poly.size() < 3:
		return true
	return not replaces(_centre(poly))


func _pts(flat: Array) -> PackedVector2Array:
	var out := PackedVector2Array()
	for i in range(0, flat.size() - 1, 2):
		out.append(Vector2(flat[i], flat[i + 1]))
	return out


func _centre(poly: PackedVector2Array) -> Vector2:
	var c := Vector2.ZERO
	for q in poly:
		c += q
	return c / maxf(poly.size(), 1)


## The landmarks loop: the outline of the tallest building (or part) standing on `at`, for a
## tower OpenStreetMap leaves unnamed (The Warsaw HUB).
func _tallest_at(at: Vector2) -> PackedVector2Array:
	var best := PackedVector2Array()
	var top := 0.0
	for b in data.get("buildings", []):
		if float(b["h"]) <= top:
			continue
		var q := _pts(b["p"])
		if q.size() >= 3 and Geometry2D.is_point_in_polygon(at, q):
			best = q
			top = float(b["h"])
	return best


func _landmark(name: String) -> PackedVector2Array:
	for l in data.get("landmarks", []):
		if l["name"] == name:
			return _pts(l["p"])
	return PackedVector2Array()


func _box_of(polys: Array) -> Rect2:
	var box := Rect2()
	var first := true
	for poly: PackedVector2Array in polys:
		for q in poly:
			if first:
				box = Rect2(q, Vector2.ZERO)
				first = false
			else:
				box = box.expand(q)
	return box.grow(2.0)


func _add_site(key: String, zone: Array, keep: Array = []) -> void:
	var z: Array[PackedVector2Array] = []
	for p: PackedVector2Array in zone:
		if p.size() >= 3:
			z.append(p)
	if z.is_empty():
		return
	var k: Array[PackedVector2Array] = []
	for p: PackedVector2Array in keep:
		if p.size() >= 3:
			k.append(p)
	sites.append({"key": key, "zone": z, "keep": k, "box": _box_of(z)})


## OpenStreetMap buildings (or parts) whose centre lies inside `poly` and that `test` accepts.
func _parts_in(poly: PackedVector2Array, test: Callable) -> Array[Dictionary]:
	var out: Array[Dictionary] = []
	var box := _box_of([poly])
	for bld in data["buildings"]:
		var q := _pts(bld["p"])
		if q.size() < 3:
			continue
		var c := _centre(q)
		# A bent footprint (Equator II's curve) can have its centroid outside itself: the outline's own building still counts.
		var own := q.size() == poly.size() and q[0].is_equal_approx(poly[0])
		if (own or box.has_point(c) and Geometry2D.is_point_in_polygon(c, poly)) and test.call(bld):
			out.append(bld)
	return out


## Courtyards (F, 2026-11-03): each COURT_SITES site gets the courts of game/data/courts.json
## (tools/bake_courts.py: closed-in ground with no LoD2 roof over it) whose middle lies in its
## zone, as `courts`; build() cuts them out of its flat tops and walls them in.
func _find_courts() -> void:
	if not FileAccess.file_exists(COURTS_PATH):
		return
	var parsed = JSON.parse_string(FileAccess.get_file_as_string(COURTS_PATH))
	if not parsed is Dictionary:
		return
	var rings: Array[PackedVector2Array] = []
	for flat: Array in parsed.get("courts", []):
		rings.append(_pts(flat))
	for s in sites:
		if not COURT_SITES.has(s["key"]):
			continue
		var mine: Array[PackedVector2Array] = []
		for r in rings:
			var c := _centre(r)
			if not (s["box"] as Rect2).has_point(c):
				continue
			for z: PackedVector2Array in s["zone"]:
				if Geometry2D.is_point_in_polygon(c, z):
					mine.append(r)
					break
		if not mine.is_empty():
			s["courts"] = mine


