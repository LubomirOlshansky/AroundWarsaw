	_lbox(mid, 0.14, mid, 0.18, g + 9.4, g + 23.4, U47_WALL)
	_lbox(mid, 0.5, mid, 0.34, g + 9.3, g + 9.9, U47_BASE.darkened(0.14))
	_lbox(mid, 0.36, mid, 0.14, g + 22.7, g + 23.4, U47_BASE)
	_lbox(mid, 0.74, mid + 0.3, 0.5, g + 23.4, g + 23.7, U47_TRIM)
