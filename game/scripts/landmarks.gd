const HOUSEBOAT_WALLS := [Color("#6e4f3a"), Color("#4b6b7a"), Color("#c9c1ad"), Color("#7b8a5e"), Color("#9a4d3c")]


func _find_barges() -> void:
	var homes: Array[PackedVector2Array] = []
	var white_d := INF
	var white := PackedVector2Array()
	var named := {}
	for bld in data.get("buildings", []):
		var kind := str(bld.get("kind", ""))
		if kind != "boat" and kind != "houseboat":
			continue
		var q := _pts(bld["p"])
		if q.size() < 3:
			continue
		if kind == "houseboat":
			homes.append(q)
			continue
		var name := str(bld.get("name", ""))
		if BARGE_NAMES.has(name):
			named[BARGE_NAMES[name]] = q
		elif name == "" and _centre(q).distance_to(BARGE_WHITE_AT) < white_d:
			white_d = _centre(q).distance_to(BARGE_WHITE_AT)
			white = q
	if white_d < 30.0:
		named["barka_biala"] = white
	for key: String in ["barka_wieczor", "barka_biala", "barka_marina", "barka_kaskada"]:
		if not named.has(key):
			continue
		var q: PackedVector2Array = named[key]
		_add_site(key, [_largest(Geometry2D.offset_polygon(q, 1.0, Geometry2D.JOIN_MITER))])
		if not sites.is_empty() and sites[-1]["key"] == key:
			sites[-1]["frame"] = _barge_frame(q)
	if not homes.is_empty():
		var zone: Array = []
		var frames: Array = []
		for q in homes:
			zone.append(_largest(Geometry2D.offset_polygon(q, 0.8, Geometry2D.JOIN_MITER)))
			frames.append(_barge_frame(q))
		_add_site("houseboats", zone)
		if not sites.is_empty() and sites[-1]["key"] == "houseboats":
			sites[-1]["frames"] = frames


## An outline's smallest oriented box: [centre, u axis (the long one), v axis, half u, half v].
func _barge_frame(poly: PackedVector2Array) -> Array:
	var best := INF
	var out: Array = []
	for i in poly.size():
		var e := poly[(i + 1) % poly.size()] - poly[i]
		if e.length() < 0.5:
			continue
		var a := e.normalized()
		var b := Vector2(-a.y, a.x)
		var lo := Vector2(INF, INF)
		var hi := Vector2(-INF, -INF)
		for p in poly:
			var l := Vector2(p.dot(a), p.dot(b))
			lo = Vector2(minf(lo.x, l.x), minf(lo.y, l.y))
			hi = Vector2(maxf(hi.x, l.x), maxf(hi.y, l.y))
		var size := hi - lo
		if size.x * size.y >= best:
			continue
		best = size.x * size.y
		var c := a * (lo.x + hi.x) * 0.5 + b * (lo.y + hi.y) * 0.5
		if size.x >= size.y:
			out = [c, a, b, size.x * 0.5, size.y * 0.5]
		else:
			out = [c, b, -a, size.y * 0.5, size.x * 0.5]
	return out


## Set the local frame from a barge's box and return the water's level under it (the lowest
## ground under its corners and centre: the river's drape, not the bank's).
func _barge_set(f: Array) -> float:
	_o = f[0]
	_a = f[1]
	_b = f[2]
	var hu: float = f[3]
	var hv: float = f[4]
	var g := INF
	for p in [_w(0.0, 0.0), _w(-hu, -hv), _w(hu, -hv), _w(hu, hv), _w(-hu, hv)]:
		g = minf(g, map.terrain_height(p.x, p.y))
	_g = g
	return g


## The hull's plan: the box with its ends raked (chamfered corners).
func _barge_hull(hu: float, hv: float, r: float) -> PackedVector2Array:
	return PackedVector2Array([_w(-hu, -hv + r), _w(-hu + r, -hv), _w(hu - r, -hv), _w(hu, -hv + r),
			_w(hu, hv - r), _w(hu - r, hv), _w(-hu + r, hv), _w(-hu, hv - r)])


## Which long side faces the bank (+1 or -1): the side whose points lie less far into the water.
func _barge_shore_side(hu: float, hv: float) -> float:
	if not map.has_method("shore_distance"):
		return 1.0
	var plus := 0.0
	var minus := 0.0
	for u in [-hu * 0.5, 0.0, hu * 0.5]:
		var p := _w(u, hv + 4.0)
		var m := _w(u, -hv - 4.0)
		plus += map.shore_distance(p.x, p.y)
		minus += map.shore_distance(m.x, m.y)
	return 1.0 if plus <= minus else -1.0


## A low wall (a bulwark, a railing) round a local rectangle, `t` thick, with a gap from gu0 to
## gu1 on the side v = gs * v1 (gs 0: none). The long sides run the whole length, the ends fit
## between them, so no two tops overlap.
func _barge_rail(u0: float, u1: float, v0: float, v1: float, y: float, h: float, t: float, col: Color,
		gs := 0.0, gu0 := 0.0, gu1 := 0.0) -> void:
	var top := col.lightened(0.1)
	for side: float in [-1.0, 1.0]:
		var vc := (v1 - t * 0.5) if side > 0.0 else (v0 + t * 0.5)
		if gs != 0.0 and signf(gs) == side and gu1 > gu0:
			if gu0 - u0 > 0.3:
				_lbox((u0 + gu0) * 0.5, vc, (gu0 - u0) * 0.5, t * 0.5, y, y + h, col, M_STONE, top)
			if u1 - gu1 > 0.3:
				_lbox((gu1 + u1) * 0.5, vc, (u1 - gu1) * 0.5, t * 0.5, y, y + h, col, M_STONE, top)
		else:
			_lbox((u0 + u1) * 0.5, vc, (u1 - u0) * 0.5, t * 0.5, y, y + h, col, M_STONE, top)
	for end: float in [-1.0, 1.0]:
		var uc := (u1 - t * 0.5) if end > 0.0 else (u0 + t * 0.5)
		_lbox(uc, (v0 + v1) * 0.5, t * 0.5, (v1 - v0) * 0.5 - t, y, y + h, col, M_STONE, top)


## A café umbrella over a small table at a local spot: the table, the pole, an eight-sided canopy.
func _barge_umbrella(u: float, v: float, y: float, r: float, col: Color) -> void:
	var none := Color(0, 0, 0, 0)
	_lbox(u, v, 0.35, 0.35, y, y + 0.75, Color("#3a3029"), M_STONE, Color("#5a4a3c"))
	_prism(_rect(u, v, 0.04, 0.04), y + 0.75, y + 2.3, BARGE_POST, none, M_STONE)
	_mode = M_STONE
	var ring := _circle(_w(u, v), r, 8)
	_pyramid(ring, y + 2.15, y + 2.6, col)


## A bar counter at a local spot (half sizes hu, hv): dark timber under a light top.
func _barge_bar(u: float, v: float, hu: float, hv: float, y: float, wood: Color) -> void:
	_lbox(u, v, hu, hv, y, y + 1.1, wood.darkened(0.35), M_STONE, wood.lightened(0.25))


## A festoon of warm bulbs from p to q, sagging `sag` in the middle: the wire in short pieces
## and a bulb at every joint (they glow at night: M_LAMP).
func _barge_festoon(p: Vector3, q: Vector3, sag: float, n: int) -> void:
	var prev := p
	for k in range(1, n + 1):
		var t := float(k) / n
		var at := p.lerp(q, t) - Vector3.UP * sag * 4.0 * t * (1.0 - t)
		_beam(prev, at, 0.03, BARGE_POST, false)
		if k < n:
			var keep := _mode
			_mode = M_LAMP
			var col := BARGE_BULB if k % 2 == 0 else BARGE_BULB_2
			var sq := PackedVector2Array([Vector2(at.x - 0.07, at.z - 0.07), Vector2(at.x + 0.07, at.z - 0.07),
					Vector2(at.x + 0.07, at.z + 0.07), Vector2(at.x - 0.07, at.z + 0.07)])
			_prism(sq, at.y - 0.16, at.y - 0.02, col, col, M_LAMP, M_LAMP)
			_mode = keep
		prev = at


## A post for the festoons at a local spot, from y up h.
func _barge_post(u: float, v: float, y: float, h: float) -> Vector3:
	_prism(_rect(u, v, 0.05, 0.05), y, y + h, BARGE_POST, BARGE_POST, M_STONE, M_STONE)
	var p := _w(u, v)
	return Vector3(p.x, y + h, p.y)


## The gangway from the deck's edge at u on side s out to the bank: a timber ramp with two
## handrails, from the first dry point the water map knows (4 m when it knows none).
func _barge_gangway(u: float, s: float, hv: float, deck: float) -> void:
	var reach := 4.0
	var bank := deck
	if map.has_method("shore_distance"):
		var t := 0.5
		while t <= 24.0:
			var p := _w(u, s * (hv + t))
			if map.shore_distance(p.x, p.y) <= 0.05:
				reach = t + 1.0
				var e := _w(u, s * (hv + reach))
				bank = clampf(map.terrain_height(e.x, e.y) + 0.05, deck - 1.5, deck + 2.5)
				break
			t += 0.5
	var w := BARGE_GANG_W * 0.5
	var a0 := _w(u - w, s * hv)
	var a1 := _w(u + w, s * hv)
	var b0 := _w(u - w, s * (hv + reach))
	var b1 := _w(u + w, s * (hv + reach))
	var p0 := Vector3(a0.x, deck + 0.05, a0.y)
	var p1 := Vector3(a1.x, deck + 0.05, a1.y)
	var q0 := Vector3(b0.x, bank, b0.y)
	var q1 := Vector3(b1.x, bank, b1.y)
	var up := (q0 - p0).cross(p1 - p0).normalized()
	if up.y < 0.0:
		up = -up
	var down := Vector3.UP * 0.18
	var wood := Color("#8a6a4c")
	_mode = M_STONE
	_quad(p0, p1, q1, q0, up, wood)
	var side := Vector3(_a.x, 0.0, _a.y)
	_quad(p0 - down, q0 - down, q0, p0, -side, wood.darkened(0.3))
	_quad(p1 - down, q1 - down, q1, p1, side, wood.darkened(0.3))
	for e: Array in [[p0, q0], [p1, q1]]:
		var ps: Vector3 = e[0]
		var qs: Vector3 = e[1]
		_beam(ps, ps + Vector3.UP * 1.0, 0.05, BARGE_POST)
		_beam(qs, qs + Vector3.UP * 1.0, 0.05, BARGE_POST)
		_beam(ps + Vector3.UP * 1.0, qs + Vector3.UP * 1.0, 0.05, Color("#c9ccd0"))


func _build_barge(site: Dictionary) -> void:
	var f: Array = site["frame"]
	var sty: Dictionary = BARGE_STYLE[site["key"]]
	var g := _barge_set(f)
	var hu: float = f[3]
	var hv: float = f[4]
	var none := Color(0, 0, 0, 0)
	var deck := g + BARGE_FREEBOARD
	var r := minf(1.6, hv * 0.4)
	# The hull: the antifouling band at the waterline, the hull's paint, the timber deck.
	var hull := _barge_hull(hu, hv, r)
	_prism(hull, g - BARGE_DRAFT, g + BARGE_BAND, sty["band"], none, M_STONE)
	_prism(hull, g + BARGE_BAND, deck, sty["hull"], sty["deck"], M_STONE, M_STONE)
	_collide(hull)
	var s := _barge_shore_side(hu, hv)
	# The deckhouse: glass between the frame's mullions, the roof slab on a small overhang.
	var hs: Vector2 = sty["house"]
	var u0 := -hu + 2.0 * hu * hs.x
	var u1 := -hu + 2.0 * hu * hs.y
	var hvh := hv - 0.8
	var house := _rect((u0 + u1) * 0.5, 0.0, (u1 - u0) * 0.5, hvh)
	var top := deck + BARGE_HOUSE_H
	_prism(house, deck, top, sty["glass"], none, M_PAVILION)
	_mode = M_STONE
	_mullions(house, deck, top, 1.8, 0.05, sty["frame"])
	var roof := _rect((u0 + u1) * 0.5, 0.0, (u1 - u0) * 0.5 + 0.25, hvh + 0.25)
	_prism(roof, top, top + BARGE_ROOF, sty["frame"], sty["roof"], M_STONE, M_STONE)
	var terr := top + BARGE_ROOF
	# The open deck's bulwark round the hull, a gap for the gangway on the bank's side.
	var gu := (-hu + r + u0) * 0.5 if u0 + hu > 5.0 else (u1 + hu - r) * 0.5
	var gw := BARGE_GANG_W * 0.5 + 0.1
	var rail: Color = (sty["hull"] as Color).lightened(0.06) if (sty["hull"] as Color).v < 0.5 else sty["band"]
	_barge_rail(-hu + r, hu - r, -hv + 0.05, hv - 0.05, deck, BARGE_RAIL, 0.12, rail,
			s, gu - gw, gu + gw)
	_barge_gangway(gu, s, hv, deck)
	# The open decks either side of the deckhouse: tables under umbrellas, a bar on the longer one.
	var fore := Vector2(-hu + r + 0.6, u0 - 0.5)
	var aft := Vector2(u1 + 0.5, hu - r - 0.6)
	var big := fore if fore.y - fore.x >= aft.y - aft.x else aft
	for span: Vector2 in [fore, aft]:
		var length := span.y - span.x
		if length < 3.5:
			continue
		var stalls: int = sty["stalls"] if span == big else 0
		if span == big:
			# The bar across the open deck's house end, its back to the deckhouse.
			var bu := span.y - 0.8 if span == fore else span.x + 0.8
			_barge_bar(bu, 0.0, 0.35, minf(hv - 1.6, 2.4), deck, sty["deck"])
		# Food stalls along the bank's side (the white barge): coloured kiosks with a lit hatch.
		for k in stalls:
			var su := span.x + 1.6 + k * 3.6
			if su + 1.4 > span.y - 2.0:
				break
			var col: Color = BARGE_STALLS[k % BARGE_STALLS.size()]
			_lbox(su, -s * (hv - 1.4), 1.3, 0.9, deck, deck + 2.4, col, M_STONE, col.darkened(0.15))
			var h0 := _w(su - 0.8, -s * (hv - 2.35))
			var h1 := _w(su + 0.8, -s * (hv - 2.35))
			var keep := _mode
			_mode = M_LAMP
			_quad(Vector3(h0.x, deck + 1.0, h0.y), Vector3(h1.x, deck + 1.0, h1.y), Vector3(h1.x, deck + 1.9, h1.y),
					Vector3(h0.x, deck + 1.9, h0.y), Vector3(_b.x, 0.0, _b.y) * s, BARGE_BULB)
			_mode = keep
		# Tables under umbrellas in a row or two.
		var start := span.x + (1.6 + stalls * 3.6 if stalls > 0 else 1.6)
		var stop := span.y - (2.2 if span == big else 1.4)
		var rows: Array = [0.0] if hv < 4.0 else [-hv * 0.45, hv * 0.45]
		if stalls > 0:
			rows = [s * hv * 0.3]
		var u := start
		while u <= stop:
			for v: float in rows:
				_barge_umbrella(u, v, deck, minf(1.3, hv * 0.38), sty["brella"])
			u += 3.2
		# The festoons over this deck: posts at its outer corners, strings to the deckhouse.
		var outer := span.x + 0.3 if span == fore else span.y - 0.3
		var inner := span.y if span == fore else span.x
		var pa := _barge_post(outer, -hv + 0.35, deck + BARGE_RAIL, 2.2)
		var pb := _barge_post(outer, hv - 0.35, deck + BARGE_RAIL, 2.2)
		var ia := _w(inner, -hvh)
		var ib := _w(inner, hvh)
		_barge_festoon(pa, pb, 0.35, 6)
		_barge_festoon(pa, Vector3(ib.x, top - 0.1, ib.y), 0.5, 7)
		_barge_festoon(pb, Vector3(ia.x, top - 0.1, ia.y), 0.5, 7)
	# The roof: a sun terrace behind a railing (umbrellas and a bar), or a plain roof with the
	# festoons strung over it on four posts.
	var tu0 := u0 - 0.15
	var tu1 := u1 + 0.15
	var tv := hvh + 0.15
	var canopy_top := terr
	if sty["terrace"]:
		_barge_rail(tu0, tu1, -tv, tv, terr, BARGE_RAIL, 0.08, sty["frame"])
		_barge_bar(tu1 - 1.0, 0.0, 0.3, minf(tv - 1.0, 2.0), terr, sty["deck"])
		var u := tu0 + 1.8
		while u <= tu1 - 2.8 and not sty.get("canopy", false):
			for v: float in ([0.0] if hv < 4.0 else [-tv * 0.5, tv * 0.5]):
				_barge_umbrella(u, v, terr, minf(1.2, tv * 0.42), sty["brella"])
			u += 3.4
		if sty.get("canopy", false):
			# The upper deck's canopy: slim posts every 2.6 m along both long sides, a pale roof
			# slab with a small overhang, and bulbs strung along its eaves; tables under it.
			var ch := 2.6
			canopy_top = terr + ch + 0.2
			var pu := tu0 + 0.4
			while pu <= tu1 - 0.3:
				for sd: float in [-1.0, 1.0]:
					_prism(_rect(pu, sd * (tv - 0.12), 0.05, 0.05), terr, terr + ch, sty["frame"], sty["frame"], M_STONE, M_STONE)
				pu += 2.6
			_prism(_rect((tu0 + tu1) * 0.5, 0.0, (tu1 - tu0) * 0.5 + 0.4, tv + 0.3), terr + ch, canopy_top,
					sty["frame"], sty["roof"], M_STONE, M_STONE)
			for sd: float in [-1.0, 1.0]:
				_barge_festoon(Vector3(_w(tu0, sd * (tv + 0.2)).x, terr + ch - 0.05, _w(tu0, sd * (tv + 0.2)).y),
						Vector3(_w(tu1, sd * (tv + 0.2)).x, terr + ch - 0.05, _w(tu1, sd * (tv + 0.2)).y), 0.3, maxi(6, roundi((tu1 - tu0) / 1.8)))
			var tu := tu0 + 2.0
			while tu <= tu1 - 3.2:
				for v: float in [-tv * 0.5, tv * 0.5]:
					_lbox(tu, v, 0.45, 0.45, terr, terr + 0.75, Color("#3a3029"), M_STONE, Color("#5a4a3c"))
				tu += 2.8
	if not sty.get("canopy", false):
		var posts: Array[Vector3] = []
		for c: Vector2 in [Vector2(tu0 + 0.3, -tv + 0.3), Vector2(tu1 - 0.3, -tv + 0.3), Vector2(tu1 - 0.3, tv - 0.3), Vector2(tu0 + 0.3, tv - 0.3)]:
			posts.append(_barge_post(c.x, c.y, terr, 2.6))
		var n := maxi(5, roundi((tu1 - tu0) / 2.5))
		_barge_festoon(posts[0], posts[1], 0.45, n)
		_barge_festoon(posts[3], posts[2], 0.45, n)
		_barge_festoon(posts[0], posts[2], 0.6, n + 1)
	# A flagpole at the -u end with the white-and-red flag.
	var fp := _barge_post(-hu + r + 0.4, 0.0, deck, 4.2)
	var fd := Vector3(_b.x, 0.0, _b.y) * 1.2
	_mode = M_STONE
	var nf := Vector3(_a.x, 0.0, _a.y)
	_quad(fp - Vector3.UP * 0.4, fp - Vector3.UP * 0.4 + fd, fp + fd, fp, nf, BARGE_FLAG_W)
	_quad(fp - Vector3.UP * 0.8, fp - Vector3.UP * 0.8 + fd, fp - Vector3.UP * 0.4 + fd, fp - Vector3.UP * 0.4, nf, BARGE_FLAG_R)
	# The name in neon standing on the roof's edge, on the face the game's camera sees most
	# (BEHIND_FACE, as the other landmarks' signs): on the river's north-south run that is the
	# deckhouse's southern end, read by whoever drives up the boulevard.
	var word: String = sty["word"]
	var best := -INF
	var at := Vector2.ZERO
	var out := Vector2.ZERO
	var room := 0.0
	for face: Array in [[_a, _w(u1 + 0.11, 0.0), 2.0 * hvh], [-_a, _w(u0 - 0.11, 0.0), 2.0 * hvh],
			[_b, _w((u0 + u1) * 0.5, hvh + 0.11), u1 - u0], [-_b, _w((u0 + u1) * 0.5, -hvh - 0.11), u1 - u0]]:
		var d := (face[0] as Vector2).dot(BEHIND_FACE)
		if d > best:
			best = d
			out = face[0]
			at = face[1]
			room = face[2]
	var k := minf(0.5, (room - 1.0) / Neon.length_of(word))
	var nrm := Vector3(out.x, 0.0, out.y)
	var base := canopy_top + 0.3 if sty.get("canopy", false) else terr + (BARGE_RAIL if sty["terrace"] else 0.0)
	signs.append([word, Vector3(at.x, base + 0.02, at.y), nrm, k, sty["tube"]])


## The houseboats: a short steel hull, a timber cabin with a band of windows and a flat roof on a
## small overhang, a railing round the open deck at one end.
func _build_houseboats(site: Dictionary) -> void:
	var none := Color(0, 0, 0, 0)
	var i := 0
	for f: Array in site["frames"]:
		var g := _barge_set(f)
		_walls.clear()
		_caps.clear()
		var hu: float = f[3]
		var hv: float = f[4]
		var deck := g + 0.6
		var r := minf(0.9, hv * 0.35)
		var hull := _barge_hull(hu, hv, r)
		_prism(hull, g - 0.4, g + 0.15, Color("#3a2b26"), none, M_STONE)
		_prism(hull, g + 0.15, deck, Color("#2d3238"), Color("#8f7255"), M_STONE, M_STONE)
		_collide(hull)
		var wall: Color = HOUSEBOAT_WALLS[i % HOUSEBOAT_WALLS.size()]
		i += 1
		var c0 := -hu + r + maxf(1.5, hu * 0.5)
		var c1 := hu - r * 0.5
		var cv := hv - 0.35
		var cab := _rect((c0 + c1) * 0.5, 0.0, (c1 - c0) * 0.5, cv)
		_prism(cab, deck, deck + 2.5, wall, none, M_STONE)
		# The windows: a glass band proud of the long walls (lit at night).
		for sd: float in [-1.0, 1.0]:
			var w0 := _w(c0 + 0.6, sd * (cv + 0.03))
			var w1 := _w(c1 - 0.6, sd * (cv + 0.03))
			var keep := _mode
			_mode = M_PAVILION
			_quad(Vector3(w0.x, deck + 0.9, w0.y), Vector3(w1.x, deck + 0.9, w1.y), Vector3(w1.x, deck + 2.0, w1.y),
					Vector3(w0.x, deck + 2.0, w0.y), Vector3(_b.x, 0.0, _b.y) * sd, Color("#6b8794"))
			_mode = keep
		_prism(_rect((c0 + c1) * 0.5, 0.0, (c1 - c0) * 0.5 + 0.3, cv + 0.3), deck + 2.5, deck + 2.7,
				wall.darkened(0.3), Color("#3b3f44"), M_STONE, M_STONE)
		_barge_rail(-hu + r, c0 - 0.05, -hv + 0.05, hv - 0.05, deck, 0.9, 0.06, Color("#c9ccd0"))
# --- The sailing marina in Port Czerniakowski (2026-11-02, spec docs/landmarks/specs/przystan.md) ---
## F's ask: the "przystań dla żaglówek" at the harbour on the Czerniakowska bank. OpenStreetMap
## maps its club house as an unnamed 14 m "building" standing in the water at the dam's west end,
## and the finger piers of the small south basin only as footpaths. The model: the club house on
## its outline (white walls, a glazed upper floor, a red hipped roof, a flagpole, a neon name),
## lit pier-end lamps, sailboats berthed between the fingers and along the dam, and more on
## buoys in the big basin, all bows to the wind. Built from the map's own outline and the water
## map (no photos in the cloud: the Mac check settles colours and the berth count).
const MARINA_AT := Vector2(1588.5, 1589.0)  # inside the unnamed club house
const MARINA_BOX := Rect2(1535.0, 1480.0, 130.0, 215.0)
## Berths between the fingers: centre z of each slip, and the x of its boats' centres.
const MARINA_SLIPS := [[1641.2, [1601.0, 1611.5]], [1647.2, [1601.0, 1611.0]], [1652.8, [1601.5, 1610.5]], [1658.5, [1601.5, 1608.0]]]
## Boats lying along the dam's north face (z, x) and on buoys in the basin (x, z).
const MARINA_DAM := [Vector2(1593.0, 1614.2), Vector2(1604.5, 1614.2), Vector2(1616.0, 1614.2), Vector2(1627.5, 1614.2), Vector2(1639.0, 1614.4)]
const MARINA_BUOYS := [Vector2(1618.0, 1470.0), Vector2(1640.0, 1492.0), Vector2(1620.0, 1515.0), Vector2(1645.0, 1535.0),
		Vector2(1624.0, 1556.0), Vector2(1598.0, 1530.0), Vector2(1636.0, 1572.0), Vector2(1604.0, 1580.0)]
const MARINA_LAMPS := [Vector2(1621.0, 1638.6), Vector2(1620.0, 1644.8), Vector2(1615.0, 1650.1), Vector2(1617.0, 1655.9), Vector2(1611.0, 1661.7)]
const MARINA_HULLS := [Color("#f2f2ee"), Color("#1f3a5f"), Color("#f2f2ee"), Color("#a3262a"), Color("#e8e0c8"), Color("#2e6e6a"), Color("#f2f2ee"), Color("#3b3f46")]
const MARINA_WALL := Color("#efeee8")
const MARINA_ROOF := Color("#a4412e")
const MARINA_TRIM := Color("#1f3a5f")
const MARINA_NEON := Color(0.3, 0.75, 1.0)
const MARINA_WIND := Vector2(0.45, -0.89)  # the boats' bows: into the wind from the north-north-east


func _find_marina() -> void:
	var q := _tallest_at(MARINA_AT)
	if q.size() < 3:
		return
	var zone: Array = [_largest(Geometry2D.offset_polygon(q, 1.0, Geometry2D.JOIN_MITER))]
	# Tiny zones at the corners of the marina's extent keep the site's box over every boat (a
	# site's zone drops what stands in it, and nothing's centre stands in a 0.2 m square).
	for c: Vector2 in [MARINA_BOX.position, MARINA_BOX.end, Vector2(MARINA_BOX.position.x, MARINA_BOX.end.y),
			Vector2(MARINA_BOX.end.x, MARINA_BOX.position.y)]:
		zone.append(PackedVector2Array([c, c + Vector2(0.2, 0.0), c + Vector2(0.2, 0.2), c + Vector2(0.0, 0.2)]))
	_add_site("marina", zone)
	if not sites.is_empty() and sites[-1]["key"] == "marina":
		sites[-1]["club"] = q


# --- Port Czerniakowski: the spit and the basin (F, 2026-11-07, his photos port-czerniakowski) ---
## F's ask: design the spit and the harbour properly. Photos: GUGiK aerials, the club's terrace
## and pontoon, WTW's gate and boathouse, the basin, its boats and houseboats
## (/mnt/project-files/port-czerniakowski/). OpenStreetMap draws every building on the spit as a
## default 14 m block. Here:
## - The tip's block becomes MAJAMI WAWA, the parody of the open-air club: a dark timber deck
##   behind a heavy railing under the willows, a red-orange stretch tent and a beige one,
##   festoons, two fire pits, a bar with thatched umbrellas, and its white floating pontoon on
##   the river side.
## - WTW's boathouse is long, white and low under a shallow cobalt roof, with the white hexagon
##   sign and a blue gate on Zaruskiego.
## - The other blocks become low halls with pitched roofs, white or grey under blue-grey and grey
##   metal, as the aerials show.
## - The basin gets boats moored stern-to along both quays between finger piers, motorboats with a
##   few sailboats, and houseboats along the west quay.
const PORT_TIP := Vector2(1404.0, 687.0)
const PORT_WTW := Vector2(1420.0, 794.0)
## The other blocks on the spit (a point in each): eaves height, wall, roof. The order follows the
## aerial from north to south: the white kayak hangar with the blue ridge, then the halls.
const PORT_HALLS := [
	[Vector2(1395.0, 755.0), 4.3, Color("#efefea"), Color("#e9ebee")],
	[Vector2(1420.0, 805.0), 4.5, Color("#d9d6cf"), Color("#7f93a6")],
	[Vector2(1429.0, 825.0), 4.0, Color("#cfcac0"), Color("#8d949b")],
	[Vector2(1425.0, 835.0), 4.8, Color("#d4d0c6"), Color("#76889a")],
	[Vector2(1450.0, 864.0), 5.0, Color("#e2dfd6"), Color("#7a8fa3")],
	[Vector2(1456.0, 890.0), 4.2, Color("#d9d3c6"), Color("#8b9198")],
	[Vector2(1468.0, 883.0), 4.6, Color("#e6e3dc"), Color("#6f8396")],
]
const PORT_WTW_WALL := Color("#f1f1ec")
const PORT_WTW_ROOF := Color("#1f4fb0")
const PORT_WTW_BLUE := Color("#2457b8")
## WTW's gate on Zaruskiego (the service road east of the boathouse) and the street's run there.
const PORT_WTW_GATE := Vector2(1437.5, 789.0)
const PORT_WTW_ALONG := Vector2(0.43, 0.9)
## The basin's run (z) and the strip of x to search for its water.
const PORT_BASIN_Z := Vector2(728.0, 992.0)
const PORT_BASIN_X := Vector2(1318.0, 1400.0)
const PORT_SLIP := 4.6          # stern-to berths: one boat per this many metres of quay
const PORT_TIMBER := Color("#8a6a4c")
const PORT_DECK := Color("#4e3a2c")       # Majami's dark terrace planks
const PORT_TENT_RED := Color("#d2492c")
const PORT_TENT_BEIGE := Color("#cdbf9f")
const PORT_STRAW := Color("#c9a764")
const PORT_HOUSEBOATS := [Color("#3a3d42"), Color("#8f969c"), Color("#2c2f33")]
const PORT_COPPER := Color("#b26a3a")


func _find_port() -> void:
	var tip := _tallest_at(PORT_TIP)
	if tip.size() >= 3:
		var zone: Array = [_largest(Geometry2D.offset_polygon(tip, 1.0, Geometry2D.JOIN_MITER))]
		_add_site("port_majami", zone)
		if not sites.is_empty() and sites[-1]["key"] == "port_majami":
			sites[-1]["tip"] = tip
			sites[-1]["box"] = (sites[-1]["box"] as Rect2).grow(45.0)
	var wtw := _tallest_at(PORT_WTW)
	if wtw.size() >= 3:
		_add_site("port_wtw", [_largest(Geometry2D.offset_polygon(wtw, 1.0, Geometry2D.JOIN_MITER))])
		if not sites.is_empty() and sites[-1]["key"] == "port_wtw":
			sites[-1]["hall"] = wtw
			sites[-1]["box"] = (sites[-1]["box"] as Rect2).grow(12.0)
	var zone: Array = []
	var halls: Array = []
	for h: Array in PORT_HALLS:
		var q := _tallest_at(h[0])
		if q.size() < 3 or q == wtw:
			continue
		zone.append(_largest(Geometry2D.offset_polygon(q, 0.8, Geometry2D.JOIN_MITER)))
		halls.append([q, h[1], h[2], h[3]])
	if not zone.is_empty():
		_add_site("port_halls", zone)
		if not sites.is_empty() and sites[-1]["key"] == "port_halls":
			sites[-1]["halls"] = halls
	# The basin: tiny zones at the corners of its extent keep the site's box over every boat.
	var b := Rect2(PORT_BASIN_X.x, PORT_BASIN_Z.x, PORT_BASIN_X.y - PORT_BASIN_X.x, PORT_BASIN_Z.y - PORT_BASIN_Z.x)
	var corners: Array = []
	for c: Vector2 in [b.position, b.end, Vector2(b.position.x, b.end.y), Vector2(b.end.x, b.position.y)]:
		corners.append(PackedVector2Array([c, c + Vector2(0.2, 0.0), c + Vector2(0.2, 0.2), c + Vector2(0.0, 0.2)]))
	_add_site("port_basin", corners)


## A low hall on a mapped outline: walls up to `h`, a pitched metal roof along its long side
## with a small overhang, the gable ends in the wall's colour.
func _port_hall(q: PackedVector2Array, h: float, wall: Color, roof: Color, rise := 1.6) -> float:
	var none := Color(0, 0, 0, 0)
	var f := _barge_frame(q)
	if f.is_empty():
		return -INF
	_barge_set(f)
	var hu: float = f[3]
	var hv: float = f[4]
	var g := INF
	var top := -INF
	for p in q:
		var t: float = map.terrain_height(p.x, p.y)
		g = minf(g, t)
		top = maxf(top, t)
	_g = g
	var eave := top + h
	_prism(q, g - 0.3, eave, wall, none, M_STONE)
	_collide(q)
	# The plinth band and a band of windows along the long sides.
	_prism(_largest(Geometry2D.offset_polygon(q, 0.06, Geometry2D.JOIN_MITER)), g - 0.3, top + 0.45, wall.darkened(0.35), none, M_STONE)
	_gable(hu + 0.35, -hu - 0.35, 0.0, hv + 0.45, eave, minf(rise, hv * 0.5), wall, roof)
	return eave


func _build_port_halls(site: Dictionary) -> void:
	for h: Array in site["halls"]:
		var eave := _port_hall(h[0], h[1], h[2], h[3])
		# The kayak hangar's blue ridge stripe (the aerial's white roof with a blue line).
		if h == site["halls"][0] and eave > -INF:
			var f := _barge_frame(h[0])
			var hu: float = f[3]
			var hv: float = f[4]
			var rise := minf(1.6, (hv + 0.45) * 0.5)
			_mode = M_STONE
			_prism(_rect(0.0, 0.0, hu + 0.35, 0.35), eave + rise - 0.05, eave + rise + 0.08, PORT_WTW_BLUE, PORT_WTW_BLUE, M_STONE, M_STONE)


## WTW's boathouse: long, white and low under a shallow cobalt roof with a raised middle; a band of
## windows; on Zaruskiego the white hexagon sign on two posts, the blue gate and two blue anchors.
func _build_port_wtw(site: Dictionary) -> void:
	var q: PackedVector2Array = site["hall"]
	var eave := _port_hall(q, 3.6, PORT_WTW_WALL, PORT_WTW_ROOF, 0.9)
	if eave == -INF:
		return
	var f := _barge_frame(q)
	var hu: float = f[3]
	var hv: float = f[4]
	_mode = M_STONE
	# The arch over the middle of the roof (the club's raised entrance bay).
	_prism(_rect(0.0, 0.0, minf(4.0, hu * 0.25), hv + 0.5), eave, eave + 1.6, PORT_WTW_WALL, PORT_WTW_ROOF, M_STONE, M_STONE)
	# Windows: a dark band on both long sides.
	for sd: float in [-1.0, 1.0]:
		var a := _w(-hu + 1.0, sd * (hv + 0.03))
		var b := _w(hu - 1.0, sd * (hv + 0.03))
		_mode = M_PAVILION
		_quad(Vector3(a.x, eave - 2.2, a.y), Vector3(b.x, eave - 2.2, b.y), Vector3(b.x, eave - 0.9, b.y), Vector3(a.x, eave - 0.9, a.y),
				Vector3(_b.x, 0.0, _b.y) * sd, Color("#5f7c8c"))
	_mode = M_STONE
	# The gate on Zaruskiego, in a frame of its own: u along the street, +v towards it.
	_o = PORT_WTW_GATE
	_a = PORT_WTW_ALONG
	_b = Vector2(PORT_WTW_ALONG.y, -PORT_WTW_ALONG.x)
	var g: float = map.terrain_height(_o.x, _o.y)
	_g = g
	for k in 14:
		var u := -4.5 + k * 0.7
		_lbox(u, 0.0, 0.06, 0.06, g, g + 1.9, PORT_WTW_BLUE, M_STONE)
	_lbox(0.0, 0.0, 4.6, 0.05, g + 1.75, g + 1.9, PORT_WTW_BLUE, M_STONE)
	_lbox(0.0, 0.0, 4.6, 0.05, g + 0.2, g + 0.32, PORT_WTW_BLUE, M_STONE)
	# The hexagon sign on two posts beside the gate, facing the street.
	var su := 6.8
	for du: float in [-0.9, 0.9]:
		_lbox(su + du, 0.0, 0.08, 0.08, g, g + 3.4, Color("#e8e8e4"), M_STONE)
	var sp := _w(su, 0.12)
	var n := Vector3(_b.x, 0.0, _b.y)
	_disc(Vector3(sp.x, g + 3.6, sp.y), n, 1.6, 6, Color("#f6f6f2"))
	_disc(Vector3(sp.x, g + 3.6, sp.y) + n * 0.08, n, 1.35, 6, PORT_WTW_BLUE)
	signs.append(["WTW", Vector3(sp.x, g + 3.25, sp.y) + n * 0.14, n, 0.36, Color(0.95, 0.97, 1.0)])
	# Two big blue anchors on slabs either side of the gate: a shank, a stock, two flukes.
	for du: float in [-6.4, 9.6]:
		var c := 1.2
		_lbox(du, c, 0.9, 0.6, g, g + 0.2, Color("#9c9a94"), M_STONE)
		_lbox(du, c, 0.12, 0.12, g + 0.2, g + 2.3, PORT_WTW_BLUE, M_STONE)
		_lbox(du, c, 0.75, 0.1, g + 2.0, g + 2.15, PORT_WTW_BLUE, M_STONE)
		for side: float in [-1.0, 1.0]:
			var a0 := _w(du, c)
			var a1 := _w(du + side * 0.75, c)
			_beam(Vector3(a0.x, g + 0.3, a0.y), Vector3(a1.x, g + 0.9, a1.y), 0.14, PORT_WTW_BLUE)


## MAJAMI WAWA at the spit's tip: the dark timber terrace on the mapped outline, its railing,
## the two tents, festoons on posts, two fire pits on the grass, a bar under thatched umbrellas,
## and the white floating pontoon on the river side (a BARGE_STYLE barge on a frame of its own).
func _build_port_majami(site: Dictionary) -> void:
	var q: PackedVector2Array = site["tip"]
	var pf := _port_pontoon_frame(q)
	if not pf.is_empty():
		_build_barge({"key": "port_majami", "frame": pf})
	var f := _barge_frame(q)
	if f.is_empty():
		return
	_barge_set(f)
	var hu: float = f[3]
	var hv: float = f[4]
	var top := -INF
	for p in q:
		top = maxf(top, map.terrain_height(p.x, p.y))
	var deck := top + 0.6
	_prism(q, _g - 0.3, deck, PORT_DECK.darkened(0.25), PORT_DECK, M_STONE, M_STONE)
	_barge_rail(-hu + 0.2, hu - 0.2, -hv + 0.2, hv - 0.2, deck, 1.0, 0.14, Color("#5b4434"), 1.0, -1.5, 1.5)
	# The red-orange stretch tent over the north half, the beige one over the south half: low
	# pyramids on four slim poles.
	for t: Array in [[-hu * 0.45, PORT_TENT_RED, 4.2], [hu * 0.45, PORT_TENT_BEIGE, 5.4]]:
		var cu: float = t[0]
		var tu := minf(4.5, hu * 0.42)
		var tv := minf(3.8, hv * 0.7)
		for c: Vector2 in [Vector2(cu - tu, -tv), Vector2(cu + tu, -tv), Vector2(cu + tu, tv), Vector2(cu - tu, tv)]:
			_lbox(c.x, c.y, 0.06, 0.06, deck, deck + 2.6, Color("#d8d4cc"), M_STONE)
		_mode = M_STONE
		_frustum(_rect(cu, 0.0, tu + 0.3, tv + 0.3), deck + 2.5, _rect(cu, 0.0, 0.5, 0.5), deck + float(t[2]), t[1], t[1])
		# Tables and wicker sofas under it.
		for k in 3:
			_lbox(cu - tu * 0.6 + k * tu * 0.6, 0.0, 0.45, 0.45, deck, deck + 0.72, Color("#3a3029"), M_STONE, Color("#6b5a48"))
	# The bar with thatched umbrellas at the deck's west end.
	_barge_bar(0.0, -hv + 1.4, minf(3.0, hu * 0.3), 0.4, deck, Color("#7a5a3e"))
	for k in 3:
		_barge_umbrella(-hu * 0.6 + k * hu * 0.6, hv - 1.8, deck, 1.3, PORT_STRAW)
	# Festoons over the deck on six posts round its edge.
	var posts: Array[Vector3] = []
	for c: Vector2 in [Vector2(-hu + 0.5, -hv + 0.5), Vector2(0.0, -hv + 0.5), Vector2(hu - 0.5, -hv + 0.5),
			Vector2(hu - 0.5, hv - 0.5), Vector2(0.0, hv - 0.5), Vector2(-hu + 0.5, hv - 0.5)]:
		posts.append(_barge_post(c.x, c.y, deck, 3.4))
	for k in 6:
		_barge_festoon(posts[k], posts[(k + 1) % 6], 0.5, 7)
	_barge_festoon(posts[1], posts[4], 0.7, 8)
	# Two round steel fire pits on the grass beyond the deck's river end, glowing at night.
	for k in 2:
		var fp := _w(hu + 3.0, (k - 0.5) * 4.0)
		var fg: float = map.terrain_height(fp.x, fp.y)
		_g = fg
		_prism(_circle(fp, 0.45, 8), fg, fg + 0.45, Color("#2e2b28"), Color("#2e2b28"), M_STONE, M_STONE)
		var keep := _mode
		_mode = M_LAMP
		_prism(_circle(fp, 0.3, 6), fg + 0.45, fg + 0.6, Color(1.0, 0.5, 0.2), Color(1.0, 0.55, 0.25), M_LAMP, M_LAMP)
		_mode = keep
		for d: float in [-1.0, 1.0]:
			var ch := fp + Vector2(d * 1.4, 0.4)
			_g = map.terrain_height(ch.x, ch.y)
			_prism(_circle(ch, 0.35, 6), _g, _g + 0.4, Color("#d9cdb4"), Color("#e6dcc4"), M_STONE, M_STONE)
	_collide(q)
	_g = top
	# The name in neon on the deck's railing towards the camera.
	var best := -INF
	var at := Vector2.ZERO
	var out := Vector2.ZERO
	for face: Array in [[_a, _w(hu + 0.1, 0.0)], [-_a, _w(-hu - 0.1, 0.0)], [_b, _w(0.0, hv + 0.1)], [-_b, _w(0.0, -hv - 0.1)]]:
		var d := (face[0] as Vector2).dot(BEHIND_FACE)
		if d > best:
			best = d
			out = face[0]
			at = face[1]
	signs.append(["MAJAMI WAWA", Vector3(at.x, deck + 1.05, at.y), Vector3(out.x, 0.0, out.y), 0.42, Color(1.0, 0.45, 0.35)])


## Where Majami's pontoon floats: off the tip on the river side, its long side along the bank, in
## water at least 2 m deep in the water map's sense (shore_distance), clear of the race pontoon.
func _port_pontoon_frame(q: PackedVector2Array) -> Array:
	if not map.has_method("shore_distance"):
		return []
	var c := _centre(q)
	var hu := 7.0
	var hv := 2.8
	for ang_deg: float in [-35.0, -55.0, -15.0, -75.0, 5.0]:
		var d := Vector2(cos(deg_to_rad(ang_deg)), sin(deg_to_rad(ang_deg)))
		var t := 8.0
		while t < 70.0:
			var p := c + d * t
			if map.shore_distance(p.x, p.y) > hv + 1.5:
				# The long side along the bank: across the way out.
				var a := Vector2(-d.y, d.x)
				var ok := true
				for k: Vector2 in [Vector2(-hu, -hv), Vector2(hu, -hv), Vector2(hu, hv), Vector2(-hu, hv)]:
					var w := p + a * k.x + d * k.y
					if map.shore_distance(w.x, w.y) < 1.0 or w.distance_to(Vector2(1464.0, 703.0)) < 14.0:
						ok = false
				if ok:
					return [p + d * 1.0, a, d, hu, hv]
				break
			t += 1.0
	return []


## The basin's boats: along both quays, stern-to between finger piers, every PORT_SLIP m; along
## the west quay's north end three houseboats instead. Each quay is found from the water map:
## for each slip's z, the first and last wet x across PORT_BASIN_X.
func _build_port_basin(_site: Dictionary) -> void:
	if not map.has_method("shore_distance"):
		return
	var n := 0
	var z := PORT_BASIN_Z.x
	var homes := 0
	while z <= PORT_BASIN_Z.y:
		var lo := INF
		var hi := -INF
		var x := PORT_BASIN_X.x
		while x <= PORT_BASIN_X.y:
			if map.shore_distance(x, z) > 0.4:
				lo = minf(lo, x)
				hi = maxf(hi, x)
			x += 0.5
		if hi - lo >= 14.0 and hi - lo <= 90.0:
			for side: float in [-1.0, 1.0]:
				var quay := lo if side < 0.0 else hi
				var into := -side  # from the quay into the water
				if side < 0.0 and z < PORT_BASIN_Z.x + 60.0 and homes < 3 and n % 3 == 0:
					var hc := Vector2(quay + into * 3.2, z)
					if map.shore_distance(hc.x, hc.y) > 1.6:
						_port_houseboat(hc, homes)
						homes += 1
						n += 1
						continue
				# An empty berth now and then, and lengths that don't repeat in step with the colours.
				if (n * 7 + int(z)) % 11 == 0:
					n += 1
					continue
				var blen := 5.2 + 0.9 * float((n * 5) % 4) + (2.5 if n % 13 == 6 else 0.0)
				var c := Vector2(quay + into * (0.8 + blen * 0.5), z)
				if hi - lo < 2.0 * blen + 8.0 or map.shore_distance(c.x, c.y) < 0.9:
					continue
				_port_finger(Vector2(quay, z + PORT_SLIP * 0.5), Vector2(into, 0.0), blen * 0.8)
				if n % 5 == 2:
					_sailboat(c, Vector2(into, 0.0), blen + 1.0, n)
				else:
					_port_motorboat(c, Vector2(into, 0.0), blen, n)
				n += 1
		z += PORT_SLIP


## A finger pier: a narrow timber walk on posts from the quay into the water.
func _port_finger(at: Vector2, d: Vector2, length: float) -> void:
	var g: float = map.terrain_height(at.x + d.x * 2.0, at.y)
	_g = g
	var a := at
	var b := at + Vector2(d.x * length, 0.0)
	var poly := PackedVector2Array([a + Vector2(0, -0.45), b + Vector2(0, -0.45), b + Vector2(0, 0.45), a + Vector2(0, 0.45)])
	_prism(poly, g + 0.25, g + 0.45, PORT_TIMBER.darkened(0.3), PORT_TIMBER, M_STONE, M_STONE)


## A small motorboat moored at `c`, bow towards `d`: a hull with a dark boot top, a pale deck, a
## console with a windscreen, a cover over the stern on every other one.
func _port_motorboat(c: Vector2, d: Vector2, length: float, i: int) -> void:
	var g: float = map.terrain_height(c.x, c.y)
	_g = g
	var a := d.normalized()
	var b := Vector2(-a.y, a.x)
	var hl := length * 0.5
	var hb := length * 0.19
	var hull := PackedVector2Array([c + a * hl, c + a * hl * 0.4 + b * hb, c - a * hl + b * hb * 0.9,
			c - a * hl - b * hb * 0.9, c + a * hl * 0.4 - b * hb])
	var col: Color = MARINA_HULLS[(i * 3) % MARINA_HULLS.size()]
	_prism(hull, g - 0.3, g + 0.2, Color("#2b2f36"), Color(0, 0, 0, 0), M_STONE)
	_prism(hull, g + 0.2, g + 0.75, col, Color("#e4ded0"), M_STONE, M_STONE)
	var cs := c + a * hl * 0.05
	var con := PackedVector2Array([cs + a * 0.5 + b * hb * 0.5, cs - a * 0.6 + b * hb * 0.5, cs - a * 0.6 - b * hb * 0.5, cs + a * 0.5 - b * hb * 0.5])
	_prism(con, g + 0.75, g + 1.15, Color("#e9e8e2"), Color("#d6d4cc"), M_STONE, M_STONE)
	var w0 := cs + a * 0.5 + b * hb * 0.55
	var w1 := cs + a * 0.5 - b * hb * 0.55
	_quad(Vector3(w0.x, g + 1.15, w0.y), Vector3(w1.x, g + 1.15, w1.y), Vector3(w1.x, g + 1.55, w1.y), Vector3(w0.x, g + 1.55, w0.y),
			Vector3(a.x, 0.3, a.y).normalized(), Color("#4b6470"))
	if i % 2 == 1:
		var cov := PackedVector2Array([c - a * hl * 0.25 + b * hb * 0.8, c - a * hl * 0.9 + b * hb * 0.75,
				c - a * hl * 0.9 - b * hb * 0.75, c - a * hl * 0.25 - b * hb * 0.8])
		_prism(cov, g + 0.75, g + 1.05, Color("#1f3a5f"), Color("#24426b"), M_STONE, M_STONE)


## A houseboat along the west quay (F's photos: an anthracite box with a glazed front, a grey
## converted barge with railings on its flat roof, one with a copper standing-seam gable).
func _port_houseboat(c: Vector2, i: int) -> void:
	var g: float = map.terrain_height(c.x, c.y)
	_g = g
	_o = c
	_a = Vector2(0.0, 1.0)
	_b = Vector2(1.0, 0.0)
	var hu := 6.0 + 2.0 * float(i % 2)
	var hv := 2.2
	var col: Color = PORT_HOUSEBOATS[i % PORT_HOUSEBOATS.size()]
	_prism(_rect(0.0, 0.0, hu, hv), g - 0.4, g + 0.6, Color("#3b3e43"), Color("#6c5a48"), M_STONE, M_STONE)
	_prism(_rect(-0.6, 0.0, hu - 1.6, hv - 0.3), g + 0.6, g + 3.2, col, Color(0, 0, 0, 0), M_STONE)
	_mode = M_PAVILION
	var f0 := _w(hu - 2.2, -hv + 0.3)
	var f1 := _w(hu - 2.2, hv - 0.3)
	_quad(Vector3(f0.x, g + 0.8, f0.y), Vector3(f1.x, g + 0.8, f1.y), Vector3(f1.x, g + 3.0, f1.y), Vector3(f0.x, g + 3.0, f0.y),
			Vector3(_a.x, 0.0, _a.y), Color("#6e8b96"))
	_mode = M_STONE
	if i % 3 == 2:
		_gable(hu - 1.8, -hu + 0.6, 0.0, hv, g + 3.2, 1.4, col, PORT_COPPER)
	else:
		_prism(_rect(-0.6, 0.0, hu - 1.5, hv - 0.2), g + 3.2, g + 3.4, col.lightened(0.1), col.darkened(0.15), M_STONE, M_STONE)
		if i % 3 == 1:
			_barge_rail(-hu + 1.0, hu - 2.2, -hv + 0.3, hv - 0.3, g + 3.4, 0.9, 0.05, Color("#c9ccd0"))
	_collide(_rect(0.0, 0.0, hu, hv))


## True where the water map says there is open water (a boat's centre wants a metre of it).
func _marina_wet(p: Vector2, margin: float) -> bool:
	return not map.has_method("shore_distance") or map.shore_distance(p.x, p.y) > margin


func _build_marina(site: Dictionary) -> void:
	_marina_club(site["club"])
	var n := 0
	# Berths: boats along x with the bow to the east, two to a slip where the water goes on.
	for slip: Array in MARINA_SLIPS:
		for x: float in slip[1]:
			var c := Vector2(x, slip[0])
			if _marina_wet(c, 1.2) and _marina_wet(c + Vector2(4.0, 0.0), 0.6) and _marina_wet(c - Vector2(4.0, 0.0), 0.6):
				_sailboat(c, Vector2.RIGHT, 8.4 + 0.3 * (n % 3), n)
				n += 1
	# Alongside the dam, bows to the west, the head of the harbour.
	for c: Vector2 in MARINA_DAM:
		if _marina_wet(c, 0.8):
			_sailboat(c, Vector2.LEFT, 9.0 + 0.4 * (n % 3), n)
			n += 1
	# On buoys in the big basin, all bows into the wind, each a little off the next.
	for c: Vector2 in MARINA_BUOYS:
		if _marina_wet(c, 8.0):
			var d := MARINA_WIND.rotated(0.18 * float(n % 5 - 2)).normalized()
			_sailboat(c, d, 8.6 + 0.8 * (n % 4), n)
			_marina_buoy(c + d * 7.5)
			n += 1
	for c: Vector2 in MARINA_LAMPS:
		_marina_lamp(c)


## One sailboat on the water at `c`, bow towards `d`: a hull with a dark sheer band and a deck, a
## doghouse, a mast with a forestay and a furled sail on the boom.
func _sailboat(c: Vector2, d: Vector2, length: float, i: int) -> void:
	var g: float = map.terrain_height(c.x, c.y)
	_g = g
	var none := Color(0, 0, 0, 0)
	var a := d.normalized()
	var b := Vector2(-a.y, a.x)
	var hl := length * 0.5
	var hb := length * 0.15
	var hull := PackedVector2Array([c + a * hl, c + a * hl * 0.45 + b * hb, c - a * hl * 0.8 + b * hb, c - a * hl + b * hb * 0.7,
			c - a * hl - b * hb * 0.7, c - a * hl * 0.8 - b * hb, c + a * hl * 0.45 - b * hb])
	var col: Color = MARINA_HULLS[i % MARINA_HULLS.size()]
	_prism(hull, g - 0.35, g + 0.35, col.darkened(0.25), none, M_STONE)
	_prism(hull, g + 0.35, g + 0.85, col, Color("#c9a77a"), M_STONE, M_STONE)
	var cab := PackedVector2Array([c + a * hl * 0.15 + b * hb * 0.6, c - a * hl * 0.5 + b * hb * 0.6,
			c - a * hl * 0.5 - b * hb * 0.6, c + a * hl * 0.15 - b * hb * 0.6])
	_prism(cab, g + 0.85, g + 1.35, Color("#e9e8e2"), Color("#d9d8d0"), M_STONE, M_STONE)
	var m0 := c + a * hl * 0.12
	var top := Vector3(m0.x, g + length * 1.15, m0.y)
	_beam(Vector3(m0.x, g + 0.85, m0.y), top, 0.1, Color("#c9ced2"))
	var bow := c + a * hl * 0.92
	_beam(Vector3(bow.x, g + 0.85, bow.y), top, 0.03, Color("#8a9096"), false)
	var boom_end := c - a * hl * 0.85
	_beam(Vector3(m0.x, g + 1.5, m0.y), Vector3(boom_end.x, g + 1.55, boom_end.y), 0.1, Color("#c9ced2"))
	_beam(Vector3(m0.x, g + 1.75, m0.y), Vector3(boom_end.x, g + 1.75, boom_end.y), 0.34, Color("#f0eadb"))


## A mooring buoy: a small red drum on the water.
func _marina_buoy(p: Vector2) -> void:
	_g = map.terrain_height(p.x, p.y)
	var ring := _circle(p, 0.35, 6)
	_prism(ring, _g - 0.1, _g + 0.35, Color("#d4483b"), Color("#d4483b"), M_STONE, M_STONE)


## A pier-end lamp: a post with a warm lantern (it glows at night).
func _marina_lamp(p: Vector2) -> void:
	var g: float = map.terrain_height(p.x, p.y)
	_g = g
	var sq := PackedVector2Array([p + Vector2(-0.05, -0.05), p + Vector2(0.05, -0.05), p + Vector2(0.05, 0.05), p + Vector2(-0.05, 0.05)])
	_prism(sq, g, g + 2.2, BARGE_POST, BARGE_POST, M_STONE, M_STONE)
	var lan := PackedVector2Array([p + Vector2(-0.14, -0.14), p + Vector2(0.14, -0.14), p + Vector2(0.14, 0.14), p + Vector2(-0.14, 0.14)])
	var keep := _mode
	_mode = M_LAMP
	_prism(lan, g + 2.2, g + 2.55, BARGE_BULB, BARGE_BULB, M_LAMP, M_LAMP)
	_mode = keep


## The club house on its mapped outline: piles into the water, white walls with a glazed upper
## band, a red hipped roof, a flagpole, and the name in neon on the face the camera sees.
func _marina_club(outline: PackedVector2Array) -> void:
	var none := Color(0, 0, 0, 0)
	var f := _barge_frame(outline)
	if f.is_empty():
		return
	_barge_set(f)
	var hu: float = f[3]
	var hv: float = f[4]
	var low := INF
	var quay := -INF
	for p in outline:
		var h: float = map.terrain_height(p.x, p.y)
		low = minf(low, h)
		quay = maxf(quay, h)
	quay = maxf(quay, low + 0.8)
	_g = low
	_prism(outline, low - 0.8, quay, Color("#5b5650"), Color("#8a7a62"), M_STONE, M_STONE)
	var walls := _largest(Geometry2D.offset_polygon(outline, -0.3, Geometry2D.JOIN_MITER))
	if walls.size() < 3:
		walls = outline
	var eave := quay + 5.4
	_prism(walls, quay, quay + 2.7, MARINA_WALL, none, M_STONE)
	_prism(walls, quay + 2.7, eave, Color("#6e8a96"), none, M_PAVILION)
	_mullions(walls, quay + 2.7, eave, 1.6, 0.05, MARINA_WALL)
	_mode = M_STONE
	_prism(_rect(0.0, 0.0, hu + 0.5, hv + 0.5), eave, eave + 0.25, MARINA_TRIM, MARINA_ROOF, M_STONE, M_STONE)
	_hip(0.0, 0.0, hu + 0.45, hv + 0.45, eave + 0.25, 2.6, MARINA_ROOF)
	var fp := _w(-hu + 0.8, -hv + 0.8)
	var base := Vector3(fp.x, quay + 0.2, fp.y)
	_beam(base, base + Vector3.UP * 9.0, 0.12, Color("#c9ced2"))
	var nf := Vector3(_a.x, 0.0, _a.y)
	var fd := Vector3(_b.x, 0.0, _b.y) * 1.5
	_quad(base + Vector3.UP * 8.0, base + Vector3.UP * 8.0 + fd, base + Vector3.UP * 9.0 + fd, base + Vector3.UP * 9.0, nf, BARGE_FLAG_W)
	_quad(base + Vector3.UP * 7.0, base + Vector3.UP * 7.0 + fd, base + Vector3.UP * 8.0 + fd, base + Vector3.UP * 8.0, nf, BARGE_FLAG_R)
	var best := -INF
	var at := Vector2.ZERO
	var out := Vector2.ZERO
	var room := 0.0
	for face: Array in [[_a, _w(hu + 0.55, 0.0), 2.0 * hv], [-_a, _w(-hu - 0.55, 0.0), 2.0 * hv],
			[_b, _w(0.0, hv + 0.55), 2.0 * hu], [-_b, _w(0.0, -hv - 0.55), 2.0 * hu]]:
		var d := (face[0] as Vector2).dot(BEHIND_FACE)
		if d > best:
			best = d
			out = face[0]
			at = face[1]
			room = face[2]
	var word := "PRZYSTAŃ"
	var k := minf(0.5, (room - 1.0) / Neon.length_of(word))
	signs.append([word, Vector3(at.x, quay + 3.0, at.y), Vector3(out.x, 0.0, out.y), k, MARINA_NEON])
	_collide(outline)


# --- Warszawa Śródmieście (the railway S3b, docs/landmarks/specs/srodmiescie.md) --------------
# The cross-city line's underground station by the Palace (1963): above ground only two long
# pavilions by Romanowicz and Szymaniak, "oversized shelters" over the stairs down to the
# platforms. Built from their two OSM outlines as glass halls under a deep light fascia and a
# thin roof, the station's name on the side the camera sees.

const SRD_OSM := "PKP Warszawa Śródmieście"
const SRD_GLASS_H := 4.4       # the glass hall over the ground
const SRD_TOP := 6.9           # the fascia's top (the OSM height is 7 m)
const SRD_OVER := 0.7          # the fascia's overhang past the glass
const SRD_STONE := Color("#dcd8cd")
const SRD_PLINTH := Color("#4a4b4d")
const SRD_GLASS := Color("#4f6a78")
const SRD_DARK := Color("#2a2c2f")
const SRD_NEON := Color(0.25, 0.75, 1.0)


func _find_srodmiescie() -> void:
	var halls: Array = []
	for l in data.get("landmarks", []):
		if l["name"] == SRD_OSM:
			var q := _pts(l["p"])
			if q.size() >= 3:
				halls.append(_simplify(q, 0.3))
	if halls.is_empty():
		return
	var zones: Array = []
	for q: PackedVector2Array in halls:
		zones.append(_largest(Geometry2D.offset_polygon(q, 1.5, Geometry2D.JOIN_MITER)))
	_add_site("srodmiescie", zones)
	if not sites.is_empty() and sites[-1]["key"] == "srodmiescie":
		sites[-1]["halls"] = halls


func _build_srodmiescie(site: Dictionary) -> void:
	var none := Color(0, 0, 0, 0)
	for q: PackedVector2Array in site["halls"]:
		var hall := q.duplicate()
		if Geometry2D.is_polygon_clockwise(hall):
			hall.reverse()
		var g := INF
		for p in hall:
			g = minf(g, map.terrain_height(p.x, p.y))
		_g = g
		_prism(hall, g - 0.6, g + 0.4, SRD_PLINTH, none, M_STONE)
		var keep := _mode
		_prism(hall, g + 0.4, g + SRD_GLASS_H, SRD_GLASS, none, M_PAVILION)
		_mode = keep
		_mullions(hall, g + 0.4, g + SRD_GLASS_H, 1.6, 0.05, SRD_DARK)
		var top := _largest(Geometry2D.offset_polygon(hall, SRD_OVER, Geometry2D.JOIN_MITER))
		_prism(top, g + SRD_GLASS_H, g + SRD_TOP, SRD_STONE, SRD_STONE.darkened(0.1), M_STONE, M_STONE)
		_soffit(top, g + SRD_GLASS_H, SRD_STONE.darkened(0.3))
		# The name on the middle of the long side the game's camera sees.
		var f := _och_frame(hall)
		var side: Vector2 = f[2]
		if side.dot(BEHIND_FACE) < 0.0:
			side = -side
		var at: Vector2 = f[0] + side * (float(f[4]) + SRD_OVER)
		signs.append(["ŚRÓDMIEŚCIE", Vector3(at.x, g + SRD_GLASS_H + 0.55, at.y), Vector3(side.x, 0.0, side.y), 0.5, SRD_NEON])
		_collide(hall)

# --- The WKD stations (the railway S3c-e, docs/landmarks/photo-reports/wkd_*.md) -------------
## The WKD commuter line's two stops on the map, built from F's Mac photo gather (Commons photos
## and the GUGiK orthophoto, 2026-11-02). Śródmieście WKD, the terminus in an open cutting by the
## Aleje: above ground only two free-standing concrete "propellers", two long tapering wings on
## one raked wedge pier and a slim post, over the stairs down; a white parapet box round each
## stair, the name board on the west one. Ochota WKD, in the cross-city cutting by Plac Zawiszy:
## a heavy concrete slab on V-shaped legs over the island platform (OpenStreetMap maps the slab
## as a 5 m "retail" box, which the site replaces), blue benches, a stair up at the west end.
## The board shows the place name, and the logo is two plain arrows: no operator's brand.

## The propellers' pier spots and which side the cutting lies on (+1: the frame's +v, south).
const WKD_SRD := [[Vector2(-1722.0, 728.0), 1.0], [Vector2(-1632.0, 711.0), -1.0]]
const WKD_SRD_A := Vector2(0.945, -0.327)  # along the cutting (its rails), east-north-east
const WKD_WING := 9.6           # the hub to a wing's tip
const WKD_WING_S := [0.0, 0.2, 0.4, 0.6, 0.75, 0.88, 0.96, 1.0]   # sections along a wing (of WKD_WING)
const WKD_WING_HW := [2.0, 1.75, 1.5, 1.25, 1.05, 0.85, 0.6, 0.25]  # their half widths: a rounded tip
const WKD_SLAB_Y := 4.0         # the slab's top over the walk at the hub; the tips rise 0.45 m
const WKD_CONCRETE := Color("#a39a8d")
const WKD_UNDER := Color("#7e766b")
const WKD_EDGE := Color("#b9b1a4")
const WKD_PARAPET := Color("#e6e4df")
const WKD_STAIR := Color("#3c3d3f")
const WKD_BOARD := Color("#3a3c40")
const WKD_RED := Color("#d22a2f")
const WKD_BLUE := Color("#2a4f9e")
const WKD_SIGN := Color(0.92, 0.95, 1.0)
## Ochota WKD: the slab's frame along the platform (OSM's island platform between the two tracks).
const WKD_OCH_O := Vector2(-2355.1, 951.2)
const WKD_OCH_A := Vector2(0.9455, -0.3253)
const WKD_OCH_HU := 24.5        # the slab's half length
const WKD_OCH_HV := 3.3         # its half width (the platform is 5.4 m wide)
const WKD_OCH_CLEAR := 3.5      # the platform's top to the slab's underside
const WKD_OCH_SLAB := 0.65
const WKD_OCH_GREY := Color("#9e9a92")
const WKD_OCH_TOP := Color("#857866")   # brown on the orthophoto
const WKD_OCH_EDGE := Color("#8b4a3a")  # the platform's red-brown edge strip
const WKD_OCH_BENCH := Color("#2f5e9e")


func _find_wkd() -> void:
	var zones: Array = []
	for p: Array in WKD_SRD:
		_wkd_srd_frame(p)
		zones.append(_rect(0.0, 0.0, WKD_WING + 0.6, 3.2))
	_add_site("wkd_srodmiescie", zones)
	_wkd_och_frame()
	# The zone holds the mapped slab's middle (the 5 m box over the platform) and the stair.
	_add_site("wkd_ochota", [_rect(-2.0, 0.0, WKD_OCH_HU + 10.0, WKD_OCH_HV + 0.5)])


## A propeller's frame: the pier spot, u along the cutting, +v towards the cutting.
func _wkd_srd_frame(p: Array) -> void:
	_o = p[0]
	_a = WKD_SRD_A
	_b = Vector2(-_a.y, _a.x) * float(p[1])


func _wkd_och_frame() -> void:
	_o = WKD_OCH_O
	_a = WKD_OCH_A
	_b = Vector2(-_a.y, _a.x)


func _build_wkd_srodmiescie(_site: Dictionary) -> void:
	var none := Color(0, 0, 0, 0)
	for k in WKD_SRD.size():
		var p: Array = WKD_SRD[k]
		_wkd_srd_frame(p)
		var g := -INF
		for q in [_w(-2.0, -2.5), _w(2.0, -2.5), _w(0.0, 0.0)]:
			g = maxf(g, map.terrain_height(q.x, q.y))
		_g = g
		var top := g + WKD_SLAB_Y
		# The parapet box round the stair: white, waist high, open at the east end where the
		# stair starts; the dark well inside with its steps.
		var hu := 3.6
		var hv := 1.7
		_lbox(-hu, 0.0, 0.12, hv, g - 0.5, g + 1.05, WKD_PARAPET, M_STONE, WKD_PARAPET)
		_lbox(0.0, -hv, hu, 0.12, g - 0.5, g + 1.05, WKD_PARAPET, M_STONE, WKD_PARAPET)
		_lbox(0.0, hv, hu, 0.12, g - 0.5, g + 1.05, WKD_PARAPET, M_STONE, WKD_PARAPET)
		_mode = M_STONE
		_cap(_rect(0.0, 0.0, hu - 0.12, hv - 0.12), g + 0.04, WKD_STAIR)
		for s in 6:
			var u := hu - 0.9 - s * 1.05
			_cap(_rect(u, 0.0, 0.08, hv - 0.2), g + 0.06, WKD_STAIR.lightened(0.25))
		_collide(_rect(0.0, 0.0, hu + 0.12, hv + 0.12))
		# The raked wedge pier on the far side from the cutting, wider at the top, and the slim
		# post under the other wing.
		var foot := _rect(-1.5, -2.5, 0.3, 0.3)
		var head := _rect(-1.0, -2.5, 0.95, 0.3)
		_mode = M_STONE
		_frustum(foot, g - 0.5, head, top - 0.4, WKD_CONCRETE.darkened(0.06))
		_prism(_circle(_w(6.2, -0.6 + 0.5 * 6.2 / WKD_WING), 0.13, 6), g - 0.5, top - 0.3, WKD_EDGE, none, M_STONE)
		_collide(_rect(-1.25, -2.5, 0.6, 0.35))
		_wkd_wings(top)
		# The logo on the pier's walk side: a white octagon, a red arrow over a blue one.
		_wkd_logo(_w(-1.25, -2.5) - _b * 0.33, g + 2.5, -_b, 0.5)
		# The west one carries the name board, on its slab on the side the camera sees.
		if k == 0:
			var face := _b if _b.dot(BEHIND_FACE) > 0.0 else -_b
			var sv := 0.3 * signf(face.dot(_b))
			var word := "ŚRÓDMIEŚCIE"
			_lbox(-4.3, sv, 3.6, 0.08, top - 0.05, top + 0.75, WKD_BOARD, M_STONE, WKD_BOARD)
			var at := _w(-4.3, sv) + face * 0.1
			var size := minf(0.32, 6.6 / Neon.length_of(word))
			signs.append([word, Vector3(at.x, top + 0.12, at.y), Vector3(face.x, 0.0, face.y), size, WKD_SIGN])


## The two wings as one slab: tapering to rounded tips, the tips raised, thin at the edge and
## thicker at the hub; the wings set off the axis in opposite ways (a propeller in plan).
func _wkd_wings(top: float) -> void:
	var secs: Array = []   # [u, v centre, half width, top y, bottom y]
	var n: int = WKD_WING_S.size()
	for i in range(n - 1, -1, -1):
		secs.append(_wkd_sec(-1.0, i, top))
	for i in range(1, n):
		secs.append(_wkd_sec(1.0, i, top))
	var keep := _mode
	_mode = M_STONE
	var corner := func(s: Array, side: float, up: bool) -> Vector3:
		var q := _w(float(s[0]), float(s[1]) + float(s[2]) * side)
		return Vector3(q.x, float(s[3]) if up else float(s[4]), q.y)
	for i in secs.size() - 1:
		var s0: Array = secs[i]
		var s1: Array = secs[i + 1]
		var l0: Vector3 = corner.call(s0, -1.0, true)
		var r0: Vector3 = corner.call(s0, 1.0, true)
		var l1: Vector3 = corner.call(s1, -1.0, true)
		var r1: Vector3 = corner.call(s1, 1.0, true)
		var lb0: Vector3 = corner.call(s0, -1.0, false)
		var rb0: Vector3 = corner.call(s0, 1.0, false)
		var lb1: Vector3 = corner.call(s1, -1.0, false)
		var rb1: Vector3 = corner.call(s1, 1.0, false)
		_wkd_face(l0, r0, r1, l1, Vector3.UP, WKD_CONCRETE)
		_wkd_face(lb0, rb0, rb1, lb1, Vector3.DOWN, WKD_UNDER)
		var mid := (l0 + r0 + l1 + r1) * 0.25
		_wkd_face(l0, l1, lb1, lb0, l0 - mid, WKD_EDGE)
		_wkd_face(r0, r1, rb1, rb0, r0 - mid, WKD_EDGE)
	for e in [0, secs.size() - 1]:
		var s: Array = secs[e]
		var out := _a * signf(float(s[0]))
		_wkd_face(corner.call(s, -1.0, true), corner.call(s, 1.0, true), corner.call(s, 1.0, false),
				corner.call(s, -1.0, false), Vector3(out.x, 0.0, out.y), WKD_EDGE)
	_mode = keep


## A wing's section i on the side `dir` (-1 west, +1 east).
func _wkd_sec(dir: float, i: int, top: float) -> Array:
	var s: float = WKD_WING_S[i]
	var y := top + 0.45 * s * s
	return [dir * s * WKD_WING, -0.6 + 0.5 * s * dir, float(WKD_WING_HW[i]), y, y - lerpf(0.55, 0.2, s)]


## A quad whose normal is its own geometry's, turned to the side `toward` points to.
func _wkd_face(a: Vector3, b: Vector3, c: Vector3, d: Vector3, toward: Vector3, col: Color) -> void:
	var n := (c - a).cross(d - b)
	if n.length() < 1e-6:
		return
	n = n.normalized()
	if n.dot(toward) < 0.0:
		n = -n
	_quad(a, b, c, d, n, col)


## The logo plate: a white octagon of radius r facing `out` with its middle at (c, y), a red arrow
## pointing one way over a blue one pointing back.
func _wkd_logo(c: Vector2, y: float, out: Vector2, r: float) -> void:
	var keep := _mode
	_mode = M_STONE
	var n := Vector3(out.x, 0.0, out.y).normalized()
	var side := Vector3(-n.z, 0.0, n.x)
	var o := Vector3(c.x, y, c.y) + n * 0.03
	var at := func(x: float, h: float, lift: float) -> Vector3:
		return o + side * x + Vector3.UP * h + n * lift
	var ring: Array[Vector3] = []
	for k in 8:
		var t := TAU * (k + 0.5) / 8.0
		ring.append(at.call(cos(t) * r, sin(t) * r, 0.0))
	for k in range(1, 7):
		_tri(ring[0], ring[k], ring[k + 1], n, Color.WHITE, Vector2(-1, -1), Vector2(-1, -1), Vector2(-1, -1), -1.0, false)
	for arrow: Array in [[1.0, 0.28, WKD_RED], [-1.0, -0.28, WKD_BLUE]]:
		var d: float = arrow[0]
		var h: float = float(arrow[1]) * r
		var col: Color = arrow[2]
		var w := 0.09 * r
		_quad(at.call(-0.55 * r * d, h - w, 0.02), at.call(0.15 * r * d, h - w, 0.02),
				at.call(0.15 * r * d, h + w, 0.02), at.call(-0.55 * r * d, h + w, 0.02), n, col)
		_tri(at.call(0.15 * r * d, h - 0.22 * r, 0.02), at.call(0.6 * r * d, h, 0.02), at.call(0.15 * r * d, h + 0.22 * r, 0.02),
				n, col, Vector2(-1, -1), Vector2(-1, -1), Vector2(-1, -1), -1.0, false)
	_mode = keep


func _build_wkd_ochota(_site: Dictionary) -> void:
	_wkd_och_frame()
	# The platform's top as map_builder draws it (its lowest corner + 0.9 + 0.1).
	var ground := INF
	for a in data.get("platforms", []):
		var q := _pts(a["p"])
		if q.size() >= 3 and Geometry2D.is_point_in_polygon(_o, q):
			for p in q:
				ground = minf(ground, map.terrain_height(p.x, p.y))
	if ground == INF:
		ground = _ground_under(_rect(0.0, 0.0, 20.0, 2.0))
	_g = ground
	var pt := ground + 1.0
	var under := pt + WKD_OCH_CLEAR
	var top := under + WKD_OCH_SLAB
	var none := Color(0, 0, 0, 0)
	# The slab: rough grey edges, brown on top, darker underneath.
	var slab := _rect(0.0, 0.0, WKD_OCH_HU, WKD_OCH_HV)
	_prism(slab, under, top, WKD_OCH_GREY, WKD_OCH_TOP, M_STONE, M_STONE)
	_soffit(slab, under, WKD_OCH_GREY.darkened(0.3))
	# The V legs along the platform's middle every 8 m: two raked legs meeting at the floor
	# (their feet down in the platform, so they stand on its ground).
	var u := -20.0
	while u <= 20.5:
		for d: float in [-1.0, 1.0]:
			_mode = M_STONE
			_frustum(_rect(u + d * 0.12, 0.0, 0.14, 0.2), ground, _rect(u + d * 0.78, 0.0, 0.17, 0.22), under,
					WKD_OCH_GREY.lightened(0.05))
		u += 8.0
	# The red-brown edge strips down both sides of the platform, blue benches between the legs.
	_mode = M_STONE
	for v: float in [-2.35, 2.35]:
		_cap(_rect(0.0, v, 25.0, 0.2), pt + 0.03, WKD_OCH_EDGE)
	for b: float in [-16.0, -8.0, 0.0, 8.0, 16.0]:
		_lbox(b, 0.0, 0.9, 0.22, ground, pt + 0.45, WKD_OCH_BENCH, M_STONE, WKD_OCH_BENCH.lightened(0.1))
	# The blue timetable board on two posts.
	_lbox(4.0, 0.0, 0.6, 0.05, pt + 1.0, pt + 2.1, WKD_OCH_BENCH, M_STONE, WKD_OCH_BENCH)
	for s: float in [-0.5, 0.5]:
		_lbox(4.0 + s, 0.0, 0.04, 0.04, ground, pt + 1.0, WKD_BOARD, M_STONE, none)
	# The stair up from the platform's west end to Al. Jerozolimskie and Towarowa: a flight of
	# 0.17 m steps between two low walls, rising west to the street.
	var street: float = map.terrain_height(_w(-36.0, 3.0).x, _w(-36.0, 3.0).y)
	var rise := maxf(street - pt, 1.0)
	var steps := clampi(ceili(rise / 0.17), 6, 40)
	var tread := 0.3
	var u0 := -WKD_OCH_HU - 1.5
	for s in steps:
		var y1 := pt + rise * float(s + 1) / steps
		var ua := u0 - s * tread
		var ring := PackedVector2Array([_w(ua, -1.2), _w(ua - tread, -1.2), _w(ua - tread, 1.2), _w(ua, 1.2)])
		_prism(ring, ground, y1, WKD_OCH_GREY.darkened(0.15), WKD_OCH_GREY.lightened(0.1), M_STONE, M_STONE)
	var u1 := u0 - steps * tread
	for v: float in [-1.35, 1.35]:
		var wall := PackedVector2Array([_w(u0, v - 0.15), _w(u1, v - 0.15), _w(u1, v + 0.15), _w(u0, v + 0.15)])
		_prism(wall, ground, pt + rise + 1.0, WKD_OCH_GREY, WKD_OCH_GREY.lightened(0.08), M_STONE, M_STONE)
	# A totem with the logo at the stair head.
	_lbox(u1 - 0.6, 1.9, 0.12, 0.12, ground, pt + rise + 2.6, WKD_BOARD, M_STONE, WKD_BOARD)
	var face := _b if _b.dot(BEHIND_FACE) > 0.0 else -_b
	_wkd_logo(_w(u1 - 0.6, 1.9) + face * 0.12, pt + rise + 2.1, face, 0.45)


# --- The brick works: Norblin, Browary Warszawskie, Hala Koszyki, Elektrownia Powiśle -------------
## F's ask (2026-11-01): the four old-industry-turned-hangout sites of the west and south as
## models (specs docs/landmarks/specs/norblin.md, browary.md, koszyki.md, elektrownia.md), each on
## its mapped outline: brick walls on a plinth with round-headed windows in rows and a cornice, and
## what makes each one itself. Norblin: glazed storeys over the restored halls and a chimney in the
## court; the Browary: the brewhouse (Warzelnia) and the villa in brick, the office blocks clad in
## warm grey with window bays, the brewery chimney; Koszyki: the market hall with its glass
## lantern; the power station: two big storeys of arches and two chimneys. No photos in the
## cloud: the Mac look check (BACKLOG) settles brick shade, storeys and the chimneys.
const WORKS_BRICK := Color("#9b4d39")
const WORKS_DARK := Color("#7d3b2c")
const WORKS_TRIM := Color("#d3c7ab")
const WORKS_PLINTH := Color("#6f6a63")
const WORKS_ROOF := Color("#5d6366")
const WORKS_GLASS := Color("#2f3a40")
const WORKS_TOP := Color("#9db4be")
const WORKS_MODERN := Color("#b3a894")
## Fabryka Norblina, rebuilt from the Mac's photo report (docs/landmarks/photo-reports/norblin.md,
## GUGiK ortho, 2026-11-02): the factory is the block between Łucka, Żelazna and Prosta that OSM
## maps as the office buildings "Plater" (east) and "Galwan" (west); the first pass stood on
## "Modsen" north of Łucka, the wrong block. Both outlines come with their courts carved out
## (tools/planted_trees.py COURTS). Their OSM height (50 m) is the glazed storeys' top.
const NORBLIN_BLOCKS := ["Plater", "Galwan"]
const NORBLIN_PT := Vector2(-2262.0, 190.0)
const NORBLIN_H := 50.0
const NORBLIN_SEDUM := Color("#7c8f55")   # the report's green sedum roofs (Browary's too)
const NORBLIN_EDGE := Color("#5e7444")    # the planted edge round them
const NORBLIN_PLANT := Color("#8b9094")   # roof plant rooms
## The garden terraces upstairs on the north-west block (report: x -2290..-2275, z 140..160 and
## x -2315..-2300, z 135..150; each pulled onto the roof when the outline lies a few metres off).
const NORBLIN_TERRACES := [Vector2(-2283.0, 150.0), Vector2(-2307.0, 146.0)]
## F's photos and look check (2026-11-03): the blocks' base is a tall copper (rust-orange)
## metal-clad wall, lit warm at night on the lane's side; over it dark office storeys with fine
## vertical fins, the top two set back with terraces; between the two blocks the covered passage
## under a glass roof (the ortho's glazed strip; its exact extent is still to verify); no chimney.
const NORBLIN_BASE := 12.0
const NORBLIN_COPPER := Color("#a2552f")
const NORBLIN_DARK := Color("#38424a")    # the office storeys' glass
const NORBLIN_FIN := Color("#7c766c")     # their fine grey-bronze fins
const NORBLIN_WHITE := Color("#ece9e2")   # the old works' white plaster
const NORBLIN_ZINC := Color("#4d5256")    # their dark grey standing-seam roofs
## The covered passage's centre line between Galwan and Plater, and its half width (the gap
## between the two outlines inside it is roofed).
const NORBLIN_PASSAGE := [Vector2(-2292.0, 136.0), Vector2(-2263.0, 199.0), 9.0]
## Where the old works stand (their centres): the white workshops between the blocks and Prosta.
const NORBLIN_OLD := Rect2(-2290.0, 185.0, 125.0, 50.0)
const NORBLIN_HALL := "Verit"
const NORBLIN_HALL_AT := Vector2(-2244.0, 242.0)
const BROWARY_NAMES := ["Warzelnia", "Laboratorium", "Biura przy Bramie", "Biura przy Warzelni", "Biura przy Willi", "Willa Schielego"]


## The landmark `name` whose outline lies near `at` (OSM repeats a name elsewhere in the city).
func _landmark_near(name: String, at: Vector2, reach: float) -> PackedVector2Array:
	for l in data.get("landmarks", []):
		if l["name"] == name:
			var q := _pts(l["p"])
			if q.size() >= 3 and _centre(q).distance_to(at) < reach:
				return q
	return PackedVector2Array()


func _find_works() -> void:
	var blocks: Array = []
	var nor_zone: Array = []
	for n: String in NORBLIN_BLOCKS:
		var q := _landmark_near(n, NORBLIN_PT, 200.0)
		if q.size() >= 3:
			# OSM traces every pilaster (Galwan has 130 corners): the walls go on the outline
			# simplified to 1.2 m (the court notches' corners stay).
			var simple := _simplify(q, 1.2)
			blocks.append(simple if simple.size() >= 3 else q)
			# The court notch can take the outline's centre out of it: the hull keeps the
			# plain block replaced (landmark pitfalls, Piano House).
			nor_zone.append(q)
			nor_zone.append(Geometry2D.convex_hull(q))
	# The old works round the open lane (F's photos, 2026-11-03): the white one- and two-storey
	# workshops and houses between the blocks and Prosta, and the long low glazed hall on Prosta
	# ("Verit" in OSM), all generic boxes before.
	var olds: Array = []
	for bld in data["buildings"]:
		if float(bld["mh"]) > 0.5 or float(bld["h"]) > 8.0:
			continue
		var q := _pts(bld["p"])
		if q.size() < 3:
			continue
		var c := _centre(q)
		var hall: bool = bld.get("name", "") == NORBLIN_HALL and c.distance_to(NORBLIN_HALL_AT) < 10.0
		if hall or (NORBLIN_OLD.has_point(c) and bld.get("name", "") == ""):
			olds.append([_simplify(q, 0.4), hall])
			nor_zone.append(q)
	if not blocks.is_empty():
		_add_site("norblin", nor_zone)
		if sites[-1]["key"] == "norblin":
			sites[-1]["blocks"] = blocks
			sites[-1]["olds"] = olds
	var rings: Array = []
	var roles: Array = []
	for n: String in BROWARY_NAMES:
		var q := _landmark_near(n, Vector2(-2500.0, -100.0), 200.0)
		if q.size() >= 3:
			rings.append(q)
			roles.append(n)
	if not rings.is_empty():
		_add_site("browary", rings)
		if sites[-1]["key"] == "browary":
			sites[-1]["roles"] = roles
	var kosz := _landmark("Hala Koszyki")
	if kosz.size() >= 3:
		_add_site("koszyki", [kosz])
		if sites[-1]["key"] == "koszyki":
			sites[-1]["ring"] = kosz
	var elek := _landmark("Elektrownia Powiśle")
	if elek.size() >= 3:
		_add_site("elektrownia", [elek])
		if sites[-1]["key"] == "elektrownia":
			sites[-1]["ring"] = elek


## A ring grown by `d` (shrunk when negative): its largest piece, or empty.
func _grown(ring: PackedVector2Array, d: float) -> PackedVector2Array:
	var out := Geometry2D.offset_polygon(ring, d, Geometry2D.JOIN_MITER)
	var best := PackedVector2Array()
	var a := 0.0
	for q: PackedVector2Array in out:
		var s := absf(_area(q))
		if s > a and not Geometry2D.is_polygon_clockwise(q):
			a = s
			best = q
	return best


## Brick walls round a ring from the ground to `h`: a plinth, a cornice, and round-headed windows
## in `rows` ([foot, spring, half width] above the ground) every `pitch` m along each wall longer
## than two bays (the windows are the walls' own panels, a few cm proud).
func _works_walls(ring: PackedVector2Array, h: float, brick: Color, rows: Array, pitch: float, glass := WORKS_GLASS) -> void:
	var g := _g
	var base := _grown(ring, 0.2)
	if base.size() >= 3:
		_prism(base, g - 0.6, g + 1.0, WORKS_PLINTH, WORKS_PLINTH, M_STONE, M_STONE)
	for i in ring.size():
		var a := ring[i]
		var b := ring[(i + 1) % ring.size()]
		var length := a.distance_to(b)
		var n := floori((length - 1.0) / pitch)
		if n < 2:
			continue
		var e := (b - a) / length
		var out := _out(ring, a, b)
		var t0 := (length - n * pitch) * 0.5 + pitch * 0.5
		for k in n:
			var at := a + e * (t0 + k * pitch)
			for r: Array in rows:
				_arch_win(at, e, out, float(r[2]), g + float(r[0]), g + float(r[1]), glass)
	var top := _grown(ring, 0.25)
	if top.size() >= 3:
		# The cornice's cap is the whole roof (one flat top, no second at the same height).
		_prism(ring, g - 0.6, g + h, brick, Color(0, 0, 0, 0), M_STONE, M_STONE)
		_prism(top, g + h - 0.9, g + h, WORKS_TRIM, WORKS_ROOF, M_STONE, M_STONE)
	else:
		_prism(ring, g - 0.6, g + h, brick, WORKS_ROOF, M_STONE, M_STONE)


## Glazed storeys on a ring: inset 1.8 m, curtain glass in `storeys` of 3.6 m from y, a flat roof.
func _works_top(ring: PackedVector2Array, y: float, storeys: int, roof := WORKS_ROOF) -> void:
	var inner := _grown(ring, -1.8)
	if inner.size() < 3:
		return
	var h := storeys * 3.6
	_mode = M_GLASS
	_prism(inner, y, y + h, WORKS_TOP, roof, M_GLASS, M_STONE)
	_parapet(inner, y + h, 0.7, WORKS_TRIM)
	_mode = M_STONE


## A brick chimney: a tapering ten-sided stack on a plinth, two pale bands and a cap near the top.
func _works_chimney(c: Vector2, h: float, r0: float, brick: Color) -> void:
	var g := _g
	var r1 := r0 * 0.62
	_mode = M_STONE
	_prism(_circle(c, r0 * 1.5, 10), g - 0.6, g + 1.4, WORKS_PLINTH, WORKS_PLINTH, M_STONE, M_STONE)
	_frustum(_circle(c, r0, 10), g + 1.4, _circle(c, r1, 10), g + h, brick)
	for band: float in [3.6, 6.4]:
		var y0 := g + h - band
		var t0 := (y0 - g - 1.4) / (h - 1.4)
		var t1 := (y0 + 1.0 - g - 1.4) / (h - 1.4)
		_frustum(_circle(c, lerpf(r0, r1, t0) + 0.06, 10), y0, _circle(c, lerpf(r0, r1, t1) + 0.06, 10), y0 + 1.0, WORKS_TRIM)
	_prism(_circle(c, r1 + 0.35, 10), g + h - 1.2, g + h, WORKS_TRIM.darkened(0.1), WORKS_ROOF, M_STONE, M_STONE)
	_collide(_circle(c, r0, 8))


## The ring's vertex farthest from `from`.
func _farthest(ring: PackedVector2Array, from: Vector2) -> Vector2:
	var best := ring[0]
	for q in ring:
		if q.distance_to(from) > best.distance_to(from):
			best = q
	return best


## The long axis of a ring: [the origin (its low corner), the unit direction along the longest edge,
## the unit across, the length, the width], for a lantern or ridge.
func _long_axis(ring: PackedVector2Array) -> Array:
	var a := Vector2.RIGHT
	var best := 0.0
	for i in ring.size():
		var d := ring[(i + 1) % ring.size()] - ring[i]
		if d.length() > best:
			best = d.length()
			a = d.normalized()
	var b := Vector2(-a.y, a.x)
	var u0 := INF
	var u1 := -INF
	var v0 := INF
	var v1 := -INF
	for q in ring:
		u0 = minf(u0, q.dot(a))
		u1 = maxf(u1, q.dot(a))
		v0 = minf(v0, q.dot(b))
		v1 = maxf(v1, q.dot(b))
	return [a * u0 + b * v0, a, b, u1 - u0, v1 - v0]


func _build_norblin(site: Dictionary) -> void:
	var none := Color(0, 0, 0, 0)
	var rings: Array = site["blocks"]
	for ring: PackedVector2Array in rings:
		_g = _ground_under(ring)
		var g := _g
		# The copper base: its panels' joints every 3 m, lit warm at night on the faces that look
		# onto the lane and Prosta (south), plain copper elsewhere; its top a dark ledge.
		var run := 0.0
		for i in ring.size():
			var a := ring[i]
			var b := ring[(i + 1) % ring.size()]
			var o := _out(ring, a, b)
			_mode = M_LAMP if o.y > 0.55 else M_STONE
			_wall(a, b, g - 0.6, g + NORBLIN_BASE, o, NORBLIN_COPPER, run)
			run += a.distance_to(b)
		_mullions(ring, g + 0.3, g + NORBLIN_BASE, 3.0, 0.04, NORBLIN_COPPER.darkened(0.2))
		_mode = M_STONE
		_cap(ring, g + NORBLIN_BASE, NORBLIN_ZINC)
		# The office storeys over it: dark glass behind fine fins, the top two set back further
		# behind a terrace with planters.
		var storeys := maxi(3, roundi((NORBLIN_H - NORBLIN_BASE) / 3.6))
		var inner := _grown(ring, -1.8)
		if inner.size() < 3:
			_collide(ring)
			continue
		var y1 := g + NORBLIN_BASE + (storeys - 2) * 3.6
		_prism(inner, g + NORBLIN_BASE, y1, NORBLIN_DARK, VARSO_DECK.darkened(0.25), M_GLASS, M_STONE)
		_mullions(inner, g + NORBLIN_BASE, y1, 1.2, 0.22, NORBLIN_FIN)
		_parapet(inner, y1, 1.0, NORBLIN_FIN.darkened(0.1))
		var top := _grown(ring, -5.0)
		var roof_y := y1
		if top.size() >= 3:
			roof_y = y1 + 7.2
			_prism(top, y1, roof_y, NORBLIN_DARK.lightened(0.06), none, M_GLASS)
			_mullions(top, y1, roof_y, 1.2, 0.18, NORBLIN_FIN)
			_norblin_planters(inner, y1)
		_mode = M_STONE
		_cap(top if top.size() >= 3 else inner, roof_y, NORBLIN_EDGE)
		_norblin_roof(inner, roof_y)
		_collide(ring)
	_norblin_passage(rings)
	for old: Array in site.get("olds", []):
		_norblin_old(old[0], old[1])
	_mode = M_STONE
	# No chimney: neither the ortho nor F's photos show one over the works.


## Planters with small trees on the set-back terrace: one in each long edge's middle of `ring`
## (the storeys' outline), 1.6 m in.
func _norblin_planters(ring: PackedVector2Array, y: float) -> void:
	for i in ring.size():
		var a := ring[i]
		var b := ring[(i + 1) % ring.size()]
		var l := a.distance_to(b)
		if l < 12.0:
			continue
		var o := _out(ring, a, b)
		var d := (b - a) / l
		for f: float in ([0.3, 0.7] if l > 30.0 else [0.5]):
			var p := a + d * l * f - o * 1.6
			_prism(PackedVector2Array([p - d * 2.0 - o * 0.5, p + d * 2.0 - o * 0.5, p + d * 2.0 + o * 0.5, p - d * 2.0 + o * 0.5]),
					y, y + 0.7, NORBLIN_PLANT, NORBLIN_EDGE, M_STONE, M_STONE)
			_varso_tree(p, y + 0.7, 2.6, 0.9)


## The covered passage between the two blocks: the gap between their outlines along
## NORBLIN_PASSAGE, under a flat glass roof at the base's top on light steel ribs.
func _norblin_passage(rings: Array) -> void:
	var a: Vector2 = NORBLIN_PASSAGE[0]
	var b: Vector2 = NORBLIN_PASSAGE[1]
	var hw: float = NORBLIN_PASSAGE[2]
	var d := (b - a).normalized()
	var o := Vector2(-d.y, d.x) * hw
	var pieces: Array = [PackedVector2Array([a - o, b - o, b + o, a + o])]
	for r: PackedVector2Array in rings:
		var grown := _grown(r, 0.15)
		var next: Array = []
		for pc: PackedVector2Array in pieces:
			for q: PackedVector2Array in Geometry2D.clip_polygons(pc, grown if grown.size() >= 3 else r):
				if q.size() >= 3 and not Geometry2D.is_polygon_clockwise(q):
					next.append(q)
		pieces = next
	var gap := _largest(pieces)
	if gap.size() < 3 or absf(_area(gap)) < 120.0:
		return
	_g = _ground_under(gap)
	var y := _g + NORBLIN_BASE - 0.1
	_mode = M_GLASS_ROOF
	_cap(gap, y, WORKS_TOP)
	_soffit(gap, y - 0.02, WORKS_TOP.darkened(0.2))
	_mode = M_STONE
	var len := a.distance_to(b)
	for k in range(1, int(len / 4.5)):
		var c := a + d * 4.5 * k
		var p0 := c - o * 1.2
		var p1 := c + o * 1.2
		for piece: PackedVector2Array in Geometry2D.intersect_polyline_with_polygon(PackedVector2Array([p0, p1]), gap):
			if piece.size() == 2:
				_beam(Vector3(piece[0].x, y + 0.15, piece[0].y), Vector3(piece[1].x, y + 0.15, piece[1].y), 0.18, NORBLIN_FIN)


## One of the old works: a white workshop or house (two rows of windows when tall enough, a
## dark grey standing-seam hipped roof), or the long low glazed hall on Prosta (glass walls lit
## warm at night under a dark low hip).
func _norblin_old(ring: PackedVector2Array, hall: bool) -> void:
	if ring.size() < 3:
		return
	if Geometry2D.is_polygon_clockwise(ring):
		ring.reverse()
	_g = _ground_under(ring)
	var g := _g
	var none := Color(0, 0, 0, 0)
	var ax := _long_axis(ring)
	var width: float = ax[4]
	var eave := 4.0 if hall else (6.4 if width > 12.0 else 4.6)
	var rise := clampf(width * 0.22, 1.6, 3.4)
	if hall:
		_prism(ring, g - 0.4, g + 0.5, WORKS_PLINTH, none, M_STONE)
		_prism(ring, g + 0.5, g + eave, WORKS_TOP.darkened(0.25), none, M_PAVILION)
		_mullions(ring, g + 0.5, g + eave, 2.0, 0.05, NORBLIN_ZINC)
	else:
		_prism(ring, g - 0.4, g + 0.5, WORKS_PLINTH.lightened(0.15), none, M_STONE)
		_bays(ring, 1.1, 2.9, 3.2, 1.3, WORKS_GLASS)
		if eave > 6.0:
			_bays(ring, 3.9, 5.6, 3.2, 1.2, WORKS_GLASS)
		_prism(ring, g + 0.5, g + eave, NORBLIN_WHITE, none, M_STONE)
	# The roof: a 0.4 m eave, slopes up to a ridge set in by most of the half width, its flat top.
	var eaves := _inset_ring(ring, -0.4)
	var ridge := _inset_ring(ring, minf(width * 0.42, 4.0))
	_mode = M_STONE
	_prism(eaves, g + eave - 0.25, g + eave, NORBLIN_ZINC.darkened(0.15), none, M_STONE)
	_soffit(eaves, g + eave - 0.25, NORBLIN_WHITE.darkened(0.2))
	_slope(ring, eaves, g + eave, ridge, g + eave + rise, NORBLIN_ZINC)
	_cap(ridge, g + eave + rise, NORBLIN_ZINC.lightened(0.06))
	_collide(ring)


## A green roof on the glazed storeys of `ring` (top at y): the sedum field a step up inside a
## 1.4 m planted edge, two grey plant rooms, and the garden terraces upstairs where a terrace spot
## (NORBLIN_TERRACES) is near: planters with small trees.
func _norblin_roof(ring: PackedVector2Array, y: float) -> void:
	var inner := _grown(ring, -3.2)
	if inner.size() < 3:
		return
	_mode = M_STONE
	_prism(inner, y, y + 0.12, NORBLIN_EDGE, NORBLIN_SEDUM, M_STONE, M_STONE)
	# Plant rooms on the long axis, a third in from each end.
	var ax := _long_axis(inner)
	var o: Vector2 = ax[0]
	var a: Vector2 = ax[1]
	var b: Vector2 = ax[2]
	for f: float in [0.3, 0.62]:
		var c := o + a * float(ax[3]) * f + b * float(ax[4]) * 0.5
		if Geometry2D.is_point_in_polygon(c, inner):
			var box := PackedVector2Array([c - a * 3.0 - b * 2.0, c + a * 3.0 - b * 2.0, c + a * 3.0 + b * 2.0, c - a * 3.0 + b * 2.0])
			_prism(box, y + 0.12, y + 2.8, NORBLIN_PLANT, NORBLIN_PLANT.darkened(0.1), M_STONE, M_STONE)
	var keep := _no_roof
	_no_roof = true
	for t: Vector2 in NORBLIN_TERRACES:
		var at := t
		if not Geometry2D.is_point_in_polygon(at, inner):
			var best := INF
			for i in inner.size():
				var cp := Geometry2D.get_closest_point_to_segment(t, inner[i], inner[(i + 1) % inner.size()])
				if cp.distance_to(t) < best:
					best = cp.distance_to(t)
					at = cp + (_centre(inner) - cp).normalized() * 2.5
			if best > 9.0:
				continue
		# A timber deck with four planters round it, a small tree in each.
		_prism(_square(at, 3.4), y + 0.12, y + 0.22, VARSO_DECK, VARSO_DECK, M_STONE, M_STONE)
		for k in 4:
			var p := at + Vector2.from_angle(TAU * k / 4.0 + 0.6) * 3.0
			_prism(_square(p, 0.6), y + 0.12, y + 0.75, NORBLIN_PLANT, NORBLIN_EDGE, M_STONE, M_STONE)
			_varso_tree(p, y + 0.75, 2.8 + 0.3 * (k % 2), 0.95)
	_no_roof = keep


func _build_browary(site: Dictionary) -> void:
	var zone: Array[PackedVector2Array] = site["zone"]
	var roles: Array = site["roles"]
	for k in zone.size():
		var ring := zone[k]
		var role: String = roles[k]
		_g = _ground_under(ring)
		var g := _g
		var h := 12.0
		match role:
			"Warzelnia":
				# The brewhouse: tall brick, narrow lancet-like windows in two rows, the brewery chimney by it.
				_works_walls(ring, 14.0, WORKS_DARK, [[1.2, 5.4, 0.9], [7.0, 11.4, 0.9]], 3.4)
				_works_chimney(_farthest(ring, _centre(ring)) + (_centre(ring) - _farthest(ring, _centre(ring))).normalized() * 3.0,
						46.0, 1.7, WORKS_DARK)
			"Willa Schielego":
				_works_walls(ring, 8.0, WORKS_BRICK.lightened(0.08), [[1.2, 3.4, 0.7]], 3.4)
			"Laboratorium":
				_works_walls(ring, 8.0, WORKS_BRICK, [[1.2, 3.8, 0.8]], 3.6)
			_:
				# The office blocks between the old walls: warm grey, brick-coloured base, glass bays.
				h = 22.0 if role == "Biura przy Warzelni" else 30.0
				_prism(_grown(ring, 0.2), g - 0.6, g + 3.0, WORKS_BRICK, WORKS_BRICK, M_STONE, M_STONE)
				# The photo report: almost every Browary block has a green sedum roof with
				# planted edges (the planted edge is the roof, the sedum field a step up).
				_prism(ring, g - 0.6, g + h, WORKS_MODERN, NORBLIN_EDGE, M_STONE, M_STONE)
				_parapet(ring, g + h, 0.8, WORKS_TRIM)
				_bays(ring, 3.4, h - 1.2, 3.0, 1.9, WORKS_GLASS)
				var sedum := _grown(ring, -1.6)
				if sedum.size() >= 3:
					_prism(sedum, g + h, g + h + 0.12, NORBLIN_EDGE, NORBLIN_SEDUM, M_STONE, M_STONE)
					if role == "Biura przy Warzelni":
						_browary_roof_garden(sedum, g + h + 0.12)
		_collide(ring)
	_browary_garden()


## Browary Warszawskie's Central Garden (photo report browary.md, the GUGiK ortho, 2026-11-02):
## the S-shaped gravel path from the south gate to the north slab and the two clearings with white
## café tables, chairs and dark-blue parasols. The same numbers as tools/planted_trees.py
## BROWARY_PATH and BROWARY_CLEARINGS, which keep the garden's 22 trees off them.
const BROWARY_PATH := [Vector2(-2459.0, -84.0), Vector2(-2456.4, -87.3), Vector2(-2454.7, -90.6),
		Vector2(-2454.3, -93.6), Vector2(-2455.5, -96.4), Vector2(-2458.1, -99.0), Vector2(-2461.5, -101.5),
		Vector2(-2464.9, -104.0), Vector2(-2467.5, -106.6), Vector2(-2468.7, -109.4), Vector2(-2468.3, -112.4),
		Vector2(-2466.6, -115.7), Vector2(-2464.0, -119.0)]
const BROWARY_CLEARINGS := [Vector2(-2459.4, -93.2), Vector2(-2463.6, -109.8)]
const BROWARY_GRAVEL := Color("#cbbd9e")
const BROWARY_PAVING := Color("#e2ded4")   # the clearings' pale stone (look check: tell them from the path)
const BROWARY_EDGE := Color("#3d3f41")     # dark steel edging round the path and the clearings
const BROWARY_CLEARING_R := 4.2
const BROWARY_WHITE := Color("#e9e6df")
const BROWARY_BLUE := Color("#24385a")
## The roof garden on the north slab (report: x -2470..-2410, z -150..-130): a gravel walk down
## its length and two small garden houses.
const BROWARY_ROOF_WALK := [Vector2(-2472.0, -133.0), Vector2(-2412.0, -148.0)]
const BROWARY_ROOF_HOUSES := [Vector2(-2460.0, -138.5), Vector2(-2424.0, -147.0)]


func _browary_garden() -> void:
	var g := map.terrain_height(-2460.0, -100.0) as float
	var none := Color(0, 0, 0, 0)
	# F's look check (2026-11-03): the path and the clearings read apart. The clearings are
	# paved in pale stone inside a dark steel edge and laid first; the main path is gravel
	# between two dark edging strips, 1.5 m each side of its line (clipped by the clearings).
	_mode = M_STONE
	_no_roof = true
	for c: Vector2 in BROWARY_CLEARINGS:
		_cap(_circle(c, BROWARY_CLEARING_R + 0.25, 14), g + 0.13, BROWARY_EDGE)
		_cap(_circle(c, BROWARY_CLEARING_R, 14), g + 0.18, BROWARY_PAVING)
	var edges: Array[PackedVector2Array] = []
	var pieces: Array[PackedVector2Array] = []
	for i in BROWARY_PATH.size() - 1:
		var a: Vector2 = BROWARY_PATH[i]
		var b: Vector2 = BROWARY_PATH[i + 1]
		var t := (b - a).normalized() * 0.6
		var n := Vector2(-t.y, t.x) / 0.6
		pieces.append(PackedVector2Array([a - t - n * 1.5, b + t - n * 1.5, b + t + n * 1.5, a - t + n * 1.5]))
		edges.append(PackedVector2Array([a - t - n * 1.75, b + t - n * 1.75, b + t + n * 1.75, a - t + n * 1.75]))
	for pc in edges:
		_cap(pc, g + 0.04, BROWARY_EDGE)  # _cap clips each piece by the ones before it (within 3 cm)
	for pc in pieces:
		_cap(pc, g + 0.08, BROWARY_GRAVEL)
	# Two white tables in each clearing, two chairs each, a dark-blue parasol over the pair.
	for c: Vector2 in BROWARY_CLEARINGS:
		for side: float in [-1.0, 1.0]:
			var p := c + Vector2(side * 1.4, 0.0)
			_prism(_circle(p, 0.45, 6), g + 0.06, g + 0.75, BROWARY_WHITE, BROWARY_WHITE, M_STONE, M_STONE)
			for q: Vector2 in [p + Vector2(0.0, -0.85), p + Vector2(0.0, 0.85)]:
				_prism(_square(q, 0.22), g + 0.06, g + 0.48, BROWARY_WHITE.darkened(0.08), BROWARY_WHITE, M_STONE, M_STONE)
		_prism(_circle(c, 0.05, 4), g + 0.06, g + 2.4, Color("#c9cdd0"), none, M_STONE)
		_mode = M_STONE
		_pyramid(_circle(c, 2.2, 8), g + 2.4, g + 3.0, BROWARY_BLUE)
	_no_roof = false


func _browary_roof_garden(roof: PackedVector2Array, y: float) -> void:
	var a: Vector2 = BROWARY_ROOF_WALK[0]
	var b: Vector2 = BROWARY_ROOF_WALK[1]
	var o := (b - a).normalized().orthogonal() * 0.8
	for q: PackedVector2Array in Geometry2D.intersect_polygons(PackedVector2Array([a - o, b - o, b + o, a + o]), roof):
		if q.size() >= 3 and not Geometry2D.is_polygon_clockwise(q):
			_prism(q, y, y + 0.06, BROWARY_GRAVEL, BROWARY_GRAVEL, M_STONE, M_STONE)
	for c: Vector2 in BROWARY_ROOF_HOUSES:
		if Geometry2D.is_point_in_polygon(c, roof):
			_prism(_square(c, 1.5), y, y + 2.6, WORKS_MODERN, WORKS_ROOF, M_STONE, M_STONE)


func _build_koszyki(site: Dictionary) -> void:
	var ring: PackedVector2Array = site["ring"]
	_g = _ground_under(ring)
	var g := _g
	# The market hall: brick with big arched windows, cream trim, and its glass lantern.
	_works_walls(ring, 11.0, WORKS_BRICK.lightened(0.04), [[1.3, 6.0, 1.3]], 4.4)
	var ax := _long_axis(ring)
	var o: Vector2 = ax[0]
	var a: Vector2 = ax[1]
	var b: Vector2 = ax[2]
	var c := o + a * float(ax[3]) * 0.5 + b * float(ax[4]) * 0.5
	_o = c
	_a = a
	_b = b
	var half := float(ax[3]) * 0.3
	_lbox(0.0, 0.0, half, 3.2, g + 11.0, g + 13.6, WORKS_TOP, M_GLASS, WORKS_TOP)
	_mode = M_GLASS_ROOF
	_frustum(_rect(0.0, 0.0, half, 3.2), g + 13.6, _rect(0.0, 0.0, half, 0.3), g + 15.0, WORKS_TOP, WORKS_TOP)
	_mode = M_STONE
	_collide(ring)


func _build_elektrownia(site: Dictionary) -> void:
	var ring: PackedVector2Array = site["ring"]
	_g = _ground_under(ring)
	var g := _g
	# The power station: two storeys of tall arches, the roof in zinc grey, two chimneys.
	_works_walls(ring, 19.0, WORKS_BRICK, [[1.4, 7.4, 1.5], [9.4, 15.6, 1.4]], 5.0)
	_parapet(ring, g + 19.0, 0.9, WORKS_TRIM)
	var c := _centre(ring)
	var far_a := _farthest(ring, c)
	var far_b := _farthest(ring, far_a)
	for p: Vector2 in [far_a, far_b]:
		_works_chimney(p + (c - p).normalized() * 3.0, 48.0, 2.0, WORKS_BRICK)


