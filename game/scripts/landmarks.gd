				MPW_CREAM if s != 0.0 else MPW_CREAM.darkened(0.05), 0.04, M_STONE)
	_arch_panel(Vector2(cx, r.position.y), Vector2.RIGHT, Vector2.UP, 0.55, g + 0.0, g + 2.0, MIROWSKA_DOOR, 0.08, M_GLASS)
