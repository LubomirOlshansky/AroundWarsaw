func _find_skins() -> void:
	for t: Dictionary in SKINS:
		# `near` picks one of several outlines that share a name (two "Pałac Branickich")
		var outline := _landmark_near(t["osm"], t["near"], 60.0) if t.has("near") else _landmark(t["osm"])
		if outline.size() < 3:
			continue
		_add_site(t["key"], [outline])
		if not sites.is_empty() and sites[-1]["key"] == t["key"]:
			sites[-1]["skin"] = {"mode": t["mode"], "wall": Color(t["wall"]), "roof": Color(t["roof"])}
			if t.has("steep"):
				sites[-1]["skin"]["steep"] = t["steep"]
			if t["key"] == "zamek":
				sites[-1]["skin"]["pale"] = {"wall": ZAMEK_VISTULA, "edges": _zamek_river_edges(outline), "near": 3.0}
				_zamek_tops()


# --- Muzeum Narodowe (the landmarks loop; a real model since the museum and Plac loop) ----------

## The museum's building (1927-1938) at the east end of Al. Jerozolimskie, mapped as one
## outline round the courtyards (with the army museum in its wings). The landmarks loop kept the
## LoD2 or OpenStreetMap model in its stone (`skin_at`); the museum and Plac Piłsudskiego loop
## (2026-10-31) builds it (`_build_muzeum`): the outline straightened (`_simplify`), and its
## courtyards (the hull's pieces outside it, over MUZEUM_COURT m²) join the zone, since the LoD2
## model's centre falls in one.
const MUZEUM := Vector2(24.0, 251.0)  # inside its wings (its outline's centre is a courtyard)
const MUZEUM_STONE := Color("#cdbfa1")  # photos 1-4: warm sandstone, a little yellower than before
const MUZEUM_ROOF := Color("#8f8b84")
const MUZEUM_COPPER := Color("#8fae9f")   # the entrance block's pale green copper roof (photo 4)
const MUZEUM_DOORS := Color("#25262a")
const MUZEUM_IRON := Color("#1d1e21")     # the forecourt fence and gate (photos 1, 3, 4)
const MUZEUM_POLE := Color("#e8e8e4")
const MUZEUM_BANNER := Color("#3a4496")   # the museum's blue banners (own design; no sponsor logos)
const MUZEUM_COURT := 1000.0
func _find_muzeum() -> void:
	for bld in data["buildings"]:
		var q := _pts(bld["p"])
		if q.size() < 20 or float(bld["h"]) < 10.0 or not _box_of([q]).has_point(MUZEUM):
			continue
		if Geometry2D.is_point_in_polygon(MUZEUM, q):
			var ring := _simplify(q, 1.0)
			var zone: Array = [q]
			var courts: Array[PackedVector2Array] = []
			for piece in Geometry2D.clip_polygons(Geometry2D.convex_hull(ring), ring):
				if absf(_area(piece)) > MUZEUM_COURT:
					courts.append(piece)
					zone.append(piece)
			_add_site("muzeum", zone)
			if not sites.is_empty() and sites[-1]["key"] == "muzeum":
				sites[-1]["ring"] = ring
				sites[-1]["h"] = maxf(float(bld["h"]), MUZEUM_WINGS)
				sites[-1]["courts"] = courts
			return


# --- MDM (the landmarks loop, street furniture) --------------------------------------------------

## Marszałkowska Dzielnica Mieszkaniowa: the tall blocks round Plac Konstytucji (MDM_SQUARE,
## within MDM_SQUARE_R) and along Marszałkowska to Plac Zbawiciela (within MDM_REACH of the
## axis), kept as LoD2 draws them but in their pale sandstone with tall windows between piers
## and grey sheet roofs; one card for the lot. The square's candelabras are map_builder's.
const MDM_SQUARE := Vector2(-533.8, 1282.4)
const MDM_SOUTH := Vector2(-413.9, 1565.2)
const MDM_SQUARE_R := 95.0
const MDM_REACH := 60.0
const MDM_STONE := Color("#e6dfcc")
const MDM_ROOF := Color("#7f7b74")
func _find_mdm() -> void:
	var zone: Array = []
	for bld in data["buildings"]:
		if float(bld["h"]) < 15.0 or str(bld.get("name", "")) != "":
			continue
		var q := _pts(bld["p"])
		if q.size() < 4:
			continue
		var c := _box_of([q]).get_center()
		var axis := Geometry2D.get_closest_point_to_segment(c, MDM_SQUARE, MDM_SOUTH)
		if c.distance_to(MDM_SQUARE) < MDM_SQUARE_R or c.distance_to(axis) < MDM_REACH:
			zone.append(q)
	if zone.is_empty():
		return
	_add_site("mdm", zone)
	if not sites.is_empty() and sites[-1]["key"] == "mdm":
		sites[-1]["skin"] = {"mode": M_MONUMENT, "wall": MDM_STONE, "roof": MDM_ROOF}


## MDM as it stands (spec docs/landmarks/specs/mdm.md, LANDMARKS 2.8; F's Street View shots,
## 2026-11-05): cream plaster above, a sand-coloured stone-clad base three storeys high with big
## shopfronts between stone piers, a cornice on every street face; deep arcades only on the
## square's own ring; at the four corners a stepped attic pavilion with finials; on the roofs
## the red MDM neon, the parody Xiaomi (XIAOMY) and BYD (BYDŁO), and the hotel's own sign.
## The blocks stay LoD2's in their skin. The frame is the street's grid: u along Marszałkowska
## (SSE), v across (WSW).
const MDM_A := Vector2(0.349, 0.937)
const MDM_TRIM := Color("#ece4d0")
const MDM_PIER := Color("#d3c39a")
const MDM_SAND := Color("#cdb98d")
const MDM_DARK := Color("#34383b")
const MDM_RED := Color(1.0, 0.16, 0.12)
const MDM_ORANGE := Color(1.0, 0.45, 0.05)
const MDM_SILVER := Color(0.88, 0.92, 0.97)
const MDM_ARCADE_DEPTH := 2.9
const MDM_BAY := 5.4
const MDM_BAND := 11.0
const MDM_RING := 80.0
## Corner pavilions: [centre, block height, half size along the street, half size across].
const MDM_CROWNS := [
	[Vector2(-458.6, 1286.5), 30.7, 5.8, 7.5],   # east block's south end
	[Vector2(-588.8, 1334.4), 30.7, 5.8, 8.5],   # west block's south end
	[Vector2(-499.5, 1388.5), 27.4, 7.5, 5.8],   # the south gate, west
	[Vector2(-462.0, 1374.3), 27.4, 7.5, 5.8],   # the south gate, east
]
## Roof and hotel signs: [word, spot, outward direction, roof height above ground, width m, colour].
const MDM_SIGNS := [
	["MDM", Vector2(-458.6, 1286.5), Vector2(0.349, 0.937), 36.4, 8.0, MDM_RED],
	["BYDŁO", Vector2(-472.8, 1274.0), Vector2(-0.937, 0.349), 31.0, 12.0, MDM_SILVER],
	["XIAOMY", Vector2(-447.0, 1366.0), Vector2(-0.349, -0.937), 27.8, 11.0, MDM_ORANGE],
	["HOTEL MDM", Vector2(-466.0, 1281.0), Vector2(-0.937, 0.349), 5.9, 5.2, MDM_RED],
]


func _build_mdm(site: Dictionary) -> void:
	_a = MDM_A
	_b = Vector2(-MDM_A.y, MDM_A.x)
	_mode = M_STONE
	var zone: Array = site["zone"]
	for poly: PackedVector2Array in zone:
		_mdm_facades(_simplify(poly, 0.8), zone)
	for t: Array in MDM_CROWNS:
		_mdm_crown(t[0], float(t[1]), float(t[2]), float(t[3]))
	for s: Array in MDM_SIGNS:
		var at: Vector2 = s[1]
		var d: Vector2 = s[2]
		var k: float = float(s[4]) / Neon.length_of(s[0])
		signs.append([s[0], Vector3(at.x, map.terrain_height(at.x, at.y) + float(s[3]), at.y), Vector3(d.x, 0.0, d.y), k, s[5]])


## The street faces of one block: those that look at the square or the axis get the stone base;
## the ones on the square's ring get a deep arcade as well.
func _mdm_facades(poly: PackedVector2Array, zone: Array) -> void:
	var n := poly.size()
	for i in n:
		var p0 := poly[i]
		var p1 := poly[(i + 1) % n]
		var length := p0.distance_to(p1)
		if length < 14.0:
			continue
		var out := _out(poly, p0, p1)
		var mid := (p0 + p1) * 0.5
		var target := Geometry2D.get_closest_point_to_segment(mid, MDM_SQUARE, MDM_SOUTH)
		if mid.distance_to(target) > 100.0 or out.dot((target - mid).normalized()) < 0.55:
			continue
		var blocked := false
		for z: PackedVector2Array in zone:
			if Geometry2D.is_point_in_polygon(mid + out * 3.0, z):
				blocked = true
				break
		if blocked:
			continue
		_mdm_facade(p0, p1, out, mid.distance_to(MDM_SQUARE) < MDM_RING)


## One facade p0 → p1 reaching `out`. Frame: u along it, v out. The base stands 0.6 m proud of
## the wall (LoD2's wall may stand a little off the OpenStreetMap outline).
func _mdm_facade(p0: Vector2, p1: Vector2, out: Vector2, arcade: bool) -> void:
	var length := p0.distance_to(p1)
	_o = p0
	_a = (p1 - p0) / length
	_b = out
	_g = minf(map.terrain_height(p0.x, p0.y), map.terrain_height(p1.x, p1.y))
	var g := _g
	var bays := maxi(int(round(length / MDM_BAY)), 2)
	var step := length / bays
	var base := 0.6
	_mode = M_MONUMENT
	_wall(_w(0.2, base), _w(length - 0.2, base), g - 0.3, g + MDM_BAND, _b, MDM_SAND)
	_mode = M_STONE
	# the ledge over the base
	_lbox(length * 0.5, base + 0.5, length * 0.5 - 0.1, 0.5, g + MDM_BAND, g + MDM_BAND + 0.7, MDM_TRIM, M_STONE, MDM_TRIM)
	# stone piers between the shopfronts, a cornice over the ground floor
	for k in range(0, bays + 1):
		var u := clampf(k * step, 0.7, length - 0.7)
		_lbox(u, base + 0.2, 0.5, 0.2, g - 0.3, g + 5.8, MDM_PIER, M_STONE, MDM_TRIM)
	_lbox(length * 0.5, base + 0.3, length * 0.5 - 0.1, 0.3, g + 5.6, g + 6.2, MDM_TRIM, M_STONE, MDM_TRIM)
	# shopfronts: dark glass in each bay
	_mode = M_GLASS
	for k in bays:
		_wall(_w(k * step + 0.9, base + 0.45), _w((k + 1) * step - 0.9, base + 0.45), g + 0.3, g + 5.2, _b, MDM_DARK)
	_mode = M_STONE
	if arcade:
		# a deep arcade over the pavement: square piers under a flat entablature
		for k in range(1, bays):
			_lbox(k * step, MDM_ARCADE_DEPTH - 0.4, 0.7, 0.7, g - 0.5, g + 5.8, MDM_PIER, M_STONE, MDM_TRIM)
		_lbox(length * 0.5, MDM_ARCADE_DEPTH * 0.5 + 0.3, length * 0.5 - 0.3, MDM_ARCADE_DEPTH * 0.5 - 0.1, g + 5.8, g + 6.4, MDM_TRIM, M_STONE, MDM_TRIM)
		_lbox(length * 0.5, MDM_ARCADE_DEPTH + 0.1, length * 0.5 - 0.3, 0.2, g + 6.4, g + 6.9, MDM_TRIM, M_STONE, MDM_TRIM)
	_collide(PackedVector2Array([_w(0.4, 0.0), _w(length - 0.4, 0.0), _w(length - 0.4, MDM_ARCADE_DEPTH if arcade else base + 1.0), _w(0.4, MDM_ARCADE_DEPTH if arcade else base + 1.0)]))


## A corner pavilion on a block's end (base sunk 1.5 m into the roof): a cornice, a recessed
## windowed attic one storey high, a cornice with a finial on every corner and along the parapet.
func _mdm_crown(c: Vector2, block_h: float, ha: float, hb: float) -> void:
	_o = c
	_a = MDM_A
	_b = Vector2(-MDM_A.y, MDM_A.x)
	_g = map.terrain_height(c.x, c.y)
	var g := _g
	var none := Color(0, 0, 0, 0)
	var y0 := g + block_h - 1.5
	_mode = M_STONE
	# a hidden core inside the block ties the pavilion to the ground (the mesh check's floating-parts rule)
	_lbox(0.0, 0.0, ha - 0.8, hb - 0.8, g - 0.5, y0 + 2.0, MDM_SAND, M_STONE, MDM_SAND)
	_lbox(0.0, 0.0, ha + 0.4, hb + 0.4, y0 + 1.5, y0 + 2.5, MDM_TRIM, M_STONE, MDM_TRIM)
	_prism(_rect(0.0, 0.0, ha - 0.9, hb - 0.9), y0 + 2.5, y0 + 7.0, MDM_STONE, none, M_MONUMENT)
	_lbox(0.0, 0.0, ha - 0.3, hb - 0.3, y0 + 7.0, y0 + 8.0, MDM_TRIM, M_STONE, MDM_TRIM)
	_lbox(0.0, 0.0, ha - 1.3, hb - 1.3, y0 + 8.0, y0 + 8.4, MDM_ROOF, M_STONE, MDM_ROOF)
	for su: float in [-1.0, 1.0]:
		for sv: float in [-1.0, 1.0]:
			_pinnacle(su * (ha - 0.5), sv * (hb - 0.5), 0.7, y0 + 8.0, 2.4, MDM_TRIM)
	for sv: float in [-1.0, 1.0]:
		for su: float in [-0.5, 0.5]:
			_pinnacle(su * (ha - 0.5), sv * (hb - 0.5), 0.5, y0 + 8.0, 1.6, MDM_TRIM)
	_mode = M_STONE



# --- Kolumna Zygmunta (the landmarks loop, Old Town) ---------------------------------------------

## Sigismund's Column on Plac Zamkowy (1644, rebuilt 1949): OpenStreetMap maps it in a dozen
## tiny 3D parts the builder drops as specks, so the square had a dark cube. Built here: the
## stepped granite base, the pedestal, the 12 m shaft, the capital and the king in bronze with
## his cross raised and his sabre. A circle zone round it; the same on both city paths.
const ZYGMUNT := Vector2(-724.2, -1465.4)
const ZYGMUNT_GRANITE := Color("#a39e96")  # steps (photo report zygmunt.md)
const ZYGMUNT_STONE := Color("#9a9186")  # the shaft, grey-brown granite
const ZYGMUNT_PLINTH := Color("#77746f")  # the pedestal, dark grey granite
const ZYGMUNT_CAPITAL := Color("#4a443a")
const ZYGMUNT_BRONZE := Color("#4f4a40")
func _find_zygmunt() -> void:
	_add_site("zygmunt", [_circle(ZYGMUNT, 4.0, 16)])


## A ring of `n` points round `c`.
func _circle(c: Vector2, r: float, n: int) -> PackedVector2Array:
	var out := PackedVector2Array()
	for k in n:
		out.append(c + Vector2.from_angle(TAU * (k + 0.5) / n) * r)
	return out


func _build_zygmunt(_site: Dictionary) -> void:
	var c := ZYGMUNT
	_g = _ground_under(_circle(c, 3.4, 8))
	var g := _g
	var none := Color(0, 0, 0, 0)
	# Four broad low granite steps, the dark granite pedestal with bronze plaques, then the shaft
	# with its bronze ring and Corinthian capital and the square abacus (photo report zygmunt.md).
	for k in 4:
		_prism(_circle(c, 3.8 - k * 0.45, 8), g - 0.4 + k * 0.15, g + 0.15 + k * 0.15, ZYGMUNT_GRANITE, ZYGMUNT_GRANITE, M_STONE, M_STONE)
	_prism(_circle(c, 1.9, 4), g + 0.3, g + 1.5, ZYGMUNT_PLINTH.darkened(0.12), none, M_STONE)
	_prism(_circle(c, 1.5, 4), g + 1.5, g + 4.6, ZYGMUNT_PLINTH, none, M_STONE)
	_prism(_circle(c, 1.58, 4), g + 4.0, g + 4.6, ZYGMUNT_BRONZE, none, M_STONE)  # the bronze inscription band
	_prism(_circle(c, 1.7, 4), g + 4.6, g + 5.0, ZYGMUNT_PLINTH, ZYGMUNT_PLINTH.lightened(0.05), M_STONE, M_STONE)
	# The shaft, tapering a little, over a bronze sculpted ring; then the capital and the abacus.
	_mode = M_STONE
	_prism(_circle(c, 0.8, 8), g + 5.0, g + 6.0, ZYGMUNT_BRONZE, ZYGMUNT_BRONZE, M_STONE, M_STONE)
	_frustum(_circle(c, 0.6, 16), g + 6.0, _circle(c, 0.45, 16), g + 16.2, ZYGMUNT_STONE)
	_frustum(_circle(c, 0.5, 12), g + 16.2, _circle(c, 0.85, 12), g + 17.8, ZYGMUNT_CAPITAL)
	_prism(_circle(c, 0.95, 4), g + 17.8, g + 18.6, ZYGMUNT_STONE, ZYGMUNT_STONE, M_STONE, M_STONE)
	# The king (facing south, down Krakowskie Przedmieście): robe, body, head; the cross held
	# high in his left hand, the sabre in his right.
	_prism(_circle(c, 0.42, 8), g + 18.6, g + 19.9, ZYGMUNT_BRONZE, none, M_STONE)
	_prism(_circle(c, 0.3, 8), g + 19.9, g + 20.9, ZYGMUNT_BRONZE, ZYGMUNT_BRONZE, M_STONE, M_STONE)
	_prism(_circle(c, 0.16, 6), g + 20.9, g + 21.3, ZYGMUNT_BRONZE, ZYGMUNT_BRONZE, M_STONE, M_STONE)
	var hand := c + Vector2(0.38, 0.05)
	_prism(_circle(hand, 0.07, 4), g + 20.2, g + 22.9, ZYGMUNT_BRONZE, ZYGMUNT_BRONZE, M_STONE, M_STONE)
	var bar := PackedVector2Array([hand + Vector2(-0.36, -0.05), hand + Vector2(0.36, -0.05), hand + Vector2(0.36, 0.05), hand + Vector2(-0.36, 0.05)])
	_prism(bar, g + 22.25, g + 22.39, ZYGMUNT_BRONZE, ZYGMUNT_BRONZE, M_STONE, M_STONE)
	var sabre := PackedVector2Array([c + Vector2(-0.34, 0.1), c + Vector2(-0.3, 0.1), c + Vector2(-0.3, 0.95), c + Vector2(-0.34, 0.95)])
	_prism(sabre, g + 19.55, g + 19.65, ZYGMUNT_BRONZE, ZYGMUNT_BRONZE, M_STONE, M_STONE)
	_collide(_circle(c, 3.4, 8))

# --- The de Gaulle statue by Rondo de Gaulle'a (F's photo, 2026-11-01) ---------------------------

## Jean Cardot's marching general (a copy of the Paris one, unveiled 15 May 2005) in front of the
## Party House, north-west of its north wing, where the lawn's curved cut-out is mapped. OSM has
## no 3D parts for it, so it is built by hand like Sigismund's Column (spec
## docs/design/gaulle-and-food-hype.md G1, from F's photo): curved granite steps with cobbled
## rings between them, a low granite cone, the tall dark granite plinth (its long side along the
## walk) and the general in dark bronze, 3.3 m, walking west in his long coat and kepi.
const GAULLE := Vector2(-171.0, 273.0)
const GAULLE_WALK := Vector2(-1.0, 0.0)
const GAULLE_STEP := Color("#b3b5b6")
const GAULLE_COBBLE := Color("#76777a")
const GAULLE_CONE := Color("#77777a")
const GAULLE_GRANITE := Color("#4c4d51")
const GAULLE_BRONZE := Color("#4a463d")
const GAULLE_PLINTH_H := 4.2
func _find_gaulle() -> void:
	_add_site("gaulle", [_circle(GAULLE, 4.4, 16)])


func _build_gaulle(_site: Dictionary) -> void:
	var c := GAULLE
	_g = _ground_under(_circle(c, 6.0, 8))
	var g := _g
	# The rings, outside in: three steps up, a cobbled band, one more step, a cobbled band.
	var rings := [[8.0, 0.15, GAULLE_STEP], [7.6, 0.3, GAULLE_STEP], [7.2, 0.45, GAULLE_STEP], [6.8, 0.47, GAULLE_COBBLE],
			[5.9, 0.62, GAULLE_STEP], [5.5, 0.64, GAULLE_COBBLE]]
	for r: Array in rings:
		var col: Color = r[2]
		_prism(_circle(c, float(r[0]), 32), g - 0.3, g + float(r[1]), col.darkened(0.06), col, M_STONE, M_STONE)
	# The low cone, cobbled on top.
	_mode = M_STONE
	_frustum(_circle(c, 4.4, 24), g + 0.64, _circle(c, 3.2, 24), g + 1.1, GAULLE_CONE, GAULLE_COBBLE.darkened(0.1))
	# The plinth in the walk's frame (u along the walk, v to his left), a faint joint at a third.
	_o = c
	_a = GAULLE_WALK
	_b = Vector2(-_a.y, _a.x)
	var top := g + 1.1 + GAULLE_PLINTH_H
	_lbox(0.0, 0.0, 1.35, 0.9, g + 1.0, g + 2.45, GAULLE_GRANITE, M_STONE, GAULLE_GRANITE)
	_lbox(0.0, 0.0, 1.33, 0.88, g + 2.45, top, GAULLE_GRANITE.lightened(0.03), M_STONE, GAULLE_GRANITE.darkened(0.05))
	_gaulle_figure(top, 3.3)
	_collide(_circle(c, 4.4, 16))


## The general, `h` m tall from his soles at `y`, in the frame _o/_a/_b (u forward): legs apart
## in mid-stride, the coat to the knee, the near arm forward, the other back, the kepi.
func _gaulle_figure(y: float, h: float) -> void:
	var k := h / 3.3
	var bz := GAULLE_BRONZE
	var none := Color(0, 0, 0, 0)
	# Legs: the front foot ahead, the back one pushing off; a shoe each.
	for side: float in [1.0, -1.0]:
		var hip := _w(0.0, 0.14 * side)
		var foot := _w(0.5 * side * k, 0.15 * side)
		var lift := 0.0 if side > 0.0 else 0.08 * k
		_beam(Vector3(hip.x, y + 1.62 * k, hip.y), Vector3(foot.x, y + lift + 0.08 * k, foot.y), 0.24 * k, bz)
		var toe := _w((0.5 * side + 0.16) * k, 0.15 * side)
		_beam(Vector3(foot.x, y + lift + 0.06 * k, foot.y), Vector3(toe.x, y + 0.06 * k, toe.y), 0.15 * k, bz.darkened(0.1))
	# The long coat: a flared skirt, the body, the shoulders.
	_mode = M_STONE
	_frustum(_rect(0.0, 0.0, 0.34 * k, 0.33 * k), y + 1.0 * k, _rect(0.0, 0.0, 0.23 * k, 0.27 * k), y + 1.75 * k, bz)
	_prism(_rect(0.0, 0.0, 0.2 * k, 0.27 * k), y + 1.75 * k, y + 2.5 * k, bz, none, M_STONE)
	_frustum(_rect(0.0, 0.0, 0.2 * k, 0.29 * k), y + 2.5 * k, _rect(0.0, 0.0, 0.14 * k, 0.18 * k), y + 2.66 * k, bz, bz)
	# Arms swing against the legs: the right forward, the left back, from the shoulders.
	for side: float in [1.0, -1.0]:
		var sh := _w(0.0, 0.31 * side * k)
		var hand := _w(-0.32 * side * k, 0.36 * side * k)
		_beam(Vector3(sh.x, y + 2.55 * k, sh.y), Vector3(hand.x, y + 1.72 * k, hand.y), 0.13 * k, bz)
	# The neck, the head and the kepi with its peak forward.
	_prism(_rect(0.0, 0.0, 0.06 * k, 0.06 * k), y + 2.62 * k, y + 2.72 * k, bz, none, M_STONE)
	_prism(_rect(0.02 * k, 0.0, 0.11 * k, 0.1 * k), y + 2.72 * k, y + 2.98 * k, bz, none, M_STONE)
	_prism(_circle(_w(0.0, 0.0), 0.12 * k, 8), y + 2.98 * k, y + 3.16 * k, bz.darkened(0.08), bz.darkened(0.12), M_STONE, M_STONE)
	_prism(_rect(0.15 * k, 0.0, 0.07 * k, 0.1 * k), y + 2.98 * k, y + 3.0 * k, bz.darkened(0.15), bz.darkened(0.15), M_STONE, M_STONE)


# --- Rondo Dmowskiego (F's photos and the city's traffic plan, 2026-11-02) ---------------------

## The roundabout where Marszałkowska crosses Al. Jerozolimskie, over the underpass to Metro
## Centrum (spec docs/landmarks/specs/rondo-dmowskiego.md). The map has the ring, the tram cross through
## the middle, the four lawns between the tracks and twelve walled stairwells; this site dresses
## them like the real place (F's aerials, 2026-11-02):
##  - the island: grey granite paving in concentric bands round the tram cross, in each quarter
##    one long bent flower bed (red or purple, in a yellow rim, like the summer planting) and a
##    short inner bed of clipped shrubs in an orange rim; no trees (the photos show none; the
##    laser scan's crowns there go: tree_free);
##  - the underpass stairs: Metro Centrum's 1990s blue "tubes" over every stairwell, a half
##    barrel of milky polycarbonate on blue steel arches, closed at the deep end, a red M post at
##    the mouth (still standing in 2026: ZTM's replacement is only on paper);
##  - the colourful mural on the Patelnia's south wall (our own pattern, not the real artwork).
## The PRASA kiosk, the ice-cream cart and the east tram stop's shelter are street details
## (tools/bake_street_details.py RONDO). The zone is two 0.2 m squares at the corners of it all
## (RONDO_BOX), so nothing mapped is dropped and every sector the pieces reach builds them.
const RONDO_C := Vector2(-836.36, 461.05)
const RONDO_U := Vector2(0.33738, 0.94137)    # along Marszałkowska, south
const RONDO_V := Vector2(0.94258, -0.33399)   # along Al. Jerozolimskie, east
const RONDO_TRACK := 4.0                      # half the tram cross's width (ballast 3 m and a kerb strip)
const RONDO_PAVING := Color("#b4b0a7")
const RONDO_BAND := Color("#86827b")
const RONDO_RIM := Color("#e2b23c")
const RONDO_RIM_INNER := Color("#d97a2b")
const RONDO_SHRUB := Color("#3f6b2f")
const RONDO_FLOWERS := [Color("#c42b3a"), Color("#7a52b8"), Color("#c42b3a"), Color("#7a52b8")]
const TUBE_BLUE := Color("#2457a8")
const TUBE_SKIN := Color("#d6e4ee")
const METRO_RED := Color("#c8171f")
## The stairwells (centrum.json `steps` with their walled outlines, `lines` k wall): centre x, z, the
## way up (to the open mouth), length and width of the walled well.
const RONDO_WELLS := [
	[-780.2, 473.9, 0.821, -0.570, 8.8, 4.6], [-850.1, 514.7, 0.357, 0.934, 9.3, 5.6],
	[-794.8, 418.0, 0.999, -0.046, 8.7, 6.0], [-789.5, 490.9, 0.038, 0.999, 8.6, 5.6],
	[-815.5, 412.9, -0.618, -0.786, 9.1, 6.3], [-862.0, 415.4, -0.011, -1.000, 9.6, 4.3],
	[-793.6, 438.3, 0.991, -0.130, 8.7, 5.9], [-876.5, 484.6, -1.000, 0.012, 9.1, 3.9],
	[-810.9, 499.4, 0.110, 0.994, 8.6, 4.0], [-884.4, 405.2, -0.204, -0.979, 8.7, 5.4],
	[-881.5, 429.3, -0.083, 0.997, 9.6, 5.8], [-864.4, 503.9, -0.996, -0.091, 8.9, 5.7],
]
## The Patelnia's south wall (centrum.json `lines` k wall, 1.9 m): the mural faces the sunken
## square (north) along its first 50 m.
const RONDO_MURAL := [Vector2(-886.2, 424.1), Vector2(-889.3, 424.2), Vector2(-892.2, 424.4), Vector2(-894.9, 424.9),
	Vector2(-901.4, 426.3), Vector2(-904.0, 426.6), Vector2(-906.2, 426.8), Vector2(-908.4, 426.7), Vector2(-910.7, 426.4),
	Vector2(-913.2, 425.9), Vector2(-915.9, 425.0), Vector2(-919.0, 424.0), Vector2(-923.6, 422.8), Vector2(-926.2, 422.4),
	Vector2(-928.8, 422.3), Vector2(-931.4, 422.3), Vector2(-933.7, 422.5), Vector2(-935.7, 422.9)]
const MURAL_COLOURS := [Color("#f2c12e"), Color("#e8562a"), Color("#d6338a"), Color("#2fb3c9"), Color("#5bbf4a"),
	Color("#7a4fc2"), Color("#f08fb8"), Color("#2a62d1"), Color("#ffffff"), Color("#1d1d24")]
const MURAL_H := 1.9


## The zone's two 0.2 m squares: the north-west and south-east corners of everything the site
## builds (the mural's far end, the south-east stairs), so its box covers it all.
const RONDO_BOX := [Vector2(-937.0, 400.0), Vector2(-776.0, 519.0)]
func _find_rondo() -> void:
	var zone: Array = []
	for a: Vector2 in RONDO_BOX:
		zone.append(PackedVector2Array([a, a + Vector2(0.2, 0), a + Vector2(0.2, 0.2), a + Vector2(0, 0.2)]))
	_add_site("rondo", zone)
	tree_free.append([RONDO_C, 27.5])


func _build_rondo(_site: Dictionary) -> void:
	_no_roof = true
	_rondo_island()
	for w: Array in RONDO_WELLS:
		_rondo_tube(Vector2(float(w[0]), float(w[1])), Vector2(float(w[2]), float(w[3])), float(w[4]), float(w[5]))
	_rondo_mural()
	_no_roof = false


## The island's edge at angle `ang` in a quarter: 25.2 m at the tracks,
## 26.8 m on the diagonals (just over the mapped lawns' outline, 24.8-26.6 m).
func _rondo_r(ang: float) -> float:
	var s := sin(2.0 * ang)
	return 25.2 + 1.6 * s * s


## A point of quarter (sv, su) in the island's frame (v east, u south) at (v, u) >= 0.
func _rondo_p(q: Vector2, v: float, u: float) -> Vector2:
	return RONDO_C + RONDO_V * (v * q.x) + RONDO_U * (u * q.y)


## A polygon of quarter `q` from local (v, u) points, counter-clockwise in the plan.
func _rondo_poly(q: Vector2, pts: Array) -> PackedVector2Array:
	var out := PackedVector2Array()
	for p: Vector2 in pts:
		out.append(_rondo_p(q, p.x, p.y))
	if Geometry2D.is_polygon_clockwise(out):
		out.reverse()
	return out


## The quarter between the tracks out to the edge, as local points (v, u).
func _rondo_quarter_local(r_scale := 1.0, inset := 0.0) -> Array:
	var pts: Array = [Vector2(RONDO_TRACK + inset, RONDO_TRACK + inset)]
	for k in 13:
		var ang := PI * 0.5 * float(k) / 12.0
		var r := _rondo_r(ang) * r_scale - inset
		var p := Vector2(cos(ang), sin(ang)) * r
		pts.append(Vector2(maxf(p.x, RONDO_TRACK + inset), maxf(p.y, RONDO_TRACK + inset)))
	return pts


## A curved band between radii r0 and r1 over the quarter, its ends cut flat `cut` m from the
## tracks (parallel to them): the beds' crescent shape (F's photos).
func _rondo_band_local(r0: float, r1: float, cut: float) -> Array:
	var pts: Array = []
	for k in 13:
		var ang := PI * 0.5 * float(k) / 12.0
		pts.append(Vector2(maxf(cos(ang) * r1, cut), maxf(sin(ang) * r1, cut)))
	for k in range(12, -1, -1):
		var ang := PI * 0.5 * float(k) / 12.0
		pts.append(Vector2(maxf(cos(ang) * r0, cut), maxf(sin(ang) * r0, cut)))
	# Clamping folds the points past the cut onto it: drop the repeats.
	var out: Array = []
	for p: Vector2 in pts:
		if out.is_empty() or (out[out.size() - 1] as Vector2).distance_to(p) > 0.05:
			out.append(p)
	return out


func _rondo_island() -> void:
	_id = 0
	_g = map.terrain_height(RONDO_C.x, RONDO_C.y)
	var g := _g
	_mode = M_STONE
	var quarters := [Vector2(1, 1), Vector2(-1, 1), Vector2(-1, -1), Vector2(1, -1)]
	for qi in 4:
		var q: Vector2 = quarters[qi]
		# Paving over the mapped lawn, then the darker concentric bands, clipped to the quarter.
		var quarter := _rondo_poly(q, _rondo_quarter_local())
		_cap(quarter, g + 0.18, RONDO_PAVING)
		for band: Vector2 in [Vector2(7.6, 8.4), Vector2(13.4, 14.0), Vector2(21.2, 21.8), Vector2(23.6, 24.2)]:
			var ring_out := PackedVector2Array()
			var ring_in := PackedVector2Array()
			for k in 13:
				var ang := PI * 0.5 * float(k) / 12.0
				ring_out.append(_rondo_p(q, cos(ang) * band.y, sin(ang) * band.y))
				ring_in.append(_rondo_p(q, cos(ang) * band.x, sin(ang) * band.x))
			ring_in.reverse()
			var strip := ring_out + ring_in
			if Geometry2D.is_polygon_clockwise(strip):
				strip.reverse()
			for piece in Geometry2D.intersect_polygons(strip, quarter):
				if piece.size() >= 3 and not Geometry2D.is_polygon_clockwise(piece):
					_cap(piece, g + 0.21, RONDO_BAND)
		# The long bed: a yellow rim, the flowers 0.3 m inside it, a speckle of lighter blooms.
		var bed := _rondo_poly(q, _rondo_band_local(15.0, 19.6, 5.0))
		_prism(bed, g, g + 0.38, RONDO_RIM.darkened(0.1), RONDO_RIM, M_STONE, M_STONE)
		var inner := Geometry2D.offset_polygon(bed, -0.3, Geometry2D.JOIN_MITER)
		var flowers: Color = RONDO_FLOWERS[qi]
		for p in inner:
			if p.size() >= 3 and not Geometry2D.is_polygon_clockwise(p):
				_prism(p, g + 0.38, g + 0.46, flowers.darkened(0.25), flowers, M_STONE, M_STONE)
				_rondo_speckle(p, g + 0.5, flowers.lightened(0.35), qi)
		# The inner bed: clipped shrubs in an orange rim.
		var small := _rondo_poly(q, _rondo_band_local(9.4, 11.8, 5.0))
		_prism(small, g, g + 0.3, RONDO_RIM_INNER.darkened(0.1), RONDO_RIM_INNER, M_STONE, M_STONE)
		for p in Geometry2D.offset_polygon(small, -0.28, Geometry2D.JOIN_MITER):
			if p.size() >= 3 and not Geometry2D.is_polygon_clockwise(p):
				_prism(p, g + 0.3, g + 0.72, RONDO_SHRUB.darkened(0.15), RONDO_SHRUB, M_STONE, M_STONE)


## Little squares of lighter flowers on a bed's top, on a 1.3 m grid (a fixed jitter per quarter).
func _rondo_speckle(poly: PackedVector2Array, y: float, col: Color, seed_q: int) -> void:
	var box := _box_of([poly])
	var x := box.position.x + 0.4
	var row := 0
	while x < box.end.x:
		var z := box.position.y + 0.4 + 0.65 * float(row % 2)
		while z < box.end.y:
			var jx := fmod(absf(x * 12.9898 + z * 78.233 + seed_q * 3.1), 1.0) * 0.5
			var p := Vector2(x + jx, z)
			if Geometry2D.is_point_in_polygon(p, poly):
				var s := 0.22
				_quad(Vector3(p.x - s, y, p.y - s), Vector3(p.x + s, y, p.y - s), Vector3(p.x + s, y, p.y + s),
						Vector3(p.x - s, y, p.y + s), Vector3.UP, col)
			z += 1.3
		x += 1.3
		row += 1


## One of Metro Centrum's blue tubes over a stairwell centred at `c`, `up` towards its mouth: a half
## barrel (radius half the well less 0.1 m) springing from 1.0 m, its skin milky polycarbonate
## (the cool pavilion glass), blue arches every ~1.5 m and a blue rim at the mouth, the deep end closed
## by a skin half-disc, and a red M post beside the mouth. ~290 triangles.
const TUBE_SEGS := 7
func _rondo_tube(c: Vector2, up: Vector2, length: float, width: float) -> void:
	_g = map.terrain_height(c.x, c.y)
	var g := _g
	var side := Vector2(-up.y, up.x)
	var r := clampf(width * 0.5 - 0.1, 1.8, 2.9)
	var y0 := g + 1.0
	var half := length * 0.5
	# The arc's points (local: across, height) from one side over to the other.
	var arc: Array[Vector2] = []
	for k in TUBE_SEGS + 1:
		var a := PI * float(k) / float(TUBE_SEGS)
		arc.append(Vector2(cos(a) * r, sin(a) * r))
	var at := func(s: float, p: Vector2) -> Vector3:
		var q := c + up * s + side * p.x
		return Vector3(q.x, y0 + p.y, q.y)
	# The skin: one strip per arc segment along the whole tube.
	_mode = M_PAVILION + 0.5
	for k in TUBE_SEGS:
		var p0: Vector2 = arc[k]
		var p1: Vector2 = arc[k + 1]
		var mid := (p0 + p1) * 0.5
		var n3: Vector3 = (at.call(0.0, mid) as Vector3) - Vector3(c.x, y0, c.y)
		n3 = n3.normalized()
		_quad(at.call(-half, p0), at.call(half, p0), at.call(half, p1), at.call(-half, p1), n3, TUBE_SKIN)
	# The deep end's half-disc (facing away from the mouth).
	var back := Vector3(-up.x, 0.0, -up.y)
	var hub: Vector3 = at.call(-half, Vector2.ZERO)
	for k in TUBE_SEGS:
		_tri(hub, at.call(-half, arc[k]), at.call(-half, arc[k + 1]), back, TUBE_SKIN.darkened(0.06),
				Vector2(-1, -1), Vector2(-1, -1), Vector2(-1, -1), -1.0)
	# The arches (the mouth's a little heavier) and the two sills along the walls.
	var n_arch := maxi(3, roundi(length / 1.5) + 1)
	for i in n_arch:
		var s := -half + length * float(i) / float(n_arch - 1)
		var w := 0.2 if i == n_arch - 1 else 0.12
		_rondo_arch(at, s, w, arc, r)
	# The two blue sills it stands on, down to the paving along the well's walls.
	_o = c
	_a = up
	_b = side
	for sx: float in [-1.0, 1.0]:
		_lbox(0.0, r * sx, half, 0.09, g, y0 + 0.02, TUBE_BLUE.darkened(0.15), M_STONE, TUBE_BLUE)
	# The M post at the mouth's right: a 3.2 m pole, a red square with a white M on both faces.
	var foot := c + up * (half + 0.9) + side * (r + 0.5)
	_beam(Vector3(foot.x, g, foot.y), Vector3(foot.x, g + 2.72, foot.y), 0.08, Color("#5b5f66"), false)
	_o = foot
	_a = side
	_b = up
	_mode = M_LAMP
	_lbox(0.0, 0.0, 0.42, 0.05, g + 2.7, g + 3.54, METRO_RED, M_LAMP, METRO_RED)
	for face: float in [-1.0, 1.0]:
		_rondo_m(foot, side, up * face, g + 3.12)


## One blue arch of a tube at `s` along it, `w` wide: an annular band 0.12 m proud of the skin,
## its faces one strip each (segments of a rib box would share planes at the joints and flicker).
func _rondo_arch(at: Callable, s: float, w: float, arc: Array[Vector2], r: float) -> void:
	_mode = M_STONE
	var k_in := (r + 0.01) / r
	var k_out := (r + 0.13) / r
	var p0: Vector3 = at.call(s - w * 0.5, Vector2.ZERO)
	var p1: Vector3 = at.call(s + w * 0.5, Vector2.ZERO)
	var axis := (p1 - p0).normalized()
	for k in arc.size() - 1:
		var a: Vector2 = arc[k]
		var b: Vector2 = arc[k + 1]
		var mid := (a + b) * 0.5
		var hub: Vector3 = at.call(s, Vector2.ZERO)
		var n_out: Vector3 = ((at.call(s, mid) as Vector3) - hub).normalized()
		var fa_i: Vector3 = at.call(s - w * 0.5, a * k_in)
		var fb_i: Vector3 = at.call(s - w * 0.5, b * k_in)
		var fa_o: Vector3 = at.call(s - w * 0.5, a * k_out)
		var fb_o: Vector3 = at.call(s - w * 0.5, b * k_out)
		var ba_i: Vector3 = at.call(s + w * 0.5, a * k_in)
		var bb_i: Vector3 = at.call(s + w * 0.5, b * k_in)
		var ba_o: Vector3 = at.call(s + w * 0.5, a * k_out)
		var bb_o: Vector3 = at.call(s + w * 0.5, b * k_out)
		_quad(fa_i, fb_i, fb_o, fa_o, -axis, TUBE_BLUE)
		_quad(ba_i, bb_i, bb_o, ba_o, axis, TUBE_BLUE)
		_quad(fa_o, fb_o, bb_o, ba_o, n_out, TUBE_BLUE.lightened(0.08))


## A white M (five strokes) on the red square at `c`, facing `n` (plan), its middle at `y`.
func _rondo_m(c: Vector2, along: Vector2, n: Vector2, y: float) -> void:
	var white := Color("#fbf7ee")
	var nrm := Vector3(n.x, 0.0, n.y)
	var strokes := [[-0.24, -0.24, -0.24, 0.24], [0.24, -0.24, 0.24, 0.24], [-0.24, 0.24, 0.0, 0.02], [0.24, 0.24, 0.0, 0.02]]
	_mode = M_LAMP
	for i in strokes.size():
		var s: Array = strokes[i]
		# The uprights 3.5 cm off the plate, the diagonals 3 cm further (no shared planes).
		var p := c + n * (0.085 if i < 2 else 0.115)
		var a := p + along * float(s[0])
		var b := p + along * float(s[2])
		var ya := y + float(s[1])
		var yb := y + float(s[3])
		var d3 := Vector3(b.x - a.x, yb - ya, b.y - a.y).normalized()
		var off := d3.cross(nrm).normalized() * 0.045
		var pa := Vector3(a.x, ya, a.y)
		var pb := Vector3(b.x, yb, b.y)
		_quad(pa - off, pb - off, pb + off, pa + off, nrm, white)


## The mural on the Patelnia's wall, facing the square (north): bold blocks of colour, circles,
## zigzag bands and black outlines in the 2010s Warsaw street-art palette, our own pattern (the real
## mural is someone's artwork). Panels 0.8-2.4 m wide, each split in two or three shapes.
func _rondo_mural() -> void:
	var rnd := 7
	for i in RONDO_MURAL.size() - 1:
		var a: Vector2 = RONDO_MURAL[i]
		var b: Vector2 = RONDO_MURAL[i + 1]
		var length := a.distance_to(b)
		var d := (b - a) / length
		var out := Vector2(d.y, -d.x)
		if out.y > 0.0:
			out = -out  # north (towards the sunken square, -z)
		var face := out * 0.19
		var t := 0.0
		while t < length - 0.05:
			rnd = (rnd * 1103515245 + 12345) % 2147483647
			var w := minf(0.8 + float(rnd % 16) * 0.1, length - t)
			var p0 := a + d * t + face
			var p1 := a + d * (t + w) + face
			var g0: float = map.terrain_height(p0.x, p0.y)
			var g1: float = map.terrain_height(p1.x, p1.y)
			var base: Color = MURAL_COLOURS[rnd % 8]
			var nrm := Vector3(out.x, 0.0, out.y)
			_mode = M_STONE
			_quad(Vector3(p0.x, g0 + 0.15, p0.y), Vector3(p1.x, g1 + 0.15, p1.y), Vector3(p1.x, g1 + MURAL_H - 0.08, p1.y),
					Vector3(p0.x, g0 + MURAL_H - 0.08, p0.y), nrm, base)
			# A shape on it: a disc, a diamond or a zigzag band, outlined in black.
			var fg: Color = MURAL_COLOURS[((rnd >> 3) + 3) % 10]
			if fg == base:
				fg = MURAL_COLOURS[9]
			var m := (p0 + p1) * 0.5 + out * 0.03
			var gm := (g0 + g1) * 0.5
			var kind := (rnd >> 7) % 3
			var rad := minf(w * 0.42, 0.75)
			var yc := gm + 0.25 + rad + float((rnd >> 9) % 3) * 0.12
			if kind == 0:
				_rondo_disc(m, d, nrm, yc, rad + 0.06, MURAL_COLOURS[9], 10)
				_rondo_disc(m + out * 0.03, d, nrm, yc, rad, fg, 10)
			elif kind == 1:
				_rondo_disc(m, d, nrm, yc, rad + 0.06, MURAL_COLOURS[9], 4)
				_rondo_disc(m + out * 0.03, d, nrm, yc, rad, fg, 4)
			else:
				var hz := gm + 0.4 + float(rnd % 5) * 0.2
				var zz := 3 + rnd % 3
				for k in zz:
					var u0 := -w * 0.5 + w * float(k) / float(zz)
					var u1 := -w * 0.5 + w * float(k + 1) / float(zz)
					var ya := hz + (0.25 if k % 2 == 0 else -0.25)
					var yb := hz + (-0.25 if k % 2 == 0 else 0.25)
					var qa := m + d * u0
					var qb := m + d * u1
					_quad(Vector3(qa.x, ya - 0.12, qa.y), Vector3(qb.x, yb - 0.12, qb.y), Vector3(qb.x, yb + 0.12, qb.y),
							Vector3(qa.x, ya + 0.12, qa.y), nrm, fg)
			t += w


## A flat disc (n sides) standing on a wall: centre `m` (plan) at height `y`, `along` the wall.
func _rondo_disc(m: Vector2, along: Vector2, nrm: Vector3, y: float, r: float, col: Color, n: int) -> void:
	var hub := Vector3(m.x, y, m.y)
	for k in n:
		var a0 := TAU * float(k) / float(n) + (PI * 0.25 if n == 4 else 0.0)
		var a1 := TAU * float(k + 1) / float(n) + (PI * 0.25 if n == 4 else 0.0)
		var q0 := m + along * cos(a0) * r
		var q1 := m + along * cos(a1) * r
		_tri(hub, Vector3(q0.x, y + sin(a0) * r, q0.y), Vector3(q1.x, y + sin(a1) * r, q1.y), nrm, col,
				Vector2(-1, -1), Vector2(-1, -1), Vector2(-1, -1), -1.0)


# --- Dom Partii (F's photos, 2026-11-01) --------------------------------------------------------

## The Party House (1948-1952, Nowy Świat 6/12, today Centrum Bankowo-Finansowe): its massing is
## the mapped one (OSM parts here, LoD2 on the Mac) in white stone (SKINS `dom_partii`); this site
## adds what the map lacks (spec docs/design/gaulle-and-food-hype.md G2): ROBUR in white tube
## letters over the north-west corner (the roof sign's parody), and the courtyard: pale paving
## with a dark key border round a lighter field, the long eight-sided fountain (the mapped
## outline) with a granite rim, its pool and five jets along its axis. Its zone is a 0.2 m square
## in the courtyard (nothing mapped stands there), so the skin keeps the building.
const DOM_COURT := [Vector2(-140.9, 306.1), Vector2(-99.7, 293.8), Vector2(-83.4, 348.6), Vector2(-124.4, 360.8)]
const DOM_FOUNTAIN := Vector2(-112.2, 327.3)
const DOM_AXIS := Vector2(0.266, 0.964)
const DOM_NW := Vector2(-161.1, 294.6)     # the outline's north-west corner
const DOM_TOP := 24.1                      # the mapped wings' height (OSM)
const DOM_PAVING := Color("#d8d4ca")
const DOM_KEY := Color("#6e6b66")
const DOM_FIELD := Color("#c9c4b8")
const DOM_GRANITE := Color("#8f8d88")
const DOM_POOL := Color("#4f7f8c")
const DOM_JET := Color("#dff3f8")
const DOM_SIGN := Color(0.95, 0.97, 1.0)
func _find_dom_partii() -> void:
	var c := DOM_FOUNTAIN + Vector2(-6.0, 0.0)
	_add_site("dom_partii_extras", [PackedVector2Array([c, c + Vector2(0.2, 0), c + Vector2(0.2, 0.2), c + Vector2(0, 0.2)])])


func _build_dom_partii(_site: Dictionary) -> void:
	var court := PackedVector2Array(DOM_COURT)
	_g = _ground_under(court)
	var g := _g
	_mode = M_STONE
	_cap(court, g + 0.04, DOM_PAVING)
	for inset: Array in [[1.6, 0.07, DOM_KEY], [2.4, 0.1, DOM_FIELD]]:
		var shrunk := Geometry2D.offset_polygon(court, -float(inset[0]), Geometry2D.JOIN_MITER)
		if not shrunk.is_empty():
			_cap(shrunk[0], g + float(inset[1]), inset[2])
	# The fountain: a long octagon round the mapped pool, a granite rim, the water, five jets.
	_o = DOM_FOUNTAIN
	_a = DOM_AXIS
	_b = Vector2(-_a.y, _a.x)
	var oct := PackedVector2Array()
	for p: Vector2 in [Vector2(-10.6, -1.6), Vector2(-8.6, -3.4), Vector2(8.6, -3.4), Vector2(10.6, -1.6),
			Vector2(10.6, 1.6), Vector2(8.6, 3.4), Vector2(-8.6, 3.4), Vector2(-10.6, 1.6)]:
		oct.append(_w(p.x, p.y))
	var rim := Geometry2D.offset_polygon(oct, 0.45, Geometry2D.JOIN_MITER)
	if not rim.is_empty():
		_prism(rim[0], g - 0.2, g + 0.5, DOM_GRANITE, DOM_GRANITE.lightened(0.1), M_STONE, M_STONE)
	_prism(oct, g + 0.5, g + 0.52, DOM_POOL, DOM_POOL, M_STONE, M_STONE)
	for u: float in [-6.0, -3.0, 0.0, 3.0, 6.0]:
		var j := _w(u, 0.0)
		_beam(Vector3(j.x, g + 0.52, j.y), Vector3(j.x, g + (2.2 if u == 0.0 else 1.4), j.y), 0.16, DOM_JET)
	# ROBUR over the north-west corner, on its north and west fronts, a little in from the corner.
	var outline := _landmark("Centrum Bankowo-Finansowe")
	if outline.size() < 3:
		return
	var top := g + DOM_TOP
	var centre := _centre(outline)
	for far: Vector2 in [Vector2(-88.7, 273.2), Vector2(-135.2, 381.4)]:
		var along := (far - DOM_NW).normalized()
		var o := Vector2(-along.y, along.x)
		if o.dot(DOM_NW - centre) < 0.0:
			o = -o
		var k := 1.5
		var mid := DOM_NW + along * (Neon.length_of("ROBUR") * k * 0.5 + 2.5) - o * 0.6
		signs.append(["ROBUR", Vector3(mid.x, top + 0.6, mid.y), Vector3(o.x, 0.0, o.y), k, DOM_SIGN])


