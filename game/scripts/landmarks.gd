		"grob": "#ddd3bf", "bez_kantow": "#d3cec2", "departament": "#dccfb2", "krolewska": "#d9d0bb"}


func _find_plac2() -> void:
	var metro := _landmark("Metropolitan")
	if metro.size() >= 3:
		_add_site("metropolitan", [metro])
		if not sites.is_empty() and sites[-1]["key"] == "metropolitan":
			sites[-1]["ring"] = _simplify(metro, 0.4)
	var hotel := _landmark("Sofitel Victoria")
	if hotel.size() >= 3:
		_add_site("wiktoria", [hotel])
		if not sites.is_empty() and sites[-1]["key"] == "wiktoria":
			sites[-1]["ring"] = _simplify(hotel, 0.8)
	for t: Dictionary in PLAC_SKINS:
		var outline := _landmark(t["osm"])
		if outline.size() < 3:
			continue
		_add_site(t["key"], [outline])
		if not sites.is_empty() and sites[-1]["key"] == t["key"]:
			sites[-1]["skin"] = {"mode": t["mode"], "wall": Color(t["wall"]), "roof": Color(t["roof"])}
	for bld in data["buildings"]:
		var q := _pts(bld["p"])
		if q.size() >= 4 and float(bld["h"]) >= 8.0 and _box_of([q]).has_point(KROLEWSKA_BLOCK) \
				and Geometry2D.is_point_in_polygon(KROLEWSKA_BLOCK, q):
			_add_site("krolewska", [q])
			if not sites.is_empty() and sites[-1]["key"] == "krolewska":
				sites[-1]["skin"] = {"mode": M_MONUMENT, "wall": KROLEWSKA_WALL, "roof": KROLEWSKA_ROOF}
			return


## Hotel Metropol (the Rondo night photos, 2026-10-31): the building stays the map's own; its
## roof carries a green neon name, a parody (METROPOLKA), on the south and east faces. A site
## with no card, so it is not on the picking grid.
func _build_metropol_sign(_site: Dictionary) -> void:
	var outline := _box_poly(_box_of([_landmark("Hotel Metropol")]))
	var g := _ground_under(outline)
	var top := 0.0
	for bld in _parts_in(outline, func(_b: Dictionary) -> bool: return true):
		top = maxf(top, float(bld["h"]))
	if top < 20.0:
		return
	_crown_signs(outline, g + top + 3.0, "METROPOLKA", Color(0.18, 1.0, 0.36), 0.0, 0.7)


## LORETKA's summer terrace (F, 2026-11-01; the real rooftop bar's: a deck, greenery, low
## seats, cocktails, pink neon). Colours: the deck's wood, the planters and their shrubs, the
## poufs, the tables, the parasols, the bar's counter and its pink strip, the lift's housing,
## the string lights' poles and bulbs.
const LOR_DECK := Color("#8a6a4c")
const LOR_PLANTER := Color("#3d3b38")
const LOR_GREEN := Color("#4f7a3a")
const LOR_POUF := Color("#e9dccb")
const LOR_TABLE := Color("#f2efe8")
const LOR_PARASOL := Color("#ff9fd6")
const LOR_COUNTER := Color("#2b2a2c")
const LOR_STRIP := Color("#ff6fc0")
const LOR_HOUSING := Color("#e6e1d6")
const LOR_POLE := Color("#202022")
const LOR_BULB := Color("#ffd08a")
const LOR_NAME := "Puro Warszawa Centrum"


## LORETKA's terrace plan, read by this model and by crowds.gd's couples (one source, so they
## sit on its poufs): from HOTEL PIURE's outline in `data` (empty without it, or under 15 m) the
## frame (`o` a corner of the longest front, `a` along it, `b` inwards), the hotel's height `h`
## over its lowest ground, the deck's span (`u0`..`u1` along, `v0`..`v1` across), the tables
## (local [u, v]) and the seats [world point, yaw facing the table], two to a table, table by table.
static func loretka_plan(data: Dictionary) -> Dictionary:
	var outline := PackedVector2Array()
	for l: Dictionary in data.get("landmarks", []):
		if str(l.get("name", "")) == LOR_NAME:
			var flat: Array = l["p"]
			for i in range(0, flat.size() - 1, 2):
				outline.append(Vector2(float(flat[i]), float(flat[i + 1])))
	if outline.size() < 3:
		return {}
	var n := outline.size()
	var best := 0
	var longest := 0.0
	var c := Vector2.ZERO
	for i in n:
		c += outline[i]
		var l := outline[i].distance_to(outline[(i + 1) % n])
		if l > longest:
			longest = l
			best = i
	c /= float(n)
	var o := outline[best]
	var a := (outline[(best + 1) % n] - o).normalized()
	var b := Vector2(-a.y, a.x)
	if (c - o).dot(b) < 0.0:
		b = -b
	# The hotel's height: its tallest mapped part whose middle is inside the outline (the
	# streamed city's index has the parts as `site_parts` only: bake_sectors.py SITE_NAMES).
	var h := 0.0
	for bld: Dictionary in data.get("buildings", data.get("site_parts", [])):
		var flat: Array = bld["p"]
		if flat.size() < 6:
			continue
		var m := Vector2.ZERO
		for i in range(0, flat.size() - 1, 2):
			m += Vector2(float(flat[i]), float(flat[i + 1]))
		m /= float(flat.size() / 2)
		if m.distance_to(c) < longest and Geometry2D.is_point_in_polygon(m, outline):
			h = maxf(h, float(bld["h"]))
	if h < 15.0:
		return {}
	# The deck on the front's first half, as deep as the slab is where it is thinnest there.
	var u0 := 1.4
	var u1 := minf(26.0, longest * 0.55)
	var depth := INF
	for u: float in [u0 + 0.5, (u0 + u1) * 0.5, u1 - 0.5]:
		var from := o + a * u + b * 0.05
		for i in n:
			if i == best:
				continue
			var hit: Variant = Geometry2D.segment_intersects_segment(from, from + b * 60.0, outline[i], outline[(i + 1) % n])
			if hit != null:
				depth = minf(depth, from.distance_to(hit) + 0.05)
	if depth == INF or depth < 8.0:
		return {}
	var v0 := 1.3
	var v1 := depth - 1.3
	var tables: Array = []
	var seats: Array = []
	var cols := 4
	for k in cols:
		var u := lerpf(u0 + 2.6, u1 - 4.6, float(k) / float(cols - 1))
		for v: float in [lerpf(v0, v1, 0.3), lerpf(v0, v1, 0.72)]:
			tables.append(Vector2(u, v))
			for side: float in [-1.0, 1.0]:
				var p := o + a * (u + side * 0.8) + b * v
				var face := -a * side
				seats.append([p, atan2(-face.x, -face.y)])
	return {"o": o, "a": a, "b": b, "h": h, "outline": outline, "u0": u0, "u1": u1, "v0": v0, "v1": v1,
			"tables": tables, "seats": seats}


## LORETKA in bubblegum pink on HOTEL PIURE's roof (the rooftop bar's neon), on its long fronts,
## and (F, 2026-11-01) its summer terrace on the roof: a wooden deck, planters of shrubs on its
## three open edges, eight low tables with a pouf each side, four pink parasols, the bar's
## counter with a pink strip, the lift's housing behind it, and string lights on six poles. Out
## of the roof grid (the crowd stands on the hotel's roof height, not the poufs).
func _build_loretka(_site: Dictionary) -> void:
	var outline := _landmark(LOR_NAME)
	var g := _ground_under(outline)
	var top := 0.0
	for bld in _parts_in(outline, func(_b: Dictionary) -> bool: return true):
		top = maxf(top, float(bld["h"]))
	if top < 15.0:
		return
	_crown_signs(outline, g + top + 2.2, "LORETKA", Color(1.0, 0.45, 0.78), 0.0, 0.45)
	var plan := loretka_plan(data)
	if plan.is_empty():
		return
	_o = plan["o"]
	_a = plan["a"]
	_b = plan["b"]
	var y := g + float(plan["h"])
	var u0: float = plan["u0"]
	var u1: float = plan["u1"]
	var v0: float = plan["v0"]
	var v1: float = plan["v1"]
	var none := Color(0, 0, 0, 0)
	var keep_roof := _no_roof
	_no_roof = true
	var d := y + 0.12  # the deck's top
	_lbox((u0 + u1) * 0.5, (v0 + v1) * 0.5, (u1 - u0) * 0.5, (v1 - v0) * 0.5, y, d, LOR_DECK.darkened(0.2), M_STONE, LOR_DECK)
	# Planters on the deck's open edges (the front, the back, the west end), shrubs on top.
	var runs := [[u0 + 0.45, v0 + 0.4, u1 - 2.2, v0 + 0.4], [u0 + 0.45, v1 - 0.4, u1 - 2.2, v1 - 0.4],
			[u0 + 0.4, v0 + 1.4, u0 + 0.4, v1 - 1.4]]
	for r: Array in runs:
		var along_u := absf(float(r[2]) - float(r[0])) > 0.1
		var length := absf(float(r[2]) - float(r[0])) if along_u else absf(float(r[3]) - float(r[1]))
		var pieces := maxi(1, roundi(length / 6.0))
		var step := length / pieces
		for k in pieces:
			var cu := float(r[0]) + (step * (k + 0.5) if along_u else 0.0)
			var cv := float(r[1]) + (0.0 if along_u else step * (k + 0.5))
			var hu := step * 0.5 - 0.3 if along_u else 0.35
			var hv := 0.35 if along_u else step * 0.5 - 0.3
			_lbox(cu, cv, hu, hv, d, d + 0.55, LOR_PLANTER, M_STONE, LOR_PLANTER.darkened(0.2))
			_lbox(cu, cv, hu - 0.08, hv - 0.08, d + 0.55, d + 1.05, LOR_GREEN, M_STONE, LOR_GREEN.lightened(0.08))
	# The tables (a pedestal and a top) and their poufs.
	for t: Vector2 in plan["tables"]:
		_lbox(t.x, t.y, 0.1, 0.1, d, d + 0.42, LOR_POLE, M_STONE, none)
		_lbox(t.x, t.y, 0.38, 0.38, d + 0.42, d + 0.48, LOR_TABLE, M_STONE, LOR_TABLE)
		for side: float in [-1.0, 1.0]:
			_lbox(t.x + side * 0.8, t.y, 0.24, 0.24, d, d + 0.36, LOR_POUF.darkened(0.08), M_STONE, LOR_POUF)
	# Four parasols over the middle of each pair of tables: a pole and a low pink cone.
	var tabs: Array = plan["tables"]
	for k in range(0, tabs.size(), 2):
		var m: Vector2 = (tabs[k] + tabs[k + 1]) * 0.5
		var w := _w(m.x, m.y)
		_beam(Vector3(w.x, d, w.y), Vector3(w.x, d + 2.55, w.y), 0.07, LOR_POLE)
		_mode = M_STONE
		_frustum(_circle(w, 1.7, 8), d + 2.2, _circle(w, 0.12, 8), d + 2.6, LOR_PARASOL.darkened(0.1), LOR_PARASOL)
	# The bar: a counter across the deck's east end with a pink strip on its front, the lift's
	# housing behind it (white render, a dark door).
	var bu := u1 - 1.6
	_lbox(bu, (v0 + v1) * 0.5, 0.4, (v1 - v0) * 0.5 - 2.0, d, d + 1.05, LOR_COUNTER, M_STONE, LOR_COUNTER.lightened(0.15))
	_mode = M_LAMP
	_lbox(bu - 0.44, (v0 + v1) * 0.5, 0.04, (v1 - v0) * 0.5 - 2.3, d + 0.75, d + 0.9, LOR_STRIP, M_LAMP, LOR_STRIP)
	_mode = M_STONE
	_lbox(u1 + 2.0, (v0 + v1) * 0.5, 2.0, 2.4, y, y + 3.1, LOR_HOUSING, M_STONE, LOR_HOUSING.darkened(0.1))
	_lbox(u1 - 0.02, (v0 + v1) * 0.5, 0.04, 0.6, d, d + 2.2, LOR_COUNTER, M_STONE, none)
	# String lights: three poles each side, a wire zig-zagging across between them, warm bulbs.
	var ps: Array = []
	for k in 3:
		var u := lerpf(u0 + 1.2, u1 - 2.6, float(k) / 2.0)
		ps.append([_w(u, v0 + 1.0), _w(u, v1 - 1.0)])
	for pr: Array in ps:
		for q: Vector2 in pr:
			_beam(Vector3(q.x, d, q.y), Vector3(q.x, d + 3.0, q.y), 0.06, LOR_POLE)
	var wires: Array = []
	for k in 2:
		wires.append([ps[k][0], ps[k + 1][1]])
		wires.append([ps[k][1], ps[k + 1][0]])
	for wr: Array in wires:
		var p0: Vector2 = wr[0]
		var p1: Vector2 = wr[1]
		var a3 := Vector3(p0.x, d + 2.95, p0.y)
		var b3 := Vector3(p1.x, d + 2.95, p1.y)
		_beam(a3, b3, 0.025, LOR_POLE, false)
		for j in range(1, 6):
			var q := a3.lerp(b3, j / 6.0) + Vector3(0, -0.12, 0)
			_mode = M_LAMP
			_prism(PackedVector2Array([Vector2(q.x - 0.06, q.z - 0.06), Vector2(q.x + 0.06, q.z - 0.06),
					Vector2(q.x + 0.06, q.z + 0.06), Vector2(q.x - 0.06, q.z + 0.06)]), q.y - 0.06, q.y + 0.1,
					LOR_BULB, LOR_BULB, M_LAMP, M_LAMP)
	_mode = M_STONE
	_no_roof = keep_roof


## Level 26 (F, 2026-11-01), the rooftop club on the Atlas Tower: on the roof of the tower's crown
## (the 4 m top storey OSM maps over the main roof, 116 m) a dark timber deck inside a glass
## balustrade, a bar with a glowing back wall at one end, the DJ booth under a lighting truss with an
## LED wall and speaker stacks at the other, lounge sofas between, planters, festoon lamps on posts
## and the name LEVEL 26 in violet neon. The people are crowds.gd's roof crowd (`level_26`), the bass
## city_sounds.gd's `club` tag, the hours places.json's. Everything is drawn with `_no_roof`, so the
## roof grid (where the crowd stands, where the violet band hangs) stays the tower's own.
func _build_level26_club(_site: Dictionary) -> void:
	var outline := _landmark("Atlas Tower")
	var crown := PackedVector2Array()
	var crown_h := 0.0
	var best := 0.0
	for bld in _parts_in(outline, func(b: Dictionary) -> bool: return float(b["h"]) >= 100.0 and float(b["mh"]) >= 100.0):
		var q := _pts(bld["p"])
		if absf(_area(q)) > best:
			best = absf(_area(q))
			crown = q
			crown_h = float(bld["h"])
	if crown.size() < 3 or best < 150.0:
		return
	var g := _ground_under(outline)
	var y := g + crown_h
	var deck := _largest(Geometry2D.offset_polygon(crown, -1.8, Geometry2D.JOIN_MITER))
	if deck.size() < 3:
		return
	var keep_roof := _no_roof
	_no_roof = true
	var none := Color(0, 0, 0, 0)
	var violet := Color("#a35cff")
	var pink := Color("#ff3d9a")
	var cyan := Color("#35e0ff")
	var warm := Color("#ffc873")
	var dark := Color("#1f1c26")
	# The deck's axes: along its longest edge (d) and across (n); its extent along each.
	var d := Vector2(1, 0)
	var longest := 0.0
	for i in deck.size():
		var e := deck[(i + 1) % deck.size()] - deck[i]
		if e.length() > longest:
			longest = e.length()
			d = e.normalized()
	var n := Vector2(-d.y, d.x)
	var c0 := _centre(deck)
	var u0 := INF
	var u1 := -INF
	var v0 := INF
	var v1 := -INF
	for q in deck:
		var r := q - c0
		u0 = minf(u0, r.dot(d))
		u1 = maxf(u1, r.dot(d))
		v0 = minf(v0, r.dot(n))
		v1 = maxf(v1, r.dot(n))
	var inner := _largest(Geometry2D.offset_polygon(deck, -0.5, Geometry2D.JOIN_MITER))
	if inner.size() < 3:
		inner = deck
	# A rectangle `hu` long along `axis` and `hv` across, centred on a point.
	var orect := func(c: Vector2, axis: Vector2, hu: float, hv: float) -> PackedVector2Array:
		var m := Vector2(-axis.y, axis.x)
		return PackedVector2Array([c - axis * hu - m * hv, c + axis * hu - m * hv, c + axis * hu + m * hv, c - axis * hu + m * hv])
	var fits := func(r: PackedVector2Array) -> bool:
		for q in r:
			if not Geometry2D.is_point_in_polygon(q, inner):
				return false
		return true
	# The floor, then the glass balustrade round it.
	_mode = M_STONE
	_prism(deck, y, y + 0.12, Color("#4a3a30"), Color("#5a4636"), M_STONE, M_STONE)
	# A hidden shaft down inside the tower's walls, so the deck is one piece with the ground
	# (check_mesh_quality's float test: nothing hangs in the air).
	_prism(_square(c0, 0.15), g - 0.5, y + 0.06, Color("#4a3a30"), none, M_STONE, M_STONE)
	_parapet(deck, y + 0.12, 1.1, Color("#b9d3e3"))
	y += 0.12
	# Where things stand: fractions of the deck's extent, nudged across until they fit.
	var spot := func(uf: float, vf: float, hu: float, hv: float, axis: Vector2) -> Vector2:
		for k in [0.0, 1.0, -1.0, 2.0, -2.0, 3.0, -3.0, 4.0, -4.0]:
			var p: Vector2 = c0 + d * lerpf(u0, u1, uf) + n * (lerpf(v0, v1, vf) + k)
			if fits.call(orect.call(p, axis, hu, hv)):
				return p
		return Vector2(INF, INF)
	# The bar at the low end, its front toward the deck (+d).
	var bar: Vector2 = spot.call(0.14, 0.5, 0.9, 3.4, n)
	if bar.x < INF:
		_prism(orect.call(bar, n, 3.3, 0.55), y, y + 1.1, dark, Color("#3a3446"), M_STONE, M_STONE)
		_prism(orect.call(bar + d * 0.57, n, 3.1, 0.03), y + 0.25, y + 0.85, violet, violet, M_LAMP, M_LAMP)
		_prism(orect.call(bar - d * 1.4, n, 3.3, 0.15), y, y + 2.3, dark, dark.lightened(0.1), M_STONE, M_STONE)
		for k in 3:
			_prism(orect.call(bar - d * 1.24, n, 3.0, 0.03), y + 1.0 + 0.5 * k, y + 1.08 + 0.5 * k,
					[pink, cyan, violet][k], [pink, cyan, violet][k], M_LAMP, M_LAMP)
		for k in 6:
			_prism(_square(bar + d * 1.25 + n * (-2.5 + k), 0.22), y, y + 0.78, Color("#2b2733"), pink if k % 2 == 0 else cyan,
					M_STONE, M_LAMP)
	# The DJ booth at the high end, under a truss, facing the deck (-d).
	var dj: Vector2 = spot.call(0.86, 0.5, 1.4, 2.4, n)
	if dj.x < INF:
		_prism(orect.call(dj, n, 1.7, 0.6), y, y + 1.15, dark, Color("#3a3446"), M_STONE, M_STONE)
		_prism(orect.call(dj - d * 0.61, n, 1.5, 0.03), y + 0.2, y + 1.0, cyan, cyan, M_LAMP, M_LAMP)
		_prism(orect.call(dj + d * 1.5, n, 2.4, 0.1), y + 0.9, y + 3.9, pink, pink, M_LAMP, M_LAMP)
		for su: float in [-1.0, 1.0]:
			_prism(_square(dj + n * (su * 2.7) - d * 0.3, 0.1), y, y + 4.2, Color("#8a8f98"), Color("#8a8f98"), M_STONE, M_STONE)
			_prism(orect.call(dj + n * (su * 3.9) + d * 0.3, d, 0.45, 0.45), y, y + 2.0, Color("#15141a"), Color("#26242d"), M_STONE, M_STONE)
		_prism(orect.call(dj - d * 0.3, n, 2.8, 0.1), y + 4.0, y + 4.25, Color("#8a8f98"), Color("#8a8f98"), M_STONE, M_STONE)
		for k in 5:
			_prism(_square(dj - d * 0.45 + n * (-2.2 + 1.1 * k), 0.18), y + 3.6, y + 4.0, [pink, cyan, violet, warm, pink][k],
					[pink, cyan, violet, warm, pink][k], M_LAMP, M_LAMP)
	# Lounge sofas and tables between, in two rows.
	var seat := [[0.36, 0.22], [0.36, 0.78], [0.62, 0.22], [0.62, 0.78]]
	for s in seat:
		var p: Vector2 = spot.call(float(s[0]), float(s[1]), 1.2, 1.0, d)
		if p.x >= INF:
			continue
		var face := (c0 - p).dot(n)
		var f := n * (1.0 if face > 0.0 else -1.0)
		_prism(orect.call(p, d, 1.1, 0.45), y, y + 0.5, Color("#3a2a55"), Color("#5a3d88"), M_STONE, M_STONE)
		_prism(orect.call(p - f * 0.5, d, 1.1, 0.12), y + 0.5, y + 0.95, Color("#3a2a55"), Color("#4a3470"), M_STONE, M_STONE)
		var t := p + f * 1.5
		_prism(_square(t, 0.4), y, y + 0.4, dark, Color("#3a3446"), M_STONE, M_STONE)
		_prism(_square(t, 0.1), y + 0.4, y + 0.55, warm, warm, M_LAMP, M_LAMP)
	# Planters along both long sides.
	for uf: float in [0.25, 0.5, 0.75]:
		for vf: float in [0.04, 0.96]:
			var p: Vector2 = spot.call(uf, vf, 0.8, 0.3, d)
			if p.x < INF:
				_prism(orect.call(p, d, 0.8, 0.3), y, y + 0.6, Color("#5a4a3a"), Color("#2f6b3a"), M_STONE, M_STONE)
				_prism(orect.call(p, d, 0.65, 0.22), y + 0.6, y + 1.5, Color("#2f6b3a"), Color("#3e8a4a"), M_STONE, M_STONE)
	# Festoon lamps: posts about every 9 m on the inner ring, a warm bulb on each and two between.
	var ring_len := 0.0
	for i in inner.size():
		ring_len += inner[i].distance_to(inner[(i + 1) % inner.size()])
	var posts: Array[Vector2] = []
	var step := maxf(ring_len / maxf(roundf(ring_len / 9.0), 4.0), 4.0)
	var walked := 0.0
	var next := 0.0
	for i in inner.size():
		var a := inner[i]
		var b := inner[(i + 1) % inner.size()]
		var el := a.distance_to(b)
		while next <= walked + el and posts.size() < 16:
			posts.append(a.lerp(b, (next - walked) / maxf(el, 0.001)))
			next += step
		walked += el
	for k in posts.size():
		var p: Vector2 = posts[k]
		_prism(_square(p, 0.06), y, y + 2.9, Color("#4a4a52"), Color("#4a4a52"), M_STONE, M_STONE)
		_prism(_square(p, 0.15), y + 2.9, y + 3.2, warm, warm, M_LAMP, M_LAMP)
		_prism(_square(p, 0.1), y + 2.3, y + 2.5, warm, warm, M_LAMP, M_LAMP)
	# The name, in violet, standing on the crown's south and east edges.
	_crown_signs(crown, y + 2.6, "LEVEL 26", VIOLET_SIGN, 0.0, 0.5)
	_no_roof = keep_roof


func _box_poly(r: Rect2) -> PackedVector2Array:
	return PackedVector2Array([r.position, Vector2(r.end.x, r.position.y), r.end, Vector2(r.position.x, r.end.y)])


## The Metropolitan: the outline's fronts in glass (M_GLASS) behind granite fins standing out
## from the ground to the parapet; the courtyard's wall in glass with painted fins (S_FINS: seen
## only from above); dark openings where the three passages go through, under a granite lintel;
## a flat roof with a parapet; the seventh storey set back, the three plant rooms on top; in the
## courtyard the paving and the round fountain with its jets.
func _build_metropolitan(site: Dictionary) -> void:
	var ring: PackedVector2Array = site["ring"]
	_g = _ground_under(ring)
	var g := _g
	var none := Color(0, 0, 0, 0)
	var court := _circle(METRO_COURT, METRO_COURT_R, 40)
	_prism(ring, g - 0.6, g + METRO_H, METRO_GLASS, none, M_GLASS)
	_inside_wall(court, g - 0.6, g + METRO_H, METRO_GLASS, M_SKIN + S_FINS / 16.0)
	_mode = M_STONE
	_cap_holes(ring, [court], g + METRO_H, METRO_ROOF)
	_parapet(ring, g + METRO_H, 0.9, METRO_GRANITE)
	_parapet(court, g + METRO_H, 0.9, METRO_GRANITE)
	# The passages: where each meets the outer front and the courtyard.
	var doors := PackedVector2Array()
	for gate: Vector2 in METRO_GATES:
		var d := (gate - METRO_COURT).normalized()
		var t := Vector2(-d.y, d.x)
		var p := _exit_point(ring, METRO_COURT, d, 120.0)
		doors.append(p)
		var half := METRO_GATE_W * 0.5
		_mode = M_STONE
		_wall(p + d * 0.45 - t * half, p + d * 0.45 + t * half, g - 0.6, g + METRO_GATE_H, d, METRO_GATE)
		_wall(p + d * 0.95 - t * (half + 0.6), p + d * 0.95 + t * (half + 0.6), g + METRO_GATE_H, g + METRO_GATE_H + 0.9, d, METRO_GRANITE)
		var q := METRO_COURT + d * (METRO_COURT_R - 0.3)
		_wall(q - t * half, q + t * half, g - 0.6, g + METRO_GATE_H, -d, METRO_GATE)
	_fins(ring, g - 0.6, g + METRO_H + 0.9, METRO_FIN_STEP, METRO_FIN_W, METRO_FIN_D, METRO_GRANITE, doors,
			METRO_GATE_W * 0.5 + 0.8)
	# The seventh storey, set back from the fins and from the courtyard.
	var upper := _largest(Geometry2D.offset_polygon(ring, -METRO_SETBACK, Geometry2D.JOIN_MITER))
	var court2 := _circle(METRO_COURT, METRO_COURT_R + METRO_SETBACK, 40)
	# the seventh storey and the plant rooms are silver metal over a glazed band (photo 2026-11-07)
	var light := Color("#aab5ba")
	if upper.size() >= 3:
		_prism(upper, g + METRO_H, g + METRO_RING_H, light, none, M_GLASS)
		_inside_wall(court2, g + METRO_H, g + METRO_RING_H, light, M_GLASS)
		_mode = M_STONE
		_cap_holes(upper, [court2], g + METRO_RING_H, METRO_ROOF.lightened(0.05))
		_parapet(upper, g + METRO_RING_H, 0.6, METRO_GRANITE)
		# The plant rooms: each block's outer part, inside a wedge round its middle.
		var inner := _largest(Geometry2D.offset_polygon(ring, -6.0, Geometry2D.JOIN_MITER))
		var core := _circle(METRO_COURT, METRO_COURT_R + 10.0, 24)
		for mid: Vector2 in METRO_BLOCKS:
			var d := (mid - METRO_COURT).normalized()
			var wedge := PackedVector2Array([METRO_COURT, METRO_COURT + d.rotated(-0.45) * 120.0,
					METRO_COURT + d * 120.0, METRO_COURT + d.rotated(0.45) * 120.0])
			for piece in Geometry2D.intersect_polygons(inner, wedge):
				for part in Geometry2D.clip_polygons(piece, core):
					if absf(_area(part)) > 40.0:
						_prism(_simplify(part, 0.4), g + METRO_RING_H, g + METRO_TOP_H, light.lightened(0.08), METRO_ROOF,
								M_GLASS, M_STONE)
	# The courtyard: its paving, the round fountain and its jets.
	var gc: float = map.terrain_height(METRO_COURT.x, METRO_COURT.y)
	_mode = M_STONE
	_cap(court, gc + 0.04, METRO_PAVING)
	_prism(_circle(METRO_COURT, 7.0, 24), gc - 0.2, gc + 0.22, METRO_GRANITE, METRO_POOL, M_STONE, M_STONE)
	for k in 8:
		var j := METRO_COURT + Vector2.from_angle(TAU * k / 8.0) * 4.2
		_beam(Vector3(j.x, gc + 0.22, j.y), Vector3(j.x, gc + 1.7, j.y), 0.14, METRO_JET)
	_collide(ring)


## A wall round the inside of a ring (a courtyard), facing its middle, in `mode`.
func _inside_wall(ring: PackedVector2Array, y0: float, y1: float, col: Color, mode: float) -> void:
	var keep := _mode
	_mode = mode
	var run := 0.0
	for i in ring.size():
		var a := ring[i]
		var b := ring[(i + 1) % ring.size()]
		_wall(a, b, y0, y1, -_out(ring, a, b), col, run)
		run += a.distance_to(b)
	_mode = keep


## Where a ray from `c` along `d` last crosses a ring (its outer front), within `reach`.
func _exit_point(ring: PackedVector2Array, c: Vector2, d: Vector2, reach: float) -> Vector2:
	var best := c + d * reach
	var far := -1.0
	for i in ring.size():
		var hit: Variant = Geometry2D.segment_intersects_segment(c, c + d * reach, ring[i], ring[(i + 1) % ring.size()])
		if hit != null and (hit as Vector2).distance_to(c) > far:
			far = (hit as Vector2).distance_to(c)
			best = hit
	return best


## The biggest of some polygons (an offset ring can break into pieces).
func _largest(polys: Array) -> PackedVector2Array:
	var best := PackedVector2Array()
	var size := 0.0
	for p: PackedVector2Array in polys:
		if absf(_area(p)) > size:
			size = absf(_area(p))
			best = p
	return best


## Vertical fins standing `depth` out from a ring's walls, one every `step` metres along it,
## `w` thick, from y0 to y1, with a top; none within `gap` of a point in `skip` (a doorway).
func _fins(ring: PackedVector2Array, y0: float, y1: float, step: float, w: float, depth: float, col: Color,
		skip: PackedVector2Array, gap: float) -> void:
	var keep := _mode
	_mode = M_STONE
	var next := step * 0.5   # where the next fin stands, from the start of the current edge
	for i in ring.size():
		var a := ring[i]
		var b := ring[(i + 1) % ring.size()]
		var length := a.distance_to(b)
		if length < 0.01:
			continue
		var e := (b - a) / length
		var out := _out(ring, a, b)
		while next <= length:
			var p := a + e * next
			next += step
			var clear := true
			for s in skip:
				if p.distance_to(s) < gap:
					clear = false
					break
			if not clear:
				continue
			var p0 := p - e * w * 0.5
			var p1 := p + e * w * 0.5
			var q0 := p0 + out * depth
			var q1 := p1 + out * depth
			_wall(p0, q0, y0, y1, -e, col)
			_wall(q0, q1, y0, y1, out, col)
			_wall(q1, p1, y0, y1, e, col)
			_quad(Vector3(p0.x, y1, p0.y), Vector3(q0.x, y1, q0.y), Vector3(q1.x, y1, q1.y), Vector3(p1.x, y1, p1.y),
					Vector3.UP, col.lightened(0.06))
		next -= length
	_mode = keep


## Hotel Wiktoria: the podium over the whole outline in dark glass under a stone fascia, the
## slab along the Królewska front in ribbon windows, a parapet and a plant room on it.
func _build_wiktoria(site: Dictionary) -> void:
	var ring: PackedVector2Array = site["ring"]
	_g = _ground_under(ring)
	var g := _g
	var none := Color(0, 0, 0, 0)
	# The frame: u east along the longest front facing north (Królewska), v south into the plot.
	_a = Vector2.RIGHT
	var longest := 0.0
	for i in ring.size():
		var a := ring[i]
		var b := ring[(i + 1) % ring.size()]
		if _out(ring, a, b).y < -0.7 and a.distance_to(b) > longest:
			longest = a.distance_to(b)
			_a = (b - a).normalized() * (1.0 if b.x >= a.x else -1.0)
	_b = Vector2(-_a.y, _a.x)
	_o = _centre(ring)
	var lo := Vector2(INF, INF)
	var hi := -lo
	for q in ring:
		lo = lo.min(_local(q))
		hi = hi.max(_local(q))
	# The podium and its fascia.
	_prism(ring, g - 0.6, g + WIKTORIA_PODIUM_H, WIKTORIA_DARK, none, M_SKIN + S_DARK / 16.0)
	var eave := _largest(Geometry2D.offset_polygon(ring, 0.4, Geometry2D.JOIN_MITER))
	_prism(eave if eave.size() >= 3 else ring, g + WIKTORIA_PODIUM_H, g + WIKTORIA_PODIUM_H + 0.9,
			WIKTORIA_STONE, WIKTORIA_ROOF, M_STONE, M_STONE)
	# The slab: the outline's northern strip, a little in from its fronts.
	var y0 := g + WIKTORIA_PODIUM_H + 0.9
	var strip := PackedVector2Array([_wl(Vector2(lo.x - 1.0, lo.y - 1.0)), _wl(Vector2(hi.x + 1.0, lo.y - 1.0)),
			_wl(Vector2(hi.x + 1.0, lo.y + WIKTORIA_SLAB_D)), _wl(Vector2(lo.x - 1.0, lo.y + WIKTORIA_SLAB_D))])
	var inner := _largest(Geometry2D.offset_polygon(ring, -1.5, Geometry2D.JOIN_MITER))
	for piece in Geometry2D.intersect_polygons(inner, strip):
		if absf(_area(piece)) < 300.0:
			continue
		var slab := _simplify(piece, 0.8)
		_prism(slab, y0, g + WIKTORIA_H, WIKTORIA_GLASS, WIKTORIA_ROOF, M_SKIN + S_BANDS / 16.0, M_STONE)
		_parapet(slab, g + WIKTORIA_H, 1.0, WIKTORIA_STONE)
		var c := _local(_centre(slab))
		_prism(_rect(c.x, c.y, 9.0, 4.0), g + WIKTORIA_H, g + WIKTORIA_H + 3.2, WIKTORIA_ROOF.lightened(0.08),
				WIKTORIA_ROOF, M_STONE, M_STONE)
	_collide(ring)


# --- Plac Małachowskiego and the Presidential Palace (2026-10-31) ------------------------------

## Three named buildings brought from skins (or LoD2 alone) to models, each to its spec in
## docs/landmarks/specs/ (trojca.md, zacheta.md, prezydencki.md). Measured in a cloud thread from
## the OpenStreetMap outlines, GUGiK's LoD2 heights and the user's photo of Zachęta (with the
## church's dome beside it); the values the specs mark *(photo check)* wait for the Mac's photos.
##
## Holy Trinity (Kościół Ewangelicko-Augsburski Świętej Trójcy, Szymon Bogumił Zug, 1777-1781):
## a white rotunda on a Greek-cross plan, a Tuscan portico of four columns under a pediment on
## each arm, a low copper dome and a tall columned lantern with a cross. The drum's centre and
## radius are a circle fitted to its mapped outline; the arms' faces are the outline's.
const TROJCA := Vector2(-854.6, -508.6)
const TROJCA_TURN := -24.6      # degrees: the arm towards the square (ENE)
const TROJCA_R := 16.7
## Each arm: its turn from TROJCA_TURN and how far its portico's front stands from the centre.
const TROJCA_ARMS := [[0.0, 21.8], [90.0, 24.1], [180.0, 21.7], [270.0, 21.3]]
## The dome's profile over the drum's attic: [radius, height above ground] (LoD2: 28.6 m at r 14.5,
## 36 m at r 8, the lantern from 37 m to 49 m, its cap to 52 m; 58 m to the cross's top).
const TROJCA_DOME := [[16.4, 26.5], [15.3, 28.8], [13.4, 31.3], [10.9, 33.6], [8.0, 35.6], [5.7, 36.7]]
const TROJCA_WHITE := Color("#e9e7e1")
const TROJCA_PLINTH := Color("#a9a59d")
const TROJCA_COPPER := Color("#6f9f8f")
const TROJCA_COPPER_DARK := Color("#4f7d70")
const TROJCA_GLASS := Color("#3c4a52")
const TROJCA_GOLD := Color("#c9a24a")


func _find_trojca() -> void:
	_add_site("trojca", [_circle(TROJCA, 25.5, 24)])


func _build_trojca(_site: Dictionary) -> void:
	var c := TROJCA
	var r := TROJCA_R
	_g = _ground_under(_circle(c, r, 8))
	var g := _g
	var none := Color(0, 0, 0, 0)
	var light := TROJCA_WHITE.lightened(0.06)
	# plinth, drum_low, band, drum_high, cornice, attic
	_prism(_circle(c, r + 0.3, 32), g - 0.5, g + 1.2, TROJCA_PLINTH, TROJCA_PLINTH, M_STONE, M_STONE)
	_prism(_circle(c, r, 32), g + 1.2, g + 15.0, TROJCA_WHITE, none, M_MONUMENT)
	_prism(_circle(c, r + 0.35, 32), g + 15.0, g + 15.8, light, light, M_STONE, M_STONE)
	_prism(_circle(c, r, 32), g + 15.8, g + 24.5, TROJCA_WHITE, none, M_STONE)
	_prism(_circle(c, r + 0.45, 32), g + 24.5, g + 25.3, light, light, M_STONE, M_STONE)
	_prism(_circle(c, r, 32), g + 25.3, g + 26.5, TROJCA_WHITE, TROJCA_WHITE.darkened(0.1), M_STONE, M_STONE)
	# oculi: one round window on every other facet of the upper drum
	for k in range(0, 32, 2):
		var mid := (TAU * (k + 0.5) / 32.0 + TAU * (k + 1.5) / 32.0) * 0.5
		var d := Vector2.from_angle(mid)
		var inset := r * cos(PI / 32.0) + 0.06
		var p := c + d * inset
		_disc(Vector3(p.x, g + 20.0, p.y), Vector3(d.x, 0.0, d.y), 1.1, 8, TROJCA_GLASS)
	# dome
	_mode = M_STONE
	for k in TROJCA_DOME.size() - 1:
		var a: Array = TROJCA_DOME[k]
		var b: Array = TROJCA_DOME[k + 1]
		var col := TROJCA_COPPER.lerp(TROJCA_COPPER.lightened(0.12), float(k) / TROJCA_DOME.size())
		_frustum(_circle(c, a[0], 32), g + float(a[1]), _circle(c, b[0], 32), g + float(b[1]), col)
	# lantern: its balustrade, the columned drum, a cornice, the cap, ball and cross
	_prism(_circle(c, 5.9, 16), g + 36.6, g + 37.6, TROJCA_COPPER_DARK, TROJCA_COPPER_DARK, M_STONE, M_STONE)
	_prism(_circle(c, 4.6, 16), g + 37.6, g + 46.0, TROJCA_COPPER, none, M_MONUMENT)
	_prism(_circle(c, 5.1, 16), g + 46.0, g + 46.7, TROJCA_COPPER_DARK, none, M_STONE)
	_mode = M_STONE
	_frustum(_circle(c, 5.1, 16), g + 46.7, _circle(c, 3.8, 16), g + 48.6, TROJCA_COPPER)
	_frustum(_circle(c, 3.8, 16), g + 48.6, _circle(c, 1.7, 16), g + 49.9, TROJCA_COPPER.lightened(0.06))
	_frustum(_circle(c, 1.7, 16), g + 49.9, _circle(c, 0.3, 16), g + 50.4, TROJCA_COPPER.lightened(0.1), TROJCA_COPPER)
	_prism(_circle(c, 0.4, 6), g + 50.4, g + 51.1, TROJCA_GOLD, TROJCA_GOLD, M_STONE, M_STONE)
	_o = c
	_a = Vector2.from_angle(deg_to_rad(TROJCA_TURN))
	_b = Vector2(-_a.y, _a.x)
	_lbox(0.0, 0.0, 0.11, 0.11, g + 51.1, g + 55.6, TROJCA_GOLD, M_STONE, TROJCA_GOLD)
	_lbox(0.0, 0.0, 0.11, 0.75, g + 54.0, g + 54.24, TROJCA_GOLD, M_STONE, TROJCA_GOLD)
	# arms: a vestibule, the stylobate, four Tuscan columns, the entablature and the pediment
	var ring := _circle(c, r + 0.3, 32)
	for arm: Array in TROJCA_ARMS:
		_o = c
		_a = Vector2.from_angle(deg_to_rad(TROJCA_TURN + float(arm[0])))
		_b = Vector2(-_a.y, _a.x)
		var face: float = arm[1]
		var back := face - 4.4
		_lbox((r - 2.0 + back) * 0.5, 0.0, (back - r + 2.0) * 0.5, 6.0, g - 0.5, g + 12.5, TROJCA_WHITE, M_MONUMENT, TROJCA_WHITE.darkened(0.1))
		_lbox(back + 2.2, 0.0, 2.2, 6.8, g - 0.5, g + 0.6, TROJCA_PLINTH, M_STONE, TROJCA_PLINTH.lightened(0.1))
		for v: float in [-4.6, -1.55, 1.55, 4.6]:
			_column(face - 1.0, v, 0.55, g + 0.6, g + 10.7, TROJCA_WHITE)
		_lbox(back + 2.25, 0.0, 2.25, 6.6, g + 10.7, g + 12.5, light, M_STONE, TROJCA_WHITE.darkened(0.1))
		_gable(face + 0.05, r - 2.0, 0.0, 6.7, g + 12.5, 3.4, TROJCA_WHITE, TROJCA_COPPER_DARK, false)
		var arm_ring := _rect((r - 2.0 + face) * 0.5, 0.0, (face - r + 2.0) * 0.5, 6.8)
		var merged := Geometry2D.merge_polygons(ring, arm_ring)
		if not merged.is_empty():
			ring = _largest(merged)
	_collide(ring)


## A column on a local spot: a square plinth, an octagonal shaft and a square capital (Tuscan).
func _column(cu: float, cv: float, r: float, y0: float, y1: float, col: Color) -> void:
	var none := Color(0, 0, 0, 0)
	var base := minf(0.45, (y1 - y0) * 0.05)
	_prism(_rect(cu, cv, r * 1.35, r * 1.35), y0, y0 + base, col.darkened(0.04), col.darkened(0.08), M_STONE, M_STONE)
	_prism(_circle(_w(cu, cv), r, 8), y0 + base, y1 - base, col, none, M_STONE)
	_prism(_rect(cu, cv, r * 1.4, r * 1.4), y1 - base, y1, col.lightened(0.05), none, M_STONE)


## A gable in the local frame: the pediment's triangle on the plane u = uf (facing away from
## ub), from v = cv - hv to cv + hv, base y, apex y + h, and its two roof slopes back to u = ub,
## closed there by a second triangle when `back` (none when it ends inside a wall).
func _gable(uf: float, ub: float, cv: float, hv: float, y: float, h: float, face: Color, roof: Color, back := true) -> void:
	var keep := _mode
	_mode = M_STONE
	var s := signf(uf - ub)
	var at := func(u: float, v: float, yy: float) -> Vector3:
		var p := _w(u, v)
		return Vector3(p.x, yy, p.y)
	var front := Vector3(_a.x * s, 0.0, _a.y * s)
	var top := y + h - _g
	var y0 := y - _g
	var l: Vector3 = at.call(uf, cv - hv, y)
	var rr: Vector3 = at.call(uf, cv + hv, y)
	var apex: Vector3 = at.call(uf, cv, y + h)
	var lb: Vector3 = at.call(ub, cv - hv, y)
	var rb: Vector3 = at.call(ub, cv + hv, y)
	var apex_b: Vector3 = at.call(ub, cv, y + h)
	_tri(l, rr, apex, front, face, Vector2(0, y0), Vector2(hv * 2.0, y0), Vector2(hv, top), top)
	if back:
		_tri(lb, rb, apex_b, -front, face, Vector2(0, y0), Vector2(hv * 2.0, y0), Vector2(hv, top), top)
	for side: float in [-1.0, 1.0]:
		var e: Vector3 = l if side < 0.0 else rr
		var eb: Vector3 = lb if side < 0.0 else rb
		var n := (Vector3(_b.x, 0.0, _b.y) * side * h + Vector3.UP * hv).normalized()
		_quad(e, eb, apex_b, apex, n, roof)
	_mode = keep


## A flat round (n-sided) disc at c facing n: an oculus, a clock face.
func _disc(c: Vector3, n: Vector3, r: float, sides: int, col: Color) -> void:
	var side := Vector3.UP.cross(n).normalized()
	var top := c.y + r - _g
	for k in sides:
		var a0 := TAU * k / sides
		var a1 := TAU * (k + 1) / sides
		var p0 := c + (side * cos(a0) + Vector3.UP * sin(a0)) * r
		var p1 := c + (side * cos(a1) + Vector3.UP * sin(a1)) * r
		_tri(c, p0, p1, n, col, Vector2(r, c.y - _g), Vector2(r + cos(a0) * r, p0.y - _g),
				Vector2(r + cos(a1) * r, p1.y - _g), top)


## A hipped roof over a local rectangle: from the eaves at y up `rise` to a ridge along the
## longer side.
func _hip(cu: float, cv: float, hu: float, hv: float, y: float, rise: float, col: Color) -> void:
	var keep := _mode
	_mode = M_STONE
	var short := minf(hu, hv) - 0.15
	_frustum(_rect(cu, cv, hu, hv), y, _rect(cu, cv, hu - short, hv - short), y + rise, col, col.darkened(0.06))
	_mode = keep


## Zachęta (Stefan Szyller, 1898-1900): the white gallery on Plac Małachowskiego, its front to the
## east. A rusticated ground floor over a basement band, the upper floor of tall windows, a cornice
## and a balustrade; the end pavilions stand forward under acroteria; in the middle two pylons
## frame two giant columns before three doors, the attic with ARTIBVS over them and a pediment
## full of sculpture; steps between two candelabra. Behind, the top-lit halls under glass.
## Frame: u along the front from its north end (u < 0) to the church's side, +v out of the front.
const ZACHETA := Vector2(-833.4, -593.3)
const ZACHETA_AXIS := Vector2(0.3339, 0.9426)
const ZACHETA_BACK := -45.0
const ZACHETA_HU := Vector2(-24.0, 23.0)   # the front's ends (u)
const ZACHETA_WIN := [-20.4, -17.0, -13.4, -9.8, 9.8, 13.4, 17.0, 20.4]
const ZACHETA_DOORS := [-4.2, 0.0, 4.1]
const ZACHETA_WHITE := Color("#ebeae4")
const ZACHETA_BASE := Color("#d4d3cd")
const ZACHETA_COLUMN := Color("#b9bab5")
const ZACHETA_GLASS := Color("#3d4850")
const ZACHETA_DOOR := Color("#4a3328")
const ZACHETA_ROOF := Color("#8d9092")
const ZACHETA_SKY := Color("#9fb0b8")
const ZACHETA_SCULPT := Color("#f4f3ee")
const ZACHETA_IRON := Color("#2f3331")


func _find_zacheta() -> void:
	var outline := _landmark("Zachęta")
	if outline.size() >= 3:
		_add_site("zacheta", [outline])
		if not sites.is_empty() and sites[-1]["key"] == "zacheta":
			sites[-1]["ring"] = outline


func _build_zacheta(site: Dictionary) -> void:
	_o = ZACHETA
	_a = ZACHETA_AXIS.normalized()
	_b = Vector2(_a.y, -_a.x)
	var u0 := ZACHETA_HU.x
	var u1 := ZACHETA_HU.y
	var body := _rect((u0 + u1) * 0.5, ZACHETA_BACK * 0.5, (u1 - u0) * 0.5, -ZACHETA_BACK * 0.5)
	_g = _ground_under(body)
	var g := _g
	var none := Color(0, 0, 0, 0)
	var light := ZACHETA_WHITE.lightened(0.05)
	# windows and doors first, so the walls behind them stay whole (they stand 7 cm proud)
	_mode = M_GLASS
	for u: float in ZACHETA_WIN:
		# the outer pair sit in the end pavilions, which stand 0.5 m forward
		var f := 0.57 if absf(u) > 20.0 else 0.07
		_wall(_w(u - 0.75, f), _w(u + 0.75, f), g + 4.2, g + 7.2, _b, ZACHETA_GLASS)
		_wall(_w(u - 0.8, f), _w(u + 0.8, f), g + 9.6, g + 13.0, _b, ZACHETA_GLASS)
		_wall(_w(u - 0.55, f), _w(u + 0.55, f), g + 0.7, g + 1.9, _b, ZACHETA_GLASS)
	for u: float in ZACHETA_DOORS:
		_wall(_w(u - 0.8, 0.07), _w(u + 0.8, 0.07), g + 9.6, g + 13.0, _b, ZACHETA_GLASS)
	_mode = M_STONE
	for u: float in ZACHETA_DOORS:
		_wall(_w(u - 0.95, 0.07), _w(u + 0.95, 0.07), g + 1.8, g + 6.8, _b, ZACHETA_DOOR)
	# body: the front in plain stone (its windows are its own), the other faces in M_MONUMENT
	var corners := [_w(u0, ZACHETA_BACK), _w(u1, ZACHETA_BACK), _w(u1, 0.0), _w(u0, 0.0)]
	var outs := [-_b, _a, _b, -_a]
	for i in 4:
		var a: Vector2 = corners[i]
		var b: Vector2 = corners[(i + 1) % 4]
		_wall(a, b, g - 0.5, g + 3.0, outs[i], ZACHETA_BASE.darkened(0.06))
		_wall(a, b, g + 3.0, g + 8.2, outs[i], ZACHETA_BASE)
		_mode = M_STONE if i == 2 else M_MONUMENT
		_wall(a, b, g + 8.2, g + 15.3, outs[i], ZACHETA_WHITE)
		_mode = M_STONE
	var band := _largest(Geometry2D.offset_polygon(body, 0.18, Geometry2D.JOIN_MITER))
	_prism(band, g + 8.2, g + 8.8, light, light, M_STONE, M_STONE)
	var eave := _largest(Geometry2D.offset_polygon(body, 0.5, Geometry2D.JOIN_MITER))
	_prism(eave, g + 14.6, g + 15.3, light, ZACHETA_ROOF, M_STONE, M_STONE)
	_parapet(body, g + 15.3, 1.3, ZACHETA_WHITE)
	# end pavilions: forward 0.5 m, an attic, an acroterion
	for p: Vector2 in [Vector2(u0 + 2.9, 0.0), Vector2(u1 - 2.9, 0.0)]:
		_lbox(p.x, 0.25, 2.9, 0.25, g - 0.5, g + 3.0, ZACHETA_BASE.darkened(0.06), M_STONE, ZACHETA_BASE)
		_lbox(p.x, 0.25, 2.9, 0.25, g + 3.0, g + 15.3, ZACHETA_WHITE, M_STONE, light)
		_lbox(p.x, -0.6, 2.4, 1.1, g + 15.3, g + 17.4, ZACHETA_WHITE, M_STONE, light)
		_pyramid(_rect(p.x, -0.6, 1.0, 0.7), g + 17.4, g + 19.2, ZACHETA_SCULPT)
	# pylons, columns on pedestals, the entablature, the ARTIBVS attic, the pediment
	for s: float in [-1.0, 1.0]:
		_lbox(s * 7.0, 0.6, 1.6, 0.6, g - 0.5, g + 17.0, ZACHETA_WHITE, M_STONE, light)
		_lbox(s * 2.2, 1.6, 0.9, 0.9, g - 0.5, g + 3.4, ZACHETA_BASE, M_STONE, ZACHETA_BASE.lightened(0.05))
		_column(s * 2.2, 1.6, 0.62, g + 3.4, g + 15.2, ZACHETA_COLUMN)
		# a candelabrum on its pedestal before each pylon
		_lbox(s * 7.0, 3.0, 0.7, 0.7, g - 0.5, g + 2.2, ZACHETA_BASE, M_STONE, ZACHETA_BASE)
		_lbox(s * 7.0, 3.0, 0.14, 0.14, g + 2.2, g + 5.6, ZACHETA_IRON, M_STONE, ZACHETA_IRON)
		_lbox(s * 7.0, 3.0, 0.7, 0.12, g + 5.0, g + 5.2, ZACHETA_IRON, M_STONE, ZACHETA_IRON)
		for k: float in [-0.7, 0.0, 0.7]:
			_mode = M_LAMP
			_prism(_rect(s * 7.0 + k, 3.0, 0.16, 0.16), g + 5.2 if k != 0.0 else g + 5.6, g + 5.6 if k != 0.0 else g + 6.0,
					Color("#f3e3b0"), Color("#f3e3b0"), M_LAMP, M_LAMP)
			_mode = M_STONE
	_lbox(0.0, 1.0, 8.6, 1.5, g + 15.2, g + 16.4, light, M_STONE, light)
	_lbox(0.0, 0.9, 8.6, 1.3, g + 16.4, g + 18.4, ZACHETA_WHITE, M_STONE, light)
	_lbox(0.0, 1.0, 9.6, 1.5, g + 18.4, g + 18.8, light, M_STONE, light)
	var keep_a := _a
	var keep_b := _b
	# The pediment faces +v: swap the frame so _gable's u runs out of the front.
	_a = keep_b
	_b = -keep_a
	_gable(2.5, -6.0, 0.0, 9.6, g + 18.8, 4.2, ZACHETA_WHITE, ZACHETA_ROOF)
	_a = keep_a
	_b = keep_b
	# the tympanum's sculpture: a tall group in the middle, lower groups to the corners
	for grp: Array in [[0.0, 1.3, 3.1], [-2.8, 1.2, 1.9], [2.8, 1.2, 1.9], [-5.6, 1.1, 0.9], [5.6, 1.1, 0.9]]:
		_lbox(grp[0], 2.65, grp[1], 0.2, g + 18.8, g + 18.8 + float(grp[2]), ZACHETA_SCULPT, M_STONE, ZACHETA_SCULPT)
	_beam(Vector3(_w(-9.8, 2.85).x, g + 18.75, _w(-9.8, 2.85).y), Vector3(_w(0.0, 2.85).x, g + 23.1, _w(0.0, 2.85).y), 0.45, light)
	# (the right one 6 cm further out: the two meet at the apex, and coplanar faces flicker)
	_beam(Vector3(_w(9.8, 2.91).x, g + 18.75, _w(9.8, 2.91).y), Vector3(_w(0.0, 2.91).x, g + 23.1, _w(0.0, 2.91).y), 0.45, light)
	# steps
	for k in 4:
		_lbox(0.0, (4.0 - k) * 0.5, 6.0, (4.0 - k) * 0.5, g - 0.5, g + 0.45 * (k + 1), ZACHETA_BASE, M_STONE,
				ZACHETA_BASE.lightened(0.04))
	# the halls behind: a raised block and its glass roof
	_lbox(-1.0, -22.0, 10.0, 14.0, g + 15.3, g + 19.0, ZACHETA_WHITE, M_STONE, none)
	_mode = M_GLASS_ROOF
	_frustum(_rect(-1.0, -22.0, 10.0, 14.0), g + 19.0, _rect(-1.0, -22.0, 0.3, 4.3), g + 23.8, ZACHETA_SKY, ZACHETA_SKY)
	_mode = M_STONE
	_collide(site["ring"])
	# the steps, the columns and the candelabra stand in front of the mapped outline
	_collide(_rect(0.0, 2.0, 7.8, 2.0))
	for s: float in [-1.0, 1.0]:
		_collide(_rect(s * 7.0, 3.0, 0.7, 0.7))



## Hala Mirowska (Stefan Szyller and Czesław Domaniewski, 1899-1901), the western of the twin
## market halls on Plac Mirowski: a red-brick hall, 97 x 44 m, its main front to the east, to the
## square. Massing from the mapped parts (spec docs/landmarks/specs/mirowska.md): brick walls 10 m
## high round the whole hall with round-headed windows between cream pilasters, a cornice, the
## nave's gabled roof (ridge 14.5 m) with a glazed lantern on top (17 m), thin tall gable ends
## (18 m, a pinnacle each) between four corner turrets with pyramid caps, and a low arcaded
## annex at the west end under a steep red tile roof (10 m). Frame: origin at the south-west
## corner, u east along the long side, +v to the north across the hall.
const MIROWSKA := Vector2(-1857.4, -501.8)
const MIROWSKA_AXIS := Vector2(0.970, -0.242)
const MIROWSKA_HU := 97.4
const MIROWSKA_HV := 43.6
const MIROWSKA_BRICK := Color("#a85c40")
const MIROWSKA_TRIM := Color("#d6ccb4")
const MIROWSKA_PLINTH := Color("#857e74")
const MIROWSKA_ROOF := Color("#6d7470")
const MIROWSKA_NAVE := Color("#8b948f")
const MIROWSKA_CAP := Color("#6f7f78")
const MIROWSKA_TILE := Color("#a8493a")
const MIROWSKA_GLASS := Color("#323a40")
const MIROWSKA_DOOR := Color("#33271f")
const MIROWSKA_SKY := Color("#a9bcc4")
## The market stalls' awnings on the square (2026-11-01).
const MIROWSKA_AWNINGS := ["#c8553a", "#3f7fa8", "#d6a53a", "#5c9a5a", "#b8607a"]


func _find_mirowska() -> void:
	var outline := _landmark("Hala Mirowska")
	if outline.size() >= 3:
		_add_site("mirowska", [outline])
		if not sites.is_empty() and sites[-1]["key"] == "mirowska":
			sites[-1]["ring"] = outline


## A round-headed panel on a wall: a rectangle up to the spring line and a four-segment half
## disc above it. `at` is the foot centre in plan, `along` the wall's direction, `out` its
## outward normal, `proud` how far it stands off the wall (against z-fighting).
func _arch_panel(at: Vector2, along: Vector2, out: Vector2, hw: float, y0: float, spring: float, col: Color,
		proud: float, mode: float) -> void:
	var keep := _mode
	_mode = mode
	var p := at + out * proud
	_wall(p - along * hw, p + along * hw, y0, spring, out, col)
	var n := Vector3(out.x, 0.0, out.y)
	var t := Vector3(along.x, 0.0, along.y)
	var c := Vector3(p.x, spring, p.y)
	var top := spring + hw - _g
	var prev := c + t * hw
	for k in range(1, 5):
		var ang := PI * k / 4.0
		var q := c + (t * cos(ang) + Vector3.UP * sin(ang)) * hw
		var a0 := PI * (k - 1) / 4.0
		_tri(c, prev, q, n, col, Vector2(hw, spring - _g),
				Vector2(hw + cos(a0) * hw, spring - _g + sin(a0) * hw),
				Vector2(hw + cos(ang) * hw, spring - _g + sin(ang) * hw), top)
		prev = q
	_mode = keep


## A round-headed window: a cream surround behind a dark glass pane.
func _arch_win(at: Vector2, along: Vector2, out: Vector2, hw: float, y0: float, spring: float,
		glass := MIROWSKA_GLASS) -> void:
	_arch_panel(at, along, out, hw + 0.3, y0 - 0.25, spring, MIROWSKA_TRIM, 0.04, M_STONE)
	_arch_panel(at, along, out, hw, y0, spring, glass, 0.08, M_GLASS)


func _build_mirowska(site: Dictionary) -> void:
	_o = MIROWSKA
	_a = MIROWSKA_AXIS.normalized()
	_b = Vector2(_a.y, -_a.x)  # to the north, across the hall
	var hu := MIROWSKA_HU
	var hv := MIROWSKA_HV
	var body := _rect(hu * 0.5, hv * 0.5, hu * 0.5, hv * 0.5)
	_g = _ground_under(body)
	var g := _g
	var none := Color(0, 0, 0, 0)
	var nave_v := hv * 0.5
	var nave_hw := 13.3
	var bay := (85.4 - 12.5) / 16.0
	# windows first, so the walls behind them stay whole (they stand off the wall by cm)
	for side in 2:
		var v := 0.0 if side == 0 else hv
		var out := -_b if side == 0 else _b
		for k in 18:
			_arch_win(_w(12.5 + (k + 0.5) * bay, v), _a, out, 1.15, g + 2.4, g + 6.6)
		for u: float in [4.2, 8.6]:  # the annex's arcade on its long sides
			_arch_win(_w(u, v), _a, out, 0.75, g + 1.1, g + 2.6)
	# the east front: a portal in the middle bay between six windows
	var pitch := hv / 7.0
	for k in 7:
		var v := (k + 0.5) * pitch
		if k == 3:
			_arch_win(_w(hu, v), _b, _a, 1.7, g + 1.3, g + 5.6, MIROWSKA_DOOR)
		else:
			_arch_win(_w(hu, v), _b, _a, 1.3, g + 2.4, g + 6.6)
	# the west face: the arcade of the annex
	for k in 8:
		_arch_win(_w(0.0, (k + 0.5) * hv / 8.0), _b, -_a, 0.8, g + 1.1, g + 2.6)
	# the thin tall gable ends: a big window in each
	_arch_win(_w(90.1, nave_v), _b, _a, 1.8, g + 11.0, g + 13.8)
	_arch_win(_w(7.7, nave_v), _b, -_a, 1.8, g + 11.0, g + 13.8)
	# the walls: brick, 10 m, flat grey roof (the nave stands on it)
	_mode = M_STONE
	var main := _rect((12.5 + hu) * 0.5, hv * 0.5, (hu - 12.5) * 0.5, hv * 0.5)
	_prism(main, g - 0.5, g + 10.0, MIROWSKA_BRICK, MIROWSKA_ROOF, M_STONE, M_STONE)
	# the annex: low brick walls under a steep red hipped roof
	_prism(_rect(6.25, hv * 0.5, 6.25, hv * 0.5), g - 0.5, g + 4.0, MIROWSKA_BRICK, none, M_STONE, M_STONE)
	_hip(6.25, hv * 0.5, 6.4, hv * 0.5 + 0.15, g + 4.0, 6.0, MIROWSKA_TILE)
	# plinth: four thin boxes round the foot
	_lbox(hu * 0.5, -0.1, hu * 0.5 + 0.2, 0.2, g - 0.5, g + 1.2, MIROWSKA_PLINTH, M_STONE, MIROWSKA_PLINTH.lightened(0.05))
	_lbox(hu * 0.5, hv + 0.1, hu * 0.5 + 0.2, 0.2, g - 0.5, g + 1.2, MIROWSKA_PLINTH, M_STONE, MIROWSKA_PLINTH.lightened(0.05))
	_lbox(hu + 0.1, hv * 0.5, 0.2, hv * 0.5 - 0.2, g - 0.5, g + 1.2, MIROWSKA_PLINTH, M_STONE, MIROWSKA_PLINTH.lightened(0.05))
	_lbox(-0.1, hv * 0.5, 0.2, hv * 0.5 - 0.2, g - 0.5, g + 1.2, MIROWSKA_PLINTH, M_STONE, MIROWSKA_PLINTH.lightened(0.05))
	# the cornice along the main block's three outer sides
	_lbox((12.5 + hu) * 0.5, -0.17, (hu - 12.5) * 0.5 + 0.35, 0.35, g + 9.0, g + 10.0, MIROWSKA_TRIM, M_STONE, MIROWSKA_TRIM)
	_lbox((12.5 + hu) * 0.5, hv + 0.17, (hu - 12.5) * 0.5 + 0.35, 0.35, g + 9.0, g + 10.0, MIROWSKA_TRIM, M_STONE, MIROWSKA_TRIM)
	_lbox(hu + 0.17, hv * 0.5, 0.35, hv * 0.5 - 0.35, g + 9.0, g + 10.0, MIROWSKA_TRIM, M_STONE, MIROWSKA_TRIM)
	# pilasters between the bays: along both long sides and across the east front
	var pil: Array[float] = []
	for k in 17:
		pil.append(12.5 + k * bay)
	pil.append_array([90.0, 94.5, hu - 0.25])
	for u: float in pil:
		_lbox(u, -0.15, 0.25, 0.15, g + 1.2, g + 9.0, MIROWSKA_TRIM, M_STONE, MIROWSKA_TRIM)
		_lbox(u, hv + 0.15, 0.25, 0.15, g + 1.2, g + 9.0, MIROWSKA_TRIM, M_STONE, MIROWSKA_TRIM)
	for k in 8:
		var v := clampf(k * pitch, 0.25, hv - 0.25)
		_lbox(hu + 0.15, v, 0.15, 0.25, g + 1.2, g + 9.0, MIROWSKA_TRIM, M_STONE, MIROWSKA_TRIM)
	# the glazed gallery on the east front (photo 2026-11-07, `warsaw-needed-photos`): a dark glass
	# band across the front over the market's ground floor, under a thin dark fascia
	_lbox(hu + 0.9, nave_v, 0.9, hv * 0.5 - 3.0, g + 3.6, g + 8.8, MIROWSKA_GLASS, M_GLASS, none)
	_lbox(hu + 0.95, nave_v, 1.0, hv * 0.5 - 2.9, g + 8.8, g + 9.5, Color("#4b2e29"), M_STONE, Color("#5a3a33"))
	# the portal's steps
	for k in 3:
		_lbox(hu + 0.4 + (2 - k) * 0.4, nave_v, 0.4 + (2 - k) * 0.4, 2.6, g - 0.5, g + 0.4 * (k + 1), MIROWSKA_PLINTH, M_STONE,
				MIROWSKA_PLINTH.lightened(0.05))
	# the nave's gabled roof and its tall gable ends
	_gable(88.7, 9.1, nave_v, nave_hw, g + 10.0, 4.5, MIROWSKA_BRICK, MIROWSKA_NAVE)
	_gable(90.1, 88.7, nave_v, nave_hw, g + 10.0, 8.0, MIROWSKA_BRICK, MIROWSKA_TRIM)
	_gable(7.7, 9.1, nave_v, nave_hw, g + 10.0, 8.0, MIROWSKA_BRICK, MIROWSKA_TRIM)
	_pinnacle(89.4, nave_v, 0.9, g + 17.8, 2.2, MIROWSKA_TRIM)
	_pinnacle(8.4, nave_v, 0.9, g + 17.8, 2.2, MIROWSKA_TRIM)
	# four corner turrets with pyramid caps
	for cu: float in [10.1, 88.0]:
		for cv: float in [11.3, hv - 11.3]:
			_lbox(cu, cv, 2.5, 2.4, g + 10.0, g + 14.4, MIROWSKA_BRICK, M_STONE, none)
			_lbox(cu, cv, 2.65, 2.55, g + 14.2, g + 15.0, MIROWSKA_TRIM, M_STONE, MIROWSKA_TRIM)
			_mode = M_STONE
			_pyramid(_rect(cu, cv, 2.7, 2.6), g + 15.0, g + 18.8, MIROWSKA_CAP)
	# the lantern along the ridge: glass sides on the slope, a glass roof
	_lbox(49.45, nave_v, 31.05, 5.5, g + 12.4, g + 16.0, MIROWSKA_SKY, M_GLASS, none)
	_mode = M_GLASS_ROOF
	_frustum(_rect(49.45, nave_v, 31.05, 5.5), g + 16.0, _rect(49.45, nave_v, 31.05, 0.3), g + 17.4, MIROWSKA_SKY, MIROWSKA_SKY)
	_mode = M_STONE
	# the market on the square (2026-11-01): ten trestle stalls under striped awnings in a row
	# along the east front, a lane's width off the wall, a bench-high counter and a thin awning
	# on each, in the stalls' mixed colours
	for k in 10:
		var sv := 3.4 + k * 4.1
		var cl := Color(MIROWSKA_AWNINGS[k % MIROWSKA_AWNINGS.size()])
		_lbox(hu + 5.0, sv, 0.8, 1.1, g + 0.0, g + 0.95, MIROWSKA_PLINTH.darkened(0.1), M_STONE, MIROWSKA_TRIM)
		_lbox(hu + 5.0, sv, 1.0, 1.4, g + 2.2, g + 2.32, cl, M_STONE, cl.lightened(0.1))
		for pv: float in [-1.2, 1.2]:
			_lbox(hu + 5.9, sv + pv, 0.05, 0.05, g, g + 2.2, Color("#4a4d52"), M_STONE)
	_collide(site["ring"])


## Hala Gwardii (Stefan Szyller and Czesław Domaniewski, 1899-1901), the eastern twin of Hala
## Mirowska on the other side of Plac Mirowski, 96.8 x 44.1 m, long axis the same as its twin's.
## OSM maps only the outline (no 3D parts) but maps it down to the pilasters, so the bays here are
## measured from it (spec docs/landmarks/specs/gwardii.md): the hall is symmetric end to end, a
## portal in the middle of both short ends, 15 pilasters on each long side. It reuses Mirowska's
## helpers, colours and massing (nave, lantern, gable ends, turrets) and drops the annex.
## Frame: origin at the south-west corner, u east along the long side, +v to the north.
const GWARDII := Vector2(-1712.77, -537.24)
const GWARDII_HU := 96.8
const GWARDII_HV := 44.1
## Pilaster centres along a long side, from the west end to the middle; the east half mirrors them.
const GWARDII_PILASTERS: Array[float] = [1.0, 7.5, 11.1, 18.3, 24.95, 31.65, 38.25, 45.1]
## Window centres along a long side, west half; the east half mirrors them, plus one at the middle.
const GWARDII_BAYS: Array[float] = [14.7, 21.6, 28.3, 35.0, 41.7]
## Pilaster centres across a short end, from the south to the middle; the north half mirrors them.
const GWARDII_END_PILASTERS: Array[float] = [1.0, 7.4, 18.1]


func _find_gwardii() -> void:
	var outline := _landmark("Hala Gwardii")
	if outline.size() >= 3:
		_add_site("gwardii", [outline])
		if not sites.is_empty() and sites[-1]["key"] == "gwardii":
			sites[-1]["ring"] = outline


func _build_gwardii(site: Dictionary) -> void:
	_o = GWARDII
	_a = MIROWSKA_AXIS.normalized()
	_b = Vector2(_a.y, -_a.x)  # to the north, across the hall
	var hu := GWARDII_HU
	var hv := GWARDII_HV
	var body := _rect(hu * 0.5, hv * 0.5, hu * 0.5, hv * 0.5)
	_g = _ground_under(body)
	var g := _g
	var none := Color(0, 0, 0, 0)
	var nave_v := hv * 0.5
	var nave_hw := 13.3
	var mid := hu * 0.5
	# window and pilaster positions along a long side, mirrored about the middle
	var wins: Array[float] = []
	for u in GWARDII_BAYS:
		wins.append(u)
		wins.append(hu - u)
	wins.append(mid)
	var pils: Array[float] = []
	for u in GWARDII_PILASTERS:
		pils.append(u)
		pils.append(hu - u)
	var end_pils: Array[float] = []
	for v in GWARDII_END_PILASTERS:
		end_pils.append(v)
		end_pils.append(hv - v)
	# windows first, so the walls behind them stay whole (they stand off the wall by cm)
	for side in 2:
		var v := 0.0 if side == 0 else hv
		var out := -_b if side == 0 else _b
		for u in wins:
			_arch_win(_w(u, v), _a, out, 1.15, g + 2.4, g + 6.6)
		for u: float in [4.25, hu - 4.25]:  # the corner bays are narrower
			_arch_win(_w(u, v), _a, out, 0.9, g + 2.4, g + 6.6)
	# both short ends: a portal in the middle bay between two windows each side
	for end in 2:
		var u := 0.0 if end == 0 else hu
		var out := -_a if end == 0 else _a
		for cv: float in [4.2, 12.75, 31.35, hv - 4.2]:
			var small := cv < 6.0 or cv > hv - 6.0
			_arch_win(_w(u, cv), _b, out, 0.9 if small else 1.3, g + 2.4, g + 6.6)
		_arch_win(_w(u, nave_v), _b, out, 1.7, g + 1.3, g + 5.6, MIROWSKA_DOOR)
	# the thin tall gable ends: a big window in each
	_arch_win(_w(89.1, nave_v), _b, _a, 1.8, g + 11.0, g + 13.8)
	_arch_win(_w(7.7, nave_v), _b, -_a, 1.8, g + 11.0, g + 13.8)
	# the walls: brick, 10 m, flat grey roof (the nave stands on it)
	_mode = M_STONE
	_prism(body, g - 0.5, g + 10.0, MIROWSKA_BRICK, MIROWSKA_ROOF, M_STONE, M_STONE)
	# plinth: four thin boxes round the foot
	_lbox(mid, -0.1, mid + 0.2, 0.2, g - 0.5, g + 1.2, MIROWSKA_PLINTH, M_STONE, MIROWSKA_PLINTH.lightened(0.05))
	_lbox(mid, hv + 0.1, mid + 0.2, 0.2, g - 0.5, g + 1.2, MIROWSKA_PLINTH, M_STONE, MIROWSKA_PLINTH.lightened(0.05))
	_lbox(hu + 0.1, nave_v, 0.2, nave_v - 0.2, g - 0.5, g + 1.2, MIROWSKA_PLINTH, M_STONE, MIROWSKA_PLINTH.lightened(0.05))
	_lbox(-0.1, nave_v, 0.2, nave_v - 0.2, g - 0.5, g + 1.2, MIROWSKA_PLINTH, M_STONE, MIROWSKA_PLINTH.lightened(0.05))
	# the cornice round all four sides
	_lbox(mid, -0.17, mid + 0.35, 0.35, g + 9.0, g + 10.0, MIROWSKA_TRIM, M_STONE, MIROWSKA_TRIM)
	_lbox(mid, hv + 0.17, mid + 0.35, 0.35, g + 9.0, g + 10.0, MIROWSKA_TRIM, M_STONE, MIROWSKA_TRIM)
	_lbox(hu + 0.17, nave_v, 0.35, nave_v - 0.35, g + 9.0, g + 10.0, MIROWSKA_TRIM, M_STONE, MIROWSKA_TRIM)
	_lbox(-0.17, nave_v, 0.35, nave_v - 0.35, g + 9.0, g + 10.0, MIROWSKA_TRIM, M_STONE, MIROWSKA_TRIM)
	# pilasters between the bays (the outline's own jogs): both long sides and both ends
	for u in pils:
		_lbox(u, -0.15, 0.6, 0.15, g + 1.2, g + 9.0, MIROWSKA_TRIM, M_STONE, MIROWSKA_TRIM)
		_lbox(u, hv + 0.15, 0.6, 0.15, g + 1.2, g + 9.0, MIROWSKA_TRIM, M_STONE, MIROWSKA_TRIM)
	for v in end_pils:
		_lbox(-0.15, v, 0.15, 0.6, g + 1.2, g + 9.0, MIROWSKA_TRIM, M_STONE, MIROWSKA_TRIM)
		_lbox(hu + 0.15, v, 0.15, 0.6, g + 1.2, g + 9.0, MIROWSKA_TRIM, M_STONE, MIROWSKA_TRIM)
	# the portals' steps, both ends
	for k in 3:
		var e := 0.4 + (2 - k) * 0.4
		_lbox(hu + e, nave_v, e, 2.6, g - 0.5, g + 0.4 * (k + 1), MIROWSKA_PLINTH, M_STONE, MIROWSKA_PLINTH.lightened(0.05))
		_lbox(-e, nave_v, e, 2.6, g - 0.5, g + 0.4 * (k + 1), MIROWSKA_PLINTH, M_STONE, MIROWSKA_PLINTH.lightened(0.05))
	# the nave's gabled roof and its two tall gable ends
	_gable(87.7, 9.1, nave_v, nave_hw, g + 10.0, 4.5, MIROWSKA_BRICK, MIROWSKA_NAVE)
	_gable(89.1, 87.7, nave_v, nave_hw, g + 10.0, 8.0, MIROWSKA_BRICK, MIROWSKA_TRIM)
	_gable(7.7, 9.1, nave_v, nave_hw, g + 10.0, 8.0, MIROWSKA_BRICK, MIROWSKA_TRIM)
	_pinnacle(88.4, nave_v, 0.9, g + 17.8, 2.2, MIROWSKA_TRIM)
	_pinnacle(8.4, nave_v, 0.9, g + 17.8, 2.2, MIROWSKA_TRIM)
	# four corner turrets with pyramid caps
	for cu: float in [10.1, hu - 10.1]:
		for cv: float in [11.3, hv - 11.3]:
			_lbox(cu, cv, 2.5, 2.4, g + 10.0, g + 14.4, MIROWSKA_BRICK, M_STONE, none)
			_lbox(cu, cv, 2.65, 2.55, g + 14.2, g + 15.0, MIROWSKA_TRIM, M_STONE, MIROWSKA_TRIM)
			_mode = M_STONE
			_pyramid(_rect(cu, cv, 2.7, 2.6), g + 15.0, g + 18.8, MIROWSKA_CAP)
	# the lantern along the ridge: glass sides on the slope, a glass roof
	_lbox(mid, nave_v, 31.05, 5.5, g + 12.4, g + 16.0, MIROWSKA_SKY, M_GLASS, none)
	_mode = M_GLASS_ROOF
	_frustum(_rect(mid, nave_v, 31.05, 5.5), g + 16.0, _rect(mid, nave_v, 31.05, 0.3), g + 17.4, MIROWSKA_SKY, MIROWSKA_SKY)
	_mode = M_STONE
	_collide(site["ring"])


## Teatr Wielki (Antonio Corazzi, 1825-1833): the opera's mass stays LoD2's (a kept skin), and the
## model adds what LoD2 flattens, the front on Plac Teatralny: a high rusticated base with wide
## steps, the portico of eight Ionic columns under a heavy entablature and an attic crowned by a
## sculpture group. Spec docs/landmarks/specs/teatr.md.
## Frame: origin at the front's west end on the outline (the front runs 96.4 m), u along the
## front, +v out of it (south-east, to the square).
const TEATR := Vector2(-903.1, -952.5)
const TEATR_AXIS := Vector2(0.7956, -0.6058)
const TEATR_MID := 48.2
const TEATR_STONE := Color("#eee6d0")
const TEATR_BASE := Color("#cdc3a9")
const TEATR_COLUMN := Color("#f1ead7")
const TEATR_SCULPT := Color("#d9d2bf")
## Portico column centres across the front, u from the middle: eight.
const TEATR_COLS := [-11.9, -8.5, -5.1, -1.7, 1.7, 5.1, 8.5, 11.9]


## The Royal Castle (Zamek Królewski). Pass 1 kept LoD2's mass in its skin and added the stone
## plinth; pass 2 (2026-11-02, from 13 Commons photos and the GUGiK orthophoto, refs/zamek/ on the
## Mac) adds what makes it read as the castle: the Clock Tower's shaft with its cream quoins, the
## gate, the iron balcony, four clock dials, and its green copper helm with the lantern, a second
## onion and the spire; the two square corner turrets of the west front with their bulbous caps;
## the cream-white Vistula front over a rusticated ground floor with its cornice; the oval central
## risalit with its copper dome and gilt figures; and the row of tubbed ball trees on the terrace
## in front of it. Spec docs/landmarks/specs/zamek.md.
func _build_zamek(site: Dictionary) -> void:
	var ring: PackedVector2Array = site["zone"][0]
	if ring.size() < 3:
		return
	_o = Vector2.ZERO
	_a = Vector2(1, 0)
	_b = Vector2(0, 1)
	_mode = M_STONE
	var n := ring.size()
	for i in n:
		var p := ring[i]
		var q := ring[(i + 1) % n]
		var len := p.distance_to(q)
		if len < 0.5:
			continue
		var out := _out(ring, p, q)
		var steps := maxi(ceili(len / 6.0), 1)
		for k in steps:
			var a := p.lerp(q, float(k) / steps) + out * 0.7
			var b := p.lerp(q, float(k + 1) / steps) + out * 0.7
			_g = minf(map.terrain_height(a.x, a.y), map.terrain_height(b.x, b.y))
			_wall(a, b, _g - 1.0, _g + 2.2, out, ZAMEK_STONE, p.distance_to(a))
	_zamek_vistula(ring)
	_zamek_dome()
	_zamek_clock_tower()
	for c: Vector2 in ZAMEK_TURRETS:
		_zamek_turret(c)
	_zamek_tubs()


## Pass 2's colours (the photos' hues, calmed to the palette) and places (the orthophoto and the
## mapped parts, world x and z).
const ZAMEK_CREAM := Color("#e6dbc0")     # quoins, cornices, the gate's surround, the lantern
const ZAMEK_VISTULA := Color("#e9e1cf")   # the Vistula (Saxon) front, cream-white
const ZAMEK_RUSTIC := Color("#cbb6a6")    # its rusticated ground floor, pinkish grey
const ZAMEK_COPPER := Color("#6f9e86")    # the helms and the dome, green copper
const ZAMEK_GILT := Color("#d6b04c")
const ZAMEK_DIAL := Color("#1f2a3a")      # the clock faces: dark blue, gilt numerals
const ZAMEK_IRON := Color("#2b2a2a")
const ZAMEK_GATE := Color("#2f2a26")
## The Clock Tower (Wieża Zegarowa) in the middle of the west front, and the front's way north.
const ZAMEK_CLOCK := Vector2(-671.0, -1519.3)
const ZAMEK_FRONT := Vector2(0.0605, -0.9982)
## The square corner turrets at the two ends of the west front.
const ZAMEK_TURRETS := [Vector2(-675.0, -1476.7), Vector2(-669.6, -1565.7)]
## The courtyard (the ground the Vistula front's storeys count from) and that front's eave.
const ZAMEK_YARD := Vector2(-632.0, -1517.0)
const ZAMEK_EAVE := 17.0
## The oval central risalit: a drum standing 1.5 m out of the front, and its dome.
const ZAMEK_DOME := Vector2(-597.2, -1566.0)
const ZAMEK_DOME_R := 7.0
## The row of tubs on the terrace in front of the Vistula front, 7 m out, one every 4 m.
const ZAMEK_TUBS := [Vector2(-590.4, -1580.2), Vector2(-572.4, -1530.2)]


## The Vistula front: every edge of the outline facing east (x > -615): a rusticated ground floor
## and two storeys of windows in cream-white, 0.35 m proud of the skin, to the eave, under a
## cream cornice.
func _zamek_vistula(ring: PackedVector2Array) -> void:
	var yard: float = map.terrain_height(ZAMEK_YARD.x, ZAMEK_YARD.y)
	var top := yard + ZAMEK_EAVE
	var n := ring.size()
	var run := 0.0
	for i in n:
		var p := ring[i]
		var q := ring[(i + 1) % n]
		if p.distance_to(q) < 0.4:
			continue
		var out := _out(ring, p, q)
		if out.x < 0.55 or (p.x + q.x) * 0.5 < -615.0:
			continue
		var a := p + out * 0.35
		var b := q + out * 0.35
		var foot: float = minf(map.terrain_height(a.x, a.y), map.terrain_height(b.x, b.y))
		_g = yard
		_mode = M_MONUMENT
		_wall(a, b, minf(foot, yard) - 0.5, yard + 4.6, out, ZAMEK_RUSTIC, run)
		_wall(a, b, yard + 4.6, top, out, ZAMEK_VISTULA, run)
		_mode = M_STONE
		_wall(a + out * 0.05, b + out * 0.05, yard + 4.4, yard + 4.8, out, ZAMEK_CREAM, run)
		_wall(p + out * 0.75, q + out * 0.75, top - 0.2, top + 0.7, out, ZAMEK_CREAM, run)
		_ledge(a, b, p + out * 0.75, q + out * 0.75, top + 0.7, ZAMEK_CREAM)
		run += p.distance_to(q)


## A flat strip between two parallel segments (a cornice's top), through `_cap` so the strips of
## two edges meeting at a corner don't overlap (z-fight).
func _ledge(a: Vector2, b: Vector2, c: Vector2, d: Vector2, y: float, col: Color) -> void:
	var quad := PackedVector2Array([a, b, d, c])
	if Geometry2D.is_polygon_clockwise(quad):
		quad.reverse()
	_cap(quad, y, col)


## The Vistula front's edges of the castle's outline (the ones `_zamek_vistula` fronts: facing east,
## east of x -615), as pairs of ends, for the skin's `pale` walls (map_builder `_skin_run`): LoD2's
## walls stand up to 0.9 m proud of the outline there (5 m at the risalits) and showed salmon
## round and over the model's cream front (F's look check, 2026-11-03).
func _zamek_river_edges(ring: PackedVector2Array) -> PackedVector2Array:
	var out := PackedVector2Array()
	var n := ring.size()
	for i in n:
		var p := ring[i]
		var q := ring[(i + 1) % n]
		if p.distance_to(q) < 0.4:
			continue
		if _out(ring, p, q).x < 0.3 or (p.x + q.x) * 0.5 < -615.0:
			continue
		out.append(p)
		out.append(q)
	return out


## The Clock Tower's LoD2 cut under the model's cornice (`lod2_tops`): LoD2 carries the shaft 3.5 m
## past it and the helm as a salmon mass to 46.7 m, which stood out of the copper helm on every
## side (F's look check, 2026-11-03). The ring is the shaft's square grown to 6 m a side from its
## middle (LoD2's shaft is 4.5-4.7 m); the cut, 30.0 m over the square, hides inside the cornice
## (29.5-30.3 m, 5.0 m), whose top caps it.
func _zamek_tops() -> void:
	var a := ZAMEK_FRONT
	var b := Vector2(a.y, -a.x)
	var ring := PackedVector2Array()
	for c: Vector2 in [Vector2(-6, -6), Vector2(6, -6), Vector2(6, 6), Vector2(-6, 6)]:
		ring.append(ZAMEK_CLOCK + a * c.x + b * c.y)
	lod2_tops.append([ring, 30.0, ZAMEK_CLOCK + b * 9.0])


## The oval central risalit of the Vistula front: a drum of windows to above the eave, a cornice,
## a green copper dome with a lantern and a gilt ball, and three gilt figure groups on its rim.
func _zamek_dome() -> void:
	_o = Vector2.ZERO
	_a = Vector2(1, 0)
	_b = Vector2(0, 1)
	var yard: float = map.terrain_height(ZAMEK_YARD.x, ZAMEK_YARD.y)
	var top := yard + ZAMEK_EAVE
	_g = yard
	var c := ZAMEK_DOME
	var r := ZAMEK_DOME_R
	_prism(_circle(c, r, 12), yard - 0.5, top + 1.2, ZAMEK_VISTULA, Color(0, 0, 0, 0), M_MONUMENT)
	_prism(_circle(c, r + 0.4, 12), top + 1.2, top + 2.0, ZAMEK_CREAM, ZAMEK_CREAM, M_STONE, M_STONE)
	_mode = M_STONE
	var prof := [[r - 0.2, 2.0], [r - 0.8, 3.6], [r - 2.4, 5.4], [r - 4.6, 6.6], [1.0, 7.1]]
	for k in prof.size() - 1:
		_frustum(_circle(c, float(prof[k][0]), 12), top + float(prof[k][1]), _circle(c, float(prof[k + 1][0]), 12),
				top + float(prof[k + 1][1]), ZAMEK_COPPER.lightened(0.03 * k), ZAMEK_COPPER)
	_prism(_circle(c, 0.9, 6), top + 7.1, top + 8.6, ZAMEK_CREAM, Color(0, 0, 0, 0), M_STONE)
	_frustum(_circle(c, 1.1, 6), top + 8.6, _circle(c, 0.15, 6), top + 9.6, ZAMEK_COPPER)
	_prism(_circle(c + Vector2(0.0, 0.0), 0.35, 6), top + 9.6, top + 10.3, ZAMEK_GILT, ZAMEK_GILT, M_STONE, M_STONE)
	# the figure groups on the rim, facing the river
	var face := Vector2(0.93, -0.36)
	for turn: float in [-0.7, 0.0, 0.7]:
		var at := c + face.rotated(turn) * (r - 0.1)
		_prism(_square(at, 0.45), top + 2.0, top + 4.1, ZAMEK_GILT.darkened(0.08), ZAMEK_GILT, M_STONE, M_STONE)


## The Clock Tower: the shaft (0.3 m proud of the mapped one) with cream quoins and string
## courses, the gate to the courtyard, the iron balcony two thirds up, a dial on every face, the
## cornice with a gilt frieze, then the helm: the copper onion, the open lantern, a second onion,
## the spire with two gilt balls and a flag (56 m).
func _zamek_clock_tower() -> void:
	_o = ZAMEK_CLOCK
	_a = ZAMEK_FRONT
	_b = Vector2(_a.y, -_a.x)  # out of the front, west to Plac Zamkowy
	var sq := _w(0.0, 9.0)
	var g: float = map.terrain_height(sq.x, sq.y)
	_g = g
	var wall := Color(ZAMEK_WALL)
	var h := 4.6
	_lbox(0.0, 0.0, h, h, g - 0.6, g + 29.5, wall, M_MONUMENT, wall)
	for su: float in [-1.0, 1.0]:
		for sv: float in [-1.0, 1.0]:
			_lbox(su * h, sv * h, 0.45, 0.45, g + 0.3, g + 29.5, ZAMEK_CREAM, M_STONE, ZAMEK_CREAM)
	for y: float in [12.6, 19.0]:
		_lbox(0.0, 0.0, h + 0.2, h + 0.2, g + y, g + y + 0.45, ZAMEK_CREAM, M_STONE, ZAMEK_CREAM)
	# the gate: a cream rusticated surround, the dark passage
	_mode = M_STONE
	_wall(_w(-2.8, h + 0.05), _w(2.8, h + 0.05), g - 0.3, g + 6.4, _b, ZAMEK_CREAM)
	_wall(_w(-2.0, h + 0.1), _w(2.0, h + 0.1), g - 0.3, g + 5.0, _b, ZAMEK_GATE)
	_lbox(0.0, h + 0.15, 0.7, 0.15, g + 5.4, g + 6.2, ZAMEK_GILT, M_STONE, ZAMEK_GILT)
	# the balcony on the square's side
	_lbox(0.0, h + 0.7, 2.4, 0.7, g + 19.6, g + 19.85, ZAMEK_IRON, M_STONE, ZAMEK_IRON)
	_lbox(0.0, h + 1.38, 2.4, 0.02, g + 19.85, g + 20.8, ZAMEK_IRON, M_STONE, ZAMEK_IRON)
	# the dials, one on each face
	for f: Vector2 in [Vector2(0, 1), Vector2(0, -1), Vector2(1, 0), Vector2(-1, 0)]:
		var nrm := _a * f.x + _b * f.y
		_dial(_w(f.x * (h + 0.02), f.y * (h + 0.02)), g + 24.0, nrm, 1.7, ZAMEK_DIAL, ZAMEK_GILT)
	_lbox(0.0, 0.0, h + 0.4, h + 0.4, g + 29.5, g + 30.3, ZAMEK_CREAM, M_STONE, ZAMEK_CREAM)
	_lbox(0.0, 0.0, h + 0.15, h + 0.15, g + 30.3, g + 30.7, ZAMEK_GILT, M_STONE, ZAMEK_GILT)
	# the helm
	var c := ZAMEK_CLOCK
	_mode = M_STONE
	var prof := [[4.4, 30.7], [4.4, 32.0], [5.0, 33.6], [4.6, 35.2], [3.2, 37.0], [1.9, 38.4]]
	for k in prof.size() - 1:
		_frustum(_circle(c, float(prof[k][0]), 8), g + float(prof[k][1]), _circle(c, float(prof[k + 1][0]), 8),
				g + float(prof[k + 1][1]), ZAMEK_COPPER.lightened(0.03 * k), ZAMEK_COPPER)
	_prism(_circle(c, 1.8, 8), g + 38.4, g + 42.0, ZAMEK_CREAM, Color(0, 0, 0, 0), M_MONUMENT)
	_prism(_circle(c, 2.05, 8), g + 42.0, g + 42.4, ZAMEK_CREAM, ZAMEK_COPPER, M_STONE, M_STONE)
	_mode = M_STONE
	var cap := [[1.6, 42.4], [2.1, 43.4], [1.6, 44.6], [0.6, 45.8], [0.2, 46.4]]
	for k in cap.size() - 1:
		_frustum(_circle(c, float(cap[k][0]), 8), g + float(cap[k][1]), _circle(c, float(cap[k + 1][0]), 8),
				g + float(cap[k + 1][1]), ZAMEK_COPPER, ZAMEK_COPPER)
	_prism(_circle(c, 0.14, 4), g + 46.4, g + 55.6, ZAMEK_COPPER, ZAMEK_COPPER, M_STONE, M_STONE)
	for y: float in [49.6, 55.6]:
		_prism(_circle(c, 0.42, 6), g + y, g + y + 0.75, ZAMEK_GILT, ZAMEK_GILT, M_STONE, M_STONE)
	_wall(c + _a * 0.15, c + _a * 1.6, g + 53.6, g + 54.6, _b, ZAMEK_COPPER)
	_wall(c + _a * 1.6, c + _a * 0.15, g + 53.6, g + 54.6, -_b, ZAMEK_COPPER)
	_o = ZAMEK_CLOCK
	_collide(_rect(0.0, 0.0, h, h))


## A corner turret of the west front: a square shaft out of the roof with cream quoins, a
## cornice, a bulbous copper cap, a small open lantern, a cap and a spire with a gilt ball (31 m).
func _zamek_turret(c: Vector2) -> void:
	_o = c
	_a = ZAMEK_FRONT
	_b = Vector2(_a.y, -_a.x)
	var sq := _w(0.0, 7.0)
	var g: float = map.terrain_height(sq.x, sq.y)
	_g = g
	var wall := Color(ZAMEK_WALL)
	_lbox(0.0, 0.0, 2.25, 2.25, g - 0.5, g + 20.5, wall, M_MONUMENT, wall)  # from the ground, inside the mass
	for su: float in [-1.0, 1.0]:
		for sv: float in [-1.0, 1.0]:
			_lbox(su * 2.25, sv * 2.25, 0.3, 0.3, g + 11.0, g + 20.5, ZAMEK_CREAM, M_STONE, ZAMEK_CREAM)
	_lbox(0.0, 0.0, 2.55, 2.55, g + 20.5, g + 21.1, ZAMEK_CREAM, M_STONE, ZAMEK_CREAM)
	_mode = M_STONE
	var prof := [[2.1, 21.1], [2.6, 22.3], [2.2, 23.4], [1.2, 24.5], [0.75, 25.0]]
	for k in prof.size() - 1:
		_frustum(_circle(c, float(prof[k][0]), 8), g + float(prof[k][1]), _circle(c, float(prof[k + 1][0]), 8),
				g + float(prof[k + 1][1]), ZAMEK_COPPER.lightened(0.03 * k), ZAMEK_COPPER)
	_prism(_circle(c, 0.7, 6), g + 25.0, g + 26.6, ZAMEK_CREAM, Color(0, 0, 0, 0), M_STONE)
	_frustum(_circle(c, 0.9, 6), g + 26.6, _circle(c, 0.15, 6), g + 28.2, ZAMEK_COPPER)
	_prism(_circle(c, 0.08, 4), g + 28.2, g + 30.6, ZAMEK_COPPER, ZAMEK_COPPER, M_STONE, M_STONE)
	_prism(_circle(c, 0.3, 6), g + 29.2, g + 29.8, ZAMEK_GILT, ZAMEK_GILT, M_STONE, M_STONE)


## The tubs of the Upper Garden's terrace (Krajobraz's design: "a row of tubs with spherical trees
## marks the terrace edges"): one every 4 m along the Vistula front.
func _zamek_tubs() -> void:
	_o = Vector2.ZERO
	_a = Vector2(1, 0)
	_b = Vector2(0, 1)
	var a: Vector2 = ZAMEK_TUBS[0]
	var b: Vector2 = ZAMEK_TUBS[1]
	var n := maxi(int(a.distance_to(b) / 4.0), 1)
	for k in n + 1:
		var p := a.lerp(b, float(k) / n)
		_tub(p, float(map.terrain_height(p.x, p.y)), k)


## A garden tub with a ball-headed tree (a clipped maple on a bare stem): a painted barrel with a
## white rim, the stem, the ball.
const TUB_PAINT := [Color("#b8473a"), Color("#4c6b4a"), Color("#4c6b4a")]
const TUB_RIM := Color("#efece4")
const TUB_LEAF := Color("#4f7f36")
const TUB_BARK := Color("#5a4636")


func _tub(p: Vector2, g: float, k: int) -> void:
	_g = g
	var none := Color(0, 0, 0, 0)
	_prism(_square(p, 0.45), g, g + 0.6, TUB_PAINT[k % TUB_PAINT.size()], none, M_STONE)
	_prism(_square(p, 0.48), g + 0.6, g + 0.78, TUB_RIM, TUB_BARK, M_STONE, M_STONE)
	_prism(_square(p, 0.06), g + 0.78, g + 2.0, TUB_BARK, none, M_STONE)
	_mode = M_STONE
	_frustum(_circle(p, 0.35, 6), g + 1.9, _circle(p, 0.78, 6), g + 2.45, TUB_LEAF.darkened(0.08))
	_frustum(_circle(p, 0.78, 6), g + 2.45, _circle(p, 0.32, 6), g + 3.05, TUB_LEAF, TUB_LEAF.lightened(0.06))


# --- Arkady Kubickiego and the castle gardens ---------------------------------------------------

## Kubicki's Arcades (Jakub Kubicki, 1818-1821) under the castle's Vistula terrace, and the gardens
## Ogród Park Krajobraz restored on and below them (krajobraz.com.pl/projekt/zamek-krolewski: the
## Upper Garden on the arcades' vault, 2015; the Lower Garden down to Wisłostrada, 2019). The
## mapped building stood as a grey box; the model is the arcade wall facing the Lower Garden in
## terracotta plaster with cream-ringed round arches every 12 m, a cream cornice and an iron
## railing, the white stone portal block in the middle, and the Upper Garden's lawn on its top at
## the terrace's level; then tubbed ball trees along the terrace edge and white vases on pedestals
## round the Lower Garden's sunken lawn carpet (its grass is map_builder's LAWN_CARPETS). The
## gardens' hedges, paths and flowerbeds are the map's own; the fountains are park_details'.
## Spec docs/landmarks/specs/zamek.md "Gardens".
const ARK_PLASTER := Color("#c8693f")
const ARK_STONE := Color("#e4dfd2")
const ARK_LAWN := Color("#74a24c")
const ARK_DARK := Color("#3a2c26")
const ARK_GRAVEL := Color("#cfcbc0")
const ARK_WATER := Color("#5ea8d8")
## The Upper Garden's big fountain (a tulip bowl in a round basin), on the vault.
const ARK_FOUNTAIN := Vector2(-556.8, -1585.8)
## The portal block's middle (the mapped outline's bump on its east side).
const ARK_PORTAL := Vector2(-546.9, -1590.0)
## The Lower Garden's white vases, both long sides of the lawn carpet: on the round beds the map
## has there (map_builder draws their rings low, GARDEN_RINGS).
const ARK_VASES := [Vector2(-520.4, -1580.7), Vector2(-507.6, -1585.8), Vector2(-492.3, -1591.9),
		Vector2(-478.1, -1597.4), Vector2(-463.5, -1603.2), Vector2(-449.0, -1608.9), Vector2(-534.4, -1614.5),
		Vector2(-521.6, -1619.5), Vector2(-506.2, -1625.6), Vector2(-492.0, -1631.2), Vector2(-477.5, -1637.0),
		Vector2(-462.8, -1642.7)]
## Fountains on the ground (in the map's basin rings): the Upper Garden's small one by the castle
## and the one in the Lower Garden's west hedge quarter; centre, water radius.
const ARK_POOLS := [[Vector2(-585.5, -1574.5), 1.0], [Vector2(-537.5, -1656.4), 2.0]]
## The site's reach: the arcades and both gardens (the sectors build what lies in it).
const ARK_BOX := Rect2(-612.0, -1700.0, 162.0, 215.0)


func _find_arkady() -> void:
	var outline := _landmark("Arkady Kubickiego")
	if outline.size() < 3:
		return
	_add_site("arkady", [outline])
	if not sites.is_empty() and sites[-1]["key"] == "arkady":
		sites[-1]["box"] = (sites[-1]["box"] as Rect2).merge(ARK_BOX)


func _build_arkady(site: Dictionary) -> void:
	var ring: PackedVector2Array = site["zone"][0]
	if ring.size() < 3:
		return
	_o = Vector2.ZERO
	_a = Vector2(1, 0)
	_b = Vector2(0, 1)
	var n := ring.size()
	# the two levels: the Lower Garden at the wall's foot, the terrace on its top
	var low := INF
	var up := -INF
	for i in n:
		var p := ring[i]
		var q := ring[(i + 1) % n]
		if p.distance_to(q) < 0.5:
			continue
		var out := _out(ring, p, q)
		var m := (p + q) * 0.5
		if out.x > 0.3:
			low = minf(low, map.terrain_height(m.x + out.x * 3.0, m.y + out.y * 3.0))
		elif out.x < -0.3:
			up = maxf(up, map.terrain_height(m.x + out.x * 6.0, m.y + out.y * 6.0))
	if low == INF:
		low = _ground_under(ring)
	if up == -INF:
		up = low
	var top := maxf(up + 0.15, low + 7.5)
	_g = low
	var run := 0.0
	for i in n:
		var p := ring[i]
		var q := ring[(i + 1) % n]
		var len := p.distance_to(q)
		if len < 0.3:
			continue
		var out := _out(ring, p, q)
		var foot: float = minf(map.terrain_height(p.x + out.x, p.y + out.y), map.terrain_height(q.x + out.x, q.y + out.y)) - 0.5
		var portal := ((p + q) * 0.5).distance_to(ARK_PORTAL) < 9.5
		var face := ARK_STONE if portal else ARK_PLASTER
		_mode = M_STONE
		_wall(p, q, foot, top - 0.7, out, face if out.x > 0.3 else ARK_PLASTER.darkened(0.06), run)
		_wall(p + out * 0.25, q + out * 0.25, top - 0.7, top, out, ARK_STONE, run)
		_ledge(p, q, p + out * 0.25, q + out * 0.25, top, ARK_STONE)
		if out.x > 0.3:
			# the arches: round-headed, ringed in cream, one every 12 m (a big one in the portal)
			if portal and len > 4.0:
				_ark_arch(p, q, out, len * 0.5, 3.5, foot + 0.5, minf(top - 1.2, foot + 6.8))
			elif len >= 8.0:
				var count := maxi(floori(len / 12.0), 1)
				for k in count:
					_ark_arch(p, q, out, (k + 0.5) * len / count, 3.0, foot + 0.5, minf(top - 1.5, foot + 5.5))
			# the railing on the edge, a post at each end
			var ra := p + out * 0.1
			var rb := q + out * 0.1
			for post: Vector2 in [ra, rb]:
				_prism(_square(post, 0.05), top, top + 1.0, ZAMEK_IRON, ZAMEK_IRON, M_STONE, M_STONE)
			for side: float in [1.0, -1.0]:
				_wall(ra if side > 0.0 else rb, rb if side > 0.0 else ra, top + 0.9, top + 1.0, out * side, ZAMEK_IRON)
				_wall(ra if side > 0.0 else rb, rb if side > 0.0 else ra, top, top + 0.12, out * side, ZAMEK_IRON)
		run += len
	# the Upper Garden on the vault: where the terrain has no terrace (the cloud's flat ground) the
	# vault gets a lawn of its own; the gravel walk along the edge always (it hides the terrain's
	# slope down to the wall's top)
	if top > up + 1.0:
		_cap(ring, top + 0.01, ARK_LAWN)
	for i in n:
		var p := ring[i]
		var q := ring[(i + 1) % n]
		if p.distance_to(q) < 0.3:
			continue
		var out := _out(ring, p, q)
		if out.x > 0.3:
			_ledge(p, q, p - out * 3.5, q - out * 3.5, top + 0.06, ARK_GRAVEL)
	_ark_fountain(ARK_FOUNTAIN, top)
	# tubs along the terrace edge, 3 m in from the railing, one every 10 m
	var tub_k := 0
	for i in n:
		var p := ring[i]
		var q := ring[(i + 1) % n]
		var len := p.distance_to(q)
		var out := _out(ring, p, q)
		if out.x <= 0.3 or len < 10.0 or ((p + q) * 0.5).distance_to(ARK_PORTAL) < 9.5:
			continue
		var count := floori(len / 10.0)
		for j in count:
			var t := (j + 0.5) / count
			_tub(p.lerp(q, t) - out * 3.0, top, tub_k)
			tub_k += 1
	# the Lower Garden's vases round the lawn carpet, the fountains' water
	for v: Vector2 in ARK_VASES:
		_vase(v, float(map.terrain_height(v.x, v.y)))
	for pool: Array in ARK_POOLS:
		var pc: Vector2 = pool[0]
		var pr: float = pool[1]
		var py: float = map.terrain_height(pc.x, pc.y)
		_g = py
		_cap(_circle(pc, pr, 10), py + 0.38, ARK_WATER)
		_prism(_circle(pc, 0.07, 4), py + 0.38, py + 1.6, ARK_WATER.lightened(0.5), ARK_WATER.lightened(0.6), M_STONE, M_STONE)
	_g = low
	_collide(ring)


## A round-headed arch on the wall p→q: a cream ring and the dark opening inside it, `at` metres
## along the wall, half as wide as `half`, from y0 to the crown at y1 (the head a half circle).
func _ark_arch(p: Vector2, q: Vector2, out: Vector2, at: float, half: float, y0: float, y1: float) -> void:
	var d := (q - p).normalized()
	var mid := p + d * at
	var n3 := Vector3(out.x, 0.0, out.y)
	for layer in 2:
		var push := 0.04 if layer == 0 else 0.08
		var hw := half + 0.45 if layer == 0 else half
		var crown := y1 + 0.45 if layer == 0 else y1
		var col := ARK_STONE if layer == 0 else ARK_DARK
		var spring := crown - hw
		var l := mid - d * hw + out * push
		var r := mid + d * hw + out * push
		_quad(Vector3(l.x, y0, l.y), Vector3(r.x, y0, r.y), Vector3(r.x, spring, r.y), Vector3(l.x, spring, l.y), n3, col)
		var c := Vector3(mid.x + out.x * push, spring, mid.y + out.y * push)
		var seg := 6
		for s in seg:
			var t0 := PI * s / seg
			var t1 := PI * (s + 1) / seg
			var e0 := Vector3(d.x * cos(t0), sin(t0), d.y * cos(t0)) * hw
			var e1 := Vector3(d.x * cos(t1), sin(t1), d.y * cos(t1)) * hw
			_tri(c, c + e0, c + e1, n3, col, Vector2(-1, -1), Vector2(-1, -1), Vector2(-1, -1), -1.0)


## The Upper Garden's fountain: a round stone basin 6 m across with its water, a tulip bowl on a
## stem in the middle, a jet.
func _ark_fountain(c: Vector2, y: float) -> void:
	_g = y
	_prism(_circle(c, 3.6, 10), y, y + 0.15, ARK_GRAVEL.darkened(0.05), ARK_GRAVEL, M_STONE, M_STONE)
	_prism(_circle(c, 3.1, 10), y + 0.15, y + 0.6, ARK_STONE, ARK_STONE, M_STONE, M_STONE)
	_cap(_circle(c, 2.8, 10), y + 0.62, ARK_WATER)
	_mode = M_STONE
	_frustum(_circle(c, 0.25, 6), y + 0.6, _circle(c, 0.3, 6), y + 1.3, ARK_STONE)
	_frustum(_circle(c, 0.3, 8), y + 1.3, _circle(c, 1.1, 8), y + 1.8, ARK_STONE, ARK_WATER)
	_prism(_circle(c, 0.07, 4), y + 1.8, y + 2.7, ARK_WATER.lightened(0.5), ARK_WATER.lightened(0.6), M_STONE, M_STONE)


## A white garden vase on a square pedestal.
func _vase(p: Vector2, g: float) -> void:
	_g = g
	_prism(_square(p, 0.32), g - 0.1, g + 1.0, ARK_STONE.darkened(0.04), ARK_STONE, M_STONE, M_STONE)
	_mode = M_STONE
	_frustum(_circle(p, 0.16, 6), g + 1.0, _circle(p, 0.4, 6), g + 1.5, ARK_STONE)
	_frustum(_circle(p, 0.4, 6), g + 1.5, _circle(p, 0.3, 6), g + 1.85, ARK_STONE, ARK_DARK.lightened(0.2))


## The Barbican (Barbakan; Gianbattista of Venice's brick outwork of 1548 in front of the Nowomiejska
## gate, burned down in 1944 and rebuilt in 1952-1954): a model instead of a skin. The mapped
## outline is a C of wall 3.5 m thick opening to the east; it is drawn as one brick-Gothic wall
## (`M_GOTHIC`: buttresses and lancets) with a crenellated parapet and four octagonal turrets with
## conical roofs on its curve. Spec docs/landmarks/specs/barbakan.md. Heights are estimates (no LoD2
## in the cloud).
const BARB_WALL := Color("#ab5a42")
const BARB_ROOF := Color("#a9502f")   # photos 1-2 and the ortho: terracotta tile
const BARB_STONE := Color("#c4b69a")
const BARB_HEIGHT := 9.5
const BARB_TOWER_H := 13.0
const BARB_TOWER_R := 2.6
## The turrets' centres on the wall's mid-line, world x and z.
const BARB_TOWERS := [Vector2(-940.9, -1841.4), Vector2(-953.0, -1841.2), Vector2(-950.8, -1832.0), Vector2(-941.9, -1828.3)]


func _find_barbakan() -> void:
	var outline := _landmark("Barbakan")
	if outline.size() >= 3:
		_add_site("barbakan", [outline])
		if not sites.is_empty() and sites[-1]["key"] == "barbakan":
			sites[-1]["ring"] = _simplify(outline, 0.35)


func _build_barbakan(site: Dictionary) -> void:
	var ring: PackedVector2Array = site["ring"]
	if ring.size() < 3:
		return
	_o = Vector2.ZERO
	_a = Vector2(1, 0)
	_b = Vector2(0, 1)
	_g = _ground_under(ring)
	var g := _g
	var top := g + BARB_HEIGHT
	# the curtain: brick Gothic to the walk, a stone top, then the crenellated parapet
	_prism(ring, g - 1.5, top, BARB_WALL, BARB_STONE, M_GOTHIC, M_STONE)
	_attic(ring, top, 1.5, BARB_WALL.darkened(0.04))
	# the four turrets: an octagon above the wall, a corbel ring, a steep cone and a finial
	for c: Vector2 in BARB_TOWERS:
		var th := g + BARB_TOWER_H
		_prism(_circle(c, BARB_TOWER_R, 12), g - 1.5, th, BARB_WALL, BARB_STONE, M_GOTHIC, M_STONE)
		_prism(_circle(c, BARB_TOWER_R + 0.3, 12), th, th + 0.5, BARB_WALL.darkened(0.08), BARB_WALL.darkened(0.08), M_STONE, M_STONE)
		# photo 1: the cone swells out over the tower (a deep eave), then rises to a short spike
		_frustum(_circle(c, BARB_TOWER_R + 0.75, 12), th + 0.5, _circle(c, BARB_TOWER_R + 0.2, 12), th + 1.1, BARB_ROOF, BARB_ROOF)
		_frustum(_circle(c, BARB_TOWER_R + 0.2, 12), th + 1.1, _circle(c, 0.2, 12), th + 5.6, BARB_ROOF.lightened(0.04), BARB_ROOF)
		_lbox_at(c, 0.06, th + 5.6, th + 7.0, BARB_STONE.darkened(0.3))
	# the merlons' stone caps along the curtain's crest (photo 2: grey-capped brick merlons every
	# 1.6 m round the bastion), set 0.45 m in from the outer face
	var cap := 0.0
	for i in ring.size():
		var a := ring[i]
		var b := ring[(i + 1) % ring.size()]
		var len := a.distance_to(b)
		if len < 1.6:
			continue
		var e := (b - a) / len
		var inn := -_out(ring, a, b) * 0.45
		var t := 0.8
		while t < len - 0.4:
			var cc := a + e * t + inn
			var q := PackedVector2Array([cc - e * 0.36, cc + e * 0.36, cc + e * 0.36 + inn.normalized() * 0.5, cc - e * 0.36 + inn.normalized() * 0.5])
			_prism(q, top + 1.5, top + 1.95, BARB_STONE.darkened(0.25), BARB_STONE.darkened(0.3), M_STONE, M_STONE)
			t += 1.6
			cap += 1.0
	_collide(ring)


## A thin square post at world point c (a finial).
func _lbox_at(c: Vector2, half: float, y0: float, y1: float, col: Color) -> void:
	_prism(_circle(c, half, 4), y0, y1, col, col, M_STONE, M_STONE)


## Piano House (Zajęcza by Topiel, Powiśle; flats of the 2010s below the music university): a model
## instead of a plain block. The mapped outline (an L with a saw-toothed west front of 1-2 m
## steps) rises to 17.8 m in white plaster with dark window strips in a piano keyboard's rhythm
## (S_KEYS), a glazed ground floor; the top floor is set back 1.6 m in dark glass under a flat
## roof. Spec docs/landmarks/specs/piano_house.md. Heights from OSM (20.8 m), the rest estimated.
const PIANO_WHITE := Color("#eeece6")
const PIANO_GLASS := Color("#3a4250")
const PIANO_ROOF := Color("#8d9094")
const PIANO_BODY := 17.8
const PIANO_TOP := 20.8


func _find_piano_house() -> void:
	var outline := _landmark("Piano House")
