		[19.8, 10.8], [21.2, 10.7], [21.2, 21.6], [10.5, 21.6], [10.5, 20.1], [-10.3, 20.0], [-10.3, 21.4],
		[-21.7, 21.3]]
## The shaft's set-back middle bays, one per face: centre u, centre v, normal u, normal v,
## half width along the face.
const P_BAYS := [[19.75, 0.75, 1.0, 0.0, 10.0], [-20.45, 0.2, -1.0, 0.0, 10.4], [0.1, 20.05, 0.0, 1.0, 10.4],
		[-0.4, -20.2, 0.0, -1.0, 10.2]]
## The courtyards (the relation's inner rings).
const P_COURTS := [
	[[-68.4, 40.7], [-67.6, 40.7], [-67.6, 36.1], [-48.8, 36.2], [-48.8, 32.8], [-34.4, 32.9], [-34.4, 65.1],
			[-48.2, 65.1], [-48.2, 63.9], [-68.4, 63.9]],
	[[-69.2, -41.8], [-69.2, -64.4], [-49.4, -64.3], [-49.4, -65.4], [-34.8, -65.4], [-34.7, -33.5],
			[-49.1, -33.5], [-49.1, -37.4], [-67.9, -37.4], [-67.9, -41.8]],
]
## The Congress Hall (west end): its mapped outline, the block and the auditorium's
## half-round end towards Emilii Plater.
const P_HALL := [[-93.6, 24.6], [-97.3, 23.1], [-101.6, 20.3], [-104.4, 18.0], [-107.7, 14.2], [-110.0, 10.0],
		[-111.8, 5.7], [-112.7, 1.3], [-112.6, -2.6], [-111.9, -6.8], [-110.5, -10.8], [-108.8, -14.4],
		[-106.6, -17.3], [-104.2, -20.2], [-101.2, -22.4], [-97.2, -24.6], [-93.3, -26.0], [-89.0, -26.8],
		[-80.5, -26.7], [-80.5, -34.2], [-65.8, -34.1], [-65.7, -22.4], [-63.3, -22.5], [-63.3, -20.0],
		[-55.3, -20.0], [-55.3, 18.8], [-62.4, 18.8], [-62.4, 20.9], [-65.1, 20.9], [-65.0, 33.4], [-80.3, 33.3],
		[-80.3, 25.3], [-89.3, 25.3]]


func _palace_frame() -> void:
	# The clock tier (139-168 m) is a square: its centre and edges give the frame.
	var outline := _landmark("Pałac Kultury i Nauki")
	var box := _box_of([outline])
	for bld in data["buildings"]:
		if absf(float(bld["h"]) - 168.0) < 0.5 and absf(float(bld["mh"]) - 139.0) < 0.5:
			var sq := _pts(bld["p"])
			if sq.size() >= 4 and box.has_point(_centre(sq)):
				_o = _centre(sq)
				# The edge closest to the grid's east-west direction is the u axis.
				for i in sq.size():
					var e := sq[(i + 1) % sq.size()] - sq[i]
					if e.length() > 5.0 and absf(e.normalized().x) > 0.7:
						_a = e.normalized() * signf(e.x)
						_b = Vector2(-_a.y, _a.x)
						return
	# Fallback: measured from the 2026 data.
	_o = Vector2(-1214.25, 247.3)
	_a = Vector2(0.9403, -0.3404)
	_b = Vector2(0.3404, 0.9403)


## Whether plan point p lies on a ring's outline (within 0.4 m): an edge there is shared.
func _on_ring(p: Vector2, ring: PackedVector2Array) -> bool:
	for i in ring.size():
		var q := Geometry2D.get_closest_point_to_segment(p, ring[i], ring[(i + 1) % ring.size()])
		if q.distance_to(p) < 0.4:
			return true
	return false


func _lpoly(pts: Array) -> PackedVector2Array:
	var out := PackedVector2Array()
	for q in pts:
		out.append(_w(q[0], q[1]))
	return out


func _build_palace(site: Dictionary) -> void:
	_palace_frame()
	var outer: PackedVector2Array = site["zone"][0]
	_g = _ground_under(outer)
	var g := _g
	var stone := SANDSTONE
	var light := SANDSTONE_LIGHT
	var roof := Color("#8f877a")
	var courts: Array = []
	for c in P_COURTS:
		courts.append(_lpoly(c))

	# The base: four storeys round the courtyards, a crenellated attic on top.
	_mode = M_MONUMENT
	var run := 0.0
	for i in outer.size():
		var a := outer[i]
		var b := outer[(i + 1) % outer.size()]
		_wall(a, b, g - 0.4, g + 18.0, _out(outer, a, b), stone, run)
		run += a.distance_to(b)
	for ring: PackedVector2Array in courts:
		for i in ring.size():
			var a := ring[i]
			var b := ring[(i + 1) % ring.size()]
			_wall(a, b, g + 4.0, g + 18.0, -_out(ring, a, b), stone.darkened(0.08))
		_mode = M_STONE
		_cap(ring, g + 4.0, Color("#a39c90"))
		_mode = M_MONUMENT
	_mode = M_STONE
	_cap_holes(outer, courts, g + 18.0, roof)
	_attic(outer, g + 18.0, 1.6, light)
	_collide(outer)

	# Wings: the corner pavilions and the entrance block.
	for w in P_WINGS:
		var poly := _lpoly([[w[0], w[1]], [w[2], w[1]], [w[2], w[3]], [w[0], w[3]]])
		_prism(poly, g + 17.0, g + w[4], stone, roof, M_MONUMENT, M_STONE)
		_attic(poly, g + w[4], 1.4, light)
		# Small pinnacles on the pavilions' corners.
		for k in 4:
			var cu: float = w[0] if k % 2 == 0 else w[2]
			var cv: float = w[1] if k < 2 else w[3]
			_pinnacle(cu, cv, 1.4, g + w[4], 4.2, light)

	# The tower: its first tier (to 67 m) and the shaft (to 139 m) on their mapped plans.
	var tier := _lpoly(P_TIER)
	var shaft := _lpoly(P_SHAFT)

	# The north and south blocks (30 m) between the tower and the annexes; no wall where they
	# meet the tower (it would hide inside it).
	for blk in P_BLOCKS:
		var poly := _lpoly(blk)
		_mode = M_MONUMENT
		var run2 := 0.0
		for i in poly.size():
			var a := poly[i]
			var b := poly[(i + 1) % poly.size()]
			if not _on_ring((a + b) * 0.5, tier):
				_wall(a, b, g + 17.0, g + 30.0, _out(poly, a, b), stone, run2)
			run2 += a.distance_to(b)
		_mode = M_STONE
		for piece in Geometry2D.clip_polygons(poly, tier):
			if not Geometry2D.is_polygon_clockwise(piece):
				_cap(piece, g + 30.0, roof)
		# The parapet only round the outer end (the open part beside the tower stays bare).
		var outer_end := PackedVector2Array()
		for q in blk:
			if absf(float(q[1])) > 40.0:
				outer_end.append(_w(q[0], q[1]))
		_attic(outer_end, g + 30.0, 1.4, light, false)
		var far: float = 60.2 if float(blk[0][1]) > 0.0 else -63.8
		var near: float = 45.0 if float(blk[0][1]) > 0.0 else -50.0
		for cu in [-17.6, 17.2]:
			_pinnacle(cu, far, 1.6, g + 30.0, 5.0, light)
			_pinnacle(cu, near, 1.6, g + 30.0, 5.0, light)

	# The Congress Hall: its mapped block with the half-round end under a flat grey metal roof
	# in concentric steps (Mac photo check 2026-11-01): the roof at the wall top, a raised
	# drum about 48 m across over the auditorium, its flat top with a small vent cap.
	var hall := _lpoly(P_HALL)
	_prism(hall, g + 17.0, g + 22.5, stone, HALL_METAL, M_MONUMENT, M_STONE)
	_attic(hall, g + 22.5, 1.2, light)
	var drum := PackedVector2Array()
	for k in 16:
		var t := TAU * k / 16.0
		drum.append(_w(-86.0 + cos(t) * 24.0, -0.75 + sin(t) * 23.5))
	_prism(drum, g + 22.5, g + 26.0, HALL_METAL.darkened(0.12), HALL_METAL.lightened(0.06), M_STONE, M_STONE)
	_lbox(-86.0, -0.75, 2.0, 2.0, g + 26.0, g + 27.0, HALL_METAL.darkened(0.2), M_STONE)

	# The east portico (Mac photo check 2026-11-01: about 25 m wide): six columns before the
	# entrance, an entablature on them.
	for k in 6:
		var cv := -12.0 + k * 4.8
		_lbox(53.4, cv, 0.65, 0.65, g, g + 13.5, light, M_STONE)
	_lbox(53.4, 0.0, 1.5, 12.8, g + 13.5, g + 15.6, stone, M_STONE, light)

	# Tier one: walls to 67 m, a roof only on the corner towers (the shaft stands on the rest).
	_mode = M_MONUMENT
	var run1 := 0.0
	for i in tier.size():
		var a := tier[i]
		var b := tier[(i + 1) % tier.size()]
		_wall(a, b, g + 17.0, g + 67.0, _out(tier, a, b), stone, run1)
		run1 += a.distance_to(b)
	_mode = M_STONE
	for piece in Geometry2D.clip_polygons(tier, shaft):
		if not Geometry2D.is_polygon_clockwise(piece) and absf(_area(piece)) > 4.0:
			_cap(piece, g + 67.0, roof)
	for cr in P_CORNERS:
		var cu: float = (cr[0] + cr[2]) * 0.5
		var cv: float = (cr[1] + cr[3]) * 0.5
		var hu: float = (cr[2] - cr[0]) * 0.5
		var hv: float = (cr[3] - cr[1]) * 0.5
		var corner := _rect(cu, cv, hu, hv)
		_attic(corner, g + 67.0, 2.2, light)
		for q in 4:
			var pu: float = cu + (-hu + 1.3 if q % 2 == 0 else hu - 1.3)
			var pv: float = cv + (-hv + 1.3 if q < 2 else hv - 1.3)
			if not Geometry2D.is_point_in_polygon(_w(pu, pv), shaft):
				_pinnacle(pu, pv, 1.8, g + 67.0, 7.0, light)
		# A small stepped crown on each corner tower.
		_prism(_rect(cu, cv, 4.5, 4.5), g + 67.0, g + 73.0, light, roof, M_STONE, M_STONE)
		_pinnacle(cu, cv, 2.2, g + 73.0, 9.0, light)

	# The shaft: heavy corner piers and a set-back middle bay on each face, ribbed in stone.
	_prism(shaft, g + 67.0, g + 139.0, stone, roof, M_MONUMENT, M_STONE)
	for bay in P_BAYS:
		var nu: float = bay[2]
		var nv: float = bay[3]
		for k in 5:
			var t: float = -bay[4] + bay[4] * 0.2 + k * bay[4] * 0.4
			var ru: float = bay[0] + nu * 0.45 + absf(nv) * t
			var rv: float = bay[1] + nv * 0.45 + absf(nu) * t
			_lbox(ru, rv, 0.45 if nu != 0.0 else 0.5, 0.45 if nv != 0.0 else 0.5, g + 67.0, g + 121.5, light, M_STONE)
			_lbox(ru, rv, 0.45 if nu != 0.0 else 0.5, 0.45 if nv != 0.0 else 0.5, g + 123.0, g + 136.0, light, M_STONE)
	# A thin cornice band about five storeys under the top (Mac photo check 2026-11-01: the
	# shaft keeps one width up to its top cornice; no step at the 114 m terrace).
	var band: PackedVector2Array = Geometry2D.offset_polygon(shaft, 0.6, Geometry2D.JOIN_MITER)[0]
	_prism(band, g + 121.5, g + 123.0, light, Color(0, 0, 0, 0), M_STONE)
	_mode = M_STONE
	_cap_holes(band, [shaft], g + 123.0, light)
	# The 30th-floor observation terrace (F, 2026-11-01): a 1.9 m ledge round the shaft at 114 m
	# (the real gallery runs inside the walls; the ledge is the walkway the visitors need, crowds.gd
	# DECKS `pkin_terrace`, 22.4 m from the centre) with a stone balustrade 1.1 m high.
	for su: float in [-1.0, 1.0]:
		_lbox(su * 21.5, 0.0, 1.9, 23.4, g + 113.5, g + 114.0, light, M_STONE, light.darkened(0.12))
		_lbox(0.0, su * 21.5, 23.4, 1.9, g + 113.5, g + 114.0, light, M_STONE, light.darkened(0.12))
		_lbox(su * 23.25, 0.0, 0.15, 23.4, g + 114.0, g + 115.1, light, M_STONE, light)
		_lbox(0.0, su * 23.25, 23.4, 0.15, g + 114.0, g + 115.1, light, M_STONE, light)
	# The shaft's top: an attic, big pinnacles on the corner piers, smaller ones between.
	_attic(shaft, g + 139.0, 3.0, light)
	for k in 4:
		var su := -1.0 if k % 2 == 0 else 1.0
		var sv := -1.0 if k < 2 else 1.0
		_pinnacle(su * 18.8, sv * 18.8, 3.4, g + 139.0, 14.0, light)
	for sd in [-1.0, 1.0]:
		_pinnacle(sd * 18.0, 0.0, 2.0, g + 139.0, 8.0, light)
		_pinnacle(0.0, sd * 18.0, 2.0, g + 139.0, 8.0, light)
	# A stepped plinth for the clock tier.
	_prism(_rect(0.0, 0.0, 12.5, 12.5), g + 139.0, g + 143.0, stone, roof, M_STONE, M_STONE)
	_attic(_rect(0.0, 0.0, 12.5, 12.5), g + 143.0, 1.6, light)

	# The clock tier (139-168 m): a dial on every face, an attic and pinnacles on top.
	var clock := _rect(0.0, 0.0, 8.5, 8.5)
	_prism(clock, g + 143.0, g + 168.0, stone, roof, M_MONUMENT, M_STONE)
	for f in 4:
		var nu: float = [1.0, -1.0, 0.0, 0.0][f]
		var nv: float = [0.0, 0.0, 1.0, -1.0][f]
		_dial(_w(nu * 8.62, nv * 8.62), g + 156.0, Vector2(_a * nu + _b * nv), 3.15)
	_attic(clock, g + 168.0, 2.0, light)
	for k in 4:
		_pinnacle(-7.4 if k % 2 == 0 else 7.4, -7.4 if k < 2 else 7.4, 1.8, g + 168.0, 9.0, light)

	# The lantern (168-188 m): tall dark arches between stone piers.
	var lantern := _rect(0.0, 0.0, 6.3, 6.3)
	_prism(lantern, g + 168.0, g + 188.0, stone, Color(0, 0, 0, 0), M_STONE)
	for f in 4:
		var nu: float = [1.0, -1.0, 0.0, 0.0][f]
		var nv: float = [0.0, 0.0, 1.0, -1.0][f]
		var n2: Vector2 = _a * nu + _b * nv
		var side := Vector2(-n2.y, n2.x)
		for k in 3:
			var c := _w(nu * 6.36, nv * 6.36) + side * (-3.6 + k * 3.6)
			_mode = M_STONE
			_quad(Vector3(c.x - side.x * 0.8, g + 171.0, c.y - side.y * 0.8), Vector3(c.x + side.x * 0.8, g + 171.0, c.y + side.y * 0.8),
					Vector3(c.x + side.x * 0.8, g + 185.0, c.y + side.y * 0.8), Vector3(c.x - side.x * 0.8, g + 185.0, c.y - side.y * 0.8),
					Vector3(n2.x, 0, n2.y), Color("#3a3640"))
	_attic(lantern, g + 188.0, 1.4, light)

	# The crown: a patina pyramid, then the gilded spire to 237 m.
	_mode = M_STONE
	_frustum(_rect(0.0, 0.0, 6.0, 6.0), g + 188.0, _rect(0.0, 0.0, 2.4, 2.4), g + 203.0, PATINA)
	# The spire's foot: a dark bronze lantern (Mac photo check 2026-11-01), then the gold spire.
	_prism(_rect(0.0, 0.0, 1.8, 1.8), g + 200.5, g + 208.0, SPIRE_BRONZE, SPIRE_BRONZE, M_STONE, M_STONE)
	_mode = M_GOLD
	_frustum(_rect(0.0, 0.0, 1.6, 1.6), g + 208.0, _rect(0.0, 0.0, 0.9, 0.9), g + 222.0, SPIRE_GOLD)
	_frustum(_rect(0.0, 0.0, 0.9, 0.9), g + 222.0, _rect(0.0, 0.0, 0.15, 0.15), g + 237.0, SPIRE_GOLD)
	# Two rings on the spire.
	_prism(_rect(0.0, 0.0, 1.3, 1.3), g + 214.0, g + 215.0, SPIRE_GOLD, SPIRE_GOLD, M_GOLD, M_GOLD)
	_prism(_rect(0.0, 0.0, 1.0, 1.0), g + 225.0, g + 225.8, SPIRE_GOLD, SPIRE_GOLD, M_GOLD, M_GOLD)


## A clock dial facing `n` (plan, unit) centred at plan point c, height y: a cream disc
## with a gold rim and hour marks (it lights up at night). Loop 1: the hands are drawn by
## building.gdshader from the disc's UV (the point on the dial in radii, x to the right as
## seen from outside, y up, both minus 10 so the shader takes it for a roof) and show the
## time in Warsaw (main.gd sets `clock_hands` once a minute).
func _dial(c: Vector2, y: float, n: Vector2, r: float, face := Color("#f4ecd6"), ink := Color("#26232a")) -> void:
	var side := Vector2(-n.y, n.x)
	var n3 := Vector3(n.x, 0.0, n.y)
	var centre := Vector3(c.x, y, c.y) + n3 * 0.05
	var seg := 20
	_mode = M_GOLD
	for k in seg:
		var t0 := TAU * k / seg
		var t1 := TAU * (k + 1) / seg
		var e0 := Vector3(side.x * cos(t0), sin(t0), side.y * cos(t0))
		var e1 := Vector3(side.x * cos(t1), sin(t1), side.y * cos(t1))
		_quad(centre + e0 * r * 1.12, centre + e1 * r * 1.12, centre + e1 * r, centre + e0 * r, n3, GOLD)
	_mode = M_DIAL
	var disc := centre + n3 * 0.04
	# `side` points to the left of someone looking at the dial from outside.
	for k in seg:
		var t0 := TAU * k / seg
		var t1 := TAU * (k + 1) / seg
		_tri(disc, disc + Vector3(side.x * cos(t0), sin(t0), side.y * cos(t0)) * r,
				disc + Vector3(side.x * cos(t1), sin(t1), side.y * cos(t1)) * r, n3, face,
				Vector2(-10, -10), Vector2(-cos(t0) - 10.0, sin(t0) - 10.0), Vector2(-cos(t1) - 10.0, sin(t1) - 10.0), -1.0)
	_mode = M_STONE
	var front := disc + n3 * 0.05
	for k in 12:
		var t := TAU * k / 12.0
		var dir := Vector3(side.x * cos(t), sin(t), side.y * cos(t))
		var across := Vector3(side.x * -sin(t), cos(t), side.y * -sin(t)) * (0.16 if k % 3 == 0 else 0.09)
		var p0 := front + dir * r * 0.78
		var p1 := front + dir * r * 0.93
		_quad(p0 - across, p1 - across, p1 + across, p0 + across, n3, ink)


# --- Złote Tarasy -----------------------------------------------------------------------------

## Złote Tarasy (Jerde Partnership, 2007), rebuilt 2026-10-31 to its spec
## docs/landmarks/specs/tarasy.md from the complex's OpenStreetMap parts: the glass wave over
## the mall, the mall's terraced sandstone podium under it, the Lumen office crescent wrapping
## it on Złota and Jana Pawła II, the Skylight tower on Emilii Plater with its lit glass crown,
## the round glass drum on the station side. Every part keeps its mapped outline and heights;
## what the part is decides its look (TARASY_*).
const TARASY_SAND := Color("#d9c7a0")      # the podium's sandstone walls
const TARASY_SHOP := Color("#c8b27e")      # the podium's golden shop glass (S_GRID)
const TARASY_TERRACE := Color("#8a9a72")   # the planted terraces (mapped #6EBE9F)
const TARASY_DECK := Color("#a49d90")      # the podium's plain roofs
const TARASY_LUMEN := Color("#9fb0b8")     # Lumen's silver-blue glass between white ribbons
const TARASY_LUMEN_ROOF := Color("#8e9497")
const TARASY_SKY := Color("#a3afb4")       # Skylight's light silver-grey cladding (Mac photos), a dark-teal window dash per floor
const TARASY_SKY_ROOF := Color("#a7b3b8")
const TARASY_CROWN := Color("#b9d2dc")     # Skylight's glass crown, lit cool white at night
const TARASY_DRUM := Color("#c9b98f")      # the drum: golden glass lit warm
const TARASY_BLOCK := Color("#3b3e4b")     # the screen block over the entrance: dark graphite
const TARASY_RED := Color("#c0624c")       # the red entrance boxes on Jana Pawła II (mapped tomato)
const TARASY_RIM := Color("#b9a983")       # the wave's glass walls: the terraces' shopfronts
const TARASY_WAVE := Color("#d4b066")      # the landmarks loop: golden glass (was #8fb6c6, ice)
## How far Skylight's crown leans in (fraction of the way to the centre) and how high it is.
const TARASY_CROWN_IN := 0.18
const TARASY_CROWN_H := 8.0


func _tarasy_dome(b: Dictionary) -> bool:
	return str(b["c"]).to_lower() == "#336699" and float(b["h"]) >= 20.0


## The mapped plate over the entrance (17 to 27 m, 19 points, Skylight's colour): the screen's block.
func _tarasy_screen_block(b: Dictionary) -> bool:
	return str(b.get("name", "")) == "" and str(b["c"]).to_lower() == "#bac1c7" and is_equal_approx(float(b["mh"]), 17.0) \
			and is_equal_approx(float(b["h"]), 27.0) and (b["p"] as Array).size() == 38


func _build_tarasy(site: Dictionary) -> void:
	_g = _ground_under(site["zone"][0])
	var g := _g
	var none := Color(0, 0, 0, 0)
	var shop := M_SKIN + float(S_GRID) / 16.0
	for b: Dictionary in site.get("parts", []):
		if _tarasy_dome(b):
			continue
		var poly := _pts(b["p"])
		if poly.size() < 3:
			continue
		var h := float(b["h"])
		var mh := float(b["mh"])
		var y0 := _ground_under(poly) - 0.4 if mh < 0.5 else g + mh
		var y1 := g + h
		var nm := str(b.get("name", ""))
		var col := str(b["c"]).to_lower()
		if _tarasy_screen_block(b):
			# F's photos (2026-11-05): the 3D screen hangs on a box that stands out in front of
			# Skylight, over the glass entrance: its south face and the curved west return make an
			# L in plan (tarasy_screen.gd). The mapped plate (17 to 27 m) grows to the screen's top.
			_prism(poly, y0, g + TarasyScreen.BLOCK_TOP, TARASY_BLOCK, TARASY_BLOCK.darkened(0.1), M_STONE, M_STONE)
		elif nm == "Lumen":
			# The office crescent: white ribbons between silver-blue glass, on the podium.
			_prism(poly, y0, y1, TARASY_LUMEN, TARASY_LUMEN_ROOF, M_SKIN + float(S_RIBBON) / 16.0, M_SKIN)
		elif nm == "Skylight":
			_tarasy_skylight(poly, y0, g)
		elif col == "#336699":
			# The glass floor under the wave's low south sweep: the wave carried down to the plaza.
			_prism(poly, y0, y1, TARASY_RIM, TARASY_WAVE, M_PAVILION, M_GLASS_ROOF)
		elif h >= 29.5 and h - mh < 1.0:
			_prism(poly, y0, y1, TARASY_SAND, TARASY_SAND.darkened(0.08), M_STONE, M_STONE)  # the drum's rim
		elif h >= 29.5 and mh < 0.5 and poly.size() >= 16:
			_prism(poly, y0, y1, TARASY_DRUM, TARASY_DECK, M_PAVILION, M_STONE)  # the drum
		elif col == "tomato":
			_prism(poly, y0, y1, TARASY_RED, TARASY_RED.darkened(0.15), M_STONE, M_STONE)
		elif col == "#6ebe9f":
			_prism(poly, y0, y1, TARASY_SAND, TARASY_TERRACE, shop, M_STONE)
		else:
			_prism(poly, y0, y1, TARASY_SAND, TARASY_DECK, shop, M_STONE)
		if mh < 0.5:
			_collide(poly)
	_tarasy_wave(site)
	_mode = M_STONE


## Skylight rebuilt from photos (refs/skylight/REPORT.md, 2026-11-05): a light silver-grey shaft
## with a dark-teal window dash per floor (S_PUNCHED), on piers with a glass canopy, a stepped
## four-floor glazed belt at 20-33 m, a roof that is high on the convex south wall and scooped
## down on the west half round an oval glass cap, plant on the east half, and no advert panels: the 3D
## screen is on the block over the entrance (tarasy_screen.gd). No lit crown: the real top has none.
const SKY_CLAD := Color("#b8bdc1")
const SKY_ROOF := Color("#8e9497")
const SKY_GLASS := Color("#4f7f92")


func _tarasy_skylight(poly: PackedVector2Array, y0: float, g: float) -> void:
	var none := Color(0, 0, 0, 0)
	var c := _centre(poly)
	var clad := M_SKIN + float(S_PUNCHED) / 16.0
	var belt := M_SKIN + float(S_RIBBON) / 16.0
	# Foot: dark lobby glass between the piers, a canopy slab at 5 m.
	var foot := _largest(Geometry2D.offset_polygon(poly, -1.0, Geometry2D.JOIN_MITER))
	if foot.size() < 3:
		foot = poly
	_prism(foot, y0, g + 5.0, SKY_GLASS.darkened(0.25), none, M_PAVILION, M_STONE)
	_prism(poly, g + 5.0, g + 5.5, Color("#c9ccce"), SKY_ROOF, M_STONE, M_STONE)
	# Lower body: cladding with the narrow gold stair slits' rhythm left to the skin.
	_prism(poly, g + 5.5, g + 20.0, SKY_CLAD, none, clad, M_SKIN)
	# The glazed belt, each edge stepped out a little.
	var out := PackedVector2Array()
	for q in poly:
		out.append(c + (q - c) * 1.012)
	_prism(out, g + 20.0, g + 33.0, SKY_GLASS, none, belt, M_SKIN)
	# The shaft to the notch line, then two roof heights.
	_prism(poly, g + 33.0, g + 100.0, SKY_CLAD, none, clad, M_SKIN)
	var split_x := c.x - 4.0
	var east := Geometry2D.intersect_polygons(poly, PackedVector2Array([
		Vector2(split_x, c.y - 60.0), Vector2(c.x + 80.0, c.y - 60.0),
		Vector2(c.x + 80.0, c.y + 60.0), Vector2(split_x, c.y + 60.0)]))
	for e: PackedVector2Array in east:
		_prism(e, g + 100.0, g + 105.0, SKY_CLAD, SKY_ROOF, clad, M_STONE)
	# West half: roof at 100 m, a lower parapet, and the oval glass cap in the notch.
	var west := Geometry2D.intersect_polygons(poly, PackedVector2Array([
		Vector2(c.x - 80.0, c.y - 60.0), Vector2(split_x, c.y - 60.0),
		Vector2(split_x, c.y + 60.0), Vector2(c.x - 80.0, c.y + 60.0)]))
	for w: PackedVector2Array in west:
		_prism(w, g + 100.0, g + 100.4, SKY_ROOF, SKY_ROOF, M_STONE, M_STONE)
	var cap_c := Vector2(-1396.0, 418.0)
	var cap := PackedVector2Array()
	var cap_top := PackedVector2Array()
	for k in 20:
		var d := Vector2.from_angle(TAU * (k + 0.5) / 20.0)
		cap.append(cap_c + Vector2(d.x * 6.0, d.y * 3.5))
		cap_top.append(cap_c + Vector2(d.x * 4.2, d.y * 2.4))
	_mode = M_PAVILION + 0.5
	_frustum(cap, g + 100.4, cap_top, g + 103.4, Color("#9fc4d2"), Color("#b9d2dc"))
	# Roof plant on the east half behind the high wall.
	_prism(_square(c + Vector2(7.0, -3.0), 4.5), g + 105.0, g + 107.5, Color("#aeb3b6"), SKY_ROOF, M_STONE, M_STONE)
	_prism(_square(c + Vector2(13.0, -1.0), 3.0), g + 105.0, g + 106.6, Color("#a2a7aa"), SKY_ROOF, M_STONE, M_STONE)
	_mode = M_STONE


## The glass wave: one surface over the mapped domes (each a cap rising to its mapped
## height, 35 m by the offices, 22 m towards the station), blended where they meet so
## the roof rolls instead of creasing, laid on the ground's slope, with glass walls
## round its rim where it stands clear of the ground: the terraces' shopfronts, lit warm
## floor by floor at night.
func _tarasy_wave(site: Dictionary) -> void:
	var domes: Array = []
	for b in site.get("domes", []):
		var poly := _pts(b["p"])
		var c := _centre(poly)
		var r := 0.0
		for q in poly:
			r += q.distance_to(c)
		domes.append([c, r / poly.size() + 1.0, float(b["h"])])
	if domes.is_empty():
		return
	var lo := Vector2(INF, INF)
	var hi := -lo
	for d in domes:
		lo = lo.min(d[0] - Vector2.ONE * d[1])
		hi = hi.max(d[0] + Vector2.ONE * d[1])
	var glass := TARASY_WAVE
	var step := 3.0
	var nx := ceili((hi.x - lo.x) / step)
	var nz := ceili((hi.y - lo.y) / step)
	# Every grid corner: inside the domes (or moved onto the nearest rim) and its height.
	var corner := PackedVector3Array()
	var inside := PackedByteArray()
	for j in nz + 1:
		for i in nx + 1:
			var p := lo + Vector2(i, j) * step
			var best := INF
			var rim := p
			var any := false
			for d in domes:
				var dist := p.distance_to(d[0])
				if dist <= d[1]:
					any = true
				if dist - d[1] < best:
					best = dist - d[1]
					rim = d[0] + (p - d[0]).normalized() * d[1] * 0.999
			if not any:
				p = rim
			corner.append(Vector3(p.x, _wave(p, domes), p.y))
			inside.append(1 if any else 0)
	_mode = M_GLASS_ROOF
	for j in nz:
		for i in nx:
			var k00 := j * (nx + 1) + i
			var k10 := k00 + 1
			var k01 := k00 + nx + 1
			var k11 := k01 + 1
			if inside[k00] + inside[k10] + inside[k01] + inside[k11] == 0:
				continue
			for tri in [[k00, k10, k11], [k00, k11, k01]]:
				var a := corner[tri[0]]
				var b := corner[tri[1]]
				var c := corner[tri[2]]
				if (b - a).cross(c - a).length() < 0.05:
					continue
				var n := (b - a).cross(c - a).normalized()
				if n.y < 0.0:
					n = -n
				_tri(a, b, c, n, glass, Vector2(-1, -1), Vector2(-1, -1), Vector2(-1, -1), -1.0)
	# The rim: glass walls where the wave stands clear of the ground.
	_mode = M_PAVILION
	var ring := PackedVector2Array()
	for d in domes:
		var seg := 40
		for k in seg:
			var a: Vector2 = d[0] + Vector2.from_angle(TAU * k / seg) * d[1]
			var b: Vector2 = d[0] + Vector2.from_angle(TAU * (k + 1) / seg) * d[1]
			var m := (a + b) * 0.5
			var covered := false
			for e in domes:
				if e != d and m.distance_to(e[0]) < e[1] - 0.3:
					covered = true
					break
			if covered:
				continue
			ring.append(m)
			var ya := _wave(a, domes)
			var yb := _wave(b, domes)
			var ga: float = map.terrain_height(a.x, a.y) - 0.3
			var gb: float = map.terrain_height(b.x, b.y) - 0.3
			if ya - ga < 0.6 and yb - gb < 0.6:
				continue
			var n: Vector2 = (m - (d[0] as Vector2)).normalized()
			_quad(Vector3(a.x, ga, a.y), Vector3(b.x, gb, b.y), Vector3(b.x, yb, b.y), Vector3(a.x, ya, a.y),
					Vector3(n.x, 0, n.y), TARASY_RIM, Vector2(0, ga - _g), Vector2(a.distance_to(b), gb - _g),
					Vector2(a.distance_to(b), yb - _g), Vector2(0, ya - _g), maxf(ya, yb) - _g)
			map._wall_faces.append_array([Vector3(a.x, ga - 1.0, a.y), Vector3(b.x, gb - 1.0, b.y), Vector3(b.x, gb + 5.0, b.y),
					Vector3(a.x, ga - 1.0, a.y), Vector3(b.x, gb + 5.0, b.y), Vector3(a.x, ga + 5.0, a.y)])


## The wave's height at a point: each dome a cap (its rim a seventh of its height), the
## caps blended smoothly where they overlap; on the ground's slope.
func _wave(p: Vector2, domes: Array) -> float:
	var k := 2.6
	var sum := 0.0
	var any := false
	for d in domes:
		var t: float = p.distance_to(d[0]) / d[1]
		if t <= 1.0:
			var v: float = d[2] * (0.14 + 0.86 * sqrt(maxf(1.0 - t * t, 0.0)))
			sum += exp(v / k)
			any = true
	var h := k * log(sum) if any else 0.0
	return map.terrain_height(p.x, p.y) + h


# --- the Rotunda ------------------------------------------------------------------------------

## The Mac photo check (2026-11-01, spec docs/landmarks/specs/rotunda.md): green-grey glass
## floor to eave between 52 silver mullions, one transom near the top; a folded-plate crown in
## brushed silver (48 radial folds whose ends make the eave's ring of downward teeth) rising
## gently to a raised oculus with a metal kerb and a glazed top in a 4 x 4 grid; the main
## entrance on the south under a flat canopy, a smaller one on the plaza (north-west), two
## triangular plates on the roof's edge, and the bank's parody name either side of the south door.
const ROT_GLASS := Color("#5e7f7a")    # #4d6f6b in shade, #6f8f8a lit
const ROT_SILVER := Color("#c3c8cc")
const ROT_FOLD_LIGHT := Color("#d4d8db")
const ROT_FOLD_DARK := Color("#b0b6bb")
const ROT_TOOTH := Color("#e4e7e9")   # the eave's teeth, white-silver
const ROT_BAYS := 52
const ROT_FOLDS := 48
const ROT_EAVE := 10.8      # the glass's top and the soffit, over the ground
const ROT_RIDGE := 12.3     # a fold's ridge at the eave (the teeth hang 1.5 m to ROT_EAVE)
const ROT_OCULUS := 5.4     # the oculus's radius (10.8 m across)
const ROT_SOUTH := Vector2(0, 1)
const ROT_PLAZA := Vector2(-0.7071, -0.7071)


func _build_rotunda(site: Dictionary) -> void:
	var poly: PackedVector2Array = site["zone"][0]
	var c := _centre(poly)
	var r := 0.0
	for q in poly:
		r += q.distance_to(c)
	r /= poly.size()
	_g = _ground_under(poly)
	var g := _g
	var none := Color(0, 0, 0, 0)
	# The drum: one bay of the 52 centred on the south door, a mullion at every corner.
	var step := TAU / ROT_BAYS
	var a0 := ROT_SOUTH.angle() + 0.5 * step
	var drum := PackedVector2Array()
	for k in ROT_BAYS:
		drum.append(c + Vector2.from_angle(a0 + k * step) * r)
	_prism(drum, g - 0.4, g + 0.3, Color("#55585c"), none, M_STONE)
	_prism(drum, g + 0.3, g + ROT_EAVE, ROT_GLASS, none, M_PAVILION + 0.75)
	_mode = M_STONE
	for p in drum:
		_rot_fin(c, p, g + 0.3, g + ROT_EAVE, 0.09, 0.32, ROT_SILVER)
	_rot_crown(c, r, g)
	# The entrances: glazed doors under a flat silver canopy, a transom over the doors.
	_rot_door(c, r, g, ROT_SOUTH, 3, 8.0, 2.0, 4.0)
	_rot_door(c, r, g, ROT_PLAZA, 2, 5.0, 1.5, 3.6)
	# The bank's name (a parody), white on the glass either side of the south door.
	for s: float in [-1.0, 1.0]:
		var d := ROT_SOUTH.rotated(s * 0.56)
		var at := c + d * (r + 0.1)
		signs.append(["BANK POLSKA", Vector3(at.x, g + 5.2, at.y), Vector3(d.x, 0.0, d.y), 0.4, Color(0.95, 0.97, 1.0)])
	_collide(drum)


## A mullion standing proud of the glass at plan point p: its face and two sides.
func _rot_fin(c: Vector2, p: Vector2, y0: float, y1: float, half: float, depth: float, col: Color) -> void:
	var o := (p - c).normalized()
	var t := Vector2(-o.y, o.x)
	var a := p - t * half
	var b := p + t * half
	var a2 := a + o * depth
	var b2 := b + o * depth
	var n := Vector3(o.x, 0, o.y)
	var tn := Vector3(t.x, 0, t.y)
	_quad(Vector3(a2.x, y0, a2.y), Vector3(b2.x, y0, b2.y), Vector3(b2.x, y1, b2.y), Vector3(a2.x, y1, a2.y), n, col)
	_quad(Vector3(b.x, y0, b.y), Vector3(b2.x, y0, b2.y), Vector3(b2.x, y1, b2.y), Vector3(b.x, y1, b.y), tn, col.darkened(0.08))
	_quad(Vector3(a.x, y0, a.y), Vector3(a2.x, y0, a2.y), Vector3(a2.x, y1, a2.y), Vector3(a.x, y1, a.y), -tn, col.darkened(0.08))


## The folded-plate roof: 48 folds from the eave to the oculus, a ridge and a valley each, the
## valleys dropping to the eave so the plates' ends make a ring of downward teeth; a recessed
## dark fascia behind the teeth, the soffit under the overhang, the oculus's kerb and glazed
## top, and the two triangular plates on the edge (north-east and south-west).
func _rot_crown(c: Vector2, r: float, g: float) -> void:
	var edge := r + 2.2
	var fold := TAU / ROT_FOLDS
	var a0 := ROT_SOUTH.angle()
	var top := g + 14.4    # a ridge at the oculus
	var low := g + 14.0    # a valley at the oculus
	_mode = M_STONE
	for k in ROT_FOLDS:
		var ar := a0 + k * fold
		var av := ar + 0.5 * fold
		var ar2 := ar + fold
		var re := c + Vector2.from_angle(ar) * edge
		var ve := c + Vector2.from_angle(av) * edge
		var re2 := c + Vector2.from_angle(ar2) * edge
		var ri := c + Vector2.from_angle(ar) * ROT_OCULUS
		var vi := c + Vector2.from_angle(av) * ROT_OCULUS
		var ri2 := c + Vector2.from_angle(ar2) * ROT_OCULUS
		var p_re := Vector3(re.x, g + ROT_RIDGE, re.y)
		var p_ve := Vector3(ve.x, g + ROT_EAVE, ve.y)
		var p_re2 := Vector3(re2.x, g + ROT_RIDGE, re2.y)
		var p_ri := Vector3(ri.x, top, ri.y)
		var p_vi := Vector3(vi.x, low, vi.y)
		var p_ri2 := Vector3(ri2.x, top, ri2.y)
		for f: Array in [[p_re, p_ve, p_vi, p_ri, ROT_FOLD_LIGHT], [p_ve, p_re2, p_ri2, p_vi, ROT_FOLD_DARK]]:
			_rot_up_tri(f[0], f[1], f[2], f[4])
			_rot_up_tri(f[0], f[2], f[3], f[4])
		# The teeth: the plates' ends, white-silver, seen as downward triangles from the street;
		# behind them (between two teeth) the dark fascia closes the edge down to the soffit.
		var o := Vector3(cos(av), 0, sin(av))
		_tri(p_re, p_re2, p_ve, o, ROT_TOOTH, Vector2(-1, -1), Vector2(-1, -1), Vector2(-1, -1), -1.0)
		var re_low := Vector3(re.x, g + ROT_EAVE, re.y)
		var back := c + Vector2.from_angle(ar) * (edge - 0.5)
		var back2 := c + Vector2.from_angle(ar2) * (edge - 0.5)
		var dark := Color("#6d7378")
		_quad(Vector3(back.x, g + ROT_EAVE, back.y), Vector3(back2.x, g + ROT_EAVE, back2.y),
				Vector3(back2.x, g + ROT_RIDGE, back2.y), Vector3(back.x, g + ROT_RIDGE, back.y), o, dark)
		# The soffit: the overhang's underside, from the glass out to the edge.
		var si := c + Vector2.from_angle(ar) * (r - 0.2)
		var si2 := c + Vector2.from_angle(ar2) * (r - 0.2)
		_quad(Vector3(si.x, g + ROT_EAVE, si.y), Vector3(si2.x, g + ROT_EAVE, si2.y), Vector3(re2.x, g + ROT_EAVE, re2.y),
				re_low, Vector3.DOWN, Color("#b9bec2"))
	# The oculus: a metal kerb 1 m over the folds, a glazed top in a 4 x 4 grid.
	var ring := _circle(c, ROT_OCULUS, 24)
	_prism(ring, low - 0.1, top + 0.9, ROT_SILVER, Color(0, 0, 0, 0), M_STONE)
	var glass_y := top + 0.9
	_mode = M_GLASS_ROOF
	_cap(ring, glass_y, Color("#8fb0ad"))
	_mode = M_STONE
	for i in range(1, 4):
		var off := -ROT_OCULUS + i * ROT_OCULUS * 0.5
		var span := sqrt(ROT_OCULUS * ROT_OCULUS - off * off) - 0.2
		for d: Vector2 in [Vector2(1, 0), Vector2(0, 1)]:
			var across := Vector2(-d.y, d.x)
			var m := c + across * off
			_prism(PackedVector2Array([m - d * span - across * 0.12, m + d * span - across * 0.12,
					m + d * span + across * 0.12, m - d * span + across * 0.12]),
					glass_y, glass_y + 0.18 + (0.02 if d.x > 0.5 else 0.0), ROT_SILVER, ROT_SILVER, M_STONE, M_STONE)
	# The two triangular plates standing on the edge, north-east and south-west.
	for d: Vector2 in [Vector2(0.7071, -0.7071), Vector2(-0.7071, 0.7071)]:
		var t := Vector2(-d.y, d.x)
		var base := c + d * (edge - 0.6)
		var pa := Vector3((base - t * 2.6).x, g + ROT_RIDGE - 0.4, (base - t * 2.6).y)
		var pb := Vector3((base + t * 2.6).x, g + ROT_RIDGE - 0.4, (base + t * 2.6).y)
		var pt := Vector3(base.x, g + ROT_RIDGE + 3.4, base.y)
		var n := Vector3(d.x, 0, d.y)
		var nn := Vector2(-1, -1)
		_tri(pa, pb, pt, n, Color("#a9b0b5"), nn, nn, nn, -1.0)
		_tri(pb, pa, pt, -n, Color("#8e959a"), nn, nn, nn, -1.0)


## A roof triangle with its normal pointing up (a fold's facet).
func _rot_up_tri(a: Vector3, b: Vector3, c: Vector3, col: Color) -> void:
	var n := (b - a).cross(c - a).normalized()
	if n.y < 0.0:
		n = -n
	_tri(a, b, c, n, col, Vector2(-1, -1), Vector2(-1, -1), Vector2(-1, -1), -1.0)


## An entrance facing `d`: `bays` dark glass doors (centred on d) to 3.2 m, a silver transom
## over them, and a flat canopy `wide` by `deep` at `at` m.
func _rot_door(c: Vector2, r: float, g: float, d: Vector2, bays: int, wide: float, deep: float, at: float) -> void:
	var step := TAU / ROT_BAYS
	var mid := d.angle()
	var first := mid - 0.5 * bays * step
	_mode = M_STONE
	for k in bays:
		var p0 := c + Vector2.from_angle(first + k * step) * (r + 0.1)
		var p1 := c + Vector2.from_angle(first + (k + 1) * step) * (r + 0.1)
		var o := Vector2.from_angle(first + (k + 0.5) * step)
		var n := Vector3(o.x, 0, o.y)
		_quad(Vector3(p0.x, g + 0.3, p0.y), Vector3(p1.x, g + 0.3, p1.y), Vector3(p1.x, g + 3.2, p1.y), Vector3(p0.x, g + 3.2, p0.y),
				n, Color("#2e3a39"))
		var q0 := c + Vector2.from_angle(first + k * step) * (r + 0.22)
		var q1 := c + Vector2.from_angle(first + (k + 1) * step) * (r + 0.22)
		_quad(Vector3(q0.x, g + 3.2, q0.y), Vector3(q1.x, g + 3.2, q1.y), Vector3(q1.x, g + 3.5, q1.y), Vector3(q0.x, g + 3.5, q0.y),
				n, ROT_SILVER)
	var t := Vector2(-d.y, d.x)
	var near := c + d * (r - 0.4)
	var far := c + d * (r + deep)
	_prism(PackedVector2Array([near - t * wide * 0.5, near + t * wide * 0.5, far + t * wide * 0.5, far - t * wide * 0.5]),
			g + at, g + at + 0.35, ROT_SILVER, ROT_SILVER.lightened(0.08), M_STONE, M_STONE)


# --- Varso Tower ------------------------------------------------------------------------------

## Built from its mapped parts: the glass slabs (177 and 205 m, the south part to 230 m),
## the dark spines at both ends, the glass crown (193-234 m, lit at night); the thin parts
## of the spire are replaced by one mast to 310 m with its five rings and a beacon.
func _build_varso(site: Dictionary) -> void:
	var zone: PackedVector2Array = site["zone"][0]
	_g = _ground_under(zone)
	var g := _g
	var spire := Vector2.INF
	var spire_h := 0.0
	var parts := _parts_in(zone, func(_b: Dictionary) -> bool: return true)
	for b in parts:
		var poly := _pts(b["p"])
		var lo := poly[0]
		var hi := poly[0]
		for q in poly:
			lo = lo.min(q)
			hi = hi.max(q)
		var h := float(b["h"])
		var mh := float(b["mh"])
		if (hi - lo).length() < 8.0 and h >= 230.0:
			# A piece of the spire or one of its rings: the tallest one marks where it stands.
			if h > spire_h:
				spire_h = h
				spire = _centre(poly)
			continue
		if h < 3.0:
			continue
		var col := _osm(b["c"], Color("#334e6b"))
		var dark := str(b["c"]).to_lower() == "#3f4140"
		var crown := mh >= 190.0 and h > 220.0
		var top_col := col.darkened(0.25)
		if dark:
			_prism(poly, g + mh - (0.4 if mh < 0.5 else 0.0), g + h, col, top_col, M_STONE, M_STONE)
		elif crown:
			# The crown: an open glass lantern round the top floors, lit at night.
			_prism(poly, g + mh, g + h, col.lightened(0.18), Color(0, 0, 0, 0), M_PAVILION + 0.5)
		else:
			_prism(poly, g + mh - (0.4 if mh < 0.5 else 0.0), g + h, col, top_col, M_GLASS, M_STONE)
		if mh < 0.5 and h > 30.0:
			_collide(poly)
	# Krajobraz K3: the sky garden on the 205 m roof, round the 230 m top (varso_place.md G1-G4).
	for b in parts:
		if float(b["mh"]) < 0.5 and absf(float(b["h"]) - VARSO_GARDEN_H) < 0.5:
			for piece in _varso_open_roof(b, parts):
				_varso_garden(piece, g + VARSO_GARDEN_H, VARSO_GARDEN)
	if spire == Vector2.INF:
		return
	# The spire: a slender mast tapering to 310 m, its rings, a beacon on top.
	var steel := Color("#b8c0cc")
	_mode = M_STONE
	var sq := func(radius: float) -> PackedVector2Array:
		var out := PackedVector2Array()
		for k in 8:
			out.append(spire + Vector2.from_angle(TAU * k / 8.0) * radius)
		return out
	_frustum(sq.call(1.6), g + 193.0, sq.call(1.2), g + 260.0, steel)
	_frustum(sq.call(1.2), g + 260.0, sq.call(0.35), g + 309.0, steel)
	for h in [240.0, 250.0, 260.0, 274.0, 294.0]:
		var rr: float = 2.7 if h < 290.0 else 1.2
		_prism(sq.call(rr), g + h - 0.6, g + h, Color("#7689a9"), Color("#8fa0bb"), M_STONE, M_STONE)
	_prism(sq.call(0.5), g + 309.0, g + 310.5, Color("#ff3b30"), Color("#ff6a5c"), M_LAMP, M_LAMP)
	# The dusk loop: the aviation light on the spire's very top.
	_prism(_square(spire, 0.35), g + 310.5, g + 311.2, DUSK_RED, DUSK_RED, M_LAMP, M_LAMP)


# --- Varso Place (Krajobraz K3, docs/landmarks/specs/varso_place.md) -----------------------------

## Chmielna 69-73: the planting is RS Architektura Krajobrazu's (ZinCo: ~4,000 m² of green on the
## garage slabs and the roofs). The sky garden is on the tower's 205 m roof (16 hawthorns up to
## 6 m, perennials, dwarf pines, timber benches; HB Reavis, 2021); Varso 2 has green terraces and
## Varso 1 a roof terrace; a 60 t glacial erratic from the dig stands by the tower's entrance.
## The tower's garden is built with the tower (its card); the rest is the site `varso_place`, a
## 0.2 m zone at the erratic (nothing stands there) with a box over the three buildings, so Varso
## I and II stay the map's own extrusions and a sector that holds any of it builds it.
const VARSO_GARDEN_H := 205.0
const VARSO_BOX := Rect2(-1822.0, 530.0, 236.0, 178.0)
const VARSO_ROCK_AT := Vector2(-1600.5, 541.5)
const VARSO_SIGN_AT := Vector2(-1597.5, 553.5)
const VARSO_SIGN_ALONG := Vector2(0.35, 0.94)   # parallel to Al. Jana Pawła II, the letters face it
const VARSO_LEAF := Color("#5f7f45")
const VARSO_PINE := Color("#3d5b3b")
const VARSO_BEDS: Array[Color] = [Color("#7b8c4e"), Color("#6c8f4f"), Color("#8a8a58")]  # perennials, lawn, grasses
const VARSO_DECK := Color("#a58a69")
const VARSO_GRANITE := Color("#8e8a82")
const VARSO_TRUNK := Color("#5b4b3d")
const VARSO_RAIL := Color("#c9dcdc")
const VARSO_ROCK := Color("#867f74")
const VARSO_SIGN := Color(0.97, 0.94, 0.86)
## Each roof's planting: trees (at most), their height and crown radius, dwarf pines, benches,
## whether the edge has planters (the terrace kind) or one big bed (the garden kind).
const VARSO_GARDEN := {"trees": 16, "h": 5.8, "r": 2.0, "pines": 10, "benches": 4, "step": 4.6}
const VARSO_TERRACE := {"trees": 9, "h": 4.6, "r": 1.6, "pines": 4, "benches": 2, "step": 5.2}


func _find_varso_place() -> void:
	if _landmark("Varso I").size() < 3 or _landmark("Varso II").size() < 3:
		return
	var c := VARSO_ROCK_AT
	_add_site("varso_place", [PackedVector2Array([c, c + Vector2(0.2, 0), c + Vector2(0.2, 0.2), c + Vector2(0, 0.2)])])
	sites[-1]["box"] = VARSO_BOX


## The plaza's sign and the erratic (P1, P2), then the roof terraces on Varso 1 and 2 (T1-T3). No
## card: off the picking grid, a tap on the roofs finds what it found before.
func _build_varso_place(_site: Dictionary) -> void:
	_id = 0
	_varso_sign()
	_varso_rock()
	for name: String in ["Varso I", "Varso II"]:
		var outline := _landmark(name)
		if outline.size() < 3:
			continue
		var g := _ground_under(outline)
		var parts := _parts_in(outline, func(b: Dictionary) -> bool: return float(b["h"]) > float(b["mh"]) + 0.5)
		for b in parts:
			if float(b["mh"]) > 0.5 or float(b["h"]) < 40.0:
				continue
			for piece in _varso_open_roof(b, parts):
				_varso_garden(piece, g + float(b["h"]), VARSO_TERRACE)


## The part of a flat roof nothing taller stands on or rises through (every part that starts
## no more than a metre above it and ends higher is cut away), as pieces of at least 60 m².
func _varso_open_roof(roof: Dictionary, parts: Array) -> Array[PackedVector2Array]:
	var h := float(roof["h"])
	var out: Array[PackedVector2Array] = [_pts(roof["p"])]
	for b: Dictionary in parts:
		if b == roof or float(b["mh"]) > h + 1.0 or float(b["h"]) <= h + 0.5:
			continue
		var over := _pts(b["p"])
		var next: Array[PackedVector2Array] = []
		for piece in out:
			for q in Geometry2D.clip_polygons(piece, over):
				if q.size() >= 3 and not Geometry2D.is_polygon_clockwise(q):
					next.append(q)
		out = next
	return out.filter(func(q: PackedVector2Array) -> bool: return _area(q) >= 60.0)


## A planted roof (G1-G4, T1-T3): a timber deck inside a glass balustrade, a raised bed of
## perennials and lawn 2.5 m in from the edge, trees with round crowns in it on a grid, dwarf
## pines between them, timber benches along the bed. Out of the roof grid (the helicopter and the
## crowds keep reading the roof itself).
func _varso_garden(roof: PackedVector2Array, y: float, look: Dictionary) -> void:
	var rims := Geometry2D.offset_polygon(roof, -0.5)
	if rims.is_empty():
		return
	var none := Color(0, 0, 0, 0)
	var keep := _no_roof
	_no_roof = true
	_mode = M_STONE
	for rim: PackedVector2Array in rims:
		if rim.size() < 3 or Geometry2D.is_polygon_clockwise(rim):
			continue
		var rev := PackedVector2Array(rim)
		rev.reverse()
		_cap(rim, y + 0.12, VARSO_DECK)
		_prism(rim, y, y + 1.1, VARSO_RAIL, none, M_PAVILION + 0.5)
		_prism(rev, y, y + 1.1, VARSO_RAIL, none, M_PAVILION + 0.5)
	var trees := 0
	var pines := 0
	var benches := 0
	var step: float = look["step"]
	var k := 0
	for bed: PackedVector2Array in Geometry2D.offset_polygon(roof, -2.5):
		if bed.size() < 3 or Geometry2D.is_polygon_clockwise(bed) or _area(bed) < 12.0:
			continue
		_prism(bed, y + 0.12, y + 0.55, VARSO_GRANITE, VARSO_BEDS[k % VARSO_BEDS.size()], M_STONE, M_STONE)
		k += 1
		# Benches: timber seats on the deck along the bed's longest edges.
		var edges: Array = []
		for i in bed.size():
			edges.append([bed[i].distance_to(bed[(i + 1) % bed.size()]), i])
		edges.sort_custom(func(a: Array, b: Array) -> bool: return a[0] > b[0])
		for e: Array in edges:
			if benches >= int(look["benches"]) or float(e[0]) < 4.0:
				break
			var a := bed[int(e[1])]
			var b := bed[(int(e[1]) + 1) % bed.size()]
			var t := (b - a).normalized()
			var o := _out(bed, a, b)
			var m := (a + b) * 0.5 + o * 0.75
			_prism(PackedVector2Array([m - t * 1.0 - o * 0.25, m + t * 1.0 - o * 0.25, m + t * 1.0 + o * 0.25, m - t * 1.0 + o * 0.25]),
					y + 0.12, y + 0.55, VARSO_DECK.darkened(0.25), VARSO_DECK, M_STONE, M_STONE)
			benches += 1
		# The trees on a grid inside the bed (a metre in), then pines in the gaps.
		var inner := Geometry2D.offset_polygon(bed, -1.0)
		if inner.is_empty():
			continue
		var area: PackedVector2Array = inner[0]
		var lo := Vector2(INF, INF)
		var hi := -lo
		for q in area:
			lo = lo.min(q)
			hi = hi.max(q)
		var spots: Array[Vector2] = []
		var gaps: Array[Vector2] = []
		var nx := floori((hi.x - lo.x) / step) + 1
		var nz := floori((hi.y - lo.y) / step) + 1
		var off := (hi - lo - Vector2(nx - 1, nz - 1) * step) * 0.5
		for iz in nz:
			for ix in nx:
				var p := lo + off + Vector2(ix, iz) * step
				if Geometry2D.is_point_in_polygon(p, area):
					spots.append(p)
				var q := p + Vector2(step, step) * 0.5
				if Geometry2D.is_point_in_polygon(q, area):
					gaps.append(q)
		for p in spots:
			if trees >= int(look["trees"]):
				break
			var j := 0.9 + 0.2 * fposmod(sin(p.x * 12.9898 + p.y * 78.233) * 43758.5453, 1.0)
			_varso_tree(p, y + 0.55, float(look["h"]) * j, float(look["r"]) * j)
			trees += 1
		for p in gaps:
			if pines >= int(look["pines"]):
				break
			_pyramid(_circle(p, 0.7, 5), y + 0.55, y + 1.9, VARSO_PINE)
			pines += 1
	_no_roof = keep


## A small tree with a round crown (the hawthorns' spheres): a trunk, then two six-sided frusta
## widening to the crown's waist and closing over it.
func _varso_tree(p: Vector2, y: float, h: float, r: float) -> void:
	_prism(_square(p, 0.12), y, y + h * 0.42, VARSO_TRUNK, Color(0, 0, 0, 0), M_STONE)
	_mode = M_STONE
	_frustum(_circle(p, r * 0.3, 6), y + h * 0.32, _circle(p, r, 6), y + h * 0.62, VARSO_LEAF.darkened(0.12))
	_frustum(_circle(p, r, 6), y + h * 0.62, _circle(p, r * 0.4, 6), y + h, VARSO_LEAF, VARSO_LEAF.lightened(0.08))


## P1 the plaza's name sign: a granite plinth along Al. Jana Pawła II by the tower's north-east
## corner, VERSO PLACE (the parody name, never the real mark) in 0.7 m letters on its avenue face.
func _varso_sign() -> void:
	var c := VARSO_SIGN_AT
	var t := VARSO_SIGN_ALONG.normalized()
	var o := Vector2(t.y, -t.x)  # out of the face, towards the avenue (east-north-east)
	_g = map.terrain_height(c.x, c.y)
	var word := "VERSO PLACE"
	var k := 0.7 / (Neon.ROW_H * Neon.PIXEL)  # 0.7 m letters
	var half := 0.5 * k * Neon.length_of(word) + 0.5
	var plinth := PackedVector2Array([c - t * half - o * 0.45, c + t * half - o * 0.45, c + t * half + o * 0.45, c - t * half + o * 0.45])
	_prism(plinth, _g - 0.3, _g + 1.2, VARSO_GRANITE, VARSO_GRANITE.lightened(0.08), M_STONE, M_STONE)
	_collide(plinth)
	# map_builder sets the letters 0.4 m out from this point: 2 cm off the plinth's face.
	var at := c + o * 0.07
	signs.append([word, Vector3(at.x, _g + 0.25, at.y), Vector3(o.x, 0.0, o.y), k, VARSO_SIGN])


## P2 the glacial erratic: about 60 t (some 22 m³), a rounded grey block 4.2 x 3.2 x 2.1 m on the
## plaza by the tower's north-east corner; the car stops at it.
func _varso_rock() -> void:
	var c := VARSO_ROCK_AT
	_g = map.terrain_height(c.x, c.y)
	var ring := PackedVector2Array()
	for i in 8:
		var a := TAU * i / 8.0 + 0.3
		ring.append(c + Vector2(cos(a) * 2.1, sin(a) * 1.6).rotated(0.5))
	var mid := PackedVector2Array()
	var top := PackedVector2Array()
	for q in ring:
		mid.append(c + (q - c) * 0.92)
		top.append(c + (q - c) * 0.5)
	_mode = M_STONE
	_frustum(ring, _g - 0.2, mid, _g + 1.2, VARSO_ROCK)
	_frustum(mid, _g + 1.2, top, _g + 2.1, VARSO_ROCK.lightened(0.06), VARSO_ROCK.lightened(0.1))
	_collide(ring)


func _osm(value, fallback: Color) -> Color:
	var s := str(value).strip_edges().to_lower()
	if s == "":
		return fallback
	var c := Color.from_string(s, Color(0, 0, 0, 0))
	return fallback if c.a == 0.0 else c


# --- the skyline's towers (the landmarks loop) ------------------------------------------------

## A tower from its mapped parts, in its skin (TOWERS). The outline itself (named like the
## tower, or the one part that holds all the others) is left out when parts are mapped; a part
## that starts in the air with nothing mapped under it stands on the ground.
func _build_tower(site: Dictionary) -> void:
	var spec: Dictionary = site["tower"]
	var zone: PackedVector2Array = site["zone"][0]
	if spec.get("novotel", false):
		_build_novotel(zone)
		return
	_g = _ground_under(zone)
	var g := _g
	var glass := Color(spec["glass"])
	var roof := Color(spec["roof"])
	var skin := M_SKIN + float(spec["style"]) / 16.0
	var parts := _parts_in(zone, func(b: Dictionary) -> bool: return float(b["h"]) > float(b["mh"]) + 0.5)
	if parts.is_empty() and spec.has("h"):
		# An office the LoD2 data covers is no longer in the OSM building list: the outline itself, at `h`.
		var flat: Array = []
		for q in zone:
			flat.append(q.x)
			flat.append(q.y)
		parts.append({"p": flat, "h": float(spec["h"]), "mh": 0.0, "c": "", "rc": "", "kind": "office", "name": str(spec.get("osm", ""))})
	if spec["key"] == "lim":
		# Centrum LIM: the podium is built from F's photos (_lim_podium), not in the tower's glass
		# (its ground floor is the part named like the outline, so before the filter below).
		parts = _lim_parts(parts, g)
	if parts.size() > 1:
		parts = parts.filter(func(b: Dictionary) -> bool: return str(b.get("name", "")) != spec.get("osm", ""))
	var boxes: Array[Rect2] = []
	var top_h := 0.0
	var top_poly := PackedVector2Array()
	var sign_poly := PackedVector2Array()
	var sign_h := 0.0
	for b in parts:
		boxes.append(_box_of([_pts(b["p"])]))
		if float(b["h"]) > top_h:
			top_h = float(b["h"])
			top_poly = _pts(b["p"])
	# RD-1 the taper (Warsaw Unit): every part from `taper.x` up is narrowed towards the shaft's
	# centre, linearly to `taper.z` at `taper.y` and held there above it (the crown).
	var tp: Vector3 = spec.get("taper", Vector3.ZERO)
	var taper_c := Vector2.ZERO
	for b in parts:
		if tp.z > 0.0 and absf(float(b["mh"]) - tp.x) < 0.5 and float(b["h"]) > tp.y - 0.5:
			taper_c = _centre(_pts(b["p"]))
	var shrink := func(y: float) -> float:
		return 1.0 if tp.z <= 0.0 else lerpf(1.0, tp.z, clampf((y - g - tp.x) / (tp.y - tp.x), 0.0, 1.0))
	var lifted: Array[PackedVector2Array] = []
	var lift_h := 0.0
	if spec["key"] == "zlota44":
		# Złota 44: the tower is lofted (_zlota_sail); only the podium is built from its parts,
		# with its roof garden.
		_zlota_sail(g, glass, roof, skin)
		_zlota_garden(parts, g)
	elif spec["key"] == "spire":
		# Warsaw Spire: the leaf-shaped tower lofted and tapering (_spire); the two lower
		# office buildings beside it are built from their parts.
		var masts: Array = []
		for b in parts:
			if float(b["h"]) >= 200.0:
				masts.append(_centre(_pts(b["p"])))
		_spire(zone, g, glass, roof, skin, masts)
		for w in range(1, (site["zone"] as Array).size()):
			_spire_wing(site["zone"][w])
		_g = g
	for k in parts.size():
		var b: Dictionary = parts[k]
		var poly := _pts(b["p"])
		var h := float(b["h"])
		var mh := float(b["mh"])
		if spec["key"] == "zlota44" and h > 40.0 or spec["key"] == "spire" and h > 100.0:
			continue
		if mh > 0.5:
			var held := false
			for j in parts.size():
				if j != k and float(parts[j]["mh"]) < mh - 0.5 and float(parts[j]["h"]) >= mh - 1.5 \
						and boxes[j].grow(-0.5).intersects(boxes[k].grow(-0.5)):
					held = true
					break
			if not held:
				if spec.has("hall") and mh < 15.0:
					lifted.append(poly)  # RD-1: a wing lifted over the gate's glass hall
					lift_h = mh
				else:
					mh = 0.0
		var small := boxes[k].size.length() < 9.0
		var base := g + mh - (0.4 if mh < 0.5 else 0.0)
		if small and spec.has("arcade") and h <= float(spec["arcade"]) + 0.5:
			# RD-2 Mennica's arcade: a mapped post is a round stainless column, 0.9 m across.
			var cc := Color(spec["columns"])
			_prism(_circle(_centre(poly), 0.45, 10), g - 0.4, g + h, cc, cc, M_STONE, M_STONE)
			continue
		if small and spec.has("hall"):
			base = g - 0.4  # Unit's gate posts stand on the ground
		if small:
			# A mast, a spire's piece or a ring: plain painted steel in its mapped colour. It starts on
			# the roof of the part it stands on (Skyliner's mast on its crown block: no faces inside).
			var foot := _centre(poly)
			for j in parts.size():
				if j != k and not boxes[j].size.length() < 9.0 and boxes[j].has_point(foot) \
						and Geometry2D.is_point_in_polygon(foot, _pts(parts[j]["p"])) and float(parts[j]["h"]) < h:
					base = maxf(base, g + float(parts[j]["h"]) - 0.4)
			var c := _osm(b["c"], roof)
			_prism(poly, base, g + h, c, c.lightened(0.1), M_STONE, M_STONE)
			continue
		if spec.has("top"):
			h = minf(h, float(spec["top"]))
		var wall := glass
		var part_skin := skin
		var crown := spec.has("crown_from") and mh >= float(spec["crown_from"]) - 0.5
		if crown:
			wall = Color(spec["crown"])
			part_skin = M_SKIN + float(S_DARK) / 16.0
			# Cladding 6 cm proud of the shaft's plane, so where the block's face runs on in the
			# shaft's (Skyliner's north face) the two never share a plane.
			var proud := Geometry2D.offset_polygon(poly, 0.06)
			if proud.size() == 1:
				poly = proud[0]
		elif spec.get("mapped", false):
			wall = _osm(b["c"], glass)  # mapped in its own colours (Chałubińskiego 8's white ribs)
		elif h < top_h * 0.3 and h < 40.0:
			# The podium: the tower's glass, a step warmer and darker (Unit's: dark sloped glass).
			wall = Color(spec["podium"]) if spec.has("podium") \
					else glass.darkened(0.12).lerp(Color("#b8a88c"), 0.0 if spec.get("cool", false) else 0.15)
			if spec.has("podium_style"):
				part_skin = M_SKIN + float(spec["podium_style"]) / 16.0
		if spec.has("arcade") and absf(h - float(spec["arcade"])) < 0.5 and mh < 0.5:
			# RD-2 the arcade's lobby: copper-tinted glass 5 m in from the column line, lit warm.
			var lobby := Geometry2D.offset_polygon(poly, -5.0)
			if lobby.size() == 1:
				_prism(lobby[0], g - 0.4, g + h, Color(spec["lobby"]), Color(0, 0, 0, 0), M_PAVILION, M_STONE)
			_collide(poly)
			continue
		if spec.has("arcade") and absf(mh - float(spec["arcade"])) < 0.5:
			_soffit(poly, g + mh, roof.darkened(0.25))  # the shaft's underside over the arcade
		if tp.z > 0.0 and mh >= tp.x - 0.5:
			var s0: float = shrink.call(g + mh)
			var s1: float = shrink.call(g + h)
			if absf(s0 - s1) < 0.0005:
				poly = _scaled(poly, taper_c, s0)
			else:
				var p0 := _scaled(poly, taper_c, s0)
				var p1 := _scaled(poly, taper_c, s1)
				var keep_m := _mode
				_mode = part_skin
				_frustum(p0, base, p1, g + h, wall)
				_mode = keep_m
				_cap(p1, g + h, roof)
				if spec.has("strips") and not crown and h >= 100.0:
					_tower_strips(poly, base + 2.0, g + h, Color(spec["strips"]), taper_c, s0, s1)
				continue
		if spec.get("crest", "") == "slope" and h >= top_h - 0.5:
			_sloped(poly, base, g + h, g + h - 24.0, wall, roof, skin)
		elif spec.has("slope_to") and not crown and h >= 100.0:
			_tower_cut(poly, base, g + h, spec, wall, roof, part_skin)
		else:
			_prism(poly, base, g + h, wall, roof, part_skin, M_SKIN)
			if crown and spec.get("crown_sign", false) and h > sign_h and not small:
				sign_poly = poly  # the crown block's highest part (Skyliner's mast is taller)
				sign_h = h
			if spec.has("strips") and not crown and h >= 100.0:
				_tower_strips(poly, base + 2.0, g + h, Color(spec["strips"]))
			if spec.has("band") and h >= top_h - 0.5:
				_tower_band(poly, g + 8.5, g + 11.5, Color(spec["band"]))
			if spec.get("crest", "") == "frame" and h >= top_h - 0.5:
				# Rondo 1: an open frame round the top, from the roof to 192 m.
				_prism(poly, g + h, g + 192.0, wall, Color(0, 0, 0, 0), M_SKIN + float(S_FRAME) / 16.0)
			if spec.get("chamfer", false) and h >= top_h - 0.5:
				_chamfered_top(poly, g + h, wall)
			if spec.has("patches") and h >= 100.0:
				_tower_patches(poly, base, g + h, Color(spec["patches"]))
			if spec.has("parapet") and h >= minf(top_h, float(spec.get("top", INF))) - 0.5:
				_tower_roof(poly, g + h, Color(spec["parapet"]), spec.get("plant", Vector2.ZERO))
		if mh < 2.0:
			_collide(poly)
	if spec.has("top"):
		top_h = minf(top_h, float(spec["top"]))
	if tp.z > 0.0:
		top_poly = _scaled(top_poly, taper_c, shrink.call(g + top_h))
	if not lifted.is_empty():
		_gate_hall(lifted, g, lift_h, float(spec["hall"]), Color("#2e4560"))
	if spec.has("skylight"):
		_podium_skylight(spec["skylight"][0], float(spec["skylight"][1]))
	for t: Array in site.get("terraces", []):
		_roof_terrace(t[0], float(t[1]), t[2])
	if sign_poly.size() >= 3:
		# The sign on the crown block, not on the shaft (_dusk_details skips it); a name of two
		# words on a narrow block goes in two rows, so the letters stay readable from the street.
		var words := str(spec["sign"]).split(" ")
		var narrow := _box_of([sign_poly]).size.length() < 40.0
		if words.size() > 1 and narrow:
			for n in words.size():
				_crown_signs(sign_poly, g + sign_h, words[n], spec.get("sign_col", DUSK_WARM), 4.0 + 7.0 * n, 0.85)
		else:
			_crown_signs(sign_poly, g + sign_h, str(spec["sign"]), spec.get("sign_col", DUSK_WARM), 4.0, 0.8)
	_dusk_details(spec, top_poly, g, top_h)


## Skyliner's cut roof (the photo report, 2026-11-03): the shaft's top falls 24 m from the side
## `slope_to` points at to the far side, and a glass fin stands on the high edge, rising 20 m over
## it. Walls from `y0`; the roof is the sloped plane.
func _tower_cut(poly: PackedVector2Array, y0: float, hi: float, spec: Dictionary, wall: Color, roof: Color, skin: float) -> void:
	var axis: Vector2 = (spec["slope_to"] as Vector2).normalized()
	var c := _centre(poly)
	var lo_d := INF
	var hi_d := -INF
	for q in poly:
		lo_d = minf(lo_d, (q - c).dot(axis))
		hi_d = maxf(hi_d, (q - c).dot(axis))
	var top := func(q: Vector2) -> float:
		return lerpf(hi - 24.0, hi, inverse_lerp(lo_d, hi_d, (q - c).dot(axis)))
	var keep := _mode
	_mode = skin
	var run := 0.0
	for i in poly.size():
		var a := poly[i]
		var b := poly[(i + 1) % poly.size()]
		var ta: float = top.call(a)
		var tb: float = top.call(b)
		var n := _out(poly, a, b)
		var nv := Vector3(n.x, 0.0, n.y)
		var l := a.distance_to(b)
		# The straight part through _wall (it clips what the site's other walls already cover in
		# the plane: the mast's and the crown's), the sloped strip over it as one triangle or two.
		var low := minf(ta, tb)
		_wall(a, b, y0, low, n, wall, run)
		if absf(ta - tb) > 0.01:
			if ta > tb:
				_tri(Vector3(a.x, low, a.y), Vector3(b.x, low, b.y), Vector3(a.x, ta, a.y), nv, wall,
						Vector2(run, low - _g), Vector2(run + l, low - _g), Vector2(run, ta - _g), ta - _g)
			else:
				_tri(Vector3(a.x, low, a.y), Vector3(b.x, low, b.y), Vector3(b.x, tb, b.y), nv, wall,
						Vector2(run, low - _g), Vector2(run + l, low - _g), Vector2(run + l, tb - _g), tb - _g)
		run += l
	_mode = M_STONE
	# The sloped roof over the outline, untangled first (a mapped outline that doubles back would
	# triangulate into overlapping triangles: _cap does the same).
	for flat in Geometry2D.merge_polygons(poly, PackedVector2Array()):
		if flat.size() >= 3 and not Geometry2D.is_polygon_clockwise(flat):
			_cut_roof(flat, top, roof)
	if spec.has("fin"):
		_cut_fin(poly, c, axis, hi, top, Color(spec["fin"]))
	_mode = keep


func _cut_roof(poly: PackedVector2Array, top: Callable, roof: Color) -> void:
	var idx := Geometry2D.triangulate_polygon(poly)
	for i in range(0, idx.size(), 3):
		var p0 := poly[idx[i]]
		var p1 := poly[idx[i + 1]]
		var p2 := poly[idx[i + 2]]
		var v0 := Vector3(p0.x, top.call(p0), p0.y)
		var v1 := Vector3(p1.x, top.call(p1), p1.y)
		var v2 := Vector3(p2.x, top.call(p2), p2.y)
		var nrm := (v1 - v0).cross(v2 - v0).normalized()
		if nrm.y < 0.0:
			nrm = -nrm
		_tri(v0, v1, v2, nrm, roof, Vector2(-1, -1), Vector2(-1, -1), Vector2(-1, -1), -1.0)


## Skyliner's glass fin: a plate along the cut's high edge, 0.6 m thick, 20 m over the cut.
func _cut_fin(poly: PackedVector2Array, c: Vector2, axis: Vector2, hi: float, top: Callable, col: Color) -> void:
	var best := 0
	var best_dot := -INF
	for i in poly.size():
		var d := ((poly[i] + poly[(i + 1) % poly.size()]) * 0.5 - c).dot(axis)
		if d > best_dot and poly[i].distance_to(poly[(i + 1) % poly.size()]) > 10.0:
			best_dot = d
			best = i
	var a := poly[best]
	var b := poly[(best + 1) % poly.size()]
	var inward := -_out(poly, a, b)
	# 0.1 m in from the face, so the plate never shares the shaft's plane.
	var f0 := a.lerp(b, 0.15) + inward * 0.1
	var f1 := a.lerp(b, 0.6) + inward * 0.1
	var fin := PackedVector2Array([f0, f1, f1 + inward * 0.6, f0 + inward * 0.6])
	_prism(fin, minf(top.call(f0), top.call(f1)) - 1.0, hi + 20.0, col, col.lightened(0.2), M_PAVILION + 0.5, M_STONE)


## Warsaw Unit's black strips (the photo report): a 4.5 m strip at each end and in the middle of
## every long face, 0.15 m proud of the glass, from `y0` to `y1`.
func _tower_strips(poly: PackedVector2Array, y0: float, y1: float, col: Color, c := Vector2.ZERO, s0 := 1.0, s1 := 1.0) -> void:
	var longest := 0.0
	for i in poly.size():
		longest = maxf(longest, poly[i].distance_to(poly[(i + 1) % poly.size()]))
	for i in poly.size():
		var a := poly[i]
		var b := poly[(i + 1) % poly.size()]
		var l := a.distance_to(b)
		if l < longest * 0.5 or l < 20.0:
			continue
		var e := (b - a) / l
		var o := _out(poly, a, b) * 0.15
		for t: float in [0.0, 0.5 * l - 2.25, l - 4.5]:
			var p0 := a + e * t
			var p1 := a + e * (t + 4.5)
			var strip := PackedVector2Array([p0, p1, p1 + o, p0 + o])
			if absf(s0 - 1.0) < 0.0005 and absf(s1 - 1.0) < 0.0005:
				_prism(strip, y0, y1, col, col, M_SKIN + float(S_DARK) / 16.0, M_STONE)
			else:
				# RD-1: on the tapering shaft the strip leans in with the glass.
				var keep := _mode
				_mode = M_SKIN + float(S_DARK) / 16.0
				_frustum(_scaled(strip, c, s0), y0, _scaled(strip, c, s1), y1, col)
				_mode = keep


## The hotel's dark band over its glazed ground floors (the HUB photo report), 0.2 m proud.
func _tower_band(poly: PackedVector2Array, y0: float, y1: float, col: Color) -> void:
	var wide := Geometry2D.offset_polygon(poly, 0.2)
	if wide.size() == 1:
		_prism(wide[0], y0, y1, col, col, M_STONE, M_STONE)


## A plan scaled by `k` about `c` (RD-1's taper).
func _scaled(poly: PackedVector2Array, c: Vector2, k: float) -> PackedVector2Array:
	var out := PackedVector2Array()
	for q in poly:
		out.append(c + (q - c) * k)
	return out


## RD-1 Warsaw Unit's gate (the report, street photos 2026-11-06): the base wings lifted 9 m stand
## over a glass hall set `inset` in, lit cool at night, under the wings' dark soffit.
func _gate_hall(lifted: Array[PackedVector2Array], g: float, lift: float, inset: float, col: Color) -> void:
	# The wings overlap (OpenStreetMap maps the base twice): one outline, their union's outer ring.
	var acc := lifted[0]
	for i in range(1, lifted.size()):
		acc = _largest(Geometry2D.merge_polygons(acc, lifted[i]))
	for m: PackedVector2Array in [acc]:
		_soffit(m, g + lift, col.darkened(0.35))
		var hall := Geometry2D.offset_polygon(m, -inset)
		for h in hall:
			if not Geometry2D.is_polygon_clockwise(h):
				_prism(h, g - 0.4, g + lift, Color("#9fb9cc"), Color(0, 0, 0, 0), M_PAVILION + 0.5, M_STONE)
		_collide(m)


## RD-3 Generation Park Y's black spandrels (the report, photo 1): on each face 3 m bays a storey
## (3.9 m) tall; every few storeys a row holds a patch a bay or two wide, and the top two storeys
## are dark under a 1.2 m white parapet. Panels 0.1 m proud of the glass, picked by a fixed hash.
func _tower_patches(poly: PackedVector2Array, y0: float, y1: float, col: Color) -> void:
	var keep := _mode
	_mode = M_STONE
	var white := Color("#e3e1da")
	var run := 0.0
	for i in poly.size():
		var a := poly[i]
		var b := poly[(i + 1) % poly.size()]
		var l := a.distance_to(b)
		var o := _out(poly, a, b)
		var e := (b - a) / maxf(l, 0.01)
		var lo := a + o * 0.1
		if l >= 6.0:
			var bays := int(l / 3.0)
			var pad := (l - bays * 3.0) * 0.5
			for lv in range(2, int((y1 - y0) / 3.9) - 2):
				var row := hash(Vector2i(lv, 7)) % 100
				if row >= 24:
					continue
				for bay in bays:
					var r := hash(Vector3i(bay + int(run), lv, i)) % 100
					if r >= 22:
						continue
					var w := 6.0 if r < 8 and bay < bays - 1 else 3.0
					var t := pad + bay * 3.0
					_wall(lo + e * t, lo + e * (t + w), y0 + lv * 3.9, y0 + (lv + 1) * 3.9, o, col)
		# the dark top storeys and the white parapet over them, all round
		_wall(lo, lo + e * l, y1 - 7.8, y1 - 1.2, o, col)
		_wall(lo, lo + e * l, y1 - 1.2, y1 + 0.3, o, white)
		run += l
	_mode = keep


## RD-4 the HUB's roofs (the report's ortho): a 1.5 m parapet with a silver edge, its inner face
## too, and a grey plant block of `plant` metres (along the longest edge, across) in the middle.
func _tower_roof(poly: PackedVector2Array, y: float, col: Color, plant: Vector2) -> void:
	var keep := _mode
	_mode = M_STONE
	_prism(poly, y, y + 1.5, col, Color(0, 0, 0, 0), M_STONE)
	var inner := Geometry2D.offset_polygon(poly, -0.3)
	if inner.size() == 1:
		var r := inner[0]
		for i in r.size():
			var a := r[i]
			var b := r[(i + 1) % r.size()]
			_wall(a, b, y, y + 1.5, -_out(r, a, b), col.darkened(0.15))
	if plant.x > 0.0:
		var c := _centre(poly)
		var e := Vector2.RIGHT
		var longest := 0.0
		for i in poly.size():
			var d := poly[(i + 1) % poly.size()] - poly[i]
			if d.length() > longest:
				longest = d.length()
				e = d.normalized()
		var n := Vector2(-e.y, e.x)
		var hx := e * plant.x * 0.5
		var hz := n * plant.y * 0.5
		var box := PackedVector2Array([c - hx - hz, c + hx - hz, c + hx + hz, c - hx + hz])
		_prism(box, y, y + 4.5, Color("#a4a9ad"), Color("#8f9599"), M_STONE, M_STONE)
		for k in 3:
			# fan units along the block's long side
			var f := c - hx * 0.6 + hx * 0.6 * k + n * (plant.y * 0.5 + 2.0)
			_prism(_square(f, 1.1), y, y + 1.6, Color("#9aa0a4"), Color("#5f6569"), M_STONE, M_STONE)
	_mode = keep


## RD-4 the HUB podium's skylight (the report's ortho): a glazed ridge over a steel kerb on the
## 10.9 m podium between the two towers, lit cool at night, and green plant strips either side.
func _podium_skylight(r: Rect2, podium_h: float) -> void:
	var ring := PackedVector2Array([r.position, Vector2(r.end.x, r.position.y), r.end, Vector2(r.position.x, r.end.y)])
	var gy := _ground_under(ring)
	var y := gy + podium_h
	_prism(ring, y, y + 0.6, Color("#3a3f44"), Color("#3a3f44"), M_STONE, M_STONE)
	var cx := r.get_center().x
	var ridge := PackedVector2Array([Vector2(cx - 0.15, r.position.y + 0.8), Vector2(cx + 0.15, r.position.y + 0.8),
			Vector2(cx + 0.15, r.end.y - 0.8), Vector2(cx - 0.15, r.end.y - 0.8)])
	var keep := _mode
	_mode = M_PAVILION + 0.5
	_frustum(ring, y + 0.6, ridge, y + 2.6, Color("#9fc3d6"), Color("#9fc3d6"))
	_mode = keep
	for side: float in [-1.0, 1.0]:
		var x0 := (r.position.x - 4.0) if side < 0.0 else (r.end.x + 2.0)
		var strip := PackedVector2Array([Vector2(x0, r.position.y), Vector2(x0 + 2.0, r.position.y),
				Vector2(x0 + 2.0, r.end.y), Vector2(x0, r.end.y)])
		_prism(strip, y, y + 0.45, Color("#6c7a5c"), Color("#6f8f4e"), M_STONE, M_STONE)


## RD-3 the terraces' roofs, found once with the whole map (a sector's build sees only its own
## buildings): for each (x, roof height, z) the outline at that height holding the point, and the
## higher blocks standing on it.
func _find_terraces(points: Array) -> Array:
	var out: Array = []
	for t: Vector3 in points:
		var at := Vector2(t.x, t.z)
		var roof := PackedVector2Array()
		var over: Array[PackedVector2Array] = []
		for bld in data["buildings"]:
			var q := _pts(bld["p"])
			if q.size() >= 3 and absf(float(bld["h"]) - t.y) < 0.3 and Geometry2D.is_point_in_polygon(at, q):
				roof = q
		if roof.size() < 3:
			push_warning("landmarks: no %.1f m roof at %s for a terrace" % [t.y, at])
			continue
		# Only blocks whose middle stands on this roof (the parts bake_sectors.py keeps for the
		# wing's named outline, so both city paths find the same).
		var box := _box_of([roof])
		for bld in data["buildings"]:
			var q := _pts(bld["p"])
			if q.size() < 3 or float(bld["h"]) <= t.y + 1.0 or float(bld["mh"]) >= t.y + 1.0:
				continue
			var c := _centre(q)
			if box.has_point(c) and Geometry2D.is_point_in_polygon(c, roof):
				over.append(q)
		out.append([roof, t.y, over])
	return out


## RD-3 a decked roof terrace on one of Generation Park's low wings (the report, ortho_wide): on
## the roof at `h` that holds `at`, timber decking 1.5 m in from the edge, red café tables and
## small trees in planters, none where a higher block stands on the roof.
func _roof_terrace(roof: PackedVector2Array, h: float, over: Array) -> void:
	var gy := _ground_under(roof)
	var y := gy + h
	var deck := Geometry2D.offset_polygon(roof, -1.5)
	if deck.size() != 1:
		return
	var keep := _mode
	_mode = M_STONE
	_prism(deck[0], y, y + 0.2, Color("#7a5c44"), Color("#9a7556"), M_STONE, M_STONE)
	var box := _box_of([deck[0]])
	var n := 0
	var x := box.position.x + 3.0
	while x < box.end.x - 2.0:
		var z := box.position.y + 3.0
		while z < box.end.y - 2.0:
			var p := Vector2(x, z)
			var free := Geometry2D.is_point_in_polygon(p, deck[0])
			for q in over:
				if free and Geometry2D.is_point_in_polygon(p, q) or free and _dist_to_ring(p, q) < 2.5:
					free = false
			if free:
				if (n % 2) == 0:
					_prism(_square(p, 0.6), y + 0.2, y + 0.75, Color("#6a6f72"), Color("#5a6b3e"), M_STONE, M_STONE)
					_varso_tree(p, y + 0.75, 3.6, 1.3)
				else:
					_prism(_square(p, 0.45), y + 0.2, y + 0.95, Color("#b5342c"), Color("#c23c32"), M_STONE, M_STONE)
				n += 1
			z += 9.0
		x += 9.0
	_mode = keep


func _dist_to_ring(p: Vector2, ring: PackedVector2Array) -> float:
	var best := INF
	for i in ring.size():
		best = minf(best, p.distance_to(Geometry2D.get_closest_point_to_segment(p, ring[i], ring[(i + 1) % ring.size()])))
	return best


## Novotel's cut-off top (the Rondo photos): the shaft ends in two setbacks, 1.4 m in and 2.8 m
## in, each 2.2 m tall, so the corners read chamfered from the street, in the shaft's white.
func _chamfered_top(poly: PackedVector2Array, roof_y: float, wall: Color) -> void:
	var y := roof_y
	for inset: float in [1.4, 2.8]:
		var shrunk := Geometry2D.offset_polygon(poly, -inset)
		if shrunk.is_empty():
			return
		_prism(shrunk[0], y, y + 2.2, wall, wall.darkened(0.1), M_SKIN + float(S_TILE) / 16.0, M_STONE)
		y += 2.2


## The dusk loop (2026-10-31): what lights up a tower's crown after dark. The tallest part
## `poly` (roof at g + top_h): the Marriott's bands and mast, a hotel's name, and red
## aviation lights on a roof of 100 m or more (the Spire and Złota 44 do theirs in their own
## builders).
func _dusk_details(spec: Dictionary, poly: PackedVector2Array, g: float, top_h: float) -> void:
	if poly.size() < 3:
		return
	if spec.get("marriott", false):
		_marriott(poly, g, top_h)
	if spec.has("sign") and not spec.get("crown_sign", false):
		_crown_signs(poly, g + top_h, str(spec["sign"]), spec.get("sign_col", DUSK_WARM), 3.0,
				0.75 if spec.get("marriott", false) else 0.7)
	if spec.has("base_sign"):
		# A shop's name over the ground floor on the south and east faces (Rondo 1's clinic).
		_crown_signs(poly, g + 5.2, str(spec["base_sign"]), Color(0.75, 1.0, 0.95), 0.0, 0.3)
	if spec.has("vsign"):
		_crown_signs(poly, g + top_h, str(spec["vsign"]), VSIGN_BLUE, 5.0, 0.5, true)
		_vsign_tail(poly, g + top_h - 5.0 - 7.04 * str(spec["vsign"]).length())
	if top_h >= 100.0 and spec["key"] != "zlota44" and spec["key"] != "spire":
		var roof_y := func(_q: Vector2) -> float: return g + top_h
		if spec.get("crest", "") == "slope":
			roof_y = _slope_roof(poly, g + top_h, g + top_h - 24.0)
		_aviation(poly, roof_y)


const DUSK_WARM := Color(1.0, 0.95, 0.86)
const DUSK_RED := Color(1.0, 0.12, 0.1)
## NOWOTEL's name: blue neon, letter over letter down the shaft (the Rondo photos).
const VSIGN_BLUE := Color(0.18, 0.42, 1.0)


## The Nowotel's tail under its stacked name (the Rondo night photos): an orange rule, the
## chain's parody line (ACORN over HOTELS) in the same blue, on the faces the name is on.
func _vsign_tail(poly: PackedVector2Array, y: float) -> void:
	_crown_signs(poly, y - 1.0, "--", Color(1.0, 0.5, 0.15), 0.0, 0.3)
	_crown_signs(poly, y - 3.5, "ACORN", VSIGN_BLUE, 0.0, 0.3)
	_crown_signs(poly, y - 6.5, "HOTELS", VSIGN_BLUE, 0.0, 0.26)


## The Marriott (the dusk loop): a dark band round the crown (top 7 m) and one two thirds up
## (4 m), each 0.15 m proud of the glass, a lattice mast on the roof (shaft, platform, a red
## lamp on top) and the brand's parody (SAMSONG) lit on the mid band, on the south and east
## faces. The name on the crown goes up with the `sign` key (_dusk_details).
func _marriott(poly: PackedVector2Array, g: float, h: float) -> void:
	var band := Color("#14191c")
	var mode := M_SKIN + float(S_DARK) / 16.0
	var wide := Geometry2D.offset_polygon(poly, 0.15)
	if wide.is_empty():
		return
	var out: PackedVector2Array = wide[0]
	var mid := g + 0.62 * h
	_prism(out, g + h - 7.0, g + h, band, Color(0, 0, 0, 0), mode)
	_prism(out, mid - 2.0, mid + 2.0, band, Color(0, 0, 0, 0), mode)
	var c := _centre(poly)
	var roof := g + h
	var steel := Color("#b8b2a8")
	_prism(_square(c, 1.2), roof, roof + 26.0, steel, steel.lightened(0.1), M_STONE, M_STONE)
	_prism(_square(c, 3.0), roof + 14.0, roof + 14.6, steel.darkened(0.15), steel, M_STONE, M_STONE)
	_prism(_square(c, 0.4), roof + 26.0, roof + 26.8, DUSK_RED, DUSK_RED, M_LAMP, M_LAMP)
	_crown_signs(poly, mid, "SAMSONG", DUSK_WARM, 0.0, 0.75)


