	# The masts: from the foot of the skin, leaning out with it, spiking over the roof.
	for k in n:
		var vi: Vector2 = inner[k]
		var vo: Vector2 = outer[k]
		var a := Vector3(vi.x, foot[k], vi.y)
		var b := Vector3(vo.x, street + 60.0, vo.y)
		_beam(a, b, 0.55, Color("#e4e6ea"))
		# The spike over the rim, thicker: the stadium's silhouette from the street.
		var s0 := a.lerp(b, (rim_y - 1.0 - a.y) / (b.y - a.y))
		_beam(s0, b + (b - a).normalized() * 0.4, 1.0, Color("#f2f3f5"))
	# The needle (mapped 30-100 m): a white spindle through a dark hub ring where the cables
	# meet (37-43 m, 15.6 m across), the folded roof stored in a white drum above it (55-63 m,
	# 21 m across), and a red light on its tip; a cable from the hub to every third mast's
	# angle on the roof's inner edge.
	var steel := Color("#f1f1ee")
	var ring10 := func(radius: float) -> PackedVector2Array:
		var ring := PackedVector2Array()
		for k in 10:
			ring.append(c + Vector2.from_angle(TAU * k / 10.0) * radius)
		return ring
	_frustum(ring10.call(0.6), street + 30.0, ring10.call(1.0), street + 37.0, steel)
	_prism(ring10.call(7.8), street + 37.0, street + 43.0, Color("#2c2d31"), Color("#3a3b40"), M_STONE, M_STONE)
	_frustum(ring10.call(1.0), street + 43.0, ring10.call(1.2), street + 51.5, steel)
	_frustum(ring10.call(1.2), street + 51.5, ring10.call(10.5), street + 55.0, steel)
	_frustum(ring10.call(10.5), street + 55.0, ring10.call(10.5), street + 61.0, Color("#e6e7e4"))
	_frustum(ring10.call(10.5), street + 61.0, ring10.call(1.6), street + 63.5, steel, steel)
	_frustum(ring10.call(1.0), street + 63.5, ring10.call(0.3), street + 99.0, steel)
	_prism(ring10.call(0.45), street + 99.0, street + 100.5, Color("#ff3b30"), Color("#ff6a5c"), M_LAMP, M_LAMP)
	var hub := Vector3(c.x, street + 40.0, c.y)
	var keep_id := _id
	_id = 0
	for k in range(0, n, 3):
		var h: Vector2 = hole[k]
		# A few cm of height apart at the hub, so neighbours' flat tops don't z-fight there.
		var lift := Vector3(0.0, (k / 3 % 5) * 0.03, 0.0)
		_beam(hub + lift, Vector3(h.x, hole_y, h.y), 0.18, Color("#c8cbd0"), false)
	_id = keep_id


## A square beam from a to b, `w` wide (masts, cables). Cables stay out of the roof grid.
func _beam(a: Vector3, b: Vector3, w: float, col: Color, solid := true, mode := M_STONE) -> void:
	var z := (b - a).normalized()
	var x := Vector3.UP.cross(z)
	if x.length_squared() < 0.001:
		x = Vector3.RIGHT
	x = x.normalized() * w * 0.5
	var y := z.cross(x).normalized() * w * 0.5
	var keep := _mode
	_mode = mode
	var corners := [x + y, -x + y, -x - y, x - y]
	for k in 4:
		var c0: Vector3 = corners[k]
		var c1: Vector3 = corners[(k + 1) % 4]
		var nrm := (c0 + c1).normalized()
		var p0 := a + c0
		var p1 := a + c1
		var p2 := b + c1
		var p3 := b + c0
		_tri(p0, p1, p2, nrm, col, Vector2(-1, -1), Vector2(-1, -1), Vector2(-1, -1), -1.0, solid)
		_tri(p0, p2, p3, nrm, col, Vector2(-1, -1), Vector2(-1, -1), Vector2(-1, -1), -1.0, solid)
	_mode = keep


# --- Warszawa Centralna -----------------------------------------------------------------------

## Colours (spec centralna.md section 5).
const CEN_GLASS := Color("#7f9fb2")     # the hall's curtain wall, lit cool white at night
const CEN_WING := Color("#8d9aa2")      # the wings' glass in a light concrete grid
const CEN_STONE := Color("#bcbaab")     # mapped: the wings and their roof boxes
const CEN_DECK := Color("#9c9a90")      # the wings' and boxes' roofs
const CEN_DOOR := Color("#3f4c55")      # the vestibules' dark glass
const CEN_FASCIA := Color("#e4e2dc")    # mapped white: the slab's edge and the shells' fascia
const CEN_ROOF := Color("#638898")      # mapped roof colour
const CEN_SOFFIT := Color("#9a968c")    # the shells' underside: the ceiling, lit at night
const CEN_PILLAR := Color("#bdb8ad")
## The shells' grid (local metres): the pillars stand on every other node along u (10 m apart
## from -65.4) on the rows v -20.5 and 21.2; the ends are the shell tier's mapped edges.
const CEN_SHELL_U0 := -65.4
const CEN_SHELL_V := [-28.0, -20.5, -13.55, -6.6, 0.35, 7.3, 14.25, 21.2, 28.9]
const CEN_SHELL_ENDS := Vector2(-68.5, 68.7)
const CEN_LOW := 12.0    # the underside at the pillar rows: the pillars' heads (photo 1)
const CEN_APEX := 14.2   # the arch's crown between the rows, over the hall
const CEN_EDGE := 16.0   # the underside at the slab's long edges: the wing tips, 2 m thick
const CEN_HIGH := 16.5   # the hall's glass goes up into the roof to here
const CEN_TOP := 18.0
const CEN_STEPS := 6     # profile pieces per half bay
const CEN_END := Color("#b9b7b0")  # the shells' end faces, grey under the white fascia

## The station hall's glass box under the flat overhanging slab, and under the slab the roof's
## shells: falling from the long edges to the pillar rows like wings and arching over the hall
## between them, the winged shape that shows at both ends. At night the hall glows cool white
## floor by floor, the shells' underside is lit, and lamps line the slab's edge.
func _build_centralna(site: Dictionary) -> void:
	_o = CENTRALNA
	_a = Vector2.from_angle(deg_to_rad(CENTRALNA_TURN))
	_b = Vector2(-_a.y, _a.x)
	_g = _ground_under(_rect(0.0, 0.0, 70.0, 43.0))
	var g := _g
	var none := Color(0, 0, 0, 0)
	# The glass hall, from the ground (the mapped storey under it is its ground floor) to the
	# slab: the shells meet its walls.
	for q: PackedVector2Array in site.get("hall", []):
		_prism(q, _ground_under(q) - 0.4, g + CEN_HIGH, CEN_GLASS, none, M_PAVILION + 0.5)
		_collide(q)
	# The lower wings either side, from the ground, and the boxes on their roofs.
	for w: Dictionary in site.get("wings", []):
		var q := _pts(w["p"])
		_prism(q, _ground_under(q) - 0.4, g + float(w["h"]), CEN_WING, CEN_DECK, M_SKIN + float(S_GRID) / 16.0, M_STONE)
		_collide(q)
	for bx: Dictionary in site.get("boxes", []):
		_prism(_pts(bx["p"]), g + float(bx["mh"]), g + float(bx["h"]), CEN_STONE, CEN_DECK, M_STONE, M_STONE)
	for q: PackedVector2Array in site.get("vest", []):
		_prism(q, _ground_under(q) - 0.4, g + 3.3, CEN_DOOR, CEN_DOOR.darkened(0.2), M_GLASS, M_STONE)
		_collide(q)
	# The pillars that stand clear of the hall and the wings (the ends), solid for the car too.
	for p: Vector2 in site.get("pillars", []):
		var l := _local(p)
		_lbox(l.x, l.y, 0.55, 0.55, g - 0.4, g + CEN_LOW + 0.3, CEN_PILLAR, M_STONE)
		_collide(_rect(l.x, l.y, 0.55, 0.55))
	# The slab: straight white edges down to the wing tips, the mapped roof colour on top in a
	# faint checker of panels over the shells' bays (every panel cut to the slab's outline; the
	# end ones reach past it).
	var slab: PackedVector2Array = site.get("slab", _rect(0.0, 0.0, 70.0, 43.0))
	_centralna_shells(g, slab)
	_prism(slab, g + CEN_EDGE, g + CEN_TOP, CEN_FASCIA, none, M_STONE)
	_mode = M_STONE
	var vb := [-44.0]
	vb.append_array(CEN_SHELL_V.slice(0, 9, 2))
	vb.append(45.0)
	for j in vb.size() - 1:
		for i in 14:
			var u0 := -80.0 if i == 0 else CEN_SHELL_U0 - 5.0 + i * 10.0
			var u1 := 80.0 if i == 13 else CEN_SHELL_U0 + 5.0 + i * 10.0
			var cell := PackedVector2Array([_w(u0, vb[j]), _w(u1, vb[j]), _w(u1, vb[j + 1]), _w(u0, vb[j + 1])])
			for piece in Geometry2D.intersect_polygons(cell, slab):
				if piece.size() >= 3 and not Geometry2D.is_polygon_clockwise(piece):
					_cap(piece, g + CEN_TOP, CEN_ROOF.darkened(0.03) if (i + j) % 2 == 1 else CEN_ROOF)
	# The dusk loop (2026-10-31): small warm-white lamps along the slab's edge, every ~5 m,
	# 0.6 m under its top, 0.08 m proud of it (0.8 m: smaller ones were under a pixel from
	# the driving camera).
	_mode = M_LAMP
	var lamp := Color(1.0, 0.93, 0.78)
	for k in slab.size():
		var ea := slab[k]
		var eb := slab[(k + 1) % slab.size()]
		var eo := _out(slab, ea, eb)
		var along := (eb - ea).normalized()
		var count := roundi(ea.distance_to(eb) / 5.0)
		for n in count:
			var t := (float(n) + 0.5) / float(count)
			var p := ea.lerp(eb, t) + eo * 0.08
			var y := g + CEN_TOP - 0.6
			var l := along * 0.4
			_quad(Vector3(p.x - l.x, y - 0.4, p.y - l.y), Vector3(p.x + l.x, y - 0.4, p.y + l.y),
					Vector3(p.x + l.x, y + 0.4, p.y + l.y), Vector3(p.x - l.x, y + 0.4, p.y - l.y),
					Vector3(eo.x, 0.0, eo.y), lamp)
	_mode = M_STONE


## The roof's underside (photo check on the Mac, 2026-11-01, refs/centralna 1-3): seen from
## either end the shells are the station's face, a wide winged shape under the straight top.
## Across the roof (v) the underside falls from the slab's long edges (CEN_EDGE) to the pillar
## rows (CEN_LOW), curving like a wing, and rises between the rows in a shallow arch over the
## hall (CEN_APEX); along u it runs straight to the slab's (bowed) ends, where a grey end face
## fills from the curve up to the fascia. Lit at night, like the ceiling it is.
func _centralna_shells(g: float, slab: PackedVector2Array) -> void:
	var lo_v := INF
	var hi_v := -INF
	for p in slab:
		var l := _local(p)
		lo_v = minf(lo_v, l.y)
		hi_v = maxf(hi_v, l.y)
	var row0: float = CEN_SHELL_V[1]
	var row1: float = CEN_SHELL_V[7]
	var mid := (row0 + row1) * 0.5
	# The profile (v, height over the ground), wing tip to wing tip, CEN_STEPS pieces a bay.
	var prof: Array[Vector2] = []
	for k in CEN_STEPS + 1:
		var t := float(k) / CEN_STEPS
		prof.append(Vector2(lerpf(lo_v, row0, t), CEN_LOW + (CEN_EDGE - CEN_LOW) * pow(1.0 - t, 0.8)))
	for k in range(1, 2 * CEN_STEPS + 1):
		var t := float(k) / (2 * CEN_STEPS)
		var v := lerpf(row0, row1, t)
		var x := (v - mid) / (row1 - mid)
		prof.append(Vector2(v, CEN_LOW + (CEN_APEX - CEN_LOW) * (1.0 - x * x)))
	for k in range(1, CEN_STEPS + 1):
		var t := float(k) / CEN_STEPS
		prof.append(Vector2(lerpf(row1, hi_v, t), CEN_LOW + (CEN_EDGE - CEN_LOW) * pow(t, 0.8)))
	# The tips sit a hair inside the slab's long edges, where the end lines still cross it.
	prof[0].x += 0.05
	prof[-1].x -= 0.05
	var ends: Array[Vector2] = []
	for q in prof:
		ends.append(_tier_ends(slab, q.x))
	_mode = M_LAMP
	for k in prof.size() - 1:
		var p0 := _w(ends[k].x, prof[k].x)
		var p1 := _w(ends[k].y, prof[k].x)
		var p2 := _w(ends[k + 1].y, prof[k + 1].x)
		var p3 := _w(ends[k + 1].x, prof[k + 1].x)
		var y0 := g + prof[k].y
		var y1 := g + prof[k + 1].y
		var a0 := Vector3(p0.x, y0, p0.y)
		var a1 := Vector3(p1.x, y0, p1.y)
		var a2 := Vector3(p2.x, y1, p2.y)
		var a3 := Vector3(p3.x, y1, p3.y)
		var n := (a1 - a0).cross(a3 - a0).normalized()
		if n.y > 0.0:
			n = -n
		_quad(a0, a1, a2, a3, n, CEN_SOFFIT)
	# The end faces: from the curve up to the fascia's foot, at both ends.
	_mode = M_STONE
	for side in 2:
		var out := -_a if side == 0 else _a
		for k in prof.size() - 1:
			var e0 := _w(ends[k][side], prof[k].x)
			var e1 := _w(ends[k + 1][side], prof[k + 1].x)
			var top := g + CEN_EDGE
			var b0 := Vector3(e0.x, g + prof[k].y, e0.y)
			var b1 := Vector3(e1.x, g + prof[k + 1].y, e1.y)
			# The ends bow out: each piece faces square to its own run, outwards.
			var run := Vector2(e1.x - e0.x, e1.y - e0.y)
			var face := Vector2(run.y, -run.x).normalized()
			if face.dot(out) < 0.0:
				face = -face
			var n := Vector3(face.x, 0.0, face.y)
			var none := Vector2(-1, -1)
			if prof[k].y > CEN_EDGE - 0.01:  # a wing tip: a triangle
				_tri(b0, b1, Vector3(e1.x, top, e1.y), n, CEN_END, none, none, none, -1.0)
			elif prof[k + 1].y > CEN_EDGE - 0.01:
				_tri(b0, b1, Vector3(e0.x, top, e0.y), n, CEN_END, none, none, none, -1.0)
			else:
				_quad(b0, b1, Vector3(e1.x, top, e1.y), Vector3(e0.x, top, e0.y), n, CEN_END)


## Where the line v (the shell tier's local plan) crosses the tier's outline: its west and
## east ends (CEN_SHELL_ENDS when the outline is missing or the line misses it).
func _tier_ends(tier: PackedVector2Array, v: float) -> Vector2:
	var lo := INF
	var hi := -INF
	for k in tier.size():
		var a := _local(tier[k])
		var b := _local(tier[(k + 1) % tier.size()])
		if (a.y - v) * (b.y - v) > 0.0 or is_equal_approx(a.y, b.y):
			continue
		var u := lerpf(a.x, b.x, (v - a.y) / (b.y - a.y))
		lo = minf(lo, u)
		hi = maxf(hi, u)
	return Vector2(lo, hi) if hi > lo else CEN_SHELL_ENDS


# --- Most Poniatowskiego's towers ---------------------------------------------------------------

## Built from the Mac photo set (refs/poniatowski, report docs/landmarks/photo-reports/
## poniatowski.md; spec docs/landmarks/specs/poniatowski.md). Each of the four groups on the
## abutments: a crenellated arcaded pavilion along the deck's outer edge (the bake's seat, ~15 x
## 4-5 m), a square shaft at its land end standing out over the lower road, and on the south
## groups a stair turret. Heights over the deck walk: the pavilion's merlons 7.5 m, the shaft's
## cornice 16 m, the belfry's crown 19 m, the corner balls 20 m; below the deck the stone base
## runs down to the boulevard (~9.6 m).
const PT_CREAM := Color("#e8dfc8")
const PT_SHADE := Color("#cfc4a8")
const PT_BASE := Color("#b9b2a2")
const PT_DARK := Color("#3a3640")
const PT_GLASS := Color("#4a5560")
const PT_ROOF := Color("#8f8a80")
## The shaft: half size, and how far its centre stands landwards past the pavilion's land end
## (along) and out from its deck-side face (across). check_roads.py C10 mirrors these.
const PT_SHAFT := 3.5
const PT_SHAFT_U := 0.5
const PT_SHAFT_V := 3.5
## The south groups' stair turret: centre in the seat's frame (land +u, out +v), radius.
const PT_TURRET := Vector3(3.5, 9.5, 2.5)
## The north groups' switchback stair down to the boulevard (OpenStreetMap maps it on both:
## the steps out from the walk, the walls round the stair with their rounded end at v ~11.5,
## the steps back to the shaft's foot; the report's "curved ramp/stair"): a straight flight from
## the pavilion's outer face out to PT_RAMP_C.y, a ramp turning round a half circle (centre
## PT_RAMP_C, radii PT_RAMP_R, the flights as wide as the ring) and a short flight back to
## v = PT_RAMP_END by the shaft, inside parapets PT_RAMP_WALL thick that take in the mapped
## walls. check_roads.py C10 mirrors its collider (PT_RAMP_BOX: u0, u1, v1; v0 = hv).
const PT_RAMP_C := Vector2(3.0, 8.2)
const PT_RAMP_R := Vector2(0.3, 2.95)
const PT_RAMP_WALL := 0.6
const PT_RAMP_END := 5.6
const PT_RAMP_BOX := Vector3(-0.6, 6.6, 11.8)


func _build_towers(site: Dictionary) -> void:
	var seats: Array = site.get("towers", [])
	var count: int = seats.size() if not seats.is_empty() else (site["zone"] as Array).size()
	var cs: Array[Vector2] = []
	var axes: Array[Vector2] = []
	var hus: Array[float] = []
	var hvs: Array[float] = []
	var gs: Array[float] = []
	var decks: Array[float] = []
	for n in count:
		if not seats.is_empty():
			# Loop 3b (R7): the bake's seat.
			var t: Dictionary = seats[n]
			cs.append(Vector2(float(t["c"][0]), float(t["c"][1])))
			axes.append(Vector2(float(t["a"][0]), float(t["a"][1])))
			hus.append(float(t["hu"]))
			hvs.append(float(t["hv"]))
			gs.append(float(t["base"]))
			decks.append(float(t["deck"]))
			continue
		var poly: PackedVector2Array = Geometry2D.offset_polygon(site["zone"][n], -3.0)[0]
		var c := _centre(poly)
		var best := 0.0
		var ax := Vector2.RIGHT
		for i in poly.size():
			var e := poly[(i + 1) % poly.size()] - poly[i]
			if e.length() > best:
				best = e.length()
				ax = e.normalized()
		var hu := 0.0
		var hv := 0.0
		for q in poly:
			hu = maxf(hu, absf((q - c).dot(ax)))
			hv = maxf(hv, absf((q - c).dot(Vector2(-ax.y, ax.x))))
		var deck: float = map.terrain_height(c.x, c.y)
		for d in [Vector2(14, 0), Vector2(-14, 0), Vector2(0, 14), Vector2(0, -14)]:
			deck = maxf(deck, map.ground_height(c.x + d.x, c.y + d.y))
		cs.append(c)
		axes.append(ax)
		hus.append(minf(hu, 8.0))
		hvs.append(minf(hv, 3.0))
		gs.append(map.terrain_height(c.x, c.y))
		decks.append(deck)
	var mid := Vector2.ZERO
	for c in cs:
		mid += c / maxf(cs.size(), 1)
	for n in count:
		var c: Vector2 = cs[n]
		# The frame: +u towards the land, +v out away from the deck (from the pair's middle).
		var pair := c
		var near := INF
		for m in count:
			if m != n and cs[m].distance_to(c) < near:
				near = cs[m].distance_to(c)
				pair = (cs[m] + c) * 0.5
		_a = axes[n] * (1.0 if (c - mid).dot(axes[n]) > 0.0 else -1.0)
		_b = Vector2(-_a.y, _a.x)
		if (c - pair).dot(_b) < 0.0:
			_b = -_b
		_o = c
		_g = gs[n]
		_pt_group(hus[n], hvs[n], gs[n], decks[n], c.y > pair.y)


## One tower group in the frame _pt_group's caller set: the pavilion u -hu..hu, v -hv..hv
## (v = -hv the deck side), the shaft and, on a south group, the stair turret.
func _pt_group(hu: float, hv: float, g: float, deck: float, south: bool) -> void:
	var d := deck
	# The pavilion: grey stone base to the deck, cream walls, a string course, merlons to 7.5 m.
	_lbox(0.0, 0.0, hu + 0.3, hv + 0.3, g - 0.5, d, PT_BASE, M_STONE)
	_lbox(0.0, 0.0, hu, hv, d, d + 5.6, PT_CREAM, M_STONE, PT_ROOF)
	_lbox(0.0, 0.0, hu + 0.15, hv + 0.15, d + 4.5, d + 4.9, PT_SHADE, M_STONE)
	_attic(_rect(0.0, 0.0, hu, hv), d + 5.6, 1.9, PT_CREAM)
	# The arcade: round arches on short columns open to the walk; glazed arched windows to the river.
	# F's look check (2026-11-03): "strengthen the pavilion arcades": the bays read flat, so each
	# bay now stands between piers 0.35 m proud on both faces (photo 14's square piers), the walk's
	# arches open taller and wider with a keystone, and an impost band and a plinth run along.
	var bays := maxi(3, roundi(2.0 * hu / 3.0))
	var bay := 2.0 * hu / bays
	for k in bays:
		var u := -hu + (k + 0.5) * bay
		_arch_panel(_w(u, -hv), _a, -_b, bay * 0.4, d, d + 3.7 - bay * 0.4, PT_DARK, 0.04, M_STONE)
		_arch_panel(_w(u, hv), _a, _b, bay * 0.32, d + 0.9, d + 3.5 - bay * 0.32, PT_GLASS, 0.04, M_PAVILION)
		for side: float in [-1.0, 1.0]:
			_lbox(u, side * (hv + 0.12), 0.18, 0.12, d + 3.55, d + 4.15, PT_SHADE, M_STONE)
	for k in bays + 1:
		var u := -hu + k * bay
		for side: float in [-1.0, 1.0]:
			_lbox(u, side * (hv + 0.17), 0.3, 0.17, d, d + 4.5, PT_SHADE, M_STONE)
	_lbox(0.0, 0.0, hu + 0.12, hv + 0.12, d, d + 0.45, PT_BASE, M_STONE)
	_lbox(0.0, 0.0, hu + 0.08, hv + 0.08, d + 2.95, d + 3.15, PT_SHADE, M_STONE)
	for k in 2:
		var u := hu * (1.0 if k == 0 else -1.0)
		var o := _a * (1.0 if k == 0 else -1.0)
		_arch_panel(_w(u, 0.0), _b, o, minf(hv * 0.5, 1.2), d + 0.9, d + 2.8, PT_GLASS, 0.04, M_PAVILION)
	# The shaft at the land end: stone base with an arched portal to the lower road, the cream
	# shaft with small arched windows and a cornice at 16 m, the belfry with three slits a face,
	# its merlon crown to 19 m and corner balls to 20 m.
	var su := hu + PT_SHAFT_U
	var sv := -hv + PT_SHAFT_V
	var r := PT_SHAFT
	_lbox(su, sv, r + 0.3, r + 0.3, g - 0.5, d + 0.4, PT_BASE, M_STONE)
	_lbox(su, sv, r, r, d + 0.4, d + 15.3, PT_CREAM, M_STONE)
	# F's look check (2026-11-03): "strengthen the shafts". Corner piers 0.25 m proud the whole
	# height, two string courses, a corbel table under the cornice, a taller belfry and crown.
	for cu: float in [-1.0, 1.0]:
		for cv: float in [-1.0, 1.0]:
			_lbox(su + cu * (r - 0.3), sv + cv * (r - 0.3), 0.55, 0.55, d + 0.4, d + 15.3, PT_SHADE, M_STONE)
	for y: float in [d + 6.6, d + 10.9]:
		_lbox(su, sv, r + 0.32, r + 0.32, y, y + 0.35, PT_SHADE, M_STONE)
	for f in 4:
		var nu: float = [1.0, -1.0, 0.0, 0.0][f]
		var nv: float = [0.0, 0.0, 1.0, -1.0][f]
		for k in 4:
			var a := -r + 1.3 + k * (2.0 * r - 2.6) / 3.0
			var cu := su + nu * (r + 0.18) + absf(nv) * a
			var cv := sv + nv * (r + 0.18) + absf(nu) * a
			_lbox(cu, cv, 0.3, 0.3, d + 14.55, d + 15.3, PT_SHADE, M_STONE)
	_lbox(su, sv, r + 0.45, r + 0.45, d + 15.3, d + 16.0, PT_SHADE, M_STONE, PT_ROOF)
	_lbox(su, sv, r - 0.5, r - 0.5, d + 16.0, d + 18.3, PT_CREAM, M_STONE, PT_ROOF)
	_attic(_rect(su, sv, r - 0.5, r - 0.5), d + 18.3, 1.3, PT_CREAM)
	for f in 4:
		var nu: float = [1.0, -1.0, 0.0, 0.0][f]
		var nv: float = [0.0, 0.0, 1.0, -1.0][f]
		var out := _a * nu + _b * nv
		var along := Vector2(-out.y, out.x)
		var face := _w(su + nu * r, sv + nv * r)
		var belfry := _w(su + nu * (r - 0.5), sv + nv * (r - 0.5))
		for k in 3:
			_arch_panel(belfry + along * (k - 1) * 1.6, along, out, 0.36, d + 16.25, d + 17.6, PT_DARK, 0.04, M_STONE)
		_arch_panel(face, along, out, 0.7, d + 7.4, d + 9.8, PT_DARK, 0.04, M_STONE)
		for k in [-1.0, 1.0]:
			_arch_panel(face + along * k * 0.85, along, out, 0.36, d + 11.6, d + 13.0, PT_DARK, 0.04, M_STONE)
		if nv >= 0.0 and nu >= 0.0:
			_arch_panel(face, along, out, 0.42, d + 3.0, d + 4.6, PT_DARK, 0.04, M_STONE)
		if nv > 0.0 or nu > 0.0:
			# The portals under the deck, to the boulevard.
			_arch_panel(_w(su + nu * (r + 0.3), sv + nv * (r + 0.3)), along, out, 1.5, g, g + 3.0, PT_DARK, 0.04, M_STONE)
		for side in [-1.0, 1.0]:
			if f < 2:
				var ball := _w(su + nu * (r - 0.5), sv + side * (r - 0.5))
				_prism(_circle(ball, 0.32, 4), d + 19.3, d + 19.8, PT_CREAM, PT_CREAM, M_STONE, M_STONE)
				_mode = M_STONE
				_pyramid(_circle(ball, 0.32, 4), d + 19.8, d + 20.4, PT_CREAM)
	# The iron lantern on the shaft's walk-side face.
	var lamp := _w(su, sv - r - 0.4)
	_prism(_circle(lamp, 0.22, 4), d + 3.2, d + 3.8, Color("#ffd27a"), Color("#1e1e22"), M_LAMP, M_STONE)
	if south:
		# The stair turret at the foot of the flight down to the lower road.
		var tc := _w(PT_TURRET.x, PT_TURRET.y)
		_prism(_circle(tc, PT_TURRET.z, 8), g - 0.5, d + 2.0, PT_CREAM, PT_ROOF, M_STONE, M_STONE)
		_attic(_circle(tc, PT_TURRET.z, 8), d + 2.0, 1.0, PT_CREAM)
		# An iron lantern on a post on the turret's crown, over the stair's turn.
		_prism(_circle(tc, 0.1, 4), d + 2.0, d + 3.6, Color("#1e1e22"), Color("#1e1e22"), M_STONE, M_STONE)
		_prism(_circle(tc, 0.24, 4), d + 3.6, d + 4.2, Color("#ffd27a"), Color("#1e1e22"), M_LAMP, M_STONE)
		# The flight from the pavilion's outer face out to the turret (its walls and landing).
		_prism(_rect(PT_TURRET.x, (hv + PT_TURRET.y - PT_TURRET.z) * 0.5, 2.5,
				(PT_TURRET.y - PT_TURRET.z - hv) * 0.5), g - 0.5, d - 0.4, PT_BASE, PT_SHADE, M_STONE, M_STONE)
	if not south:
		_pt_ramp(hv, g, d)
	# Solid from the boulevard to over the deck (a car on either level stops at it).
	_collide_span(_rect(0.0, 0.0, hu + 0.6, hv + 0.6), g - 1.0, d + 6.0)
	_collide_span(_rect(su, sv, r + 0.3, r + 0.3), g - 1.0, d + 6.0)
	if south:
		_collide_span(_circle(_w(PT_TURRET.x, PT_TURRET.y), PT_TURRET.z, 8), g - 1.0, d + 3.0)


## A north group's switchback stair (PT_RAMP_*), in the frame _pt_group's caller set: grey stone
## treads stepping down from the walk (d) to the boulevard (g) evenly along the way, cream
## parapets a metre over them on the outer sides and a cream wall between the two flights, solid.
func _pt_ramp(hv: float, g: float, d: float) -> void:
	var c := PT_RAMP_C
	var r0 := PT_RAMP_R.x
	var r1 := PT_RAMP_R.y
	var pw := PT_RAMP_WALL * 0.5
	var w := (r1 - r0) * 0.5
	var first := c.y - hv
	var turn := PI * (r0 + r1) * 0.5
	var last := c.y - PT_RAMP_END
	var total := first + turn + last
	var drop := d - g
	# The first flight, out from the walk.
	var n1 := 8
	for k in n1:
		var v0 := hv + first * k / n1
		var v1 := hv + first * (k + 1) / n1
		var top := d - drop * (first * (k + 0.5) / n1) / total
		_prism(_rect(c.x - r0 - w, (v0 + v1) * 0.5, w, (v1 - v0) * 0.5), g - 0.5, top, PT_BASE, PT_SHADE, M_STONE, M_STONE)
		_prism(_rect(c.x - r1 - pw, (v0 + v1) * 0.5, pw, (v1 - v0) * 0.5), g - 0.5, top + 1.0, PT_CREAM, PT_SHADE, M_STONE, M_STONE)
	# The turn: a ramp round the half circle, its outer parapet following it.
	var n2 := 10
	for k in n2:
		var a0 := PI * (1.0 - float(k) / n2)
		var a1 := PI * (1.0 - float(k + 1) / n2)
		var top := d - drop * (first + turn * (k + 0.5) / n2) / total
		for ring in [[r0, r1, top, PT_BASE], [r1, r1 + PT_RAMP_WALL, top + 1.0, PT_CREAM]]:
			var ri: float = ring[0]
			var ro: float = ring[1]
			_prism(PackedVector2Array([_w(c.x + cos(a0) * ri, c.y + sin(a0) * ri), _w(c.x + cos(a0) * ro, c.y + sin(a0) * ro),
					_w(c.x + cos(a1) * ro, c.y + sin(a1) * ro), _w(c.x + cos(a1) * ri, c.y + sin(a1) * ri)]),
					g - 0.5, ring[2], ring[3], PT_SHADE, M_STONE, M_STONE)
	# The last flight, back towards the shaft's foot.
	var n3 := 4
	for k in n3:
		var v0 := c.y - last * k / n3
		var v1 := c.y - last * (k + 1) / n3
		var top := d - drop * (first + turn + last * (k + 0.5) / n3) / total
		_prism(_rect(c.x + r0 + w, (v0 + v1) * 0.5, w, (v0 - v1) * 0.5), g - 0.5, top, PT_BASE, PT_SHADE, M_STONE, M_STONE)
		_prism(_rect(c.x + r1 + pw, (v0 + v1) * 0.5, pw, (v0 - v1) * 0.5), g - 0.5, top + 1.0, PT_CREAM, PT_SHADE, M_STONE, M_STONE)
	# The wall between the flights, from the walk's height down to the turn.
	_prism(_rect(c.x, (hv + c.y) * 0.5, r0, (c.y - hv) * 0.5), g - 0.5, d - drop * first / total + 1.0, PT_CREAM, PT_SHADE, M_STONE, M_STONE)
	# Two iron lanterns light the way down (photos 14, 25: black bracket lamps on the stonework):
	# on posts on the parapet at the turn's outermost point and at the foot of the last flight.
	var apex := d - drop * (first + turn * 0.5) / total + 1.0
	var foot := d - drop * (first + turn + last) / total + 1.0
	for at in [Vector3(c.x, c.y + r1 + pw, apex), Vector3(c.x + r1 + pw, PT_RAMP_END + 0.3, foot)]:
		var lp := _w(at.x, at.y)
		_prism(_circle(lp, 0.08, 4), at.z, at.z + 1.6, Color("#1e1e22"), Color("#1e1e22"), M_STONE, M_STONE)
		_prism(_circle(lp, 0.2, 4), at.z + 1.6, at.z + 2.1, Color("#ffd27a"), Color("#1e1e22"), M_LAMP, M_STONE)
	_collide_span(_rect((PT_RAMP_BOX.x + PT_RAMP_BOX.y) * 0.5, (hv + PT_RAMP_BOX.z) * 0.5,
			(PT_RAMP_BOX.y - PT_RAMP_BOX.x) * 0.5, (PT_RAMP_BOX.z - hv) * 0.5), g - 1.0, d + 1.2)


# --- Muzeum Narodowe and Plac Piłsudskiego (the museum and Plac loop, 2026-10-31) ----------------

## The museum's raised entrance block stands at the back of its forecourt (Dziedziniec im.
## Stanisława Lorentza, the courtyard open to Al. Jerozolimskie): the middle of that wall and the
## building's own axis along the avenue (east); its back is MUZEUM_AXIS turned a quarter (south).
const MUZEUM_DOOR := Vector2(-2.95, 276.7)
const MUZEUM_AXIS := Vector2(0.964, -0.267)
## The army museum's tank and field gun: on the east courtyard's lawn between its pool and the
## east block (map areas), lined up with that wall.
const MUZEUM_TANK := Vector2(53.8, 211.0)
const MUZEUM_GUN := Vector2(56.5, 233.0)
const MUZEUM_YARD_DIR := Vector2(-0.276, -0.961)
## Plac part 2: the heights are estimates (OpenStreetMap tags the wings building:levels=4,
## which the bake turns into 14.2 m at 3.3 m a storey; the museum's galleries are taller storeys).
const MUZEUM_TOP := 25.0           # the entrance block's parapet (estimate; was 20 m)
const MUZEUM_WINGS := 18.5         # the wings' parapet (estimate: four storeys of about 4.4 m)
const MUZEUM_PLINTH := Color("#a99f8b")
const MUZEUM_GLASS := Color("#3b424b")
const ARMY_OLIVE := Color("#5a6141")
const ARMY_TRACK := Color("#2f302b")
const ARMY_PAD := Color("#9a968d")


## A closed outline with the steps under `tol` metres dropped (Douglas-Peucker), so walls run
## straight between the mapped corners (the museum's outline has 481 points: every pier).
func _simplify(ring: PackedVector2Array, tol: float) -> PackedVector2Array:
	var far := 0
	for i in ring.size():
		if ring[i].distance_squared_to(ring[0]) > ring[far].distance_squared_to(ring[0]):
			far = i
	if far == 0:
		return ring
	var back := ring.slice(far)
	back.append(ring[0])
	var out := _dp(ring.slice(0, far + 1), tol)
	out.resize(out.size() - 1)
	var rest := _dp(back, tol)
	rest.resize(rest.size() - 1)
	out.append_array(rest)
	return out if out.size() >= 3 else ring


func _dp(pts: PackedVector2Array, tol: float) -> PackedVector2Array:
	var best := -1.0
	var at := 0
	for i in range(1, pts.size() - 1):
		var d := pts[i].distance_to(Geometry2D.get_closest_point_to_segment(pts[i], pts[0], pts[-1]))
		if d > best:
			best = d
			at = i
	if best <= tol:
		return PackedVector2Array([pts[0], pts[-1]])
	var out := _dp(pts.slice(0, at + 1), tol)
	out.resize(out.size() - 1)
	out.append_array(_dp(pts.slice(at), tol))
	return out


func _area(poly: PackedVector2Array) -> float:
	var a := 0.0
	for i in poly.size():
		var p := poly[i]
		var q := poly[(i + 1) % poly.size()]
		a += p.x * q.y - q.x * p.y
	return a * 0.5


## Tall window bays along a ring's walls: a pane `w` wide every `step` metres (the walls'
## piers between them), from h0 to h1 over the ground, 0.07 m proud of the wall, in the
## curtain-wall glass (M_GLASS: a transom every 4 m, some lit at night); none where a bay's
## foot falls in `skip` (a block standing in front of that wall).
func _bays(ring: PackedVector2Array, h0: float, h1: float, step: float, w: float, col: Color,
		skip := PackedVector2Array()) -> void:
	var keep := _mode
	_mode = M_GLASS
	var along := 0.0
	for i in ring.size():
		var a := ring[i]
		var b := ring[(i + 1) % ring.size()]
		var length := a.distance_to(b)
		along += length
		var n := floori((length - 1.5) / step)
		if n < 1:
			continue
		var e := (b - a) / length
		var out := _out(ring, a, b)
		var t0 := (length - n * step) * 0.5 + step * 0.5
		for k in n:
			var p := a + e * (t0 + k * step) + out * 0.07
			if skip.size() >= 3 and Geometry2D.is_point_in_polygon(p, skip):
				continue
			# UV.x centred on a pane of the shader's 1.5 m grid (so its mullions frame the bay), at
			# the bay's distance round the ring (so each bay draws its own lit rooms at night).
			var pane := floorf((along + t0 + k * step) / 1.5) * 1.5
			_wall(p - e * w * 0.5, p + e * w * 0.5, _g + h0, _g + h1, out, col, pane + 0.75 - w * 0.5)
	_mode = keep


## A thin parapet (zero thickness, both sides drawn) round a ring, from y up `height`.
func _parapet(ring: PackedVector2Array, y: float, height: float, col: Color) -> void:
	var keep := _mode
	_mode = M_STONE
	var run := 0.0
	for i in ring.size():
		var a := ring[i]
		var b := ring[(i + 1) % ring.size()]
		_wall(a, b, y, y + height, _out(ring, a, b), col, run)
		run += a.distance_to(b)
	_mode = keep


## Muzeum Narodowe: Tadeusz Tołwiński's stripped-classical block in pale stone. The mapped
## outline straightened, on a darker plinth, to its wings' height (MUZEUM_WINGS) with a parapet; tall narrow
## window bays in a steady rhythm on every front; at the back of the forecourt the raised
## entrance block (MUZEUM_TOP) with its recessed glazed portal behind four square piers under a
## lintel, two tall bays either side, and steps; on the east courtyard's lawn the army museum's
## hardware: a tank and a field gun on concrete pads.
func _build_muzeum(site: Dictionary) -> void:
	var ring: PackedVector2Array = site["ring"]
	_g = _ground_under(ring)
	var g := _g
	var h: float = site["h"]
	var light := MUZEUM_STONE.lightened(0.07)
	var base := Geometry2D.offset_polygon(ring, 0.35, Geometry2D.JOIN_MITER)
	if not base.is_empty():
		_prism(base[0], g - 0.6, g + 1.3, MUZEUM_PLINTH, MUZEUM_PLINTH, M_STONE, M_STONE)
	_prism(ring, g - 0.6, g + h, MUZEUM_STONE, MUZEUM_ROOF, M_STONE, M_STONE)
	_parapet(ring, g + h, 1.0, light)
	# The entrance block, in the forecourt's frame (u east along the avenue, v to the back).
	_o = MUZEUM_DOOR
	_a = MUZEUM_AXIS
	_b = Vector2(-_a.y, _a.x)
	var block := _rect(0.0, 7.0, 12.0, 9.5)
	_bays(ring, 2.0, h - 2.2, 4.4, 1.3, MUZEUM_GLASS, _rect(0.0, 7.0, 12.5, 10.0))
	_muzeum_piers(ring, g + 1.3, g + h, 4.4, light, _rect(0.0, 7.0, 12.5, 10.0))
	_prism(block, g - 0.6, g + MUZEUM_TOP, MUZEUM_STONE, MUZEUM_COPPER, M_STONE, M_STONE)
	_parapet(block, g + MUZEUM_TOP, 1.0, light)
	var front := -_b
	_mode = M_GLASS
	_wall(_w(-6.5, -2.56), _w(6.5, -2.56), g, g + 12.5, front, MUZEUM_GLASS)
	for u in [-9.6, 9.6]:
		_wall(_w(u - 0.65, -2.56), _w(u + 0.65, -2.56), g + 2.0, g + MUZEUM_TOP - 2.5, front, MUZEUM_GLASS, 0.1)
	for u in [-4.875, -1.625, 1.625, 4.875]:
		_lbox(u, -3.5, 0.55, 0.55, g, g + 12.5, light, M_STONE, light)
	_lbox(0.0, -3.4, 7.0, 0.95, g + 12.5, g + 13.6, light, M_STONE, light)
	_lbox(0.0, -6.0, 8.5, 3.5, g - 0.6, g + 0.4, MUZEUM_PLINTH, M_STONE, MUZEUM_PLINTH)
	_lbox(0.0, -7.1, 9.5, 1.3, g - 0.6, g + 0.15, MUZEUM_PLINTH, M_STONE, MUZEUM_PLINTH)
	_lbox(0.0, -8.3, 10.5, 1.2, g - 0.6, g - 0.05, MUZEUM_PLINTH, M_STONE, MUZEUM_PLINTH)
	_muzeum_doors(g)
	_muzeum_forecourt(g)
	_collide(ring)
	_collide(_rect(0.0, -2.5, 7.0, 1.6))
	# The army museum's hardware on the lawn of the east courtyard, beside its pool, noses north.
	_tank(MUZEUM_TANK, MUZEUM_YARD_DIR)
	_field_gun(MUZEUM_GUN, MUZEUM_YARD_DIR.rotated(-0.5))


## The wings' stone piers (photos 1-4 of refs/muzeum_narodowe: tall square pilasters between the
## window strips, every second storey-strip, under a deep cornice): one on every bay boundary of
## each straight run, 1 m wide and 0.5 m proud, from `y0` to `y1`; none where `skip` (the block in
## front of that wall) covers the foot. Same rhythm as `_bays`, so each strip sits between two.
func _muzeum_piers(ring: PackedVector2Array, y0: float, y1: float, step: float, col: Color,
		skip: PackedVector2Array) -> void:
	var keep := _mode
	_mode = M_STONE
	for i in ring.size():
		var a := ring[i]
		var b := ring[(i + 1) % ring.size()]
		var length := a.distance_to(b)
		var n := floori((length - 1.5) / step)
		if n < 1:
			continue
		var e := (b - a) / length
		var out := _out(ring, a, b)
		var t0 := (length - n * step) * 0.5
		for k in n + 1:
			var c := a + e * (t0 + k * step)
			if skip.size() >= 3 and Geometry2D.is_point_in_polygon(c + out * 0.3, skip):
				continue
			var q := PackedVector2Array([c - e * 0.5 - out * 0.1, c + e * 0.5 - out * 0.1,
					c + e * 0.5 + out * 0.5, c - e * 0.5 + out * 0.5])
			_prism(q, y0, y1 - 0.5, col, col.lightened(0.05), M_STONE, M_STONE)
	_mode = keep


## The entrance's three dark doors in the recessed wall behind the piers (photo 3: three tall black
## doors, the middle one under the banner strip), local frame already set to the block's.
func _muzeum_doors(g: float) -> void:
	for u in [-3.25, 0.0, 3.25]:
		_wall(_w(u - 1.1, -2.58), _w(u + 1.1, -2.58), g + 0.4, g + 5.2, -_b, MUZEUM_DOORS)


## The forecourt (photos 1, 3, 4): the black spear-topped iron fence across its mouth with the gate
## standing open in the middle, six flagpoles with blue banners in front of the steps, and the
## fountain pool in the court. In the block's frame the mouth is v = -62.7, between the wings
## (u -22 .. 24.7); the court is a pedestrian forecourt, the fence closes it to cars but for the gate.
func _muzeum_forecourt(g: float) -> void:
	var vf := -62.7
	var u0 := -22.0
	var u1 := 24.7
	var gate := 3.6
	var u := u0
	var fence := MUZEUM_IRON
	var keep := _mode
	while u <= u1 + 0.01:
		if absf(u - 1.35) > gate:
			var gy: float = map.terrain_height(_w(u, vf).x, _w(u, vf).y)
			_lbox(u, vf, 0.07, 0.07, gy - 0.1, gy + 2.2, fence, M_STONE, fence)
			if int(round((u - u0) / 1.2)) % 5 == 0:
				_lbox(u, vf, 0.16, 0.16, gy - 0.1, gy + 2.5, fence, M_STONE, fence)
		u += 1.2
	for seg in [Vector2(u0, 1.35 - gate), Vector2(1.35 + gate, u1)]:
		var p0 := _w(seg.x, vf)
		var p1 := _w(seg.y, vf)
		var y0: float = map.terrain_height(p0.x, p0.y)
		var y1: float = map.terrain_height(p1.x, p1.y)
		_beam(Vector3(p0.x, y0 + 2.0, p0.y), Vector3(p1.x, y1 + 2.0, p1.y), 0.08, fence)
		_beam(Vector3(p0.x, y0 + 0.4, p0.y), Vector3(p1.x, y1 + 0.4, p1.y), 0.08, fence)
		_collide(_rect((seg.x + seg.y) * 0.5, vf, (seg.y - seg.x) * 0.5, 0.15))
	# the gate's two open leaves, swung in
	for side in [-1.0, 1.0]:
		var hinge: float = 1.35 + side * gate
		_lbox(hinge, vf, 0.2, 0.2, g - 0.1, g + 2.6, fence, M_STONE, fence)
		_wall(_w(hinge, vf + 0.5), _w(hinge, vf + 3.0), g, g + 2.2, _w(1.0, 0.0) - _w(0.0, 0.0), fence)
	# six flagpoles in a row before the steps, a banner hung from each
	var k := 0
	for fu in [-9.0, -5.4, -1.8, 1.8, 5.4, 9.0]:
		var base := _w(fu, -13.0)
		var by: float = map.terrain_height(base.x, base.y)
		_beam(Vector3(base.x, by, base.y), Vector3(base.x, by + 11.0, base.y), 0.14, MUZEUM_POLE)
		_mode = M_STONE
		var col := MUZEUM_BANNER if k % 2 == 0 else MUZEUM_BANNER.lightened(0.12)
		_wall(_w(fu + 0.07, -13.0), _w(fu + 1.0, -13.0), by + 6.5, by + 10.6, -_b, col)
		_wall(_w(fu + 1.0, -13.0), _w(fu + 0.07, -13.0), by + 6.5, by + 10.6, _b, col)
		k += 1
	_mode = keep


## A tank on show (a hull on its tracks, an eight-sided turret, the gun), on a pad; `dir` its nose.
func _tank(c: Vector2, dir: Vector2) -> void:
	var g: float = map.terrain_height(c.x, c.y)
	_o = c
	_a = dir
	_b = Vector2(-dir.y, dir.x)
	_lbox(0.0, 0.0, 4.0, 2.4, g - 0.3, g + 0.15, ARMY_PAD, M_STONE, ARMY_PAD)
	for v in [-1.45, 1.45]:
		_lbox(0.0, v, 3.4, 0.4, g + 0.15, g + 1.1, ARMY_TRACK, M_STONE, ARMY_TRACK)
	_lbox(-0.1, 0.0, 3.1, 1.1, g + 0.5, g + 1.55, ARMY_OLIVE, M_STONE, ARMY_OLIVE.darkened(0.08))
	var turret := _circle(_w(-0.4, 0.0), 1.15, 8)
	_prism(turret, g + 1.55, g + 2.3, ARMY_OLIVE.lightened(0.04), ARMY_OLIVE, M_STONE, M_STONE)
	var muzzle := _w(4.3, 0.0)
	var root := _w(0.6, 0.0)
	_beam(Vector3(root.x, g + 1.9, root.y), Vector3(muzzle.x, g + 2.0, muzzle.y), 0.2, ARMY_OLIVE.darkened(0.25))
	_collide(_rect(0.0, 0.0, 3.4, 1.9))


## A field gun on show: the carriage and its shield, two wheels, the barrel raised, the split trail.
func _field_gun(c: Vector2, dir: Vector2) -> void:
	var g: float = map.terrain_height(c.x, c.y)
	_o = c
	_a = dir
	_b = Vector2(-dir.y, dir.x)
	_lbox(-0.6, 0.0, 3.0, 1.7, g - 0.3, g + 0.15, ARMY_PAD, M_STONE, ARMY_PAD)
	_lbox(0.0, 0.0, 0.7, 0.6, g + 0.6, g + 1.1, ARMY_OLIVE, M_STONE, ARMY_OLIVE)
	_lbox(0.45, 0.0, 0.06, 0.95, g + 0.7, g + 1.9, ARMY_OLIVE.darkened(0.1), M_STONE, ARMY_OLIVE)
	for v in [-0.95, 0.95]:
		_lbox(0.0, v, 0.6, 0.1, g + 0.15, g + 1.35, ARMY_TRACK, M_STONE, ARMY_TRACK)
	var root := _w(0.2, 0.0)
	var muzzle := _w(3.4, 0.0)
	_beam(Vector3(root.x, g + 1.05, root.y), Vector3(muzzle.x, g + 2.0, muzzle.y), 0.17, ARMY_OLIVE.darkened(0.25))
	for v in [-1.0, 1.0]:
		var p0 := _w(-0.4, v * 0.3)
		var p1 := _w(-3.2, v * 1.0)
		_beam(Vector3(p0.x, g + 0.75, p0.y), Vector3(p1.x, g + 0.25, p1.y), 0.16, ARMY_OLIVE.darkened(0.15))


## Plac Piłsudskiego's edges: Hotel Europejski (its mapped outline) and the Tomb of the Unknown
## Soldier (built at its place, like Sigismund's Column; its zone the mapped outline, which
## drops the hundred tiny 3D parts it is mapped in).
## Hotel Europejski (Enrico Marconi, 1857-1877; restored and reopened in 2018), rebuilt from
## photos (F, 2026-11-03: the Krakowskie Przedmieście front square on, the north-east corner close
## up, two aerials; with refs/krakowskie 28-29 and the GUGiK LoD2 heights). Spec
## docs/landmarks/specs/europejski.md. Cream stone all round: a rusticated ground floor of tall
## round-arched shop windows; three floors above, the first with pedimented windows over
## balustrade panels, the second with capped windows, the third small; at each rounded corner a
## bow-front of Corinthian columns in two tiers with curved balconies and arched windows; the main
## cornice, a balustrade attic, and set back behind it the dark louvred glass roof storey with its
## rounded ends; an inner courtyard under a glass roof. The plan is the outline's four straight
## fronts (OSM) with the corners rounded at EURO_R; edge 0 is Krakowskie Przedmieście (east),
## 1 the south front, 2 Plac Piłsudskiego's side (west), 3 Ossolińskich (north).
const EURO_CORNERS := [Vector2(-615.39, -913.99), Vector2(-587.82, -854.59),
		Vector2(-673.81, -833.85), Vector2(-688.95, -895.68)]  # the fronts' lines meeting (NE, SE, SW, NW)
const EURO_R := 6.5        # the bow-fronts' radius (front photo: ~13 m pavilions on a 65 m front)
const EURO_SEGS := 5       # facets per bow (a column on every joint)
const EURO_PAV := 13.0     # each corner pavilion's reach along a front, from the corner
const EURO_BAY := 3.6      # the window bays between the pavilions (11 on Krakowskie)
const EURO_WING := 14.0    # the wings' depth round the courtyard
const EURO_GF := 7.2       # the rusticated ground floor's top (LoD2: eaves ~20 m, roof storey ~25 m)
const EURO_T1 := 12.4      # the first floor's top: the lower column tier's entablature
const EURO_T2 := 13.4      # the second balcony, the upper tier's foot
const EURO_CORNICE := 19.4
const EURO_TOP := 20.0     # the cornice's top, the attic's foot
const EURO_ATTIC := 21.5
const EURO_ROOF := 25.0    # the roof storey's top
const EURO_COURT := 8.5    # the courtyard's glass roof
const EUROPEJSKI_WALL := Color("#eeeae0")  # photo 29 (refs/krakowskie) and F's photos
const EUROPEJSKI_BASE := Color("#e4dfd2")
const EUROPEJSKI_TRIM := Color("#f6f3ea")
const EUROPEJSKI_SHADE := Color("#cfc8b8")
const EUROPEJSKI_ROOF := Color("#262b2b")   # the louvres
const EUROPEJSKI_LEAD := Color("#8d918e")
const EUROPEJSKI_ZINC := Color("#66746f")  # the roof storey's top (F's aerial: green-grey)
const EUROPEJSKI_COURT := Color("#a39d92")  # the courtyard (F's aerial: pale, paved and glazed)
const EUROPEJSKI_GLASS := Color("#3a3f47")
const EUROPEJSKI_SHOP := Color("#4a4036")
const EUROPEJSKI_GOLD := Color(1.0, 0.8, 0.45)
const EUROPEJSKI_WORD := "HOTEL EUROPEJSKI"
const EUROPEJSKI_H := EURO_TOP  # the far skyline and the checks
## The Tomb: the middle of its arcade, the arcade's long axis (south), its piers along it.
const GROB := Vector2(-865.75, -768.7)
const GROB_AXIS := Vector2(-0.2425, -0.970)
const GROB_PIERS := [-5.55, -1.85, 1.85, 5.55]
const GROB_ROW := 2.98            # each row of piers this far from the axis
const GROB_STONE := Color("#ddd3bf")
const GROB_GRANITE := Color("#7f7c78")
const GROB_BRONZE := Color("#4f4a40")
const GROB_FLAME := Color("#ffb04a")
func _find_plac() -> void:
	var euro := _landmark("Hotel Europejski")
	if euro.size() >= 3:
		_add_site("europejski", [euro])
		if not sites.is_empty() and sites[-1]["key"] == "europejski":
			sites[-1]["ring"] = _euro_ring(0.0)
			sites[-1]["raw"] = euro
	var grob := _landmark("Grób Nieznanego Żołnierza")
	if grob.size() >= 3:
		var grown := Geometry2D.offset_polygon(grob, 1.0, Geometry2D.JOIN_MITER)
		_add_site("grob", [grown[0] if not grown.is_empty() else grob])
	_find_plac2()
	# Plac Piłsudskiego from photos (2026-11-02): the monuments and masts on the square.
	_find_plac_photos()


## The inward normal of front e (from corner e to e + 1).
func _euro_in(e: int) -> Vector2:
	var a: Vector2 = EURO_CORNERS[e % 4]
	var b: Vector2 = EURO_CORNERS[(e + 1) % 4]
	var t := (b - a).normalized()
	var n := Vector2(-t.y, t.x)
	var mid := (EURO_CORNERS[0] + EURO_CORNERS[1] + EURO_CORNERS[2] + EURO_CORNERS[3]) * 0.25
	return n if n.dot(mid - (a + b) * 0.5) > 0.0 else -n


## Front e's length, corner to corner.
func _euro_len(e: int) -> float:
	return (EURO_CORNERS[e % 4] as Vector2).distance_to(EURO_CORNERS[(e + 1) % 4])


## How far from corner i the bow meets the straight fronts (its tangent points, inset 0).
func _euro_tan(i: int) -> float:
	var c: Vector2 = EURO_CORNERS[i % 4]
	var u1 := ((EURO_CORNERS[(i + 3) % 4] as Vector2) - c).normalized()
	var u2 := ((EURO_CORNERS[(i + 1) % 4] as Vector2) - c).normalized()
	return EURO_R / tan(absf(u1.angle_to(u2)) * 0.5)


## A point on front e, u metres from its corner, moved d metres in (out when d < 0).
func _euro_pt(e: int, u: float, d: float) -> Vector2:
	var a: Vector2 = EURO_CORNERS[e % 4]
	var t := ((EURO_CORNERS[(e + 1) % 4] as Vector2) - a).normalized()
	return a + t * u + _euro_in(e) * d


## Corner i's bow at inset d: EURO_SEGS + 1 points from front i - 1's side to front i's. Every
## inset shares the bow's centre, so the rings stay concentric with the same corner count.
func _euro_arc(i: int, d: float) -> PackedVector2Array:
	var c: Vector2 = EURO_CORNERS[i % 4]
	var n1 := _euro_in(i + 3)
	var n2 := _euro_in(i)
	var u1 := ((EURO_CORNERS[(i + 3) % 4] as Vector2) - c).normalized()
	var u2 := ((EURO_CORNERS[(i + 1) % 4] as Vector2) - c).normalized()
	var half := absf(u1.angle_to(u2)) * 0.5
	var centre := c + (u1 + u2).normalized() * EURO_R / sin(half)
	var r := maxf(EURO_R - d, 0.6)
	var cd := c + (n1 + n2) * d / (1.0 + n1.dot(n2))
	var p1 := cd + u1 * r / tan(half)
	var p2 := cd + u2 * r / tan(half)
	var a1 := (p1 - centre).angle()
	var da := wrapf((p2 - centre).angle() - a1, -PI, PI)
	var out := PackedVector2Array()
	for k in EURO_SEGS + 1:
		out.append(centre + Vector2.from_angle(a1 + da * k / EURO_SEGS) * r)
	return out


## The whole plan at inset d (out when d < 0): the four bows joined by the straight fronts.
func _euro_ring(d: float) -> PackedVector2Array:
	var ring := PackedVector2Array()
	for i in 4:
		ring.append_array(_euro_arc(i, d))
	return ring


## Corner i's pavilion as a path at inset d: from front i - 1's pavilion end round the bow to
## front i's.
func _euro_path(i: int, d: float) -> PackedVector2Array:
	var path := PackedVector2Array([_euro_pt(i + 3, _euro_len(i + 3) - EURO_PAV, d)])
	path.append_array(_euro_arc(i, d))
	path.append(_euro_pt(i, EURO_PAV, d))
	return path


## A segment's outward normal (away from the plan's middle).
func _euro_out(a: Vector2, b: Vector2) -> Vector2:
	var t := (b - a).normalized()
	var n := Vector2(t.y, -t.x)
	var mid := (EURO_CORNERS[0] + EURO_CORNERS[1] + EURO_CORNERS[2] + EURO_CORNERS[3]) * 0.25
	return n if n.dot((a + b) * 0.5 - mid) > 0.0 else -n


## A balcony along a path: the slab (front and top) `deep` out from the wall at y, and its
## balustrade near the slab's edge (a pale rail and plinth, darker between: the balusters' shade).
func _euro_balcony(i: int, y: float, deep: float) -> void:
	var wall := _euro_path(i, 0.0)
	var edge := _euro_path(i, -deep)
	var rail := _euro_path(i, -deep + 0.08)
	_mode = M_STONE
	for j in wall.size() - 1:
		var out := _euro_out(wall[j], wall[j + 1])
		var n := Vector3.UP
		_quad(Vector3(wall[j].x, y + 0.28, wall[j].y), Vector3(wall[j + 1].x, y + 0.28, wall[j + 1].y),
				Vector3(edge[j + 1].x, y + 0.28, edge[j + 1].y), Vector3(edge[j].x, y + 0.28, edge[j].y), n, EUROPEJSKI_TRIM)
		_wall(edge[j], edge[j + 1], y, y + 0.28, out, EUROPEJSKI_TRIM.darkened(0.04))
		for s: float in [1.0, -1.0]:
			_wall(rail[j], rail[j + 1], y + 0.28, y + 0.42, out * s, EUROPEJSKI_TRIM)
			_wall(rail[j], rail[j + 1], y + 0.42, y + 1.0, out * s, EUROPEJSKI_SHADE)
			_wall(rail[j], rail[j + 1], y + 1.0, y + 1.15, out * s, EUROPEJSKI_TRIM.lightened(0.04))


## A column on a plan spot: a hexagonal shaft and a flared (Corinthian) capital.
func _euro_column(p: Vector2, y0: float, y1: float, r: float) -> void:
	var none := Color(0, 0, 0, 0)
	_prism(_circle(p, r, 6), y0, y1 - 0.5, EUROPEJSKI_TRIM, none, M_STONE)
	_mode = M_STONE
	_frustum(_circle(p, r, 6), y1 - 0.5, _circle(p, r * 1.7, 6), y1, EUROPEJSKI_TRIM.lightened(0.05), EUROPEJSKI_TRIM)


## A face in the current front's frame: u0..u1, y0..y1 (absolute), v out from the wall.
func _euro_face(u0: float, u1: float, y0: float, y1: float, v: float, col: Color, mode := M_STONE) -> void:
	_mode = mode
	_wall(_w(u0, v), _w(u1, v), y0, y1, _b, col, 0.0 if mode != M_GLASS else 0.75 - (u1 - u0) * 0.5)
	_mode = M_STONE


## A ledge (a sill, a window cap) in the front's frame: its face `deep` out and its top.
func _euro_ledge(u0: float, u1: float, y0: float, y1: float, deep: float, col: Color) -> void:
	_euro_face(u0, u1, y0, y1, deep, col)
	var a := _w(u0, 0.0)
	var b := _w(u1, 0.0)
	var c := _w(u1, deep)
	var d := _w(u0, deep)
	_quad(Vector3(a.x, y1, a.y), Vector3(b.x, y1, b.y), Vector3(c.x, y1, c.y), Vector3(d.x, y1, d.y), Vector3.UP, col.lightened(0.04))


## A window with its surround in the front's frame (the pane `hw` half wide).
func _euro_window(cu: float, y0: float, y1: float, hw: float) -> void:
	_euro_face(cu - hw - 0.18, cu + hw + 0.18, y0 - 0.18, y1 + 0.1, 0.04, EUROPEJSKI_TRIM)
	_euro_face(cu - hw, cu + hw, y0, y1, 0.08, EUROPEJSKI_GLASS, M_GLASS)


## A round-headed opening with its surround on a plan spot (`along` the wall, `out` from it).
func _euro_arched(at: Vector2, along: Vector2, out: Vector2, hw: float, y0: float, spring: float, glass: Color) -> void:
	_arch_panel(at, along, out, hw + 0.22, y0, spring, EUROPEJSKI_TRIM, 0.04, M_STONE)
	_arch_panel(at, along, out, hw, y0, spring, glass, 0.08, M_GLASS)
	_mode = M_STONE


func _build_europejski(site: Dictionary) -> void:
	var raw: PackedVector2Array = site.get("raw", site["ring"])
	var ring := _euro_ring(0.0)
	_g = _ground_under(raw)
	var g := _g
	var none := Color(0, 0, 0, 0)
	# Bows first: their columns, windows and balconies stand off the walls drawn after them.
	for i in 4:
		var arc := _euro_arc(i, 0.0)
		var cols := _euro_arc(i, -0.55)
		for k in arc.size():
			_euro_column(cols[k], g + EURO_GF + 1.15, g + EURO_T1, 0.32)
			_euro_column(cols[k], g + EURO_T2 + 1.15, g + EURO_CORNICE, 0.34)
		for k in arc.size() - 1:
			var mid := (arc[k] + arc[k + 1]) * 0.5
			var along := (arc[k + 1] - arc[k]).normalized()
			var out := _euro_out(arc[k], arc[k + 1])
			_euro_arched(mid, along, out, 0.5, g + EURO_GF + 1.4, g + EURO_T1 - 1.6, EUROPEJSKI_GLASS)
			_euro_arched(mid, along, out, 0.5, g + EURO_T2 + 1.4, g + EURO_CORNICE - 3.2, EUROPEJSKI_GLASS)
			if k == EURO_SEGS / 2:
				_euro_arched(mid, along, out, 0.75, g + 0.3, g + 4.4, EUROPEJSKI_SHOP)
		_euro_balcony(i, g + EURO_GF, 1.0)
		_euro_balcony(i, g + EURO_T1 + 0.05, 0.8)
	# The fronts, each in its own frame: u from its corner, +v out of the wall.
	for e in 4:
		var length := _euro_len(e)
		_o = EURO_CORNERS[e]
		_a = ((EURO_CORNERS[(e + 1) % 4] as Vector2) - _o).normalized()
		_b = -_euro_in(e)
		# the pavilions' straight parts: paired columns at the inner end, an arched window per storey
		for end in 2:
			var t := _euro_tan(e if end == 0 else e + 1)
			var s := 1.0 if end == 0 else -1.0
			var u0 := 0.0 if end == 0 else length
			var inner := u0 + s * EURO_PAV
			for du: float in [0.6, 1.5]:
				var p := _w(inner - s * du, 0.55)
				_euro_column(p, g + EURO_GF + 1.15, g + EURO_T1, 0.32)
				_euro_column(p, g + EURO_T2 + 1.15, g + EURO_CORNICE, 0.34)
			var cw := (u0 + s * t + inner - s * 2.0) * 0.5
			var at := _w(cw, 0.0)
			_euro_arched(at, _a, _b, 0.65, g + EURO_GF + 1.4, g + EURO_T1 - 1.5, EUROPEJSKI_GLASS)
			_euro_arched(at, _a, _b, 0.65, g + EURO_T2 + 1.4, g + EURO_CORNICE - 3.1, EUROPEJSKI_GLASS)
			_euro_arched(at, _a, _b, 0.95, g + 0.3, g + 4.4, EUROPEJSKI_SHOP)
		# the window bays between the pavilions
		var span := length - 2.0 * EURO_PAV
		var n := maxi(int(round(span / EURO_BAY)), 1)
		var bay := span / n
		for k in n:
			var cu := EURO_PAV + (k + 0.5) * bay
			if (k - n / 2) % 2 == 0:  # the ground floor: tall arched shop windows, doors between
				_euro_arched(_w(cu, 0.0), _a, _b, 1.15, g + 0.3, g + 4.5, EUROPEJSKI_SHOP)
			else:
				_euro_window(cu, g + 0.3, g + 3.6, 0.6)
				_euro_window(cu, g + 4.6, g + 5.6, 0.55)
			# the first floor: a balustrade panel, the window, its cap and pediment
			_euro_ledge(cu - 1.05, cu + 1.05, g + EURO_GF + 0.3, g + EURO_GF + 1.1, 0.16, EUROPEJSKI_TRIM)
			_euro_window(cu, g + EURO_GF + 1.3, g + EURO_T1 - 1.4, 0.62)
			_euro_ledge(cu - 0.95, cu + 0.95, g + EURO_T1 - 1.25, g + EURO_T1 - 1.05, 0.2, EUROPEJSKI_TRIM)
			var p0 := _w(cu - 0.95, 0.12)
			var p1 := _w(cu + 0.95, 0.12)
			var p2 := _w(cu, 0.12)
			var yb := g + EURO_T1 - 1.05
			_tri(Vector3(p0.x, yb, p0.y), Vector3(p1.x, yb, p1.y), Vector3(p2.x, yb + 0.6, p2.y), Vector3(_b.x, 0.0, _b.y),
					EUROPEJSKI_TRIM, Vector2(-1, -1), Vector2(-1, -1), Vector2(-1, -1), -1.0)
			# the second floor's capped window, the third's small one
			_euro_window(cu, g + EURO_T2 + 0.6, g + EURO_T2 + 2.7, 0.58)
			_euro_ledge(cu - 0.9, cu + 0.9, g + EURO_T2 + 2.85, g + EURO_T2 + 3.05, 0.2, EUROPEJSKI_TRIM)
			_euro_window(cu, g + EURO_T2 + 4.0, g + EURO_T2 + 5.1, 0.5)
		# the attic's dies at the bay joints and the pavilions' ends
		for k in n + 1:
			_lbox(EURO_PAV + k * bay, -0.15, 0.22, 0.22, g + EURO_TOP, g + EURO_ATTIC, EUROPEJSKI_TRIM, M_STONE, EUROPEJSKI_TRIM)
		if e == 0:  # Krakowskie Przedmieście: the name over the middle bays
			var mu := length * 0.5
			_euro_face(mu - 4.2, mu + 4.2, g + EURO_T1 + 0.05, g + EURO_T2 - 0.05, 0.1, EUROPEJSKI_BASE)
			var k := 7.2 / Neon.length_of(EUROPEJSKI_WORD)
			var at := _w(mu, -0.25)
			var yk := g + (EURO_T1 + EURO_T2) * 0.5 - 0.5 * k * Neon.ROW_H * Neon.PIXEL
			signs.append([EUROPEJSKI_WORD, Vector3(at.x, yk, at.y), Vector3(_b.x, 0.0, _b.y), k, EUROPEJSKI_GOLD])
	# The walls: the ground floor's rusticated courses, the stone above, the string courses.
	var courses := 6
	for k in courses:
		var y0 := g - 0.6 + (EURO_GF + 0.6) * k / courses
		var y1 := g - 0.6 + (EURO_GF + 0.6) * (k + 1) / courses
		_prism(ring, y0, y1, EUROPEJSKI_BASE.darkened(0.06 if k % 2 == 0 else 0.0), none, M_STONE)
	_prism(ring, g + EURO_GF, g + EURO_CORNICE, EUROPEJSKI_WALL, none, M_STONE)
	_prism(_euro_ring(-0.25), g + EURO_GF - 0.25, g + EURO_GF, EUROPEJSKI_TRIM, none, M_STONE)
	_prism(_euro_ring(-0.2), g + EURO_T1, g + EURO_T1 + 0.3, EUROPEJSKI_TRIM, none, M_STONE)
	_prism(_euro_ring(-0.3), g + EURO_CORNICE - 0.7, g + EURO_CORNICE, EUROPEJSKI_TRIM.darkened(0.03), none, M_STONE)
	# The main cornice and the roof round the courtyard.
	var court := _euro_ring(EURO_WING)
	_prism(_euro_ring(-0.7), g + EURO_CORNICE, g + EURO_TOP, EUROPEJSKI_TRIM.lightened(0.04), none, M_STONE)
	_mode = M_STONE
	_cap_holes(_euro_ring(-0.7), [court], g + EURO_TOP, EUROPEJSKI_LEAD)
	# The balustrade attic: plinth, the balusters' shade, rail.
	var attic := _euro_ring(0.15)
	_parapet(attic, g + EURO_TOP, 0.3, EUROPEJSKI_TRIM)
	_parapet(_euro_ring(0.3), g + EURO_TOP + 0.3, EURO_ATTIC - EURO_TOP - 0.55, EUROPEJSKI_SHADE)
	_parapet(attic, g + EURO_ATTIC - 0.25, 0.25, EUROPEJSKI_TRIM.lightened(0.04))
	# The roof storey: dark louvred glass set back behind the attic, its top curving in.
	var louvre0 := _euro_ring(1.7)
	var louvre1 := _euro_ring(3.0)
	_mode = M_GLASS
	_prism(louvre0, g + EURO_TOP, g + EURO_ROOF - 1.3, EUROPEJSKI_ROOF, none, M_GLASS)
	_mode = M_STONE
	_frustum(louvre0, g + EURO_ROOF - 1.3, _euro_ring(2.2), g + EURO_ROOF - 0.5, EUROPEJSKI_ROOF.lightened(0.04))
	_frustum(_euro_ring(2.2), g + EURO_ROOF - 0.5, louvre1, g + EURO_ROOF, EUROPEJSKI_ROOF.lightened(0.08))
	var inner := _euro_ring(EURO_WING - 1.8)
	_cap_holes(louvre1, [inner], g + EURO_ROOF, EUROPEJSKI_ZINC)
	# The courtyard: its walls face in (stone with windows), the glass roof low over it.
	for j in inner.size():
		var a := inner[j]
		var b := inner[(j + 1) % inner.size()]
		_mode = M_GLASS
		_wall(a, b, g + EURO_TOP, g + EURO_ROOF, -_euro_out(a, b), EUROPEJSKI_ROOF)
	for j in court.size():
		var a := court[j]
		var b := court[(j + 1) % court.size()]
		_mode = M_MONUMENT
		_wall(a, b, g + EURO_COURT, g + EURO_TOP, -_euro_out(a, b), EUROPEJSKI_WALL)
	_mode = M_STONE
	_cap(court, g + EURO_COURT, EUROPEJSKI_COURT)
	_collide(raw)  # the mapped outline: the car meets the facade where the map's pavement ends


# --- Muzeum Sztuki Nowoczesnej ------------------------------------------------------------

## The Museum of Modern Art (Thomas Phifer, 2024), first scene item 1 (2026-10-31), built to its
## spec docs/landmarks/specs/msn.md from the museum's OpenStreetMap parts: one long white box on
## a glazed ground floor behind deep white fins, a thin dark slot all round where the upper box
## sits back, the "city room" windows, a glass grid over the flat roof. Its plan frame: u along
## the long side (north-north-west end at u < 0), +v towards the Palace, -v Marszałkowska.
const MSN := Vector2(-1022.4, 100.15)
const MSN_AXIS := Vector2(0.3445, 0.9388)
const MSN_HU := 51.85          # the box's half length and half width (the outline)
const MSN_HV := 19.9
const MSN_INSET := 0.7         # the slot band sits this far in
const MSN_CORE := Vector2(45.8, 13.95)  # the glazed ground floor's half plan
const MSN_BASE := 5.0          # the soffit
const MSN_SLOT := Vector2(12.5, 13.8)
const MSN_H := 26.0
## The fins' centres (u) on the Marszałkowska face (v -17.4) and the Plac Defilad face (v +17.35).
const MSN_FINS_EAST := [-50.4, -39.4, -26.4, -18.4, -10.4, 0.4, 7.4, 15.3, 26.4, 33.8, 40.8, 50.4]
const MSN_FINS_WEST := [-50.4, -39.5, -32.5, -26.5, -18.5, -10.6, 0.4, 7.3, 15.2, 26.2, 33.7, 40.7, 50.3]
## The ends' fins, turned along u: [u, v].
const MSN_FINS_END := [[-49.4, 3.95], [-49.4, -8.5], [49.4, 6.3], [49.4, -8.55]]
## The roof (photo check on the Mac, 2026-11-01, refs/msn/ortho.jpg and 2.jpg): one gridded glass
## field over the whole roof inside a white edge MSN_SKY_EDGE wide, and two small square light
## wells [u, v, half side] cut into it.
const MSN_SKY_EDGE := 2.2
const MSN_WELLS := [Vector3(5.0, 4.9, 4.0), Vector3(31.5, -0.6, 3.5)]
## The Marszałkowska face's city-room window (refs/msn/4.jpg): a deep recess in the upper box,
## u -1..11, 14 to 20.5 m, the glass 3 m back.
const MSN_LOGGIA := [-1.0, 11.0, 14.0, 20.5, 3.0]
## The north-west corner block (OSM: u -64.3..-53.8, v 16.5..27, 26 m on an 8 m base).
const MSN_CORNER_U := -64.3
const MSN_CORNER_V := Vector2(16.5, 27.0)
const MSN_WHITE := Color("#ebe9e3")
const MSN_ROOF := Color("#d9d8d2")
const MSN_LOBBY := Color("#a9c3cd")
const MSN_SLOT_GLASS := Color("#4a5960")
const MSN_WINDOW := Color("#8fa9b6")
const MSN_SKY_GLASS := Color("#cfd8dc")
func _find_msn() -> void:
	var outline := _landmark("Muzeum Sztuki Nowoczesnej")
	if outline.size() < 3:
		return
	# Grown a metre so the fins and the mapped parts on the edge go with it.
	var grown := Geometry2D.offset_polygon(outline, 1.0, Geometry2D.JOIN_MITER)
	_o = MSN
	_a = MSN_AXIS.normalized()
	_b = Vector2(-_a.y, _a.x)
	var corner := _rect((MSN_CORNER_U - MSN_HU) * 0.5, (MSN_CORNER_V.x + MSN_CORNER_V.y) * 0.5,
			(MSN_HU + MSN_CORNER_U) * -0.5 + 1.0, (MSN_CORNER_V.y - MSN_CORNER_V.x) * 0.5 + 1.0)
	_add_site("msn", [grown[0] if not grown.is_empty() else outline, corner])


func _build_msn(_site: Dictionary) -> void:
	_o = MSN
	_a = MSN_AXIS.normalized()
	_b = Vector2(-_a.y, _a.x)
	var box := _rect(0.0, 0.0, MSN_HU, MSN_HV)
	_g = _ground_under(box)
	var g := _g
	var none := Color(0, 0, 0, 0)
	# The windows first, flush, so the walls are cut round them (F's night photo, 2026-10-31):
	# w1 and w3 on the Plac Defilad face, w4 and w5 on the north end, w2 on Marszałkowska.
	_mode = M_PAVILION
	_wall(_w(0.0, MSN_HV), _w(14.0, MSN_HV), g + 16.5, g + 22.5, _b, MSN_WINDOW)
	_wall(_w(-1.0, MSN_HV), _w(5.0, MSN_HV), g + 7.0, g + 10.5, _b, MSN_WINDOW)
	_wall(_w(37.0, -MSN_HV), _w(39.0, -MSN_HV), g + 14.5, g + 19.0, -_b, MSN_WINDOW)
	_wall(_w(-MSN_HU, -9.0), _w(-MSN_HU, -15.0), g + 15.5, g + 22.0, -_a, MSN_WINDOW)
	# loggia: w2, the recess on Marszałkowska. Its opening goes into _walls undrawn, so the upper
	# box's wall is cut round it; then the glass at the back, the reveals, the sill and the head.
	var lu0: float = MSN_LOGGIA[0]
	var lu1: float = MSN_LOGGIA[1]
	var ly0: float = g + MSN_LOGGIA[2]
	var ly1: float = g + MSN_LOGGIA[3]
	var lv := -MSN_HV + float(MSN_LOGGIA[4])
	var lo0 := _w(lu0, -MSN_HV)
	var lo1 := _w(lu1, -MSN_HV)
	_walls.append(PackedFloat32Array([lo0.x, lo0.y, lo1.x, lo1.y, ly0, ly1, -_b.x, -_b.y]))
	_wall(_w(lu0, lv), _w(lu1, lv), ly0, ly1, -_b, MSN_WINDOW)
	_mode = M_STONE
	_wall(_w(lu0, -MSN_HV), _w(lu0, lv), ly0, ly1, _a, MSN_WHITE.darkened(0.1))
	_wall(_w(lu1, lv), _w(lu1, -MSN_HV), ly0, ly1, -_a, MSN_WHITE.darkened(0.18))
	for k: Array in [[ly0, Vector3.UP, MSN_WHITE], [ly1, Vector3.DOWN, MSN_WHITE.darkened(0.25)]]:
		var p0 := _w(lu0, -MSN_HV)
		var p1 := _w(lu1, -MSN_HV)
		var p2 := _w(lu1, lv)
		var p3 := _w(lu0, lv)
		var y: float = k[0]
		_quad(Vector3(p0.x, y, p0.y), Vector3(p1.x, y, p1.y), Vector3(p2.x, y, p2.y), Vector3(p3.x, y, p3.y), k[1], k[2])
	_mode = M_PAVILION
	_wall(_w(-MSN_HU, -11.5), _w(-MSN_HU, -14.0), g + 7.0, g + 9.5, -_a, MSN_WINDOW)
	# corner: the full-height block standing out at the north-west corner (OSM's part at
	# (-1062, 54), closed up to the box), solid to the ground, a glazed top a metre under the roof.
	var corner := PackedVector2Array([_w(MSN_CORNER_U, MSN_CORNER_V.x), _w(-MSN_HU, MSN_CORNER_V.x),
			_w(-MSN_HU, MSN_CORNER_V.y), _w(MSN_CORNER_U, MSN_CORNER_V.y)])
	_prism(corner, g - 0.4, g + MSN_H - 1.0, MSN_WHITE, MSN_SKY_GLASS, M_STONE, M_GLASS_ROOF)
	# core: the glazed lobby, lit warm at night.
	_prism(_rect(0.0, 0.0, MSN_CORE.x, MSN_CORE.y), g - 0.4, g + MSN_BASE, MSN_LOBBY, none, M_PAVILION)
	# fins
	for u: float in MSN_FINS_EAST:
		_prism(_rect(u, -17.4, 0.5, 1.5), g - 0.4, g + MSN_BASE, MSN_WHITE, none, M_STONE)
	for u: float in MSN_FINS_WEST:
		_prism(_rect(u, 17.35, 0.5, 1.5), g - 0.4, g + MSN_BASE, MSN_WHITE, none, M_STONE)
	for f: Array in MSN_FINS_END:
		_prism(_rect(f[0], f[1], 1.5, 0.5), g - 0.4, g + MSN_BASE, MSN_WHITE, none, M_STONE)
	_mode = M_STONE
	# soffit
	_msn_ring(MSN_HU, MSN_HV, MSN_CORE.x, MSN_CORE.y, g + MSN_BASE, Vector3.DOWN, MSN_WHITE.darkened(0.12))
	# lower
	_prism(box, g + MSN_BASE, g + MSN_SLOT.x, MSN_WHITE, none, M_STONE)
	# ledge, slot, under
	var hu := MSN_HU - MSN_INSET
	var hv := MSN_HV - MSN_INSET
	_msn_ring(MSN_HU, MSN_HV, hu, hv, g + MSN_SLOT.x, Vector3.UP, MSN_WHITE)
	_prism(_rect(0.0, 0.0, hu, hv), g + MSN_SLOT.x, g + MSN_SLOT.y, MSN_SLOT_GLASS, none, M_GLASS)
	_mode = M_STONE
	_msn_ring(MSN_HU, MSN_HV, hu, hv, g + MSN_SLOT.y, Vector3.DOWN, MSN_WHITE.darkened(0.15))
	# upper
	_prism(box, g + MSN_SLOT.y, g + MSN_H, MSN_WHITE, none, M_STONE)
	# sky: the glass field over the top galleries, lit from inside at night, round the wells;
	# drawn first so the stone roof after it keeps only the white edge.
	var wells: Array = []
	for w: Vector3 in MSN_WELLS:
		wells.append(_rect(w.x, w.y, w.z, w.z))
	_mode = M_GLASS_ROOF
	_cap_holes(_rect(0.0, 0.0, MSN_HU - MSN_SKY_EDGE, MSN_HV - MSN_SKY_EDGE), wells, g + MSN_H, MSN_SKY_GLASS)
	_mode = M_STONE
	_cap_holes(box, wells, g + MSN_H, MSN_ROOF)
	# wells: open courts cut into the roof, 4 m deep, their floors in shade.
	for well: PackedVector2Array in wells:
		for i in 4:
			var a := well[i]
			var b := well[(i + 1) % 4]
			_wall(a, b, g + MSN_H - 4.0, g + MSN_H, -_out(well, a, b), MSN_WHITE.darkened(0.2))
		_cap(well, g + MSN_H - 4.0, MSN_ROOF.darkened(0.35))
	_collide(box)


## A flat ring in the museum's frame between the half plans (hu, hv) and (iu, iv) at y, facing
## `n` (up for a ledge, down for a soffit): four quads.
func _msn_ring(hu: float, hv: float, iu: float, iv: float, y: float, n: Vector3, col: Color) -> void:
	for r: Array in [[-hu, -hv, -iu, hv], [iu, -hv, hu, hv], [-iu, -hv, iu, -iv], [-iu, iv, iu, hv]]:
		var p0 := _w(r[0], r[1])
		var p1 := _w(r[2], r[1])
		var p2 := _w(r[2], r[3])
		var p3 := _w(r[0], r[3])
		_quad(Vector3(p0.x, y, p0.y), Vector3(p1.x, y, p1.y), Vector3(p2.x, y, p2.y), Vector3(p3.x, y, p3.y), n, col)


# --- Domy Towarowe Centrum (the Eastern Wall) ----------------------------------------------

## First scene item 3 (spec docs/landmarks/specs/dtc.md, 2026-10-31): the three glass department
## stores on Marszałkowska's east side, right of the car at the start (Junior beside it, Sawa and
## Wars behind), built from their OpenStreetMap parts: the recessed glazed shop floor (mh 0,
## 5.5 m, its mapped piers), the cantilevered curtain-wall box over it (5.5 to 17.5 m, the
## landmark's outline), an aluminium fascia at the slab and a cornice at the roof, a set-back top
## storey, and each store's name on the roof as a lit parody sign facing the street.
const DTC := [{"osm": "Junior", "sign": "JUNIOREK"}, {"osm": "Sawa", "sign": "SAWKA"}, {"osm": "Wars", "sign": "WARSIK"}]
const DTC_BASE := 5.5        # the shop floor's top (OSM part h 5.5)
const DTC_FASCIA := 0.8      # the slab edge over the shop windows
const DTC_BODY := 17.5       # the curtain wall's top (OSM part h 17.5)
const DTC_CORNICE := 0.5
const DTC_TOP := 3.0         # the top storey (OSM parts 17.5 to 20.5)
const DTC_TOP_IN := 3.0      # and how far it stands back from the long sides (the Mac photo check)
const DTC_TOP_END := 8.0     # and from the ends (6-10 m in the photos)
const DTC_RECESS := 4.5      # the shop floor's set-back under the cantilever (photos: 4-5 m)
## Down Marszałkowska (south-south-east) from the stores: the game's camera looks up the street,
## so the stores' south ends face it.
const DTC_SOUTH := Vector2(0.349, 0.937)
const DTC_SHOP := Color("#6e7f84")      # the dark shop windows deep under the cantilever, lit warm at night
const DTC_GLASS := Color("#56656e")     # the curtain wall's dark blue-grey glass (the Mac photo check)
const DTC_ALU := Color("#c9cdcf")       # fascia, cornice, soffit: light aluminium
const DTC_TOP_WALL := Color("#dfe1dc")  # the top storey's panels (OSM #E4E5DE)
const DTC_ROOF := Color("#4f5559")      # the main roof
const DTC_TOP_ROOF := Color("#5d6468")  # the top storey's roof
const DTC_SKY := Color("#cfd8dc")       # the roof lights, lit at night
const DTC_SIGN := Color(1.0, 0.86, 0.55)
## The stores' shops and ads (printed banners on the curtain walls, lit shop fronts under the
## cantilever, the furniture outside) come from data/eastern_wall_shops.json, as the stores are
## now (2026-11: UNIKAT where Zara was, LUKA's bakery, the four-floor TAK MAKS, the two-storey
## FROGS XXL on H&M's corner): these shops change often, so they are swapped there, not here.
const DTC_SHOPS_FILE := "res://data/eastern_wall_shops.json"
## The street face (Marszałkowska), the back, the far end: the faces the file names.
const DTC_EAST := Vector2(0.937, -0.349)


## The file's stores (osm name -> {banners, fronts, props}); empty when it is missing.
static func dtc_shops() -> Dictionary:
	var f := FileAccess.get_file_as_string(DTC_SHOPS_FILE)
	var json: Variant = JSON.parse_string(f) if f != "" else null
	if json is Dictionary and (json as Dictionary).get("stores") is Dictionary:
		return json["stores"]
	return {}


static func _dtc_dir(face: String) -> Vector2:
	match face:
		"south":
			return DTC_SOUTH
		"north":
			return -DTC_SOUTH
		"east":
			return DTC_EAST
	return -DTC_EAST


func _find_dtc() -> void:
	var zone: Array[PackedVector2Array] = []
	for d: Dictionary in DTC:
		var outline := _landmark(d["osm"])
		if outline.size() < 3:
			continue
		var grown := Geometry2D.offset_polygon(outline, 1.0, Geometry2D.JOIN_MITER)
		zone.append(grown[0] if not grown.is_empty() else outline)
	_add_site("dtc", zone)


func _build_dtc(_site: Dictionary) -> void:
	var none := Color(0, 0, 0, 0)
	var skin := M_SKIN + float(S_EASTWALL) / 16.0
	var shops := dtc_shops()
	for d: Dictionary in DTC:
		var outline := _landmark(d["osm"])
		if outline.size() < 3:
			continue
		_g = _ground_under(outline)
		var g := _g
		# shop: the dark glazed ground floor, its mapped outline (the piers are its jogs) kept at
		# least DTC_RECESS in from the edge (the photo check: 4-5 m under the cantilever).
		var mapped := PackedVector2Array()
		for part in _parts_in(outline, func(b: Dictionary) -> bool: return float(b["mh"]) < 0.5 and float(b["h"]) < DTC_BASE + 1.0):
			var q := _pts(part["p"])
			if _area(q) > _area(mapped):
				mapped = q
		var drawn := Geometry2D.offset_polygon(outline, -DTC_RECESS, Geometry2D.JOIN_MITER)
		var shop: PackedVector2Array = drawn[0] if not drawn.is_empty() else outline
		if _area(mapped) > _area(outline) * 0.5:
			var both := _largest(Geometry2D.intersect_polygons(mapped, shop))
			if _area(both) > _area(shop) * 0.6:
				shop = both
		_prism(shop, g - 0.4, g + DTC_BASE, DTC_SHOP, none, M_PAVILION)
		# body: the fascia over the shops, the curtain wall, the cornice and the roof.
		_prism(outline, g + DTC_BASE, g + DTC_BASE + DTC_FASCIA, DTC_ALU, none, M_STONE)
		_prism(outline, g + DTC_BASE + DTC_FASCIA, g + DTC_BODY - DTC_CORNICE, DTC_GLASS, none, skin)
		_prism(outline, g + DTC_BODY - DTC_CORNICE, g + DTC_BODY, DTC_ALU, DTC_ROOF, M_STONE, M_STONE)
		# soffit: the cantilever's light aluminium underside round the shop floor.
		_mode = M_STONE
		_soffit(outline, g + DTC_BASE, DTC_ALU.darkened(0.06))
		# top: the set-back top storey, 3 m in on the long sides and DTC_TOP_END at the ends.
		var top := _dtc_top(outline)
		if top.size() >= 3:
			var y := g + DTC_BODY + DTC_TOP
			_prism(top, g + DTC_BODY, y, DTC_TOP_WALL, DTC_TOP_ROOF, M_SKIN + float(S_DARK) / 16.0, M_STONE)
			_dtc_roof(top, y, d["osm"] == "Junior")
		var store: Dictionary = shops.get(str(d["osm"]), {})
		_dtc_banners(outline, top, g, store.get("banners", []))
		_dtc_fronts(outline, shop, g, store.get("fronts", []))
		_dtc_props(outline, g, store.get("props", []))
		_dtc_green(outline, g, store.get("roof_green", []))
		_dtc_sign(outline, str(d["sign"]), g + DTC_BODY)
		_collide(shop)
	_mode = M_STONE
	_dtc_relax()


## R1 (docs/design/start-area-real.md): the old Kino Relax behind Junior (Złota 8, 1970, Poland's
## first 70 mm cinema), heritage-listed and reopened as the theatre Scena Relax: its name in
## letters on the roof edge the start's camera sees. Only a sign (the building stays the map's).
const RELAX_RED := Color(0.86, 0.1, 0.16)  # the red word on the yellow banner
## The word in a 3 x 5 grid, row by row from the top.
const RELAX_GLYPHS := ["110101110101101", "111100110100111", "100100100100111", "010101111101101", "101101010101101"]
func _dtc_relax() -> void:
	pass  # the word is on the banner now (_build_scena_relax)


## The top storey's plan: the outline drawn in 3 m, then cut back to DTC_TOP_END from each end
## (along the street).
func _dtc_top(outline: PackedVector2Array) -> PackedVector2Array:
	var inset := Geometry2D.offset_polygon(outline, -DTC_TOP_IN, Geometry2D.JOIN_MITER)
	if inset.is_empty():
		return PackedVector2Array()
	var lo := INF
	var hi := -INF
	var c := _centre(outline)
	for q in outline:
		var s := (q - c).dot(DTC_SOUTH)
		lo = minf(lo, s)
		hi = maxf(hi, s)
	var across := Vector2(-DTC_SOUTH.y, DTC_SOUTH.x)
	var a := lo + DTC_TOP_END
	var b := hi - DTC_TOP_END
	var band := PackedVector2Array([c + DTC_SOUTH * a - across * 60.0, c + DTC_SOUTH * b - across * 60.0,
			c + DTC_SOUTH * b + across * 60.0, c + DTC_SOUTH * a + across * 60.0])
	return _largest(Geometry2D.intersect_polygons(inset[0], band))


## The top storey's roof (the photo check): small square skylights in pairs and 2 x 2
## clusters every 12 m down the middle, a few curved half-cylinder vents, and fewer, larger
## plant boxes at the north end. Junior's roof is stepped: a lighter raised strip over its east
## half, a light-blue glazed skylight block and more plant.
func _dtc_roof(top: PackedVector2Array, y: float, junior: bool) -> void:
	var c := _centre(top)
	var across := Vector2(-DTC_SOUTH.y, DTC_SOUTH.x)
	var lo := INF
	var hi := -INF
	for q in top:
		var s := (q - c).dot(DTC_SOUTH)
		lo = minf(lo, s)
		hi = maxf(hi, s)
	var mid_off := 0.0
	if junior:
		# The raised strip over the east half (the side away from the street).
		var strip := _largest(Geometry2D.intersect_polygons(top, PackedVector2Array([
				c + DTC_SOUTH * (lo - 1.0) + across * 0.5, c + DTC_SOUTH * (hi + 1.0) + across * 0.5,
				c + DTC_SOUTH * (hi + 1.0) - across * 40.0, c + DTC_SOUTH * (lo - 1.0) - across * 40.0])))
		if strip.size() >= 3:
			_prism(strip, y, y + 1.2, DTC_TOP_WALL.darkened(0.08), Color("#848b8f"), M_STONE, M_STONE)
		mid_off = 4.0   # the skylights move onto the lower west half
		# The glazed skylight block, on the strip near the south end.
		var gb := c + DTC_SOUTH * (hi - 14.0) - across * 4.5
		var block := PackedVector2Array([gb - DTC_SOUTH * 5.0 - across * 2.6, gb + DTC_SOUTH * 5.0 - across * 2.6,
				gb + DTC_SOUTH * 5.0 + across * 2.6, gb - DTC_SOUTH * 5.0 + across * 2.6])
		_prism(block, y + 1.2, y + 2.6, Color("#a9c6d6"), Color("#b4d2e0"), M_PAVILION + 0.5, M_GLASS_ROOF)
	var line := c + across * mid_off
	var n := 0
	var s := lo + 6.0
	while s < hi - 5.0:
		var p := line + DTC_SOUTH * s
		if n % 4 == 2:
			# A curved vent, its axis along the store.
			_dtc_vent(p, y)
		else:
			var cluster := n % 2 == 0
			for i in (4 if cluster else 2):
				var off := Vector2(-1.5 if i % 2 == 0 else 1.5, -1.5 if i < 2 else 1.5)
				if not cluster:
					off.y = 0.0
				var q := p + across * off.x + DTC_SOUTH * off.y
				_prism(_rot_square(q, 1.1), y, y + 0.45, DTC_ALU, DTC_SKY, M_STONE, M_GLASS_ROOF)
		s += 12.0
		n += 1
	# The plant: a few large boxes at the north end (more on Junior).
	var boxes := 3 if junior else 2
	for i in boxes:
		var q := line + DTC_SOUTH * (lo + 3.5) + across * (-4.0 + i * 4.0) + (DTC_SOUTH * 6.0 if i == 2 else Vector2.ZERO)
		if Geometry2D.is_point_in_polygon(q, top):
			_prism(_rot_square(q, 1.7), y, y + 1.9, Color("#a3aaac"), Color("#8d9497"), M_STONE, M_STONE)


## A square of half side h with its sides along and across the stores.
func _rot_square(c: Vector2, h: float) -> PackedVector2Array:
	var a := Vector2(-DTC_SOUTH.y, DTC_SOUTH.x)
	return PackedVector2Array([c - DTC_SOUTH * h - a * h, c + DTC_SOUTH * h - a * h, c + DTC_SOUTH * h + a * h, c - DTC_SOUTH * h + a * h])


## A curved half-cylinder vent on the roof, 2 m across and 4 m long along the store.
func _dtc_vent(p: Vector2, y: float) -> void:
	var a := Vector2(-DTC_SOUTH.y, DTC_SOUTH.x)
	var seg := 6
	var col := Color("#b4babd")
	_mode = M_STONE
	var e0 := p - DTC_SOUTH * 2.0
	var e1 := p + DTC_SOUTH * 2.0
	for k in seg:
		var t0 := PI * k / seg
		var t1 := PI * (k + 1) / seg
		var o0 := a * cos(t0)
		var o1 := a * cos(t1)
		var h0 := sin(t0)
		var h1 := sin(t1)
		var nm := (t0 + t1) * 0.5
		var n := Vector3(a.x * cos(nm), sin(nm), a.y * cos(nm))
		_quad(Vector3((e0 + o0).x, y + h0, (e0 + o0).y), Vector3((e1 + o0).x, y + h0, (e1 + o0).y),
				Vector3((e1 + o1).x, y + h1, (e1 + o1).y), Vector3((e0 + o1).x, y + h1, (e0 + o1).y), n, col)
		for e: Vector2 in [e0, e1]:
			var out := -DTC_SOUTH if e == e0 else DTC_SOUTH
			var nn := Vector2(-1, -1)
			_tri(Vector3(e.x, y, e.y), Vector3((e + o0).x, y + h0, (e + o0).y), Vector3((e + o1).x, y + h1, (e + o1).y),
					Vector3(out.x, 0, out.y), col.darkened(0.1), nn, nn, nn, -1.0)


## Where a sign `w` m wide goes on the face of `poly` that looks along the file's `face` ("west" is
## the street), `at` 0..1 from its left end to its right as read from outside: a ray in from
## outside finds the wall there (the outlines jog, so the wall is found, not assumed).
## [point on the wall, along the wall (to the reader's right), the wall's outward normal, the
## face's length], or [] when the ray meets no wall facing that way.
func _dtc_spot(poly: PackedVector2Array, face: String, at: float, w: float) -> Array:
	var want := _dtc_dir(face)
	var right := Vector2(want.y, -want.x)
	var lo := INF
	var hi := -INF
	var top := -INF
	for q in poly:
		lo = minf(lo, q.dot(right))
		hi = maxf(hi, q.dot(right))
		top = maxf(top, q.dot(want))
	var r := (lo + hi) * 0.5
	if hi - lo > w + 0.6:
		r = lerpf(lo + w * 0.5 + 0.3, hi - w * 0.5 - 0.3, clampf(at, 0.0, 1.0))
	var hit := _dtc_ray(poly, right * r + want * (top + 1.0), -want, 80.0)
	if hit.is_empty() or (hit[1] as Vector2).dot(want) < 0.8:
		return []
	var o: Vector2 = hit[1]
	return [hit[0], Vector2(o.y, -o.x), o, hi - lo]


## The first edge of `poly` a ray from `from` along `dir` meets within `far` m: [the point, that
## edge's outward normal], or [].
func _dtc_ray(poly: PackedVector2Array, from: Vector2, dir: Vector2, far: float) -> Array:
	var best := INF
	var out := []
	for i in poly.size():
		var a := poly[i]
		var b := poly[(i + 1) % poly.size()]
		var hit: Variant = Geometry2D.segment_intersects_segment(from, from + dir * far, a, b)
		if hit != null and from.distance_to(hit as Vector2) < best:
			best = from.distance_to(hit as Vector2)
			out = [hit as Vector2, _out(poly, a, b)]
	return out


## Lines of lit letters (the neon atlas) centred at `at` on a face with outward normal `o`, between
## y0 and y1, at most `w` m wide and `cap` m a row.
func _dtc_words(lines: Array, at: Vector2, o: Vector2, y0: float, y1: float, w: float, cap: float, ink: Color) -> void:
	if lines.is_empty():
		return
	var row := Neon.ROW_H * Neon.PIXEL
	var k := minf(cap, 0.85 * (y1 - y0) / lines.size()) / row
	for l: String in lines:
		k = minf(k, 0.8 * w / Neon.length_of(l))
	var step := row * k
	var y := (y0 + y1) * 0.5 - 0.5 * step * lines.size()
	for i in range(lines.size() - 1, -1, -1):
		signs.append([str(lines[i]), Vector3(at.x, y, at.y), Vector3(o.x, 0.0, o.y), k, ink])
		y += step


## The printed ad banners (the Mac photo check; what they say: data/eastern_wall_shops.json): big
## posters the curtain wall's height (or the top storey's), 0.2 m proud of the glass, each a colour
## with its words lit on it.
func _dtc_banners(outline: PackedVector2Array, top: PackedVector2Array, g: float, list: Array) -> void:
	for spec: Dictionary in list:
		var on_top := bool(spec.get("top", false))
		var poly := top if on_top else outline
		if poly.size() < 3:
			continue
		var w := float(spec.get("w", 10.0))
		var spot := _dtc_spot(poly, str(spec.get("face", "south")), float(spec.get("at", 0.5)), w)
		if spot.is_empty() or float(spot[3]) < (5.0 if on_top else 12.0):
			continue
		var m: Vector2 = spot[0]
		var dir: Vector2 = spot[1]
		var o: Vector2 = spot[2]
		w = minf(w, float(spot[3]) * 0.85)
		var y0 := g + (DTC_BODY + 0.4 if on_top else DTC_BASE + DTC_FASCIA + 0.4)
		var y1 := g + (DTC_BODY + DTC_TOP - 0.3 if on_top else DTC_BODY - DTC_CORNICE - 0.4)
		if spec.has("y0"):
			y0 = g + float(spec["y0"])
		if spec.has("y1"):
			y1 = g + float(spec["y1"])
		var q0 := m - dir * w * 0.5 + o * 0.2
		var q1 := m + dir * w * 0.5 + o * 0.2
		var p0 := m - dir * w * 0.5
		var p1 := m + dir * w * 0.5
		var col := Color(str(spec.get("bg", "#c8322e")))
		_mode = M_STONE
		_quad(Vector3(q0.x, y0, q0.y), Vector3(q1.x, y0, q1.y), Vector3(q1.x, y1, q1.y), Vector3(q0.x, y1, q0.y), Vector3(o.x, 0, o.y), col)
		_quad(Vector3(q0.x, y1, q0.y), Vector3(q1.x, y1, q1.y), Vector3(p1.x, y1, p1.y), Vector3(p0.x, y1, p0.y), Vector3.UP, col.darkened(0.2))
		_dtc_words(spec.get("lines", []), m + o * 0.25, o, y0, y1, w, 2.4, Color(str(spec.get("ink", "#ffffff"))))


## The shop fronts on the recessed glazed floor (data/eastern_wall_shops.json `fronts`): the
## shop's glass tinted its own colour (lit from inside at night) and a lit fascia band over it with
## the name; a two-storey shop (FROGS XXL) also glows through the curtain wall's first floor.
func _dtc_fronts(outline: PackedVector2Array, shop: PackedVector2Array, g: float, list: Array) -> void:
	for spec: Dictionary in list:
		var w := float(spec.get("w", 8.0))
		var spot := _dtc_spot(outline, str(spec.get("face", "west")), float(spec.get("at", 0.5)), w)
		if spot.is_empty():
			continue
		var m: Vector2 = spot[0]
		w = minf(w, float(spot[3]) * 0.9)
		# The shop's glass: its wall straight in from the curtain wall (under the cantilever).
		var hit := _dtc_ray(shop, m + (spot[2] as Vector2) * 0.5, -(spot[2] as Vector2), 12.0)
		if hit.is_empty():
			continue
		var wall: Vector2 = hit[0]
		var o: Vector2 = hit[1]
		var dir := Vector2(o.y, -o.x)
		var p0 := wall - dir * w * 0.5 + o * 0.06
		var p1 := wall + dir * w * 0.5 + o * 0.06
		var n := Vector3(o.x, 0, o.y)
		if spec.has("glass"):
			_mode = M_PAVILION
			_quad(Vector3(p0.x, g + 0.25, p0.y), Vector3(p1.x, g + 0.25, p1.y), Vector3(p1.x, g + 3.7, p1.y), Vector3(p0.x, g + 3.7, p0.y), n, Color(str(spec["glass"])))
		# The name: a lit board hung from the cantilever's edge (the slab's fascia), where the
		# street and the game's high camera both see it; the shop's glass behind stays tinted.
		var band := Color(str(spec.get("band", "#2b2f36")))
		var co: Vector2 = spot[2]
		var cd: Vector2 = spot[1]
		var b0 := m - cd * w * 0.5 + co * 0.3
		var b1 := m + cd * w * 0.5 + co * 0.3
		var t0 := m - cd * w * 0.5
		var t1 := m + cd * w * 0.5
		var by0 := g + DTC_BASE - 1.4
		var by1 := g + DTC_BASE + DTC_FASCIA - 0.05
		_mode = M_LAMP
		_quad(Vector3(b0.x, by0, b0.y), Vector3(b1.x, by0, b1.y), Vector3(b1.x, by1, b1.y), Vector3(b0.x, by1, b0.y), Vector3(co.x, 0, co.y), band)
		_mode = M_STONE
		_quad(Vector3(b0.x, by1, b0.y), Vector3(b1.x, by1, b1.y), Vector3(t1.x, by1, t1.y), Vector3(t0.x, by1, t0.y), Vector3.UP, band.darkened(0.3))
		_quad(Vector3(b0.x, by0, b0.y), Vector3(b1.x, by0, b1.y), Vector3(t1.x, by0, t1.y), Vector3(t0.x, by0, t0.y), Vector3.DOWN, band.darkened(0.4))
		_dtc_words(spec.get("lines", []), m + co * 0.35, co, by0 + 0.05, by1 - 0.05, w, 1.6, Color(str(spec.get("ink", "#ffffff"))))
		if spec.has("portal"):
			# A coloured portal round the doors (the discount store's red frame): two posts at the
			# board's ends down to the pavement, at the cantilever's edge.
			var pc := Color(str(spec["portal"]))
			for e: Vector2 in [b0, b1]:
				var pp := e - co * 0.15
				_prism(PackedVector2Array([pp - cd * 0.25 - co * 0.15, pp + cd * 0.25 - co * 0.15, pp + cd * 0.25 + co * 0.15, pp - cd * 0.25 + co * 0.15]),
						g, by0, pc, pc, M_LAMP, M_STONE)
		if bool(spec.get("two_storey", false)) and spec.has("glass"):
			# The first floor behind the curtain wall: the shop's colour glowing through the glass.
			var c0 := m - cd * w * 0.5 + co * 0.08
			var c1 := m + cd * w * 0.5 + co * 0.08
			var y0 := g + DTC_BASE + DTC_FASCIA + 0.1
			_mode = M_PAVILION
			_quad(Vector3(c0.x, y0, c0.y), Vector3(c1.x, y0, c1.y), Vector3(c1.x, y0 + 4.0, c1.y), Vector3(c0.x, y0 + 4.0, c0.y), Vector3(co.x, 0, co.y), Color(str(spec["glass"])).darkened(0.15))
	_mode = M_STONE


## The green roof strips (`roof_green`, F's aerial photos): sedum along a long side of the main
## roof, between the cornice and the set-back top storey, kept off the ends.
func _dtc_green(outline: PackedVector2Array, g: float, list: Array) -> void:
	for spec: Dictionary in list:
		var want := _dtc_dir(str(spec.get("face", "west")))
		var right := Vector2(want.y, -want.x)
		var lo := INF
		var hi := -INF
		var top := -INF
		for q in outline:
			lo = minf(lo, q.dot(right))
			hi = maxf(hi, q.dot(right))
			top = maxf(top, q.dot(want))
		var w := float(spec.get("w", 2.0))
		var s0 := top - 0.9 - w
		var s1 := top - 0.9
		var r0 := lo + DTC_TOP_END * 0.5
		var r1 := hi - DTC_TOP_END * 0.5
		var band := PackedVector2Array([right * r0 + want * s0, right * r1 + want * s0, right * r1 + want * s1, right * r0 + want * s1])
		var inset := Geometry2D.offset_polygon(outline, -0.9, Geometry2D.JOIN_MITER)
		if inset.is_empty():
			continue
		var strip := _largest(Geometry2D.intersect_polygons(inset[0], band))
		if strip.size() >= 3:
			_prism(strip, g + DTC_BODY, g + DTC_BODY + 0.3, Color("#7d8a66"), Color(str(spec.get("colour", "#6f8f4a"))), M_STONE, M_STONE)


## The furniture outside a shop (`props`): FROGS XXL's cream parasols and green seats on the corner.
func _dtc_props(outline: PackedVector2Array, g: float, list: Array) -> void:
	_mode = M_STONE
	for spec: Dictionary in list:
		var spot := _dtc_spot(outline, str(spec.get("face", "west")), float(spec.get("at", 0.5)), 0.0)
		if spot.is_empty():
			continue
		var p: Vector2 = spot[0] + (spot[2] as Vector2) * float(spec.get("out", 2.0))
		var col := Color(str(spec.get("colour", "#3fae3b")))
		match str(spec.get("kind", "seat")):
			"parasol":
				_prism(_square(p, 0.05), g, g + 2.5, Color("#3a3d40"), Color("#3a3d40"), M_STONE, M_STONE)
				var h := 1.6
				var tip := Vector3(p.x, g + 3.0, p.y)
				var c := [p + Vector2(-h, -h), p + Vector2(h, -h), p + Vector2(h, h), p + Vector2(-h, h)]
				for i in 4:
					var u: Vector2 = c[i]
					var v: Vector2 = c[(i + 1) % 4]
					var mid := (u + v) * 0.5 - p
					var nn := Vector3(mid.x, h * 1.6, mid.y).normalized()
					_tri(Vector3(u.x, g + 2.4, u.y), Vector3(v.x, g + 2.4, v.y), tip, nn, col, Vector2(-1, -1), Vector2(-1, -1), Vector2(-1, -1), -1.0)
					_tri(Vector3(u.x, g + 2.4, u.y), Vector3(v.x, g + 2.4, v.y), tip, Vector3.DOWN, col.darkened(0.25), Vector2(-1, -1), Vector2(-1, -1), Vector2(-1, -1), -1.0, false)
			_:
				var ring := PackedVector2Array()
				for i in 6:
					ring.append(p + Vector2(cos(TAU * i / 6.0), sin(TAU * i / 6.0)) * 0.7)
				_prism(ring, g, g + 0.45, col, col.lightened(0.1), M_STONE, M_STONE)


## The store's name on the roof over its south end (the face the game's camera sees from the
## street): a lit parody sign on a frame, the word over 75 % of the end (letters 3.2 m at most),
## standing on the cornice.
func _dtc_sign(outline: PackedVector2Array, word: String, y: float) -> void:
	var best := -1
	var best_score := 0.0
	for i in outline.size():
		var a := outline[i]
		var b := outline[(i + 1) % outline.size()]
		var score := _out(outline, a, b).dot(DTC_SOUTH) * minf(a.distance_to(b), 12.0)
		if score > best_score:
			best_score = score
			best = i
	if best < 0:
		return
	var a := outline[best]
	var b := outline[(best + 1) % outline.size()]
	var o := _out(outline, a, b)
	var mid := (a + b) * 0.5 - o * 1.0
	var k := minf(0.75 * a.distance_to(b) / Neon.length_of(word), 3.2 / (Neon.ROW_H * Neon.PIXEL))
	var tall := Neon.ROW_H * Neon.PIXEL * k
	# The frame: two posts and a rail behind the letters.
	var d := (b - a).normalized()
	var half := 0.5 * k * Neon.length_of(word) + 0.3
	for s: float in [-half, half]:
		var p := mid + d * s - o * 0.4
		_prism(_square(p, 0.15), y, y + tall + 0.6, DTC_ALU.darkened(0.3), DTC_ALU.darkened(0.3), M_STONE, M_STONE)
	var r0 := mid - d * half - o * 0.4
	var r1 := mid + d * half - o * 0.4
	_prism(PackedVector2Array([r0 - o * 0.1, r1 - o * 0.1, r1 + o * 0.1, r0 + o * 0.1]), y + 0.2, y + 0.5,
			DTC_ALU.darkened(0.3), DTC_ALU.darkened(0.3), M_STONE, M_STONE)
	signs.append([word, Vector3(mid.x, y + 0.5, mid.y), Vector3(o.x, 0.0, o.y), k, DTC_SIGN])


## The underside of a box at y over its whole outline, facing down (an overhang's soffit; the part
## over the inner floor is its ceiling, never seen).
func _soffit(outer: PackedVector2Array, y: float, col: Color) -> void:
	var idx := Geometry2D.triangulate_polygon(outer)
	for i in range(0, idx.size() - 2, 3):
		var p0 := outer[idx[i]]
		var p1 := outer[idx[i + 1]]
		var p2 := outer[idx[i + 2]]
		_tri(Vector3(p0.x, y, p0.y), Vector3(p1.x, y, p1.y), Vector3(p2.x, y, p2.y), Vector3.DOWN, col,
				Vector2(-1, -1), Vector2(-1, -1), Vector2(-1, -1), -1.0, false)


# --- The Bridge and Grzybowska 77 (F's photos, 2026-11-06) -----------------------------------

## The Bridge (Plac Europejski, by Towarowa; spec docs/landmarks/specs/bridge.md), rebuilt from
## F's nine photos (2026-11-06): a 174 m glass shaft whose faces fold along long diagonal seams
## into big triangular facets, each tilted a little so it catches the sky differently; the south
## end steps down to 149 m with a dark notched crown block (149-168 m) set in over it; the bank's
## blue name on the top of the long faces as a parody, ERZATZ; a 12 m glazed atrium lobby set
## back under the tower, its soffit timber, leaning concrete columns along the street faces.
## The tower's frame: u along the long west face from its north end to the south, v across to
## the east (metres from the west face's north corner).
const BR_O := Vector2(-2778.8, 80.8)
const BR_U := Vector2(0.2095, 0.9778)
const BR_TOP := 174.0      ## the north part's roof (OSM's 174 m)
const BR_STEP := 149.0     ## the south part's glass top (F's aerial: 25 m under the roof)
const BR_CROWN := 168.0    ## the dark crown block's top
const BR_CUT := 30.0       ## u of the step: the south 13 m of the tower is the low part
const BR_LOBBY := 12.0     ## the atrium's height; the facets start over it
const BR_GLASS := Color("#5a7d9c")
const BR_SEAM := Color("#1e252c")
const BR_DARK := Color("#24282c")
const BR_ROOF := Color("#646b70")
const BR_LOBBY_GLASS := Color("#9a8c76")  # warm: the timber slats behind the atrium's glass
const BR_TIMBER := Color("#b0824e")
const BR_CONCRETE := Color("#5e6266")
const BR_SIGN := Color(0.2, 0.55, 1.0)  # the bank's blue
## The folds, from F's aerial and the street photos: seams as polylines in (s, t), s along a face
## from its north (or west) end, t up the tower's 174 m. They start and end beyond a face's edge
## or on another seam, so each splits the face into whole facets.
const BR_FOLDS_LONG := [
	[Vector2(0.07, 1.03), Vector2(0.25, 0.51), Vector2(0.28, -0.03)],
	[Vector2(0.72, 0.88), Vector2(0.48, 0.48), Vector2(0.29, 0.02)],
	[Vector2(0.48, 0.50), Vector2(0.48, 0.09)],
	[Vector2(0.26, 0.04), Vector2(0.70, 0.18), Vector2(1.03, 0.18)],
	[Vector2(0.86, 0.47), Vector2(1.03, 0.22)],
]
const BR_FOLDS_SHORT := [
	[Vector2(0.12, 1.03), Vector2(0.88, 0.32), Vector2(1.03, 0.26)],
	[Vector2(-0.03, 0.40), Vector2(0.55, 0.12), Vector2(0.60, -0.03)],
]
## The facets' shading: a colour step and a turn of the normal (degrees about the vertical).
const BR_SHADE := [[0.0, 0.0], [0.13, 11.0], [-0.11, -9.0], [0.07, 15.0], [-0.06, -13.0]]


func _find_bridge() -> void:
	var outline := _landmark("The Bridge")
	if outline.size() >= 3:
		_add_site("bridge", [outline])
		if not sites.is_empty() and sites[-1]["key"] == "bridge":
			sites[-1]["raw"] = outline
	var g77 := _landmark("Bellona")
	if g77.size() >= 3:
		_add_site("grzybowska77", [g77])
		if not sites.is_empty() and sites[-1]["key"] == "grzybowska77":
			sites[-1]["raw"] = g77


func _br_u(p: Vector2) -> float:
	return (p - BR_O).dot(BR_U)


func _build_bridge(site: Dictionary) -> void:
	var raw: PackedVector2Array = site["raw"]
	var ring := _simplify(raw, 1.6)
	_g = _ground_under(raw)
	var g := _g
	var v := Vector2(BR_U.y, -BR_U.x)
	var big := 200.0
	var north_half := PackedVector2Array([BR_O - BR_U * big - v * big, BR_O + BR_U * BR_CUT - v * big,
			BR_O + BR_U * BR_CUT + v * big, BR_O - BR_U * big + v * big])
	var south_half := PackedVector2Array([BR_O + BR_U * BR_CUT - v * big, BR_O + BR_U * big - v * big,
			BR_O + BR_U * big + v * big, BR_O + BR_U * BR_CUT + v * big])
	var north := _largest(Geometry2D.intersect_polygons(ring, north_half))
	var south := _largest(Geometry2D.intersect_polygons(ring, south_half))
	var longest := 0.0
	for i in ring.size():
		longest = maxf(longest, ring[i].distance_to(ring[(i + 1) % ring.size()]))
	# The shaft: every face of the outline, faceted along its folds.
	for i in ring.size():
		var a := ring[i]
		var b := ring[(i + 1) % ring.size()]
		var l := a.distance_to(b)
		if l < 0.5:
			continue
		var folds: Array = []
		if l >= longest * 0.6:
			folds = BR_FOLDS_LONG
		elif l >= 12.0:
			folds = BR_FOLDS_SHORT
		_br_face(ring, a, b, g, folds)
	# The step's inner face: the north part's glass from the low part's top to the roof.
	_mode = M_SKIN + float(S_FINS) / 16.0
	for i in north.size():
		var a := north[i]
		var b := north[(i + 1) % north.size()]
		if absf(_br_u(a) - BR_CUT) < 0.05 and absf(_br_u(b) - BR_CUT) < 0.05:
			_wall(a, b, g + BR_STEP, g + BR_TOP, _out(north, a, b), BR_GLASS)
	# Roofs: the north part's flat top with a plant box; the low part's ledge and its dark crown.
	_mode = M_STONE
	_cap(north, g + BR_TOP, BR_ROOF)
	_no_roof = true
	_prism(_square(_centre(north), 3.0), g + BR_TOP, g + BR_TOP + 3.0, BR_ROOF.darkened(0.15), BR_ROOF, M_STONE, M_STONE)
	_no_roof = false
	if south.size() >= 3:
		_cap(south, g + BR_STEP, BR_ROOF)
		var box := _largest(Geometry2D.offset_polygon(south, -0.9))
		if box.size() >= 3:
			_prism(box, g + BR_STEP, g + BR_CROWN, BR_DARK, BR_DARK.lightened(0.1), M_SKIN + float(S_DARK) / 16.0, M_STONE)
	_br_lobby(ring, g)
	_br_sign(north, g)
	_aviation(north, func(_q: Vector2) -> float: return g + BR_TOP)
	_collide(raw)
	pocket_rings.append(raw)


## One face a→b of the shaft, from the lobby's top to its roof (the step where it crosses BR_CUT),
## split along `folds` into facets, each a shade lighter or darker and turned a few degrees; dark
## seams over the folds.
func _br_face(ring: PackedVector2Array, a: Vector2, b: Vector2, g: float, folds: Array) -> void:
	var l := a.distance_to(b)
	var e := (b - a) / l
	var out := _out(ring, a, b)
	var ua := _br_u(a)
	var ub := _br_u(b)
	# s runs from the face's north end (smaller u); for a face across the tower (u nearly the
	# same at both ends), from its west end.
	var flip := ua > ub + 0.5 if absf(ua - ub) > 0.5 else (a.x > b.x)
	var top_at := func(x: float) -> float:
		var q := a + e * x
		return BR_TOP if _br_u(q) < BR_CUT else BR_STEP
	var y0 := BR_LOBBY
	var face := PackedVector2Array()
	face.append(Vector2(0.0, y0))
	face.append(Vector2(l, y0))
	var ta: float = top_at.call(0.02)
	var tb: float = top_at.call(l - 0.02)
	face.append(Vector2(l, tb))
	if absf(ta - tb) > 0.1:
		var xc := clampf((BR_CUT - ua) / (ub - ua) * l, 0.0, l)
		face.append(Vector2(xc, tb))
		face.append(Vector2(xc, ta))
	face.append(Vector2(0.0, ta))
	var pieces: Array = [face]
	var face_cw := Geometry2D.is_polygon_clockwise(face)
	var seams: Array = []
	for f: Array in folds:
		var pts: Array[Vector2] = []
		for q: Vector2 in f:
			var x := (1.0 - q.x) * l if flip else q.x * l
			pts.append(Vector2(x, q.y * BR_TOP))
		seams.append(pts)
		for k in range(pts.size() - 1):
			var p0: Vector2 = pts[k]
			var p1: Vector2 = pts[k + 1]
			var d := (p1 - p0).normalized()
			var nn := Vector2(-d.y, d.x) * 0.04
			p0 -= d * 0.3
			p1 += d * 0.3
			var strip := PackedVector2Array([p0 - nn, p1 - nn, p1 + nn, p0 + nn])
			var next: Array = []
			for pc: PackedVector2Array in pieces:
				# A seam ending inside a facet cuts a hole (the other winding): not a facet.
				for r in Geometry2D.clip_polygons(pc, strip):
					if r.size() >= 3 and Geometry2D.is_polygon_clockwise(r) == face_cw:
						next.append(r)
			pieces = next
	var keep := _mode
	_mode = M_SKIN + float(S_FINS) / 16.0
	var nv := Vector3(out.x, 0.0, out.y)
	for pc: PackedVector2Array in pieces:
		var c := _centre(pc)
		var hsh := fposmod(sin(c.x * 0.731 + c.y * 0.173 + a.x * 0.01) * 43758.5453, 1.0)
		var sh: Array = BR_SHADE[int(hsh * BR_SHADE.size()) % BR_SHADE.size()] if folds.size() > 0 else BR_SHADE[0]
		var col := BR_GLASS.lightened(float(sh[0])) if float(sh[0]) >= 0.0 else BR_GLASS.darkened(-float(sh[0]))
		var n := nv.rotated(Vector3.UP, deg_to_rad(float(sh[1])))
		var idx := Geometry2D.triangulate_polygon(pc)
		for t in range(0, idx.size() - 2, 3):
			var q0 := pc[idx[t]]
			var q1 := pc[idx[t + 1]]
			var q2 := pc[idx[t + 2]]
			var w0 := a + e * q0.x
			var w1 := a + e * q1.x
			var w2 := a + e * q2.x
			var top := maxf(ta, tb)
			_tri(Vector3(w0.x, g + q0.y, w0.y), Vector3(w1.x, g + q1.y, w1.y), Vector3(w2.x, g + q2.y, w2.y), n, col,
					Vector2(q0.x, q0.y), Vector2(q1.x, q1.y), Vector2(q2.x, q2.y), top)
	# The seams: dark mullion-thick lines 0.1 to 0.35 m proud, clipped to the face's top.
	_mode = M_STONE
	for si in seams.size():
		var pts: Array = seams[si]
		# Each seam, and each leg of one, a little prouder than the last: where two meet their beams
		# never share a plane.
		for k in range(pts.size() - 1):
			var proud := 0.1 + 0.05 * si + 0.025 * k
			var p0: Vector2 = pts[k]
			var p1: Vector2 = pts[k + 1]
			var lim0: float = top_at.call(clampf(p0.x, 0.02, l - 0.02))
			var lim1: float = top_at.call(clampf(p1.x, 0.02, l - 0.02))
			p0 = Vector2(clampf(p0.x, 0.0, l), clampf(p0.y, y0, lim0))
			p1 = Vector2(clampf(p1.x, 0.0, l), clampf(p1.y, y0, lim1))
			if p0.distance_to(p1) < 0.5:
				continue
			var w0 := a + e * p0.x + out * proud
			var w1 := a + e * p1.x + out * proud
			_beam(Vector3(w0.x, g + p0.y, w0.y), Vector3(w1.x, g + p1.y, w1.y), 0.5, BR_SEAM, false)
	_mode = keep


## The atrium: warm glass set 1.6 m back under the tower (the timber slats show through), the
## timber soffit, and leaning concrete columns in V pairs every 9 m along the faces.
func _br_lobby(ring: PackedVector2Array, g: float) -> void:
	var inner := _largest(Geometry2D.offset_polygon(ring, -1.6))
	if inner.size() < 3:
		return
	_prism(inner, g - 0.4, g + BR_LOBBY, BR_LOBBY_GLASS, Color(0, 0, 0, 0), M_PAVILION)
	_soffit(ring, g + BR_LOBBY, BR_TIMBER)
	var keep := _mode
	_mode = M_STONE
	for i in ring.size():
		var a := ring[i]
		var b := ring[(i + 1) % ring.size()]
		var l := a.distance_to(b)
		if l < 10.0:
			continue
		var e := (b - a) / l
		var o := _out(ring, a, b)
		var n := floori(l / 9.0)
		var pad := (l - (n - 1) * 9.0) * 0.5
		for k in n:
			var p := a + e * (pad + 9.0 * k) - o * 0.8
			var lean := e * (2.2 if k % 2 == 0 else -2.2)
			_beam(Vector3(p.x - lean.x, g - 0.2, p.y - lean.y), Vector3(p.x + lean.x, g + BR_LOBBY, p.y + lean.y), 0.8, BR_CONCRETE)
	_mode = keep


## ERZATZ, the bank's parody (the tower's new tenant, F 2026-11-06), in blue at the top of the two long faces of the north part
## (F's aerial: high on the long face, over the north end), 4 m under the roof.
func _br_sign(north: PackedVector2Array, g: float) -> void:
	var v := Vector2(BR_U.y, -BR_U.x)
	for i in north.size():
		var a := north[i]
		var b := north[(i + 1) % north.size()]
		var l := a.distance_to(b)
		var o := _out(north, a, b)
		if l < 20.0 or absf(o.dot(v)) < 0.8:
			continue
		var mid := (a + b) * 0.5 + o * 0.15
		var k := 0.62 * l / Neon.length_of(BR_WORD)
		var base_y := g + BR_TOP - 4.0 - Neon.ROW_H * Neon.PIXEL * k
		signs.append([BR_WORD, Vector3(mid.x, base_y, mid.y), Vector3(o.x, 0.0, o.y), k, BR_SIGN])


const BR_WORD := "ERZATZ"


## Grzybowska 77 (spec docs/landmarks/specs/bridge.md, part 2), from F's photos: a post-war office
## block in warm tan brick over a pale stone ground floor of square piers (dark glazing and brown
## spandrels between them), a stone band with a long balcony and a black rail over the street,
## four storeys of windows in stone frames, a stone cornice, a set-back pale attic storey and roof
## plant. The wall it shares with The Bridge has no windows.
const G77_GROUND := 5.6
const G77_FLOOR := 3.35
const G77_TOP := 19.4      ## the cornice (G77_GROUND + 4 storeys)
const G77_ATTIC := 3.0
const G77_BRICK := Color("#b08a6a")
const G77_STONE := Color("#d9d2c3")
const G77_PANE := Color("#4a5560")
const G77_SPANDREL := Color("#7a5038")
const G77_ROOF := Color("#8f9396")
const G77_RAIL := Color("#25282a")
const G77_BAY := 3.3


func _build_bellona(site: Dictionary) -> void:
	var raw: PackedVector2Array = site["raw"]
	var ring := _simplify(raw, 0.8)
	_g = _ground_under(raw)
	var g := _g
	var none := Color(0, 0, 0, 0)
	_mode = M_STONE
	var tower := _landmark("The Bridge")
	var shared := PackedVector2Array()
	if tower.size() >= 3:
		shared = _largest(Geometry2D.offset_polygon(tower, 1.5))
	# Windows and piers first (proud of the walls), then the walls.
	_g77_ground(ring, g, shared)
	for k in 4:
		var y0 := G77_GROUND + 0.6 + G77_FLOOR * k + 0.85
		_g77_windows(ring, g, y0, y0 + 1.85, shared)
	_prism(ring, g - 0.4, g + G77_GROUND, G77_STONE.darkened(0.25), none, M_STONE)
	_prism(ring, g + G77_GROUND, g + G77_GROUND + 0.6, G77_STONE, none, M_STONE)
	_prism(ring, g + G77_GROUND + 0.6, g + G77_TOP, G77_BRICK, none, M_STONE)
	var cornice := _largest(Geometry2D.offset_polygon(ring, 0.35, Geometry2D.JOIN_MITER))
	_prism(cornice, g + G77_TOP, g + G77_TOP + 0.7, G77_STONE, G77_ROOF, M_STONE, M_STONE)
	_g77_balcony(ring, g, shared)
	# The attic, 2 m back, pale, a row of small windows; roof plant on it.
	var attic := _largest(Geometry2D.offset_polygon(ring, -2.0))
	if attic.size() >= 3:
		var ay := G77_TOP + 0.7
		_g77_windows(attic, g, ay + 0.8, ay + 2.2, PackedVector2Array())
		_prism(attic, g + ay, g + ay + G77_ATTIC, G77_STONE.darkened(0.05), G77_ROOF, M_STONE, M_STONE)
		_parapet(ring, g + ay, 0.9, G77_STONE)
		var c := _centre(attic)
		_no_roof = true
		for d: Vector2 in [Vector2(-6.0, 3.0), Vector2(5.0, -4.0)]:
			_prism(_square(c + d, 1.8), g + ay + G77_ATTIC, g + ay + G77_ATTIC + 1.6, G77_ROOF.darkened(0.2), G77_ROOF, M_STONE, M_STONE)
		_no_roof = false
	_collide(raw)
	pocket_rings.append(raw)


## Stone-framed windows on every face not shared with the tower: a pale frame 0.04 m proud, the
## pane (curtain-wall glass, lit at night) 0.08 m proud, one per bay.
func _g77_windows(ring: PackedVector2Array, g: float, y0: float, y1: float, shared: PackedVector2Array) -> void:
	var keep := _mode
	for i in ring.size():
		var a := ring[i]
		var b := ring[(i + 1) % ring.size()]
		var l := a.distance_to(b)
		var n := floori((l - 1.0) / G77_BAY)
		if n < 1:
			continue
		var e := (b - a) / l
		var o := _out(ring, a, b)
		var pad := (l - n * G77_BAY) * 0.5 + G77_BAY * 0.5
		for k in n:
			var p := a + e * (pad + k * G77_BAY)
			if shared.size() >= 3 and Geometry2D.is_point_in_polygon(p, shared):
				continue
			_mode = M_STONE
			_wall(p - e * 0.95 + o * 0.04, p + e * 0.95 + o * 0.04, g + y0 - 0.25, g + y1 + 0.25, o, G77_STONE)
			_mode = M_GLASS
			_wall(p - e * 0.7 + o * 0.08, p + e * 0.7 + o * 0.08, g + y0, g + y1, o, G77_PANE)
	_mode = keep


## The ground floor: square stone piers 0.9 m wide, 0.4 m proud, one per bay; between them dark
## glazing over a brown spandrel.
func _g77_ground(ring: PackedVector2Array, g: float, shared: PackedVector2Array) -> void:
	var keep := _mode
	for i in ring.size():
		var a := ring[i]
		var b := ring[(i + 1) % ring.size()]
		var l := a.distance_to(b)
		var n := floori(l / G77_BAY)
		if n < 1:
			continue
		var e := (b - a) / l
		var o := _out(ring, a, b)
		var pad := (l - n * G77_BAY) * 0.5
		for k in n + 1:
			var p := a + e * (pad + k * G77_BAY)
			if shared.size() >= 3 and Geometry2D.is_point_in_polygon(p, shared):
				continue
			var pier := PackedVector2Array([p - e * 0.45, p + e * 0.45, p + e * 0.45 + o * 0.4, p - e * 0.45 + o * 0.4])
			_prism(pier, g - 0.4, g + G77_GROUND, G77_STONE, G77_STONE, M_STONE, M_STONE)
			if k < n:
				var m := p + e * G77_BAY * 0.5 + o * 0.06
				_mode = M_STONE
				_wall(m - e * 1.15, m + e * 1.15, g + 0.6, g + 1.5, o, G77_SPANDREL)
				_mode = M_GLASS
				_wall(m - e * 1.15, m + e * 1.15, g + 1.5, g + G77_GROUND - 0.4, o, G77_PANE)
	_mode = keep


## The long balcony over the ground floor on the street face (F's photo from Towarowa): a stone
## slab 1.1 m deep along the longest face, a black rail on its edge.
func _g77_balcony(ring: PackedVector2Array, g: float, shared: PackedVector2Array) -> void:
	var best := -1
	var longest := 0.0
	for i in ring.size():
		var a := ring[i]
		var b := ring[(i + 1) % ring.size()]
		var mid := (a + b) * 0.5
		if shared.size() >= 3 and Geometry2D.is_point_in_polygon(mid, shared):
			continue
		if a.distance_to(b) > longest:
			longest = a.distance_to(b)
			best = i
	if best < 0:
		return
	var a := ring[best]
	var b := ring[(best + 1) % ring.size()]
	var e := (b - a) / longest
	var o := _out(ring, a, b)
	var p0 := a + e * 0.6
	var p1 := b - e * 0.6
	var y := g + G77_GROUND + 0.6
	_prism(PackedVector2Array([p0, p1, p1 + o * 1.1, p0 + o * 1.1]), y - 0.25, y, G77_STONE, G77_STONE, M_STONE, M_STONE)
	var r0 := p0 + o * 1.05
	var r1 := p1 + o * 1.05
	_beam(Vector3(r0.x, y + 1.0, r0.y), Vector3(r1.x, y + 1.0, r1.y), 0.08, G77_RAIL, false)
	var steps := floori(longest / 1.6)
	for k in steps + 1:
		var p := p0.lerp(p1, float(k) / float(steps)) + o * 1.05
		_beam(Vector3(p.x, y, p.y), Vector3(p.x, y + 1.0, p.y), 0.05, G77_RAIL, false)


# --- Behind the Eastern Wall: the re-clad tower and the 1960s slabs ---------------------------

## The Mac photo check (2026-11-01, specs C and D: docs/landmarks/specs/tower75.md, slabs.md): the
## buildings the start's camera sees over the stores. C: the 75 m tower at (-819, 254), a 1970s
## point block re-clad in light horizontal metal with punched windows in bands, on a two-storey
## dark glass podium, a steel frame of big red parody letters on its roof and a small billboard
## at the roof's edge. D: the four 37 m slabs behind Junior, 1960s housing in light warm grey
## plaster, balcony bands on the long faces, plainer end walls, lift and stair houses on the
## flat roofs, and a big rooftop billboard on the slab behind Sawa. Both unnamed (no card).
const TOWER75_AT := Vector2(-819.0, 254.0)
const TOWER75_PODIUM := 7.0
const TOWER75_CLAD := Color("#d9dcdc")
const TOWER75_GLASS := Color("#3e4e5e")
## F's photos (2026-11-05): the appliance maker's red script on the tower's crown, beside the
## discount store's red box; ours a parody, PRALKA PLUS (KOKA-KOLKA moves to the Sezam corner, the
## Eastern Wall photo pass in BACKLOG).
const TOWER75_WORD := "PRALKA PLUS"
const SLAB_AT := [Vector2(-862.0, 86.0), Vector2(-853.0, 190.0), Vector2(-813.0, 207.0), Vector2(-778.0, 308.0)]
const SLAB_BILLBOARD := 1     # the slab behind Sawa (index in SLAB_AT)
## F's look check (2026-11-03): light warm grey (provisional), with clear horizontal balcony
## bands (SLAB_BAND ledges, one a storey on the long faces); the ends the same grey a shade down.
const SLAB_PLASTER := Color("#d3cfc6")
const SLAB_END := Color("#c4bfb5")
const SLAB_BAND := Color("#aaa499")
const SLAB_STOREY := 2.8
const SLAB_WORD := "ORANŻADA"
## Faces the game's camera sees most (south and east): signs face the one nearest this.
const BEHIND_FACE := Vector2(0.349, 0.937)


## The OpenStreetMap outline standing at a point (the first outline holding it).
func _outline_at(at: Vector2) -> PackedVector2Array:
	for bld in data["buildings"]:
		var q := _pts(bld["p"])
		if q.size() >= 3 and float(bld["mh"]) < 0.5 and _box_of([q]).has_point(at) and Geometry2D.is_point_in_polygon(at, q):
			return q
	return PackedVector2Array()


func _find_behind() -> void:
	# Zones grown 3 m: the LoD2 model of each stands a little off its OpenStreetMap outline.
	var tower := _outline_at(TOWER75_AT)
	if tower.size() >= 3:
		_add_site("tower75", [_largest(Geometry2D.offset_polygon(tower, 3.0, Geometry2D.JOIN_MITER))])
		sites[-1]["outline"] = tower
	var slabs: Array[PackedVector2Array] = []
	var outlines: Array[PackedVector2Array] = []
	for at: Vector2 in SLAB_AT:
		var q := _outline_at(at)
		if q.size() >= 3:
			slabs.append(_largest(Geometry2D.offset_polygon(q, 3.0, Geometry2D.JOIN_MITER)))
			outlines.append(q)
	_add_site("slabs", slabs)
	if not sites.is_empty() and sites[-1]["key"] == "slabs":
		sites[-1]["outlines"] = outlines


## The edge of `poly` whose outward normal is nearest `want`, among the longer edges.
func _edge_facing(poly: PackedVector2Array, want: Vector2, min_len: float) -> int:
	var best := -1
	var score := -INF
	for i in poly.size():
		var a := poly[i]
		var b := poly[(i + 1) % poly.size()]
		if a.distance_to(b) < min_len:
			continue
		var sc := _out(poly, a, b).dot(want)
		if sc > score:
			score = sc
			best = i
	return best


## A steel frame on a roof along edge a→b (drawn in `inset` m): two or more posts and two rails,
## the word on it facing out, lit by day and night.
func _roof_frame(poly: PackedVector2Array, i: int, y: float, inset: float, tall: float, word: String, colour: Color,
		share: float, panel := Color(0, 0, 0, 0)) -> void:
	var a := poly[i]
	var b := poly[(i + 1) % poly.size()]
	var o := _out(poly, a, b)
	var d := (b - a).normalized()
	var mid := (a + b) * 0.5 - o * inset
	var wide := a.distance_to(b) * share
	var k := minf(0.85 * wide / Neon.length_of(word), (tall - 0.6) / (Neon.ROW_H * Neon.PIXEL))
	var steel := Color("#5b6166")
	var posts := maxi(2, ceili(wide / 8.0) + 1)
	for n in posts:
		var p := mid + d * (-0.5 * wide + wide * n / (posts - 1)) - o * 0.3
		_prism(_square(p, 0.15), y, y + tall, steel, steel, M_STONE, M_STONE)
	for ry: float in [0.4, tall - 0.3]:
		var r0 := mid - d * wide * 0.5 - o * 0.3
		var r1 := mid + d * wide * 0.5 - o * 0.3
		_prism(PackedVector2Array([r0 - o * 0.08, r1 - o * 0.08, r1 + o * 0.08, r0 + o * 0.08]), y + ry - 0.15, y + ry + 0.15,
				steel, steel, M_STONE, M_STONE)
	if panel.a > 0.0:
		var p0 := mid - d * wide * 0.5 - o * 0.12
		var p1 := mid + d * wide * 0.5 - o * 0.12
		_mode = M_STONE
		_quad(Vector3(p0.x, y + 0.6, p0.y), Vector3(p1.x, y + 0.6, p1.y), Vector3(p1.x, y + tall - 0.1, p1.y),
				Vector3(p0.x, y + tall - 0.1, p0.y), Vector3(o.x, 0, o.y), panel)
	var h := Neon.ROW_H * Neon.PIXEL * k
	signs.append([word, Vector3(mid.x, y + 0.5 * tall - 0.5 * h, mid.y), Vector3(o.x, 0.0, o.y), k, colour])


func _build_tower75(site: Dictionary) -> void:
	var outline: PackedVector2Array = _simplify(site["outline"], 0.6)
	_g = _ground_under(outline)
	var g := _g
	var none := Color(0, 0, 0, 0)
	# The podium: two storeys of dark grey-blue glass in a square grid.
	_prism(outline, g - 0.4, g + TOWER75_PODIUM, TOWER75_GLASS, Color("#6e767b"), M_SKIN + float(S_DARK) / 16.0, M_STONE)
	# The shaft, a step in from the podium, in its cladding with punched windows.
	var shaft := _largest(Geometry2D.offset_polygon(outline, -1.2, Geometry2D.JOIN_MITER))
	if shaft.size() < 3:
		shaft = outline
	var top := g + 75.0
	_prism(shaft, g + TOWER75_PODIUM, top - 0.9, TOWER75_CLAD, none, M_SKIN + float(S_PUNCHED) / 16.0)
	_prism(shaft, top - 0.9, top, TOWER75_CLAD.lightened(0.08), Color("#8b9296"), M_STONE, M_STONE)
	# The roof: a plant room, the big letters' frame facing down the street, a small billboard on
	# the edge beside it.
	var c := _centre(shaft)
	_prism(_square(c, 3.2), top, top + 3.0, Color("#b9bdbe"), Color("#8b9296"), M_STONE, M_STONE)
	var face := _edge_facing(shaft, BEHIND_FACE, 10.0)
	if face >= 0:
		_roof_frame(shaft, face, top, 1.2, 6.0, TOWER75_WORD, Color(1.0, 0.16, 0.12), 0.9)
		var side := _edge_facing(shaft, Vector2(BEHIND_FACE.y, -BEHIND_FACE.x), 8.0)
		if side >= 0 and side != face:
			# The four-floor discount store below (opened Sep 2026) put its red box up here
			# (F's photos, 2026-11-05).
			_roof_frame(shaft, side, top, 0.8, 3.2, "TAK MAKS", Color(1, 1, 1), 0.6, Color("#d0161e"))
	_collide(outline)


func _build_slabs(site: Dictionary) -> void:
	var k := 0
	for z: PackedVector2Array in site["outlines"]:
		var poly := _simplify(z, 0.6)
		if poly.size() < 3:
			k += 1
			continue
		_g = _ground_under(poly)
		var g := _g
		var top := g + 37.3
		# Walls: the long faces in plaster with their balcony bands, the ends plain.
		var longest := 0.0
		for i in poly.size():
			longest = maxf(longest, poly[i].distance_to(poly[(i + 1) % poly.size()]))
		var run := 0.0
		for i in poly.size():
			var a := poly[i]
			var b := poly[(i + 1) % poly.size()]
			var long_face := a.distance_to(b) > longest * 0.5
			_mode = M_SKIN + float(S_SLAB) / 16.0 if long_face else M_STONE
			var o := _out(poly, a, b)
			_wall(a, b, g - 0.4, top, o, SLAB_PLASTER if long_face else SLAB_END, run)
			run += a.distance_to(b)
			if long_face:
				var d := (b - a).normalized()
				var y := g + 4.2
				while y < top - 1.5:
					var a1 := a + d * 0.3
					var b1 := b - d * 0.3
					_prism(PackedVector2Array([a1, b1, b1 + o * 0.45, a1 + o * 0.45]), y, y + 0.25, SLAB_BAND, SLAB_BAND.lightened(0.1),
							M_STONE, M_STONE)
					y += SLAB_STOREY
		_mode = M_STONE
		_cap(poly, top, Color("#8c8a84"))
		# The roof: lift and stair houses along the slab's long axis.
		var axis := Vector2.ZERO
		for i in poly.size():
			var e := poly[(i + 1) % poly.size()] - poly[i]
			if e.length() > axis.length():
				axis = e
		axis = axis.normalized()
		var c := _centre(poly)
		var span := 0.0
		for q in poly:
			span = maxf(span, absf((q - c).dot(axis)))
		for f: float in [-0.45, 0.45]:
			var p := c + axis * span * f
			var across := Vector2(-axis.y, axis.x)
			_prism(PackedVector2Array([p - axis * 3.0 - across * 2.2, p + axis * 3.0 - across * 2.2, p + axis * 3.0 + across * 2.2,
					p - axis * 3.0 + across * 2.2]), top, top + 3.2, SLAB_PLASTER.darkened(0.06), Color("#7d7b75"), M_STONE, M_STONE)
		if k == SLAB_BILLBOARD:
			var face := _edge_facing(poly, BEHIND_FACE, 15.0)
			if face >= 0:
				_roof_frame(poly, face, top, 4.5, 5.5, SLAB_WORD, Color(1.0, 0.62, 0.15), minf(0.9, 25.0 / poly[face].distance_to(poly[(face + 1) % poly.size()])), Color("#1d3d6b"))
		_collide(poly)
		k += 1
	_mode = M_STONE


# --- Osiedle Za Żelazną Bramą: eleven large-panel blocks ---------------------------------------

## F's ask (2026-11-01): the estate between Żelazna and Aleja Jana Pawła II (Jerzy Skolimowski's,
## 1965-72) as a model, as the halls are. Eleven OpenStreetMap blocks, found by a point inside
## each: five 43.9 m slabs in a row from Żelazna to Sienna, the 60.4 m high block among them, and
## the five 37-41 m slabs with the saw-toothed long faces along Sienna's east end. Each is built
## from its own outline and height in the estate's panel skin (S_ESTATE, spec zelazna.md): pale
## concrete panels, ribbon windows, a coloured loggia stack in every fourth bay; blank end walls
## with a dark stair slot; a canopy and door at each long face's middle; lift and stair houses.
const ZELAZNA_AT := [Vector2(-2085.6, 304.2), Vector2(-2034.6, 287.2), Vector2(-1979.1, 270.5),
		Vector2(-1927.2, 255.2), Vector2(-2045.6, 348.6), Vector2(-1995.5, 322.2), Vector2(-1857.0, 316.4),
		Vector2(-1857.9, 260.4), Vector2(-1843.5, 217.7), Vector2(-1873.1, 382.1), Vector2(-1842.6, 377.0)]
const ZELAZNA_PANELS := ["#d2cfc6", "#cbcdc6", "#d6cfc0", "#c8cbc9"]
const ZELAZNA_END := Color("#b9b5aa")
const ZELAZNA_ROOF := Color("#77777a")
const ZELAZNA_SLOT := Color("#3b4650")
const ZELAZNA_CANOPY := Color("#8d8b86")


func _find_zelazna() -> void:
	var zones: Array[PackedVector2Array] = []
	var rings: Array[PackedVector2Array] = []
	var heights: Array[float] = []
	for at: Vector2 in ZELAZNA_AT:
		for bld in data["buildings"]:
			var q := _pts(bld["p"])
			if q.size() >= 3 and float(bld["mh"]) < 0.5 and _box_of([q]).has_point(at) and Geometry2D.is_point_in_polygon(at, q):
				zones.append(_largest(Geometry2D.offset_polygon(q, 3.0, Geometry2D.JOIN_MITER)))
				rings.append(q)
				heights.append(float(bld["h"]))
				break
	_add_site("zelazna", zones)
	if not sites.is_empty() and sites[-1]["key"] == "zelazna":
		sites[-1]["outlines"] = rings
		sites[-1]["heights"] = heights


func _build_zelazna(site: Dictionary) -> void:
	var k := 0
	for z: PackedVector2Array in site["outlines"]:
		var poly := _simplify(z, 0.6)
		var height: float = site["heights"][k]
		var panel := Color(ZELAZNA_PANELS[k % ZELAZNA_PANELS.size()])
		if height > 55.0:
			panel = Color("#bfc4c6")  # the high block: a cooler grey
		k += 1
		if poly.size() < 3:
			continue
		_g = _ground_under(poly)
		var g := _g
		var top := g + height
		var axis := Vector2.ZERO
		for i in poly.size():
			var e := poly[(i + 1) % poly.size()] - poly[i]
			if e.length() > axis.length():
				axis = e
		axis = axis.normalized()
		var run := 0.0
		for i in poly.size():
			var a := poly[i]
			var b := poly[(i + 1) % poly.size()]
			var o := _out(poly, a, b)
			var len := a.distance_to(b)
			var end_wall := absf(o.dot(axis)) > 0.8
			_mode = M_STONE if end_wall else M_SKIN + float(S_ESTATE) / 16.0
			_wall(a, b, g - 0.4, top, o, ZELAZNA_END if end_wall else panel, run)
			run += len
			var d := (b - a) / maxf(len, 0.01)
			var mid := (a + b) * 0.5
			if end_wall and len >= 6.0:
				# the stair slot: a dark glazed strip up the blank end.
				var p := mid + o * 0.05
				_mode = M_GLASS
				_wall(p - d * 0.5, p + d * 0.5, g + 3.2, top - 3.0, o, ZELAZNA_SLOT)
			elif not end_wall and len >= 14.0:
				# the entrance: a dark door and a flat canopy over it.
				var p := mid + o * 0.06
				_mode = M_GLASS
				_wall(p - d * 1.3, p + d * 1.3, g, g + 2.4, o, ZELAZNA_SLOT)
				_mode = M_STONE
				var f := mid - o * 0.1
				var c := mid + o * 1.8
				_prism(PackedVector2Array([f - d * 2.2, f + d * 2.2, c + d * 2.2, c - d * 2.2]), g + 2.7, g + 2.95,
						ZELAZNA_CANOPY, ZELAZNA_CANOPY.darkened(0.1), M_STONE, M_STONE)
		_mode = M_STONE
		_cap(poly, top, ZELAZNA_ROOF)
		# lift and stair houses at a third and two thirds of the long axis.
		var c0 := _centre(poly)
		var span := 0.0
		for q in poly:
			span = maxf(span, absf((q - c0).dot(axis)))
		var across := Vector2(-axis.y, axis.x)
		for f: float in [-0.4, 0.4]:
			var p := c0 + axis * span * f
			_prism(PackedVector2Array([p - axis * 2.8 - across * 2.0, p + axis * 2.8 - across * 2.0, p + axis * 2.8 + across * 2.0,
					p - axis * 2.8 + across * 2.0]), top, top + 3.0, panel.darkened(0.08), Color("#6a6a6d"), M_STONE, M_STONE)
		_collide(poly)
# --- Pokorna 2: the residential tower by Muranów ---------------------------------------------

## F (2026-11-01): "Pokorna 2 looks strange, not as an apartment". OpenStreetMap has it as one
## 57 m `apartments` outline (12 corners, a stepped 1970s block off Pokorna) and the plain
## extrusion read as an office. Spec docs/landmarks/specs/pokorna2.md: the long faces take the
## loggia skin S_SLAB (a window in every 3.6 m bay) plus a real balcony slab and railing on
## every floor; the short faces stay plain; lift house and water tank on the flat roof. Unnamed.
const POKORNA2_AT := Vector2(-2123.0, -2217.0)
const POKORNA2_FLOOR := 2.85          # the S_SLAB shader's floor height
const POKORNA2_PLASTER := Color("#d6c3ad")
const POKORNA2_END := Color("#bda98f")
const POKORNA2_SLAB := Color("#e8e2d6")
const POKORNA2_RAIL := Color("#6f8f95")


func _find_pokorna2() -> void:
	var q := _outline_at(POKORNA2_AT)
	if q.size() < 3:
		return
	_add_site("pokorna2", [_largest(Geometry2D.offset_polygon(q, 3.0, Geometry2D.JOIN_MITER))])
	sites[-1]["outline"] = q


func _build_pokorna2(site: Dictionary) -> void:
	var poly := _simplify(site["outline"], 0.6)
	if poly.size() < 3:
		return
	_g = _ground_under(poly)
	var g := _g
	var floors := 20
	var top := g + POKORNA2_FLOOR * floors
	for i in poly.size():
		var a := poly[i]
		var b := poly[(i + 1) % poly.size()]
		var long_face := a.distance_to(b) >= 8.0
		_mode = M_SKIN + float(S_SLAB) / 16.0 if long_face else M_STONE
		_wall(a, b, g - 0.4, top, _out(poly, a, b), POKORNA2_PLASTER if long_face else POKORNA2_END)
	_mode = M_STONE
	_cap(poly, top, Color("#8c8a84"))
	# A balcony slab with a railing on every floor above the first, along each long face, held
	# 0.8 m short of the corners so neighbouring faces' balconies never cross.
	for i in poly.size():
		var a := poly[i]
		var b := poly[(i + 1) % poly.size()]
		var len := a.distance_to(b)
		if len < 8.0:
			continue
		var d := (b - a) / len
		var o := _out(poly, a, b)
		var a2 := a + d * 0.8
		var b2 := b - d * 0.8
		var slab := PackedVector2Array([a2, b2, b2 + o * 1.0, a2 + o * 1.0])
		if Geometry2D.is_polygon_clockwise(slab) != Geometry2D.is_polygon_clockwise(poly):
			slab.reverse()
		for n in range(1, floors):
			var y := g + POKORNA2_FLOOR * n
			_prism(slab, y, y + 0.15, POKORNA2_SLAB, POKORNA2_SLAB, M_STONE, M_STONE)
			_wall(a2 + o * 1.0, b2 + o * 1.0, y + 0.15, y + 0.95, o, POKORNA2_RAIL)
	# The roof: a lift house on the longest face's middle and a water tank beside it.
	var best := 0
	var longest := 0.0
	for i in poly.size():
		var el := poly[i].distance_to(poly[(i + 1) % poly.size()])
		if el > longest:
			longest = el
			best = i
	var e0 := poly[best]
	var e1 := poly[(best + 1) % poly.size()]
	var dd := (e1 - e0).normalized()
	var oo := _out(poly, e0, e1)
	var mid := (e0 + e1) * 0.5 - oo * 3.0
	_prism(PackedVector2Array([mid - dd * 3.0 - oo * 2.0, mid + dd * 3.0 - oo * 2.0, mid + dd * 3.0 + oo * 2.0, mid - dd * 3.0 + oo * 2.0]),
			top, top + 3.2, POKORNA2_PLASTER.darkened(0.06), Color("#7d7b75"), M_STONE, M_STONE)
	var tank := mid + dd * 7.0
	_prism(_square(tank, 1.6), top, top + 2.4, Color("#9aa3a8"), Color("#7d8388"), M_STONE, M_STONE)
	_collide(poly)
	_mode = M_STONE


# --- Kino Muranów: the cinema under the arcaded block on Andersa ---------------------------

## F's four photos (2026-11-07, thread "Add arthouse cinema tour quest"; spec
## docs/landmarks/specs/kino_muranow.md): the cream one-storey pavilion along the socialist-realist
## block's front on Generała Andersa 5, its flat roof a paved terrace with a white balustrade and two
## pillars with ball finials before the arch through the block above; red MURANÓW letters over the
## doors with a white KINO either side; poster boards under little lamps; a grey plinth; the round
## fountain with the putti on the square in front, on the arch's axis; at night festoons of bulbs and
## paper lanterns over a café garden by the doors. OpenStreetMap maps the pavilion as one jagged
## `commercial` outline; the model straightens its front (KM_FRONT) the way the photos show it.
## In the frame: u along the front (towards Nowolipki, south-east), v out to the square.
const KM_AT := Vector2(-1661.5, -1209.8)          # the OSM cinema point (inside the pavilion)
const KM_O := Vector2(-1653.5, -1212.1)           # the front's middle (the doors)
const KM_U := Vector2(0.481, 0.876)               # along the front
const KM_V := Vector2(0.876, -0.481)              # out to the square
const KM_FRONT := 15.0                            # the straight front's half length
const KM_DEEP := 14.0                             # how deep the straightened block reaches back
const KM_H := 4.8                                 # the pavilion's top over the square
const KM_PLINTH := 0.9
const KM_RAIL := 1.05                             # the balustrade over the terrace
const KM_ARCH_U := -3.0                           # the arch's (and the fountain's) axis along u
const KM_ARCH_V := -27.3                          # the block's front behind the terrace
const KM_FOUNT := Vector2(-0.3, 19.2)             # the fountain's middle (u, v): OSM's basin ring
const KM_FOUNT_R := 5.0                           # the basin
const KM_STEP := 0.15                             # the round platform's steps (photo 4): rise,
const KM_TREAD := 0.4                             # tread,
const KM_STEPS := 3                               # count; the platform runs 1.6 m round the basin
const KM_PLAT_R := KM_FOUNT_R + 1.6
## The bench row by the metro parapet (map_builder BENCH_ROWS sets OSM's benches in it): its
## middle and direction in game x/z; the site paves a strip under it (the street photo).
const KM_BENCH_MID := Vector2(-1623.8, -1213.9)
const KM_BENCH_DIR := Vector2(-0.49, 0.872)
const KM_WALL := Color("#e7dcb6")
const KM_CORNICE := Color("#efe7cc")
const KM_GREY := Color("#8c8b86")
const KM_TERRACE := Color("#bdb7aa")
const KM_BALUSTER := Color("#ece8dc")
const KM_STEP_STONE := Color("#c9c3b6")
const KM_STONE := Color("#d2c5a3")                # the arch block's stone, a shade under the walls
const KM_RED := Color(0.86, 0.13, 0.1)            # the letters (lit at night)
const KM_WHITE := Color(0.96, 0.95, 0.9)
const KM_GLASS := Color("#2e3539")
const KM_FRAME := Color("#2a2a2a")
const KM_PATINA := Color("#6f9a84")               # the fountain's green bronze
const KM_WATER := Color("#58798a")
## The poster boards (u from, u to) and each one's two parody posters' colours (no real films).
const KM_POSTERS := [[-8.6, -3.1, [Color("#c8582a"), Color("#2f3f6a")]], [3.1, 8.6, [Color("#e9e4d6"), Color("#3f7a4a")]]]
## The café garden's tables (u, v) by the left posters, and the festoon posts (u, v).
const KM_TABLES := [Vector2(-10.6, 2.6), Vector2(-7.8, 4.2), Vector2(-5.2, 2.8), Vector2(-9.2, 6.0), Vector2(-12.6, 5.0)]
const KM_POSTS := [Vector2(-12.0, 8.2), Vector2(-4.0, 8.6), Vector2(4.5, 8.4), Vector2(11.5, 7.8)]
const KM_TABLE_TOP := Color("#d9d2c4")
const KM_CHAIR := Color("#3a3d40")


func _find_kino_muranow() -> void:
	var q := _outline_at(KM_AT)
	if q.size() < 3:
		return
	var front := PackedVector2Array([_km(-KM_FRONT, 0.0), _km(KM_FRONT, 0.0), _km(KM_FRONT, -KM_DEEP), _km(-KM_FRONT, -KM_DEEP)])
	# Simplified again: the OSM corners left a hand's breadth off the straight front make slivers.
	var body := _simplify(_largest(Geometry2D.merge_polygons(_simplify(q, 0.6), front)), 0.4)
	if body.size() < 3:
		return
	var fc := _km(KM_FOUNT.x, KM_FOUNT.y)
	_add_site("kino_muranow", [_largest(Geometry2D.offset_polygon(body, 0.5, Geometry2D.JOIN_MITER))])
	if sites.is_empty() or sites[-1]["key"] != "kino_muranow":
		return
	sites[-1]["body"] = body
	tree_free.append([fc, KM_PLAT_R + KM_TREAD * (KM_STEPS - 1) + 1.0])


## A point in the cinema's frame.
static func _km(u: float, v: float) -> Vector2:
	return KM_O + KM_U * u + KM_V * v


func _build_kino_muranow(site: Dictionary) -> void:
	var body: PackedVector2Array = site["body"]
	var g := float(map.terrain_height(_km(0.0, 3.0).x, _km(0.0, 3.0).y))
	_g = g
	var top := g + KM_H
	# The pavilion: a grey plinth, the cream walls, a cornice slab whose top is the terrace.
	_prism(body, g - 0.6, g + KM_PLINTH, KM_GREY, Color(0, 0, 0, 0), M_STONE)
	_prism(body, g + KM_PLINTH, top - 0.35, KM_WALL, Color(0, 0, 0, 0), M_STONE)
	var lip := _largest(Geometry2D.offset_polygon(body, 0.22, Geometry2D.JOIN_MITER))
	_prism(lip, top - 0.35, top, KM_CORNICE, KM_TERRACE, M_STONE, M_STONE)
	# The balustrade along every edge that faces the square (white, a darker coping on top).
	for i in body.size():
		var a := body[i]
		var b := body[(i + 1) % body.size()]
		var o := _out(body, a, b)
		if o.dot(KM_V) < 0.3 or a.distance_to(b) < 1.0:
			continue
		var d := (b - a).normalized()
		var mid := (a + b) * 0.5 + o * 0.05
		_pow_box(mid, d, a.distance_to(b) * 0.5 + 0.1, 0.13, top, top + KM_RAIL - 0.12, KM_BALUSTER, KM_BALUSTER)
		_pow_box(mid, d, a.distance_to(b) * 0.5 + 0.15, 0.2, top + KM_RAIL - 0.12, top + KM_RAIL, KM_CORNICE.darkened(0.06), KM_CORNICE)
	_km_front(g, top)
	_km_terrace(top)
	_km_fountain()
	_km_garden(g, top)
	_collide(body)
	_collide(_circle(_km(KM_FOUNT.x, KM_FOUNT.y), KM_PLAT_R + KM_TREAD * (KM_STEPS - 1), 16))
	_mode = M_STONE


## The front: the doors' glass bay, the poster boards with their lamps, the red MURANÓW and the
## two white KINO words, all a hand's breadth proud of the wall.
func _km_front(g: float, top: float) -> void:
	var n3 := Vector3(KM_V.x, 0.0, KM_V.y)
	var f := 0.06
	# The doors: a warm-lit glass bay (M_PAVILION) with dark frames.
	var keep := _mode
	_mode = M_PAVILION
	var d0 := _km(-2.4, f)
	var d1 := _km(2.4, f)
	_quad(Vector3(d0.x, g, d0.y), Vector3(d1.x, g, d1.y), Vector3(d1.x, g + 3.0, d1.y), Vector3(d0.x, g + 3.0, d0.y), n3, KM_GLASS,
			Vector2(0, 0), Vector2(4.8, 0), Vector2(4.8, 3.0), Vector2(0, 3.0), 3.0)
	_mode = M_STONE
	for u: float in [-2.4, -1.2, 0.0, 1.2, 2.4]:
		var p := _km(u, f + 0.1)
		_beam(Vector3(p.x, g, p.y), Vector3(p.x, g + 3.05, p.y), 0.09, KM_FRAME)
	var h0 := _km(-2.45, f + 0.1)
	var h1 := _km(2.45, f + 0.1)
	for y: float in [3.05, 2.2]:
		_beam(Vector3(h0.x, g + y, h0.y), Vector3(h1.x, g + y, h1.y), 0.09, KM_FRAME)
	# The poster boards: a dark frame, two posters each, a little lamp over each poster.
	for board: Array in KM_POSTERS:
		var u0: float = board[0]
		var u1: float = board[1]
		var a := _km(u0, f)
		var b := _km(u1, f)
		_quad(Vector3(a.x, g + 0.95, a.y), Vector3(b.x, g + 0.95, b.y), Vector3(b.x, g + 3.45, b.y), Vector3(a.x, g + 3.45, a.y), n3, KM_FRAME)
		var cols: Array = board[2]
		for k in 2:
			var pu0 := lerpf(u0, u1, k * 0.5) + 0.12
			var pu1 := lerpf(u0, u1, (k + 1) * 0.5) - 0.12
			var p0 := _km(pu0, f + 0.05)
			var p1 := _km(pu1, f + 0.05)
			var col: Color = cols[k]
			_quad(Vector3(p0.x, g + 1.07, p0.y), Vector3(p1.x, g + 1.07, p1.y), Vector3(p1.x, g + 3.33, p1.y), Vector3(p0.x, g + 3.33, p0.y), n3, col)
			# A title band and a face-sized block on each (shapes only, no real film).
			var t0 := _km(pu0 + 0.2, f + 0.1)
			var t1 := _km(pu1 - 0.2, f + 0.1)
			_quad(Vector3(t0.x, g + 1.35, t0.y), Vector3(t1.x, g + 1.35, t1.y), Vector3(t1.x, g + 1.65, t1.y), Vector3(t0.x, g + 1.65, t0.y), n3,
					KM_WHITE if col.get_luminance() < 0.5 else KM_FRAME)
			var c := (pu0 + pu1) * 0.5
			var m0 := _km(c - 0.55, f + 0.1)
			var m1 := _km(c + 0.55, f + 0.1)
			_quad(Vector3(m0.x, g + 2.0, m0.y), Vector3(m1.x, g + 2.0, m1.y), Vector3(m1.x, g + 3.05, m1.y), Vector3(m0.x, g + 3.05, m0.y), n3,
					col.lightened(0.35) if col.get_luminance() < 0.5 else col.darkened(0.45))
			var lamp := _km(c, f + 0.35)
			_mode = M_LAMP
			_pow_box(lamp, KM_U, 0.14, 0.1, g + 3.62, g + 3.75, BARGE_BULB, BARGE_BULB, M_LAMP)
			_mode = M_STONE
			var arm := _km(c, f)
			_beam(Vector3(arm.x, g + 3.7, arm.y), Vector3(lamp.x, g + 3.7, lamp.y), 0.04, KM_FRAME, false)
	# The words: red MURANÓW over the doors, white KINO at each end (photo 2: KINO, MURANÓW, KINO).
	_km_word("MURANÓW", -0.6, g + 3.75, 0.95, 0.28, KM_RED, f)
	_km_word("KINO", -11.6, g + 3.95, 0.6, 0.15, KM_WHITE, f)
	_km_word("KINO", 11.3, g + 3.95, 0.6, 0.15, KM_WHITE, f)
	_mode = keep


## A word in solid pixel blocks on the front, centred on u, its bottom at y, `h` tall; `sx` is a
## pixel column's width (the real letters are wide). M_LAMP: its colour by day, lit at night.
func _km_word(text: String, u: float, y: float, h: float, sx: float, col: Color, f: float) -> void:
	var sy := h / 7.0
	var width := 0.0
	for ch in text:
		width += (_pow_glyph_w(ch) + 1) * sx
	width -= sx
	var at := u - width * 0.5
	var keep := _mode
	_mode = M_LAMP
	for ch in text:
		var lit := {}
		for q: Vector2i in _pow_glyph(ch):
			lit[q] = true
		# Horizontal runs, one block each.
		for q: Vector2i in lit:
			if lit.has(q - Vector2i(1, 0)):
				continue
			var e := q
			while lit.has(e + Vector2i(1, 0)):
				e += Vector2i(1, 0)
			var row := PixelFont.BODY + 6 - q.y   # 0 at the body's bottom row, accents above
			var u0 := at + q.x * sx
			var u1 := at + (e.x + 1) * sx
			# The reader faces -v: their left-to-right runs along -u, so the word is mirrored about u.
			var p := _km(2.0 * u - (u0 + u1) * 0.5, f + 0.12)
			_pow_box(p, KM_U, (u1 - u0) * 0.5, 0.1, y + row * sy, y + (row + 1) * sy, col, col.lightened(0.15), M_LAMP)
		at += (_pow_glyph_w(ch) + 1) * sx
	_mode = keep


## The terrace on the roof: the two pillars with ball finials before the arch, and the arch block
## in the residential front behind (piers, the round arch, a dark passage, the attic).
func _km_terrace(top: float) -> void:
	for side: float in [-1.0, 1.0]:
		var p := _km(KM_ARCH_U + side * 5.6, -19.5)
		_pow_box(p, KM_U, 0.48, 0.48, top, top + 0.6, KM_BALUSTER.darkened(0.04), KM_BALUSTER)
		_pow_box(p, KM_U, 0.3, 0.3, top + 0.6, top + 4.6, KM_BALUSTER, KM_BALUSTER)
		_pow_box(p, KM_U, 0.42, 0.42, top + 4.6, top + 4.9, KM_CORNICE, KM_CORNICE)
		_pow_box(p, KM_U, 0.12, 0.12, top + 4.9, top + 5.05, KM_GREY.darkened(0.3), KM_GREY.darkened(0.3))
		# The ball: an octagonal drum with pointed caps.
		var ball := _circle(p, 0.3, 8)
		_prism(ball, top + 5.17, top + 5.45, KM_GREY.darkened(0.35), Color(0, 0, 0, 0), M_STONE)
		_pyramid(ball, top + 5.45, top + 5.62, KM_GREY.darkened(0.3))
		var under := _circle(p, 0.3, 8)
		under.reverse()
		_pyramid(under, top + 5.17, top + 5.05, KM_GREY.darkened(0.4))
	# The arch block: proud of the block's front, from the terrace to over the eaves.
	var gb := float(map.terrain_height(_km(KM_ARCH_U, KM_ARCH_V - 6.0).x, _km(KM_ARCH_U, KM_ARCH_V - 6.0).y))
	var crown := maxf(gb + 15.4, top + 12.0)
	var v0 := KM_ARCH_V - 0.2
	var v1 := KM_ARCH_V + 0.9
	var half := 5.2      # the block's half width
	var r := 2.6         # the arch's radius
	var spring := top + 6.2
	var piers := [[KM_ARCH_U - half, KM_ARCH_U - r], [KM_ARCH_U + r, KM_ARCH_U + half]]
	for pr: Array in piers:
		var c := (float(pr[0]) + float(pr[1])) * 0.5
		_pow_box(_km(c, (v0 + v1) * 0.5), KM_U, (float(pr[1]) - float(pr[0])) * 0.5, (v1 - v0) * 0.5, top - 0.2, crown, KM_STONE, KM_STONE.darkened(0.1))
	# Over the arch: the solid part from its crown up, then the arch's curve in steps.
	_pow_box(_km(KM_ARCH_U, (v0 + v1) * 0.5), KM_U, r, (v1 - v0) * 0.5, spring + r, crown, KM_STONE, KM_STONE.darkened(0.1))
	var steps := 6
	for k in steps:
		var a0 := PI * 0.5 * k / steps
		var a1 := PI * 0.5 * (k + 1) / steps
		var w := r * cos(a1)   # the opening's half width at this step's top
		var y0 := spring + r * sin(a0)
		var y1 := spring + r * sin(a1)
		for side: float in [-1.0, 1.0]:
			var cu := KM_ARCH_U + side * (w + (r - w) * 0.5)
			_pow_box(_km(cu, (v0 + v1) * 0.5), KM_U, (r - w) * 0.5, (v1 - v0) * 0.5, y0, y1 + 0.02, KM_STONE, KM_STONE)
	# The passage: dark behind the opening.
	var n3 := Vector3(KM_V.x, 0.0, KM_V.y)
	var a := _km(KM_ARCH_U - r, v0 + 0.05)
	var b := _km(KM_ARCH_U + r, v0 + 0.05)
	_quad(Vector3(a.x, top, a.y), Vector3(b.x, top, b.y), Vector3(b.x, spring + r, b.y), Vector3(a.x, spring + r, a.y), n3, Color("#3b3a36"))
	# The cornice over the block and the attic's band.
	_pow_box(_km(KM_ARCH_U, (v0 + v1) * 0.5 + 0.1), KM_U, half + 0.3, (v1 - v0) * 0.5 + 0.3, crown - 0.5, crown - 0.15, KM_CORNICE, KM_CORNICE)
	_pow_box(_km(KM_ARCH_U, (v0 + v1) * 0.5 + 0.2), KM_U, half + 0.05, 0.12, spring + r + 1.2, spring + r + 1.45, KM_CORNICE, KM_CORNICE)


## The fountain on the square: a round platform up three steps (photo 4; OSM's ring `wall` is
## the basin, map_builder SITE_WALLS leaves it to this site), a round stone basin with water, a
## square green-bronze pedestal, four putti round a column, and the wide upper bowl (photo 1).
func _km_fountain() -> void:
	var c := _km(KM_FOUNT.x, KM_FOUNT.y)
	var g0 := float(map.terrain_height(c.x, c.y))
	# The steps, on the half towards the cinema only (photo 4; the street photo from Andersa has the
	# basin's paving ring level with the benches): outermost first, a riser from below the ground
	# and a tread ring inside it. Round the other half the platform ends in one low stone kerb.
	var unit := _circle(Vector2.ZERO, 1.0, 24)
	var stepped: Array[bool] = []
	for k in 24:
		stepped.append(((unit[k] + unit[(k + 1) % 24]) * 0.5).dot(-KM_V) > 0.0)
	for s in KM_STEPS:
		var ro := KM_PLAT_R + KM_TREAD * (KM_STEPS - 1 - s)
		var ri := ro - KM_TREAD if s < KM_STEPS - 1 else KM_FOUNT_R - 0.05
		var y1 := g0 + KM_STEP * (s + 1)
		var shade := KM_STEP_STONE.darkened(0.04 * (KM_STEPS - 1 - s))
		for k in 24:
			var top := s == KM_STEPS - 1
			if not stepped[k] and not top:
				continue
			var y0 := g0 - 0.25 if s == 0 or not stepped[k] else g0 + KM_STEP * s
			var a := c + unit[k] * ro
			var b := c + unit[(k + 1) % 24] * ro
			var o := ((a + b) * 0.5 - c).normalized()
			_quad(Vector3(a.x, y0, a.y), Vector3(b.x, y0, b.y), Vector3(b.x, y1, b.y), Vector3(a.x, y1, a.y), Vector3(o.x, 0.0, o.y), shade.darkened(0.12))
			var ia := c + unit[k] * ri
			var ib := c + unit[(k + 1) % 24] * ri
			_quad(Vector3(a.x, y1, a.y), Vector3(b.x, y1, b.y), Vector3(ib.x, y1, ib.y), Vector3(ia.x, y1, ia.y), Vector3.UP, shade)
			# Where the flight ends, the side of this step's band.
			if not top:
				for side in 2:
					var j := k + side
					if stepped[(k + 2 * side - 1 + 24) % 24]:
						continue
					var e := unit[j % 24]
					var t := Vector2(-e.y, e.x) * (1.0 if side == 1 else -1.0)
					var p0 := c + e * (ro - KM_TREAD)
					var p1 := c + e * ro
					_quad(Vector3(p0.x, g0 - 0.25, p0.y), Vector3(p1.x, g0 - 0.25, p1.y), Vector3(p1.x, y1, p1.y), Vector3(p0.x, y1, p0.y), Vector3(t.x, 0.0, t.y), shade.darkened(0.08))
	# The paved strip under the bench row, its front towards the fountain.
	var bd := KM_BENCH_DIR.normalized()
	var bf := Vector2(-bd.y, bd.x)
	if bf.dot(c - KM_BENCH_MID) < 0.0:
		bf = -bf
	var gb := float(map.terrain_height(KM_BENCH_MID.x, KM_BENCH_MID.y))
	var m := KM_BENCH_MID
	var strip := PackedVector2Array([m - bd * 5.4 - bf * 1.0, m + bd * 5.4 - bf * 1.0, m + bd * 5.4 + bf * 1.7, m - bd * 5.4 + bf * 1.7])
	_prism(strip, gb - 0.2, gb + 0.03, KM_STEP_STONE.darkened(0.15), KM_STEP_STONE.darkened(0.05), M_STONE, M_STONE)
	var g := g0 + KM_STEP * KM_STEPS
	var outer := _circle(c, KM_FOUNT_R, 20)
	var inner := _circle(c, KM_FOUNT_R - 0.4, 20)
	# The rim as 20 short wall pieces, inside and out, and its top.
	for k in 20:
		var a := outer[k]
		var b := outer[(k + 1) % 20]
		var ia := inner[k]
		var ib := inner[(k + 1) % 20]
		var o := ((a + b) * 0.5 - c).normalized()
		var n := Vector3(o.x, 0.0, o.y)
		_quad(Vector3(a.x, g - 0.02, a.y), Vector3(b.x, g - 0.02, b.y), Vector3(b.x, g + 0.55, b.y), Vector3(a.x, g + 0.55, a.y), n, KM_BALUSTER.darkened(0.08))
		_quad(Vector3(ia.x, g + 0.2, ia.y), Vector3(ib.x, g + 0.2, ib.y), Vector3(ib.x, g + 0.55, ib.y), Vector3(ia.x, g + 0.55, ia.y), -n, KM_BALUSTER.darkened(0.2))
		_quad(Vector3(a.x, g + 0.55, a.y), Vector3(b.x, g + 0.55, b.y), Vector3(ib.x, g + 0.55, ib.y), Vector3(ia.x, g + 0.55, ia.y), Vector3.UP, KM_BALUSTER)
	_cap(inner, g + 0.2, KM_WATER)
	# The pedestal (scrolled corners as a wider foot and a cornice), the putti, the column, the bowl.
	_pow_box(c, KM_U, 0.95, 0.95, g + 0.15, g + 0.5, KM_PATINA.darkened(0.1), KM_PATINA)
	_pow_box(c, KM_U, 0.75, 0.75, g + 0.5, g + 1.55, KM_PATINA, KM_PATINA)
	_pow_box(c, KM_U, 0.9, 0.9, g + 1.55, g + 1.75, KM_PATINA.lightened(0.08), KM_PATINA.lightened(0.08))
	for k in 4:
		var d := Vector2.from_angle(KM_U.angle() + PI * 0.25 + PI * 0.5 * k)
		var p := c + d * 0.48
		_pow_box(p, d, 0.17, 0.2, g + 1.75, g + 2.55, KM_PATINA.lightened(0.04), KM_PATINA)
		_pow_box(p + d * 0.02, d, 0.13, 0.13, g + 2.55, g + 2.85, KM_PATINA.lightened(0.1), KM_PATINA.lightened(0.1))
	var col := _circle(c, 0.26, 8)
	_prism(col, g + 1.75, g + 3.75, KM_PATINA, Color(0, 0, 0, 0), M_STONE)
	# The bowl: a flared frustum from the column out to its rim, a flat top of water.
	var lo := _circle(c, 0.4, 16)
	var hi := _circle(c, 1.75, 16)
	for k in 16:
		var a := lo[k]
		var b := lo[(k + 1) % 16]
		var ha := hi[k]
		var hb := hi[(k + 1) % 16]
		var o := ((ha + hb) * 0.5 - c).normalized()
		var n := (Vector3(o.x, 0.0, o.y) * 0.4 + Vector3.DOWN * 0.9).normalized()
		_quad(Vector3(a.x, g + 3.6, a.y), Vector3(b.x, g + 3.6, b.y), Vector3(hb.x, g + 4.1, hb.y), Vector3(ha.x, g + 4.1, ha.y), n, KM_PATINA.darkened(0.08))
		_quad(Vector3(ha.x, g + 4.1, ha.y), Vector3(hb.x, g + 4.1, hb.y), Vector3(hb.x, g + 4.3, hb.y), Vector3(ha.x, g + 4.3, ha.y), Vector3(o.x, 0.0, o.y), KM_PATINA)
	_cap(hi, g + 4.3, KM_PATINA.lightened(0.12))


## The café garden by the doors and its lights: small tables with folding chairs, festoons of warm
## bulbs from the front's top out to four posts and along the front, paper lanterns under them.
func _km_garden(g: float, top: float) -> void:
	for t: Vector2 in KM_TABLES:
		var p := _km(t.x, t.y)
		var y := float(map.terrain_height(p.x, p.y))
		_pow_box(p, KM_U, 0.36, 0.36, y + 0.71, y + 0.75, KM_TABLE_TOP.darkened(0.1), KM_TABLE_TOP)
		_beam(Vector3(p.x, y, p.y), Vector3(p.x, y + 0.72, p.y), 0.07, KM_CHAIR, false)
		for side: float in [-1.0, 1.0]:
			var s := p + KM_U * (side * 0.62)
			var to := -KM_U * side
			_pow_box(s, to, 0.2, 0.2, y + 0.42, y + 0.46, KM_CHAIR, KM_CHAIR)
			_pow_box(s - to * 0.2, to, 0.025, 0.2, y + 0.46, y + 0.86, KM_CHAIR, KM_CHAIR)
			_beam(Vector3(s.x, y, s.y), Vector3(s.x, y + 0.43, s.y), 0.05, KM_CHAIR, false)
	var hook_y := top - 0.75
	var hooks: Array[Vector3] = []
	for u: float in [-14.0, -7.0, 0.0, 7.0, 14.0]:
		var h := _km(u, 0.3)
		hooks.append(Vector3(h.x, hook_y, h.y))
	for i in hooks.size() - 1:
		_pow_festoon(hooks[i], hooks[i + 1], 0.35, 6)
	for k in KM_POSTS.size():
		var pp: Vector2 = KM_POSTS[k]
		var foot := _km(pp.x, pp.y)
		var y := float(map.terrain_height(foot.x, foot.y))
		_beam(Vector3(foot.x, y - 0.3, foot.y), Vector3(foot.x, y + 3.6, foot.y), 0.1, KM_FRAME)
		var from: Vector3 = hooks[mini(k + 1, hooks.size() - 1)]
		_pow_festoon(from, Vector3(foot.x, y + 3.55, foot.y), 0.6, 7)
		if k + 1 < KM_POSTS.size():
			var nxt: Vector2 = KM_POSTS[k + 1]
			var nf := _km(nxt.x, nxt.y)
			var ny := float(map.terrain_height(nf.x, nf.y))
			_pow_festoon(Vector3(foot.x, y + 3.55, foot.y), Vector3(nf.x, ny + 3.55, nf.y), 0.5, 7)
	# The paper lanterns: bigger warm-white globes hung under the front's festoon.
	var keep := _mode
	_mode = M_LAMP
	for u: float in [-12.5, -9.0, -5.5, 5.5, 9.0, 12.5]:
		var p := _km(u, 1.4)
		var ring := _circle(p, 0.24, 6)
		_prism(ring, hook_y - 0.95, hook_y - 0.55, Color(1.0, 0.93, 0.78), Color(1.0, 0.93, 0.78), M_LAMP, M_LAMP)
		_beam(Vector3(p.x, hook_y - 0.55, p.y), Vector3(p.x, hook_y - 0.3, p.y), 0.02, KM_FRAME, false)
	_mode = keep


# --- TR Warszawa's building site ----------------------------------------------------------

## F's ask (2026-10-31): the empty plot west of the museum, between its tree court and the
## Palace, fenced for TR Warszawa's theatre, as a messy building site and nothing built yet
## (F's night photo: a hoarding with black tarps, dug-up ground with old foundations, rubble,
## cabins): a hoarding with a gate, the dug-up ground, spoil heaps, the grid of old foundation
## walls, stacked cabins, a skip, pallets and steel, a small digger and one tower crane (a red
## lamp on its top, lit at night). In the museum's frame (MSN, MSN_AXIS): u -62..16, v 46..100.
const TR_U := Vector2(-62.0, 16.0)   # the plot along u
const TR_V := Vector2(46.0, 100.0)   # and across (towards the Palace)
const TR_HOARD := Color("#3f5a4a")   # dark green hoarding boards
const TR_TARP := Color("#232527")    # black tarp on the fence
const TR_DIRT := Color("#7d6a55")
const TR_SPOIL := Color("#8b7760")
const TR_CONCRETE := Color("#a7a49d")
const TR_STEEL := Color("#4a4d52")
const TR_CRANE := Color("#e2b33a")
const TR_CABIN := Color("#e8ebee")
const TR_CABIN_B := Color("#3d6fa3")
## The crane: [u, v, mast height, jib angle (deg, from +u), jib length, counter-jib length].
const TR_CRANES := [[-6.0, 90.0, 40.0, 200.0, 44.0, 12.0]]
## Spoil heaps: [u, v, half u, half v, height].
const TR_HEAPS := [[-48.0, 88.0, 7.0, 5.0, 3.2], [-30.0, 92.0, 5.0, 4.0, 2.4], [6.0, 56.0, 4.0, 3.5, 2.0]]
## The old foundations: walls [u0, v0, u1, v1, height] (a grid with gaps, as dug up).
const TR_RUINS := [[-40.0, 58.0, -18.0, 58.0, 0.9], [-40.0, 58.0, -40.0, 78.0, 0.7], [-29.0, 62.0, -29.0, 80.0, 1.1],
		[-36.0, 70.0, -14.0, 70.0, 0.6], [-18.0, 58.0, -18.0, 66.0, 1.0], [-22.0, 80.0, -8.0, 80.0, 0.8]]
func _find_tr() -> void:
	_o = MSN
	_a = MSN_AXIS.normalized()
	_b = Vector2(-_a.y, _a.x)
	_add_site("tr", [_tr_rect(0.5)])


## The plot's rectangle in the museum's frame, grown by `grow` metres.
func _tr_rect(grow: float) -> PackedVector2Array:
	return _rect((TR_U.x + TR_U.y) * 0.5, (TR_V.x + TR_V.y) * 0.5,
			(TR_U.y - TR_U.x) * 0.5 + grow, (TR_V.y - TR_V.x) * 0.5 + grow)


func _build_tr(_site: Dictionary) -> void:
	_o = MSN
	_a = MSN_AXIS.normalized()
	_b = Vector2(-_a.y, _a.x)
	var u0 := TR_U.x
	var u1 := TR_U.y
	var v0 := TR_V.x
	var v1 := TR_V.y
	var cu := (u0 + u1) * 0.5
	var cv := (v0 + v1) * 0.5
	var hu := (u1 - u0) * 0.5
	var hv := (v1 - v0) * 0.5
	var plot := _tr_rect(0.0)
	_g = _ground_under(plot)
	var g := _g
	var none := Color(0, 0, 0, 0)
	# hoarding: 2.4 m boards, 0.2 m thick, black tarp on the long run by the tree court and a
	# 10 m gate in it; green boards on the other three runs.
	var t := 0.1
	var gate := Vector2(-8.0, 2.0)
	_lbox((u0 + gate.x) * 0.5, v0 + t, (gate.x - u0) * 0.5, t, g - 0.3, g + 2.4, TR_TARP, M_STONE)
	_lbox((gate.y + u1) * 0.5, v0 + t, (u1 - gate.y) * 0.5, t, g - 0.3, g + 2.4, TR_TARP, M_STONE)
	_lbox(cu, v1 - t, hu, t, g - 0.3, g + 2.4, TR_HOARD, M_STONE)
	_lbox(u0 + t, cv, t, hv - 2.0 * t, g - 0.3, g + 2.4, TR_HOARD, M_STONE)
	_lbox(u1 - t, cv, t, hv - 2.0 * t, g - 0.3, g + 2.4, TR_HOARD, M_STONE)
	# ground: the dug-up dirt inside the hoarding.
	_lbox(cu, cv, hu - 0.4, hv - 0.4, g - 0.3, g + 0.15, TR_DIRT, M_STONE, TR_DIRT)
	# heaps: spoil heaps of dug soil and rubble.
	_mode = M_STONE
	for h: Array in TR_HEAPS:
		_frustum(_rect(h[0], h[1], h[2], h[3]), g + 0.15, _rect(h[0], h[1], h[2] * 0.3, h[3] * 0.3), g + 0.15 + h[4],
				TR_SPOIL, TR_SPOIL.lightened(0.06))
	# ruins: the old foundation walls, broken off at different heights.
	for w: Array in TR_RUINS:
		var along := Vector2(w[2] - w[0], w[3] - w[1])
		var mid := Vector2(w[0] + w[2], w[1] + w[3]) * 0.5
		var half_u := maxf(absf(along.x) * 0.5, 0.25)
		var half_v := maxf(absf(along.y) * 0.5, 0.25)
		_lbox(mid.x, mid.y, half_u, half_v, g + 0.15, g + 0.15 + w[4], TR_CONCRETE.darkened(0.12), M_STONE, TR_CONCRETE)
	# cabins: two stacks of site cabins inside the gate, white and blue.
	for i in 2:
		var su := u1 - 4.0 - i * 2.7
		_lbox(su, v0 + 5.0, 1.2, 3.0, g + 0.15, g + 2.75, TR_CABIN, M_STONE, TR_CABIN.darkened(0.08))
		_lbox(su, v0 + 5.0, 1.2, 3.0, g + 2.75, g + 5.35, TR_CABIN_B if i == 0 else TR_CABIN, M_STONE, TR_CABIN.darkened(0.12))
	# skip: an open steel skip by the gate (walls only, rubble inside).
	_prism(_rect(-14.0, v0 + 4.0, 2.8, 1.2), g + 0.15, g + 1.6, Color("#c8552f"), none, M_STONE)
	_lbox(-14.0, v0 + 4.0, 2.6, 1.0, g + 0.15, g + 1.2, TR_SPOIL.darkened(0.1), M_STONE, TR_SPOIL.darkened(0.1))
	# stacks: pallets of blocks and bundles of steel along the far board.
	for i in 5:
		var su := u1 - 6.0 - i * 3.4
		_lbox(su, v1 - 3.0, 1.1, 0.9, g + 0.15, g + 1.1 + 0.25 * (i % 2), Color("#9a7b5c") if i % 2 == 0 else TR_STEEL, M_STONE)
	# digger: a small yellow excavator by the heaps, its arm down into the ground.
	_tr_digger(Vector2(-38.0, 84.0), 30.0)
	for c: Array in TR_CRANES:
		_tr_crane(c)
	_o = MSN
	_a = MSN_AXIS.normalized()
	_b = Vector2(-_a.y, _a.x)
	_collide(plot)


## digger: tracks, the turning body, the cab and the boom, at `at` (museum frame), turned `deg`.
func _tr_digger(at: Vector2, deg: float) -> void:
	var g := _g
	var p := _w(at.x, at.y)
	_o = p
	_a = Vector2.from_angle(deg_to_rad(deg) + MSN_AXIS.angle())
	_b = Vector2(-_a.y, _a.x)
	for side: float in [-1.1, 1.1]:
		_lbox(0.0, side, 1.9, 0.4, g + 0.15, g + 0.85, Color("#2f3033"), M_STONE)
	_lbox(-0.2, 0.0, 1.5, 1.2, g + 0.85, g + 1.9, TR_CRANE, M_STONE)
	_lbox(0.6, 0.6, 0.6, 0.55, g + 1.9, g + 3.1, TR_CRANE.darkened(0.1), M_STONE, Color("#3a4046"))
	_lbox(2.6, -0.4, 1.4, 0.2, g + 1.6, g + 2.2, TR_CRANE, M_STONE)
	_lbox(4.0, -0.4, 0.2, 0.2, g + 0.15, g + 2.2, TR_STEEL, M_STONE)
	_o = MSN
	_a = MSN_AXIS.normalized()
	_b = Vector2(-_a.y, _a.x)


## crane: a square mast on a concrete foot, the slewing deck, the operator's cab, the jib and
## the counter-jib with its counterweight, the A-frame with its two ties, a red lamp on top.
func _tr_crane(c: Array) -> void:
	var g := _g
	var base := _w(c[0], c[1])
	var h: float = c[2]
	_o = base
	_a = Vector2.from_angle(deg_to_rad(c[3]) + MSN_AXIS.angle())
	_b = Vector2(-_a.y, _a.x)
	var none := Color(0, 0, 0, 0)
	_lbox(0.0, 0.0, 2.2, 2.2, g - 0.3, g + 1.2, TR_CONCRETE, M_STONE)
	_prism(_rect(0.0, 0.0, 0.8, 0.8), g + 1.2, g + h, TR_CRANE, none, M_STONE)
	_lbox(0.0, 0.0, 1.3, 1.3, g + h, g + h + 1.0, TR_CRANE.darkened(0.15), M_STONE)
	_lbox(1.6, -1.6, 0.9, 0.8, g + h - 1.2, g + h + 1.0, TR_CABIN, M_STONE)
	var jl: float = c[4]
	var cl: float = c[5]
	_lbox(jl * 0.5, 0.0, jl * 0.5, 0.5, g + h + 1.0, g + h + 2.2, TR_CRANE, M_STONE)
	_lbox(-cl * 0.5 - 0.0, 0.0, cl * 0.5, 0.6, g + h + 1.0, g + h + 1.8, TR_CRANE, M_STONE)
	_lbox(-cl + 1.6, 0.0, 1.5, 1.1, g + h - 0.6, g + h + 1.0, TR_CONCRETE.darkened(0.15), M_STONE)
	# the A-frame: a tapered tower over the mast, the ties as thin slanted boxes.
	_mode = M_STONE
	_frustum(_rect(0.0, 0.0, 0.7, 0.7), g + h + 2.2, _rect(0.0, 0.0, 0.25, 0.25), g + h + 8.0, TR_CRANE, TR_CRANE)
	for tie: Vector2 in [Vector2(jl * 0.7, g + h + 2.2), Vector2(-cl + 0.5, g + h + 1.8)]:
		var top := _w(0.0, 0.0)
		var end := _w(tie.x, 0.0)
		var side := _b * 0.12
		var y_top := g + h + 7.6
		var n := Vector3(end.x - top.x, tie.y - y_top, end.y - top.y).cross(Vector3(side.x, 0.0, side.y)).normalized()
		_quad(Vector3(top.x - side.x, y_top, top.y - side.y), Vector3(top.x + side.x, y_top, top.y + side.y),
				Vector3(end.x + side.x, tie.y, end.y + side.y), Vector3(end.x - side.x, tie.y, end.y - side.y),
				n if n.y > 0.0 else -n, TR_CRANE.darkened(0.1))
	_prism(_rect(0.0, 0.0, 0.25, 0.25), g + h + 8.0, g + h + 8.6, DUSK_RED, DUSK_RED, M_LAMP, M_LAMP)
	_mode = M_STONE


## The Tomb of the Unknown Soldier: the three arches left of the Saxon Palace's colonnade (blown
## up in 1944). A granite platform, two rows of four stone piers, round arches on both long
## faces, the entablature and its cornice over them; under the middle arch the tomb slab with
## wreaths and the eternal flame (it glows at night) on the square's side.
func _build_grob(_site: Dictionary) -> void:
	_o = GROB
	_a = GROB_AXIS
	_b = Vector2(-_a.y, _a.x)
	_g = map.terrain_height(GROB.x, GROB.y)
	var g := _g
	var light := GROB_STONE.lightened(0.06)
	_lbox(0.0, 0.0, 7.6, 4.4, g - 0.5, g + 0.3, GROB_GRANITE, M_STONE, GROB_GRANITE)
	for v: float in [-GROB_ROW, GROB_ROW]:
		for u: float in GROB_PIERS:
			_lbox(u, v, 0.65, 0.65, g + 0.3, g + 5.0, GROB_STONE, M_STONE, GROB_STONE)
			_lbox(u, v, 0.8, 0.8, g + 5.0, g + 5.35, light, M_STONE, light)
		# The arches between the piers, on the row's outer face.
		var face := v + signf(v) * 0.65
		for k in GROB_PIERS.size() - 1:
			_arch(float(GROB_PIERS[k]) + 0.65, float(GROB_PIERS[k + 1]) - 0.65, face, g + 3.6, g + 5.35, GROB_STONE)
	_lbox(0.0, 0.0, 6.3, 3.75, g + 5.35, g + 7.3, GROB_STONE, M_STONE, GROB_STONE.darkened(0.08))
	_lbox(0.0, 0.0, 6.55, 4.0, g + 7.3, g + 7.65, light, M_STONE, light.darkened(0.1))
	# The tomb, its wreaths, the flame in its bronze bowl.
	_lbox(0.0, 0.0, 1.2, 0.8, g + 0.3, g + 0.55, GROB_GRANITE.darkened(0.3), M_STONE, GROB_GRANITE.darkened(0.3))
	_lbox(-0.75, -0.95, 0.3, 0.3, g + 0.3, g + 0.6, Color("#c8323a"), M_STONE, Color("#c8323a"))
	_lbox(0.75, -0.95, 0.3, 0.3, g + 0.3, g + 0.6, Color("#f1efe8"), M_STONE, Color("#f1efe8"))
	var bowl := _w(0.0, -1.9)
	_prism(_circle(bowl, 0.35, 6), g + 0.3, g + 1.0, GROB_BRONZE, GROB_BRONZE, M_STONE, M_STONE)
	_mode = M_LAMP
	_pyramid(_circle(bowl, 0.26, 4), g + 1.0, g + 1.75, GROB_FLAME)
	_mode = M_STONE
	_collide(_rect(0.0, 0.0, 6.3, 3.7))


## A round arch's spandrel in the plane v = `v` of the local frame: the wall between y_spring
## and y_top from u0 to u1, less a half circle over the opening (six steps).
func _arch(u0: float, u1: float, v: float, y_spring: float, y_top: float, col: Color) -> void:
	var keep := _mode
	_mode = M_STONE
	var r := (u1 - u0) * 0.5
	var cu := (u0 + u1) * 0.5
	var n2 := _b * signf(v)
	var n := Vector3(n2.x, 0.0, n2.y)
	var steps := 6
	var at := func(u: float, y: float) -> Vector3:
		var p := _w(u, v)
		return Vector3(p.x, y, p.y)
	var uv := func(u: float, y: float) -> Vector2: return Vector2(u - u0, y - _g)
	var top := y_top - _g
	var prev := Vector2(u0, y_spring)
	for k in range(1, steps + 1):
		var ang := PI - PI * k / steps
		var cur := Vector2(cu + cos(ang) * r, y_spring + sin(ang) * r)
		var corner := Vector2(u0 if k * 2 <= steps else u1, y_top)
		_tri(at.call(corner.x, corner.y), at.call(prev.x, prev.y), at.call(cur.x, cur.y), n, col,
				uv.call(corner.x, corner.y), uv.call(prev.x, prev.y), uv.call(cur.x, cur.y), top)
		prev = cur
	_tri(at.call(u0, y_top), at.call(cu, y_spring + r), at.call(u1, y_top), n, col,
			uv.call(u0, y_top), uv.call(cu, y_spring + r), uv.call(u1, y_top), top)
	_mode = keep


