	_lbox(mid, 0.45, mid, 0.18, g + WD_EAVE - 1.4, g + WD_EAVE - 0.7, WD_SHADE)
	_lbox(mid, 0.8, mid + 0.4, 0.6, g + WD_EAVE - 0.7, g + WD_EAVE, WD_WHITE)
