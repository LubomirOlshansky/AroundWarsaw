const BUW_PATHS := [
	[Vector2(113.0, -942.5), Vector2(104.0, -944.5), Vector2(97.0, -943.5), Vector2(90.0, -940.5), Vector2(82.0, -938.0),
			Vector2(74.5, -935.5), Vector2(68.0, -932.5), Vector2(62.0, -928.0), Vector2(55.5, -925.0), Vector2(51.5, -921.0),
			Vector2(51.5, -915.5)],
