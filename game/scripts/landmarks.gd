		_lbox(u, v - 0.22, 0.28, 0.05, g + 0.34, g + 0.78, PCZ_GREEN.darkened(0.1), M_STONE, PCZ_GREEN)


func _build_plac_centralny_lamps(_site: Dictionary) -> void:
