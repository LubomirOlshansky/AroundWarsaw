## Pomnik Umschlagplatz (Hanna Szmalenberg and Władysław Klamerus, 1988), from
## refs/umschlagplatz/: an open-topped enclosure of white-grey marble slabs, 16 m along Stawki,
## 10 m deep and 4 m high; in the middle of the street side a tall narrow gate under a black
## stone semicircle; a black band round the outside at two thirds of the height with the name
## cut in it; the names on the walls inside. A quiet place: no props, no gags.
func _build_umschlagplatz(_site: Dictionary) -> void:
	_mon_frame(UMSCHLAG, UMSCHLAG_A)
	_g = _ground_under(_rect(0.0, 0.0, 8.0, 5.0))
	var g := _g
	var m := UMSCHLAG_MARBLE
	var bk := UMSCHLAG_BLACK
	var top := g + 4.0
	_mode = M_STONE
	_cap(_rect(0.0, 0.0, 7.6, 4.6), g + 0.06, Color("#bdbdb8"))
	_lbox(0.0, -4.8, 8.0, 0.2, g - 0.3, top, m, M_STONE, m.lightened(0.04))
	for s: float in [-1.0, 1.0]:
		_lbox(7.8 * s, 0.0, 0.2, 4.6, g - 0.3, top, m, M_STONE, m.lightened(0.04))
		_lbox(4.7 * s, 4.8, 3.3, 0.2, g - 0.3, top, m, M_STONE, m.lightened(0.04))
		_lbox(1.1 * s, 4.8, 0.3, 0.3, g - 0.3, g + 4.6, m.darkened(0.03), M_STONE, m)
		# the black band outside, at two thirds of the height
		_lbox(8.03 * s, 0.0, 0.03, 5.0, g + 2.6, g + 3.1, bk)
		_lbox(4.7 * s, 5.03, 3.3, 0.03, g + 2.6, g + 3.1, bk)
		# the names: a slightly darker field on the side walls inside
		_lbox(7.57 * s, 0.0, 0.03, 3.8, g + 0.8, g + 3.4, m.darkened(0.08))
	_lbox(0.0, -5.03, 8.06, 0.03, g + 2.6, g + 3.1, bk)
	_lbox(0.0, -4.57, 6.5, 0.03, g + 0.8, g + 3.4, m.darkened(0.08))
	# the gate: a lintel over the narrow opening, the black semicircle on it
	_lbox(0.0, 4.8, 0.8, 0.3, g + 3.9, g + 4.6, bk)
	_mon_halfdisc(0.0, 4.8, g + 4.6, 1.4, 0.4, bk)
	_collide(_rect(0.0, 0.0, 8.1, 5.1))


## Pomnik Poległym i Pomordowanym na Wschodzie (Maksymilian Biskupski, 1995), from
## refs/pomnik_wschod/: in Muranowska's wide median a bronze railway flatcar piled with crosses
## (Latin and Orthodox, a matzevah and a Muslim tombstone among them), up to 6 m over the
## street, at the east end of a track of 41 bronze sleepers with the places' names, laid on a
## low mound of rounded field stones 37 m long. Respectful, like Umschlagplatz.
func _build_pomnik_wschod(_site: Dictionary) -> void:
	_mon_frame(WSCHOD, WSCHOD_A)
	_g = _ground_under(_rect(0.0, 0.0, 22.0, 2.0))
	var g := _g
	var bz := WSCHOD_BRONZE
	_lbox(0.9, 0.0, 23.9, 4.6, g - 0.3, g + 0.05, Color("#77746f"), M_STONE, Color("#827f79"))
	_mode = M_STONE
	_frustum(_rect(0.0, 0.0, 22.2, 2.0), g + 0.05, _rect(0.0, 0.0, 22.0, 1.5), g + 0.45, WSCHOD_STONE, WSCHOD_STONE.lightened(0.05))
	# the 41 named sleepers west of the wagon, and the plain ones under it
	for i in 48:
		var u := -21.6 + 0.9 * i
		_lbox(u, 0.0, 0.13, 1.3, g + 0.45, g + 0.6, bz.lightened(0.04 * (i % 3)), M_STONE, bz.lightened(0.08))
	for s: float in [-1.0, 1.0]:
		_lbox(0.0, 0.72 * s, 21.9, 0.04, g + 0.6, g + 0.72, bz.lightened(0.12))
	# the flatcar on its two bogies at the track's east end
	for u: float in [16.4, 20.6]:
		_lbox(u, 0.0, 0.9, 0.85, g + 0.72, g + 1.1, bz.darkened(0.15))
	_lbox(18.5, 0.0, 3.5, 1.25, g + 1.1, g + 1.4, bz.darkened(0.08), M_STONE, bz)
	# the crosses, packed and leaning a little; every fourth Orthodox
	var rng := RandomNumberGenerator.new()
	rng.seed = 1795
	var deck := g + 1.4
	for i in 24:
		var cu := rng.randf_range(15.4, 21.6)
		var cv := rng.randf_range(-0.95, 0.95)
		var hh := rng.randf_range(2.2, 4.6)
		var lean := Vector3(rng.randf_range(-0.25, 0.25), 0.0, rng.randf_range(-0.25, 0.25))
		var foot := _mon_p(cu, cv, deck)
		var head := foot + Vector3.UP * hh + lean
		var col := bz.lightened(rng.randf_range(0.0, 0.12))
		_beam(foot, head, 0.14, col)
		var arm := 0.28 * hh
		var at := foot.lerp(head, 0.74)
		var across := Vector3(_b.x, 0.0, _b.y) * arm * 0.5 if i % 2 == 0 else Vector3(_a.x, 0.0, _a.y) * arm * 0.5
		_beam(at - across, at + across, 0.12, col)
		if i % 4 == 1:
			var top := foot.lerp(head, 0.88)
			_beam(top - across * 0.5, top + across * 0.5, 0.1, col)
			var low := foot.lerp(head, 0.4)
			_beam(low - across * 0.5 - Vector3.UP * 0.12, low + across * 0.5 + Vector3.UP * 0.12, 0.1, col)
	# the matzevah (a round-topped slab) and the Muslim tombstone (a pointed one)
	_lbox(16.0, -0.6, 0.08, 0.35, deck, deck + 1.2, bz.lightened(0.1))
	_frustum(_rect(16.0, -0.6, 0.08, 0.35), deck + 1.2, _rect(16.0, -0.6, 0.08, 0.18), deck + 1.42, bz.lightened(0.1), bz.lightened(0.1))
	_lbox(21.2, 0.55, 0.08, 0.25, deck, deck + 1.0, bz.lightened(0.06))
	_pyramid(_rect(21.2, 0.55, 0.08, 0.25), deck + 1.0, deck + 1.4, bz.lightened(0.06))
	# the cobbled apron round it (4.6 m each side, 2 m past the buffers): the kerb a car meets
	_collide(_rect(0.9, 0.0, 23.9, 4.6))
## Sąd Najwyższy's colonnade (Marek Budzyński and Zbigniew Badowski, 1999; spec
## docs/landmarks/specs/sad_najwyzszy.md, from the Mac's Plac Krasińskich photo reports, 2026-11-02).
## OpenStreetMap maps the court's columns as 2 m boxes 12 m tall under 2 m beams (12-14 m) in
## "marble #deeded", so they drew white; the photos show them green and ribbed, with dark metal
## lettering low on the shafts and relief rosettes in the capitals. The main block (LoD2, real roof)
## stays the map's: only the mapped colonnade is rebuilt, in its mapped plan and heights.
const SN_BOX := Rect2(-1345.0, -1790.0, 145.0, 100.0)
const SN_WEST_BEAM := Vector2(-1316.0, -1763.0)  # the north-west wing's beam, mapped without a colour
const SN_GREEN := Color("#738483")
const SN_RIB := Color("#83948f")
const SN_CAP := Color("#8b9b95")
const SN_ROSE := Color("#a9b5ab")
const SN_LETTERS := Color("#4f5c59")
const SN_BEAM := Color("#6f807e")
const SN_BEAM_TOP := Color("#5c6b69")


func _find_sad_najwyzszy() -> void:
	if _landmark("Sąd Najwyższy").size() < 3:
		return
	var parts := _parts_in(_box_poly(SN_BOX), func(b: Dictionary) -> bool:
			if str(b["c"]).to_lower() == "#deeded":
				return true
			return float(b["mh"]) >= 11.5 and _centre(_pts(b["p"])).distance_to(SN_WEST_BEAM) < 3.0)
	if parts.is_empty():
		return
	var zone: Array = []
	for b in parts:
		zone.append(_pts(b["p"]))
	_add_site("sad_najwyzszy", zone)
	if not sites.is_empty() and sites[-1]["key"] == "sad_najwyzszy":
		sites[-1]["parts"] = parts


func _build_sad_najwyzszy(site: Dictionary) -> void:
	var beams: Array[PackedVector2Array] = []
	var beam_y: Array[float] = []
	for b: Dictionary in site["parts"]:
		if float(b["mh"]) < 11.5:
			continue
		var poly := _pts(b["p"])
		_g = _ground_under(poly)
		var y0 := _g + float(b["mh"])
		_prism(poly, y0, _g + float(b["h"]), SN_BEAM, SN_BEAM_TOP, M_STONE, M_STONE)
		# the beam's soffit, seen from the steps
		var keep := _mode
		_mode = M_STONE
		_cap_piece(poly, y0 - 0.01, SN_BEAM.darkened(0.2))
		_mode = keep
		beams.append(poly)
		beam_y.append(y0)
	for b: Dictionary in site["parts"]:
		if float(b["mh"]) >= 11.5:
			continue
		var poly := _pts(b["p"])
		_g = _ground_under(poly)
		var top := _g + float(b["h"])
		var c := _centre(poly)
		for k in beams.size():
			if Geometry2D.is_point_in_polygon(c, beams[k]):
				top = beam_y[k]  # the shaft meets its beam whatever the ground does
				break
		_sn_column(poly, _g, top)
		_collide(poly)


## One column: a dark plinth, the band of lettering, the green shaft with its ribs, the wider
## capital with a rosette on every face.
func _sn_column(poly: PackedVector2Array, g: float, top: float) -> void:
	var none := Color(0, 0, 0, 0)
	var plinth := Geometry2D.offset_polygon(poly, 0.06, Geometry2D.JOIN_MITER)
	var cap := Geometry2D.offset_polygon(poly, 0.14, Geometry2D.JOIN_MITER)
	var band := Geometry2D.offset_polygon(poly, 0.015, Geometry2D.JOIN_MITER)
	var cap_y := top - 1.0
	_prism(plinth[0] if not plinth.is_empty() else poly, g - 0.3, g + 0.5, SN_LETTERS.darkened(0.2), SN_LETTERS, M_STONE, M_STONE)
	_prism(band[0] if not band.is_empty() else poly, g + 0.5, g + 3.0, SN_LETTERS, none, M_STONE)
	_prism(poly, g + 3.0, cap_y, SN_GREEN, none, M_STONE)
	_prism(cap[0] if not cap.is_empty() else poly, cap_y, top, SN_CAP, none, M_STONE)
	var keep := _mode
	_mode = M_STONE
	for i in poly.size():
		var a := poly[i]
		var b := poly[(i + 1) % poly.size()]
		var length := a.distance_to(b)
		if length < 0.8:
			continue
		var d := (b - a) / length
		var out := _out(poly, a, b)
		# the ribs: two thin vertical fins on every face (front and sides, no tops: they end
		# under the capital and on the lettering band)
		var nrm := Vector3(out.x, 0.0, out.y)
		var side := Vector3(d.x, 0.0, d.y)
		for t: float in [length / 3.0, length * 2.0 / 3.0]:
			var m := a + d * t
			var l0 := m - d * 0.05
			var l1 := m + d * 0.05
			var f0 := l0 + out * 0.08
			var f1 := l1 + out * 0.08
			_quad(Vector3(f0.x, g + 3.0, f0.y), Vector3(f1.x, g + 3.0, f1.y), Vector3(f1.x, cap_y, f1.y), Vector3(f0.x, cap_y, f0.y), nrm, SN_RIB)
			_quad(Vector3(l0.x, g + 3.0, l0.y), Vector3(f0.x, g + 3.0, f0.y), Vector3(f0.x, cap_y, f0.y), Vector3(l0.x, cap_y, l0.y), -side, SN_RIB.darkened(0.08))
			_quad(Vector3(f1.x, g + 3.0, f1.y), Vector3(l1.x, g + 3.0, l1.y), Vector3(l1.x, cap_y, l1.y), Vector3(f1.x, cap_y, f1.y), side, SN_RIB.darkened(0.08))
		var mid := (a + b) * 0.5 + out * 0.2
		_disc(Vector3(mid.x, cap_y + 0.5, mid.y), nrm, minf(0.32, length * 0.2), 6, SN_ROSE)
	_mode = keep


# --- Bracka and Plac Trzech Krzyży: Vitkac, Jabłkowski's, the Sheraton (photo reports, 2026-11-03) ---

## Three photo builds from the Mac gather (docs/landmarks/photo-reports/vitkac.md, jablkowskich.md,
## sheraton.md, CITY_INVENTORY 80-82). Each is built whole over its OpenStreetMap outline (the
## GUGiK LoD2 block and the mapped parts in the zone are dropped), colours and storeys from the
## photos, heights from the reports. The OSM outlines were trusted over the reports' ortho boxes
## where they disagree (Vitkac's ortho box sits ~20 m south of the outline, inside the error of the
## report's frame). Brands only as parodies: VIPKAC (a VIP's hangover), SZERATON.
## Specs docs/landmarks/specs/vitkac.md, jablkowscy.md, sheraton.md.

## Vitkac (Bracka 9): six storeys in a dark grey stone and metal skin with horizontal bands and big
## flush square windows, a fully glazed ground floor of shop windows, a set-back glass top storey
## with a planted terrace on the Bracka side; the long block's ends are rounded.
