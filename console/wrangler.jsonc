// The developer console (tools/console.py): static page, served with noindex headers (_headers is
// written next to index.html). Deploy rarely, from the Mac: console/README.md. Set the route to the
// subdomain F picks (below is a suggestion) before the first deploy.
{
  "name": "aroundwarsaw-console",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "../build/console",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "console.aroundwarsaw.app", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false
}
